
@{
    ViewBag.Title = "AboutProduct";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    #tablelist tbody tr td, tr th {
        text-align: left !important;
        border: 1px solid #dcdcdc !important;
        font-family: sans-serif;
        padding: 2px 5px;
    }

    #tablelist tbody tr th {
        background-color: forestgreen;
        padding: 2px 5px !important;
        font-weight: 400 !important
    }
</style>

<script type="text/javascript">

    $(document).ready(function () {

        AboutProductList();
        BindProduct();
    });  

    function AboutProductList() {
        debugger;

        $.ajax({
            type: "GET",
            url: "/ProductSearch/AboutProductList",
            async: false,
            success: function (json) {// json

                var data = json;
                var tbodyHTML = '';

                if (data != null) {
                    $(data).each(function (idx, elm) {

                        tbodyHTML += "<tr>";
                        tbodyHTML += "<td>" + elm.ProductName + "</td>";
                        tbodyHTML += "<td>" + "<a class='DeleteCss' onclick=GetDataId(" + elm.ProductId + ")><li class='fa fa-pencil-square-o'></li></a>" + "</td>";
                        tbodyHTML += "</tr>";

                    });
                }

                $(".tbodydata").html(tbodyHTML);
                $("#tablelist").show();
                $("#searchtext").val('');


            }
        });


    }


    function SearchText() {
        debugger;
        feed = {};
        feed.ProductName = $('#product option:selected').text();
        //$("#searchtext").val();
        if ($('#product option:selected').text() !== '') {
           

            $.ajax({
                type: "GET",
                url: "/ProductSearch/ListBasedOnSearchAboutProduct",
                async: false,
                data: feed,
                success: function (json) {// json
                    var data = json;
                    var tbodyHTML = '';

                    if (data != null) {
                        $(data).each(function (idx, elm) {

                            tbodyHTML += "<tr>";
                            tbodyHTML += "<td>" + elm.ProductName + "</td>";
                            tbodyHTML += "<td>" + "<a class='DeleteCss' onclick=GetDataId(" + elm.ProductId + ")><li class='fa fa-pencil-square-o'></li></a>" + "</td>";
                            tbodyHTML += "</tr>";

                        });
                    }

                    $(".tbodydata").html(tbodyHTML);
                    $("#tablelist").show();


                }
            });
        }

    }


    function BindProduct() {
        debugger
        $.ajax({
            type: "GET",
            url: "/ChemicalPricing/BindProduct",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            success: function (response) {
             debugger
                innerHTML = "";
                if (response.length != 0) {
                    $(response).each(function (idx, elm) {

                        innerHTML += "<option>" + elm.ProductName + "</option>";

                    });
                    $('#product').html(innerHTML);
                    $('#product').selectpicker('refresh');

                }
                else {

                }
            },
            failure: function (response) {
                console.log(response)
            },
            error: function (response) {
                console.log(response)
            }
        });
    }


    function GetDataId(id) {

        var ID = id;
        var url = "/Admin/EditAboutProduct?ID=" + ID + "";
        window.open(url, '_blank');

    }


</script>

<div class="col-md-12">

    <div class="row">
        <div class="col-md-12"><h3 style="text-align:center; color:white;margin:10px 0px;"> About Product list</h3></div>
        <div class="col-md-3"><a href="@Url.Action("AddAboutProduct", "Admin")" class="btn btn-success btn-block" style="margin-bottom:10px;"><i class="fa fa-plus"></i> Add About Product </a></div>
        <div class="col-md-3 " style="padding:0px"><select name="product" id="product" class="form-control" data-live-search="true" data-live-search-placeholder="Enter Your Product Name Ex: Methanol, Acetic Acid" data-max-options="1" data-none-selected-text="Select Product"></select>@*<input type="text" class="form-control" id="searchtext" placeholder="search" />*@</div>
        <div class="col-md-3">
            <input type="button" value="Search" class="btn btn-success" onclick="SearchText()" />
            <input type="button" value="Clear" style=" text-align:left" class="btn btn-success" onclick="AboutProductList()" />
        </div>
    </div>
</div>

<div class="data-detail-wrapper">
    <div class="col-lg-12">
        <table id="tablelist" class="table" style=" margin-top:10px;width:100%">

            <tr>
               
                <th> Product Name </th>
                <th> Edit </th>
               
            </tr>


            <tbody class="tbodydata"></tbody>

        </table>
    </div>
    <br /><br />

</div>