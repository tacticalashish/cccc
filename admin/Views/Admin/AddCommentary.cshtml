@using ChemAnalyst.DAL
@model ChemAnalyst.Models.SA_Commentary
@{
    ViewBag.Title = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*<script src="..\ckeditor/ckeditor.js" type="text/javascript"></script>*@
<script src="~\ckeditor/ckeditor.js" type="text/javascript"></script>

<script type="text/javascript">

        $(document).ready(function () {
            @if (Model != null && Model.id > 0)
            {

                @:$('#RegionFID').val('@TempData["RegionFID"]').trigger('change');

                @:setTimeout(function () {
                @:$('#CountryFID').val('@Model.CountryFID');
                @:$('#CountryFID').trigger('change'); }, 300);

                @:setTimeout(function () {
                @:$('#Product').val('@Model.Product'); }, 600);
            }
        });

        $(document).on('change', '#RegionFID', function () {
            var regionID = $(this).val()

            if (regionID == '') {
                $('#CountryFID').html("<option value=''>Select Country *</option>");
                return true;
            }

            var innerHTML = "<option>loading...</option>"
            $('#CountryFID').html(innerHTML);

            $.ajax({
                url: "/ProductAndCategory/GetCountryBasedOnRegion",
                data: { regionID: regionID }
            }).complete(function (jqXHR, textStatus) {
                if (textStatus == "success" && jqXHR.responseText != null) {
                    var json = JSON.parse(jqXHR.responseText);
                    innerHTML = "<option value=''>Select Country *</option>"

                    $(json).each(function (index, value) {
                        innerHTML += "<option value=" + value.id + ">" + value.CountryName + "</option>"
                    });
                    $('#CountryFID').html(innerHTML);
                }
            });
        });


        $(document).on('change', '#CountryFID', function () {
            var countryFID = $(this).val()

            if (countryFID == '') {
                $('#Product').html("<option value=''>Select Product *</option>");
                return true;
            }

            var innerHTML = "<option>loading...</option>"
            $('#Product').html(innerHTML);

            $.ajax({
                url: "/ProductAndCategory/GetProductBasedOnCountry",
                data: { countryFID: countryFID }
            }).complete(function (jqXHR, textStatus) {
                if (textStatus == "success" && jqXHR.responseText != null) {
                    var json = JSON.parse(jqXHR.responseText);
                    innerHTML = "<option value=''>Select Product *</option>"

                    $(json).each(function (index, value) {
                        innerHTML += "<option value=" + value.id + ">" + value.ProductName + "</option>"
                    });

                    $('#Product').html(innerHTML);
                }
            });
        });
</script>
<div class="update-profile-wrapper">
    <h3 style="padding-bottom:24px;">
        <a href="@Url.Action("ShowCommentaryList", "Admin")"><i class="fa fa-list"></i>Commentary List</a>
        <span style="color:red;font-size: 14px;margin-left: 360px;">@TempData["ErrorMessage"]</span>
    </h3>
    <div class="white-wrapper">

        <div class="col-md-6 col-lg-7 col-md-offset-2">
            <div class="eq-form">
                <div class="change">
                    @{
                        if (Model != null && Model.ImgPath != null)
                        {
                            <img src="~/ProductImages/@Model.ImgPath" alt="" style="width:95px; height:95px" />
                        }
                        else
                        {
                            <img src="~/images/change-img.jpg" alt="" style="width:95px; height:95px" />
                        }
                    }
                    <p>Add New Commentary</p>
                </div>

                <div class="eq-form-box">
                    @using (Html.BeginForm("SaveCommentary", "Admin", null, FormMethod.Post, new { enctype = "multipart/form-data", autocomplete = "off" }))
                    {
                        @Html.AntiForgeryToken()
                        <div style="visibility:hidden">
                            @Html.TextBoxFor(model => model.id, new { @class = "form-control", @placeholder = "Title * ", required = "required" })
                        </div>
                        <div class="col-md-12 col-lg-12 form-group">
                            @Html.DropDownListFor(item => item.Language, (new List<SelectListItem>
                                 {
                                new SelectListItem{ Text="Select Language *", Value = ""},
                                  new SelectListItem{ Text="English", Value = "English"},
                                  new SelectListItem{ Text="Japan", Value ="Japan" },
                                  new SelectListItem{ Text="Korea", Value = "Korea" },
                                  new SelectListItem{ Text="Germany", Value = "Germany"} }), new { @class = "form-control", required = "required" });
                        </div>
                        <div class="col-sm-12 col-lg-12 form-group">
                            @Html.DropDownList("RegionFID", new DALHelper().IEnumerableRegion(new SelectListItem { Text = "Select Region  *", Value = "" }), new { @class = "form-control", required = "required" })
                        </div>
                        <div class="col-sm-12 col-lg-12 form-group">
                            <select id="@Html.IdFor(item=> item.CountryFID)" name="@Html.NameFor(item=> item.CountryFID)" class="form-control" required="required">
                                <option value="">Select Country *</option>
                            </select>
                        </div>
                        <div class="col-md-12 col-lg-12 form-group">
                            @*@Html.DropDownListFor(item => item.ProductFID, new SelectList(Model.listOfSA_Product, "id", "ProductName"), "Select Product *", new { @class = "form-control", @required = "required" })*@
                            <select id="@Html.IdFor(item=> item.Product)" name="@Html.NameFor(item=> item.Product)" class="form-control" required="required">
                                <option value="">Select Product *</option>
                            </select>
                        </div>
                        @*<div class="col-sm-4 col-lg-12 form-group">
                                @Html.DropDownListFor(m => m.Product, ChemAnalyst.DAL.ProductDataStore.GetProduct(), "Select Product", new { @class = "form-control", required = "required" })
                            </div>*@
                        <div class="col-md-4 col-lg-12 form-group">
                            @Html.TextBoxFor(model => model.Title, new { @class = "form-control", @placeholder = "Title * ", required = "required" })
                        </div>
                        <div class="col-md-4 col-lg-12 form-group">
                            @Html.TextAreaFor(model => model.Description, new { @class = "form-control", @rows = 200, @placeholder = "Description * ", id = "Desc" })
                        </div>
                        <script>
                            CKEDITOR.replace("Desc");
                        </script>
                        <div class="col-md-4 col-lg-12 form-group">
                            @Html.TextBoxFor(model => model.Producers, new { @class = "form-control", @placeholder = "Producer * " })
                        </div>
                        @*<div class="col-md-4 col-lg-12 form-group">
                                @Html.TextBoxFor(model => model.Meta, new { @class = "form-control", @placeholder = "Meta Title * ", required = "required" })
                            </div>
                            <div class="col-md-4 col-lg-12 form-group">
                                @Html.TextAreaFor(model => model.MetaDescription, new { @class = "form-control", @rows = 4, @placeholder = "Meta Description * " })
                            </div>*@
                        <div class="col-md-4 col-lg-12 form-group">
                            @Html.TextBoxFor(model => model.CreatedTime, new { @class = "form-control", @rows = 4, @placeholder = "Commentary date " })
                        </div>
                        <div class="col-sm-6 col-lg-12">
                            <div class="form-group">
                                <input type="hidden" name="ImgPath" value="@Model.ImgPath" />
                                <input type="file" name="file" class="form-control" />
                            </div>
                        </div>
                        <div class="btn-wrapper">
                            @*<a class="gray-btn" href="@Url.Action("Job","Job")">Cancel</a>*@
                            <input type="submit" class="btn btn-primary" value="Save">
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" type="text/css" href="~/css/jquery.datetimepicker.css"/ >
<script src="~/js/jquery.datetimepicker.full.min.js"></script>
<script type="text/javascript">

    $(function () {
        // $("#CreatedTime").val('');
        jQuery('#CreatedTime').datetimepicker();
    });

    $(function () {
        $('#Desc').ckeditor({
            toolbar: 'Full',
            enterMode: CKEDITOR.ENTER_BR,
            shiftEnterMode: CKEDITOR.ENTER_P
        });
    });
</script>
<script>

    $(document).on('click', '.browse', function () {
        var file = $(this).parent().parent().parent().find('.file');
        file.trigger('click');
    });
    $(document).on('change', '.file', function () {
        $(this).parent().find('.form-control').val($(this).val().replace(/C:\\fakepath\\/i, ''));
    });


</script>

