@using ChemAnalyst.DAL
@model ChemAnalyst.Models.SA_Commentary
@{
    ViewBag.Title = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*<script src="..\ckeditor/ckeditor.js" type="text/javascript"></script>*@
<script src="~\ckeditor/ckeditor.js" type="text/javascript"></script>
<script type="text/javascript">

        $(document).ready(function () {
            @if (Model != null && Model.id > 0)
            {
                if (Model.CountryFID.HasValue)
                {
                    @:$('#CommentaryType').val('country').trigger('change');
                }
                else
                {
                    @:$('#CommentaryType').val('region').trigger('change');
                }

                 @:setTimeout(function () {
                @:$('#RegionFID').val('@Model.RegionFID');
                @:$('#RegionFID').trigger('change'); }, 300);

                if (Model.CountryFID.HasValue) {
                @:setTimeout(function () {
                @:$('#CountryFID').val('@Model.CountryFID');
                @:$('#CountryFID').trigger('change'); }, 600);
                }

                @:setTimeout(function () {
                @:$('#Product').val('@Model.Product');
                @:$('#Product').trigger('change');}, 900);

                @:setTimeout(function () {
                @:$('#MetaDescription').val('@Model.MetaDescription');}, 1100);
            }
        });

        $(document).on('change', '#RegionFID', function () {
            var regionID = $(this).val()
            var CommentaryType = $('#CommentaryType').val();

            console.log(CommentaryType + '  ' + regionID);

            if (CommentaryType.toLowerCase() == 'country') {
                BindCountry(regionID);
            }
            else {
                BindProduct(regionID);
            }
        });

        function BindCountry(regionID) {
            if (regionID == '') {
                $('#CountryFID').html("<option value=''>Select Country *</option>");
                return true;
            }

            var innerHTML = "<option>loading...</option>"
            $('#CountryFID').html(innerHTML);

            $.ajax({
                url: "/ProductAndCategory/GetCountryBasedOnRegion",
                data: { regionID: regionID }
            }).complete(function (jqXHR, textStatus) {
                if (textStatus == "success" && jqXHR.responseText != null) {
                    var json = JSON.parse(jqXHR.responseText);
                    innerHTML = "<option value=''>Select Country *</option>"

                    $(json).each(function (index, value) {
                        innerHTML += "<option value=" + value.id + ">" + value.CountryName + "</option>"
                    });
                    $('#CountryFID').html(innerHTML);
                }
            });
    }

    function BindProduct(regionID) {

        if (regionID == '') {
            $('#Product').html("<option value=''>Select Product *</option>");
            return true;
        }

        var innerHTML = "<option>loading...</option>"
        $('#Product').html(innerHTML);

        $.ajax({
            url: "/ProductAndCategory/GetProductBasedOnRegion",
            data: { regionFID: regionID }
        }).complete(function (jqXHR, textStatus) {
            if (textStatus == "success" && jqXHR.responseText != null) {
                var json = JSON.parse(jqXHR.responseText);
                innerHTML = "<option value=''>Select Product *</option>"
                console.log(json);
                $(json).each(function (index, value) {
                    innerHTML += "<option value=" + value.id + ">" + value.ProductName + "</option>"
                });

                $('#Product').html(innerHTML);
            }
        });
    }



        $(document).on('change', '#CountryFID', function () {
            var countryFID = $(this).val()

            if (countryFID == '') {
                $('#Product').html("<option value=''>Select Product *</option>");
                return true;
            }

            var innerHTML = "<option>loading...</option>"
            $('#Product').html(innerHTML);

            $.ajax({
                url: "/ProductAndCategory/GetProductBasedOnCountry",
                data: { countryFID: countryFID }
            }).complete(function (jqXHR, textStatus) {
                if (textStatus == "success" && jqXHR.responseText != null) {
                    var json = JSON.parse(jqXHR.responseText);
                    innerHTML = "<option value=''>Select Product *</option>"

                    $(json).each(function (index, value) {
                        innerHTML += "<option value=" + value.id + ">" + value.ProductName + "</option>"
                    });

                    $('#Product').html(innerHTML);
                }
            });
    });


    $(document).on('change', '#Product', function () {
        var productID = $(this).val()

        if (productID == '') {
            $('#MetaDescription').html("<option value=''>Select Range *</option>");
            return true;
        }
        BindFileType(productID, true);
    });

    function BindFileType(productID, isCountryWise) {

        $.ajax({
            url: "/MarketAnalysis/GetRangeBasedOnProduct",
            data: {
                productID: productID,
                isCountryWise: isCountryWise
            }
        }).complete(function (jqXHR, textStatus) {
            if (textStatus == "success" && jqXHR.responseText != null) {
                var json = JSON.parse(jqXHR.responseText);
                innerHTML = "<option value=''>Range *</option>"

                $(json).each(function (index, value) {
                    innerHTML += "<option value='" + value.Name + "'>" + value.Name + "</option>"
                });

                $('#MetaDescription').html(innerHTML);
            }
        });

        //var innerHTML = "<option>loading...</option>"
        //$('#MetaDescription').html(innerHTML);
    }

    $(document).on('change', '#CommentaryType', function () {
        var fileBase = $(this).val();
        $('#RegionFID').val('');
        $('#CountryFID').html("<option value=''>Select Country *</option>");
        $('#Product').html("<option value=''>Select Product *</option>");
        $('#MetaDescription').html("<option value=''>Select Range *</option>");

        if (fileBase.toLowerCase() == 'country') {
            $('#CountryFID').parent().show();
        }
        else if (fileBase.toLowerCase() == 'region') {
            $('#CountryFID').parent().hide();
        }
    });


</script>

<div class="update-profile-wrapper">

