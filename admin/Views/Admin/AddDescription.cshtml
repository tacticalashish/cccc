@using ChemAnalyst.DAL
@model ChemAnalyst.Models.Productdescription

@{
    ViewBag.Title = "AddDescription";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    input[type=file] {
        color: #220808!important;
        margin-bottom: 5px;
    }
</style>

<script src="~\ckeditor/ckeditor.js" type="text/javascript"></script>


<script type="text/javascript">

    $(document).ready(function () {

     
            @if (Model != null && Model.Id > 0)
             {

                @:$('#Region').val('@TempData["Region"]').trigger('change');
               
                @:setTimeout(function () {
                @:$('#Country').val('@Model.Country');
                @:$('#Country').trigger('change'); }, 300);

                @:setTimeout(function () {
                @:$('#Product').val('@Model.Product'); }, 600);
             }
      

    });

        $(document).on('change', '#Region', function() {
            var regionID = $(this).val()

            if (regionID == '') {
                $('#Country').html("<option value=''>Select Country *</option>");
                return true;
            }

            var innerHTML = "<option>loading...</option>"
            $('#Country').html(innerHTML);

            $.ajax({
                url: "/ProductAndCategory/GetCountryBasedOnRegion",
                data: { regionID: regionID }
            }).complete(function (jqXHR, textStatus) {
                if (textStatus == "success" && jqXHR.responseText != null) {
                    var json = JSON.parse(jqXHR.responseText);
                    innerHTML = "<option value=''>Select Country *</option>"

                    $(json).each(function (index, value) {
                        innerHTML += "<option value=" + value.id + ">" + value.CountryName + "</option>"
                    });
                    $('#Country').html(innerHTML);
                }
            });
        });


        $(document).on('change', '#Country', function () {
            var countryFID = $(this).val()

            if (countryFID == '') {
                $('#Product').html("<option value=''>Select Product *</option>");
                return true;
            }

            var innerHTML = "<option>loading...</option>"
            $('#Product').html(innerHTML);

            $.ajax({
                url: "/ProductAndCategory/GetProductBasedOnCountry",
                data: { countryFID: countryFID }
            }).complete(function (jqXHR, textStatus) {
                if (textStatus == "success" && jqXHR.responseText != null) {
                    var json = JSON.parse(jqXHR.responseText);
                    innerHTML = "<option value=''>Select Product *</option>"

                    $(json).each(function (index, value) {
                        innerHTML += "<option value=" + value.id + ">" + value.ProductName + "</option>"
                    });

                    $('#Product').html(innerHTML);
                }
            });
        });



</script>




<div class="">
    <div class="">
        @using (Html.BeginForm("SaveProductDescription", "Admin", null, FormMethod.Post, new { enctype = "multipart/form-data", autocomplete = "off" }))
        { 
            @Html.AntiForgeryToken()
