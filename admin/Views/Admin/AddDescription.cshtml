                </div>
                <script>
                    CKEDITOR.replace("Fds");
                </script>
                <div class="col-md-12 form-group">
                    @Html.LabelFor(model => model.Grades)
                    @Html.TextAreaFor(model => model.Grades, new { @class = "form-control", @rows = 200, @placeholder = "Grades  ", id = "Grad" })
                </div>
                <script>
                    CKEDITOR.replace("Grad");
                </script>

                <div class="col-md-12 form-group">
                    @Html.LabelFor(model => model.Enduse)
                    @Html.TextAreaFor(model => model.Enduse, new { @class = "form-control", @rows = 200, @placeholder = "Enduse  ", id = "End" })
                </div>
                <script>
                    CKEDITOR.replace("End");
                </script>
                <div class="col-md-12 form-group">
                    @Html.LabelFor(model => model.Referallinks)
                    @Html.TextAreaFor(model => model.Referallinks, new { @class = "form-control", @rows = 200, @placeholder = "Referallinks  ", id = "Rlink" })
                </div>
                <script>
                    CKEDITOR.replace("Rlink");
                </script>

                <div class="col-md-3">
                    @Html.LabelFor(model => model.ProductionProcess)
                    <input type="hidden" name="productionprocess" value="@Model.ProductionProcess" />
                    <input type="file" name="file" class="form-control" value="@Model.ProductionProcess" />
                </div>
                <div class="col-md-3"><div style="visibility:hidden">
    @Html.TextBoxFor(model => model.Id, new { @class = "", @placeholder = "Title * ", required = "required" })
</div></div>

                <div style="visibility:hidden" class="col-md-12">

                    <div class="">
                        @Html.LabelFor(model => model.CreatedBy, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-2">
                            @Html.EditorFor(model => model.CreatedBy, new { htmlAttributes = new { @class = "form-control"  } })
                            @Html.ValidationMessageFor(model => model.CreatedBy, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="">
                        @Html.LabelFor(model => model.CreatedDate, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-2">
                            @Html.TextBox("CreatedDate", String.Format("{0:s}", Model.CreatedDate))
                            @*@Html.EditorFor(model => model.CreatedDate, new { @class = "form-control"})*@
                            @Html.ValidationMessageFor(model => model.CreatedDate, "", new { @class = "text-danger" })
                            
                        </div>
                    </div>                
                 </div>

                    <div class=" col-md-3">
                        <input type="submit" value="Save" class="btn btn-success" />
                    </div>
  
                <div class="col-md-12 " style="margin-top:10px;">
                   
                </div>

              
            </div>
         }
         </div>
       </div>





<script>

 
          function GetProductDetails() {

            if ($("#Id").val() != null && $("#Id").val() > 0) {

            }
            else {
                var feed = {};
                feed.product = $("#Product").val();
                //feed.CountryName = $('#Country option:selected').text();

                $.ajax({

                    type: "POST",
                    url: "/ProductSearch/GetproductDetails",
                    async: false,
                    data: feed,
                    success: function (json) {

                        var data = json.result;
                        if (data == true) {
                            $(".btn-success").hide();
                        alert("Please Select Another Product");
                        }
                        else {
                            $(".btn-success").show();
                        }
                    },
                    error: function (response) {
                            alert("Failed");
                    }
                });
            }
          }


</script>









