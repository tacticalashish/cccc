@model ChemAnalyst.Models.SA_Region
@{
    ViewBag.Title = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="update-profile-wrapper">
    <h3><a href="@Url.Action("RegionList","Admin")" class="btn btn-info"><i class="fa fa-list"></i> Region List</a></h3>
    <div class="white-wrapper">
        <div class="col-md-6 col-lg-7 col-md-offset-2">
            <div class="eq-form">
                <div class="change">
                    <img src="~/images/change-img.jpg" alt="" />
                    <p>Add New Region</p>
                </div>
                <div class="eq-form-box">
                    @using (Html.BeginForm("SaveRegion", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {


                        @Html.AntiForgeryToken()
                        <div style="visibility:hidden">
                            @Html.TextBoxFor(model => model.id, new { @class = "form-control", @placeholder = "Title * " })
                        </div>
                        <div class="col-md-4 col-lg-6 form-group">
                            @Html.TextBoxFor(model => model.RegionName, new { @class = "form-control", @placeholder = "Name * ", required = "required" })
                            @{
                                if (TempData["Message"] != null)
                                {
                                    <span style="color:red; font-size:12px">@TempData["Message"]</span>
                                }
                            }
                        </div>
                        <div class="btn-wrapper">
                            <a class="gray-btn" href="@Url.Action("RegionList","Admin")">Cancel</a>
                            <input type="submit" class="blue-btn" value="Save">
                        </div>
                                }



                </div>
            </div>

        </div>
    </div>

</div>
