@{
    ViewBag.Title = "Company Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<head>
    <link href="https://cdn.datatables.net/1.10.15/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/responsive/2.1.1/css/responsive.bootstrap.min.css" rel="stylesheet" />

    <script src="https://cdn.datatables.net/1.10.15/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.15/js/dataTables.bootstrap4.min.js "></script>
    
    <script type="text/javascript">

        $(document).ready(function () { 
            $('#companyList').DataTable({
                "ajax": {
                    "url": "/Admin/GetCompanyReport",
                    "type": "GET",
                    "datatype": "json"
                },

                "columnDefs": [

                    {
                        "targets": [0],
                        "visible": false
                    }
                ],
                "columns": [
                    { "data": "RowNumber" },
                    { "data": "CompanyName", "autoWidth": true },
                    { "data": "FirstContactDetail", "autoWidth": true },
                    { "data": "SecondContactDetail", "autoWidth": true },
                    {

                        "render": function (data, type, row, meta) { return '<a href="../Admin/CompanyMaster?id=' + row.ID + '"><i class="fa fa-pencil-square-o"></i></a>'; }
                    },
                ]
            });
        });



        function UpdateStatus(userId) {
            $.ajax({
                url: "UpdateStatus",
                type: "POST",
                data: { userId: userId },
                cache: false,
                async: true,
                success: function (data) {
                    window.location.reload(true);
                }

            })
        }
    </script>
</head>




<div class="update-profile-wrapper">

    <h3><a href="@Url.Action("CompanyMaster", "Admin")" class="btn btn-success"><i class="fa fa-plus"></i> Add Company</a></h3>

    <div class="white-wrapper" style="padding-top:10px;margin-top:10px">

        <div class="data-detail-wrapper table-responsive">

            <table id="companyList" class="table">
                <thead>
                    <tr>
                        <th>S.No</th>
                        <th>Company Name</th>
                        <th>Primary Contact Detail</th>
                        <th>Secondary Contact Detail</th>
                        <th>Edit</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>

    </div>

</div>




