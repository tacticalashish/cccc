
@{
    ViewBag.Title = "EditAboutProduct";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~\ckeditor/ckeditor.js" type="text/javascript"></script>
<script src="//ajax.googleapis.com/ajax/libs/jquery/1.9.1/jquery.min.js"></script>


<script type="text/javascript">

    $(document).ready(function () {
        GetDataId();
    });

    function GetDataId() {
        debugger
        var Id = @ViewBag.Id;
        debugger;
        $.ajax({
            type: "GET",
            url: "/ProductSearch/GetByIdOfAboutProduct",
            data: { Id:Id },
            async: false,

            success: function (json) {// json
                debugger
                var data = json.listofGetDetailsByIdOfAboutProduct;
                var tbodyHTML = '';
               

                if (data != null) {
                    $(data).each(function (idx, elm) {

                        $("#product").val(elm.ProductName);
                        
                        CKEDITOR.instances['AboutProduct'].setData(elm.AboutProduct);

                    });
                }

            }

        });
    }

    function EditAboutProduct() {
        debugger;
        var Id = @ViewBag.Id;
        var ProductName = $('#product').val();
        var AboutProduct = CKEDITOR.instances.AboutProduct.getData();

        var enProductdescription = {
            Id :Id,
            ProductName: ProductName,
            AboutProduct: AboutProduct
        };

        $.ajax({
            type: "POST",
            url: "/ProductSearch/EditAboutProduct",
            data: '{enProductdescription: ' + JSON.stringify(enProductdescription) + '}',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            
            success: function () {
                window.location.href = '/Admin/AboutProduct';

            },
            error: function (response) {

                alert("Failed");
            }
        });
    }


</script>

<div class="col-md-12">
    <div class="row">
        <div class="col-md-12"><h3 style="text-align:center; color:white;margin:10px 0px;"> Edit About Product </h3></div>
        <div class="col-md-6">
            <label>Productname</label>
            <input type="text" id="product" /> 
          
        </div>

        <div class="col-md-8">
            <label>About Product</label>

            <textarea class="ckeditor" cols="80" id="AboutProduct" name="editor1" rows="10"></textarea>
            <script>
                CKEDITOR.replace("AboutProduct");
            </script>

        </div>

    </div>
</div>
<div class="col-md-2">
    <input type="button" value="Update" class="btn btn-success" onclick="EditAboutProduct()" />
</div>


