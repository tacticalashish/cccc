
@{
    ViewBag.Title = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model IEnumerable<ChemAnalyst.Models.SA_Region>
<head>
    <link href="https://cdn.datatables.net/1.10.15/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/responsive/2.1.1/css/responsive.bootstrap.min.css" rel="stylesheet" />

    <script src="https://cdn.datatables.net/1.10.15/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.15/js/dataTables.bootstrap4.min.js "></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#tblRegion').DataTable({
                "ajax": {
                    "url": "../Admin/LoadRegionData",
                    "type": "GET",
                    "datatype": "json"
                },
                "columns": [
                    //{ "data": "id" },
                    { "data": "RegionName", "autoWidth": true },
                    {
                        "render": function (data, type, row, meta) { return '<a href="../Admin/EditRegion/' + row.id + '"><i class="fa fa-pencil-square-o"></i></a>'; }
                    },
                    //{
                    //    data: null, render: function (data, type, row) {
                    //        return '<a href="../Admin/DeleteRegion/' + row.id + '"><i class="fa fa-trash-o fa-lg"></i></a>';
                    //    }
                    //},
                ]
            });
        });
    </script>
</head>




<div class="update-profile-wrapper">

    <h3><a href="@Url.Action("AddRegion", "Admin")" class="btn btn-info"><i class="fa fa-plus"></i> Add New Region</a></h3>
    <div class="white-wrapper" style="padding-top:10px; margin-top:10px;">
        <div class="data-detail-wrapper table-responsive">
            <table id="tblRegion" class="table">
                <thead>
                    <tr>
                        @*<th>
                            <div class="checkbox checkbox-info">
                                <input id="selectall" class="styled" type="checkbox">
                                <label for="check4"></label>
                            </div>
                        </th>*@
                        <th>Name</th>
                        <th>Edit</th>
                        @*<th>Delete</th>*@
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>




