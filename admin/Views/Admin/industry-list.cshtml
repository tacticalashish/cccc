<div class="update-profile-wrapper">
    <div class="row">
        <div class="col-md-12">
            <a class="btn btn-success mt10" href="@Url.Action("AddIndustry", "Industry")"><i class="fa fa-plus"></i> Add New Industry Report</a>
            <a class="btn btn-success mt10" href="@Url.Action("ShowStateList", "Admin")"><i class="fa fa-plus"></i> State Management</a>
            <a class="btn btn-success mt10" href="@Url.Action("ShowCountryList", "Admin")"><i class="fa fa-plus"></i> Country Management</a>
            <a class="btn btn-success mt10" href="@Url.Action("RegionList", "Admin")"><i class="fa fa-plus"></i> Region Management</a>
            <a class="btn btn-success mt10" href="@Url.Action("ListRegionAndCountryRelation", "Admin")"><i class="fa fa-plus"></i> Region and Country Relation</a>
            <a class="btn btn-success mt10" href="@Url.Action("ProductAndFileTypeRelation", "Admin")"><i class="fa fa-plus"></i> Product and Chemical Range Relation</a>
            <a class="btn btn-success mt10" href="@Url.Action("ProductAndMarketRangeRelation", "Admin")"><i class="fa fa-plus"></i> Product and Market Range Relation</a>
        </div>
    </div>
    <div class="row">
        <div class="col-md-7"></div>
        <div class="col-md-5">
            <div class="d-flex align-items-center justify-content-between mt30">
                <label class="me-2">Search:</label>
                <input type="text" class="form-control me-2" id="Searchtext" placeholder="Enter Search" />
                <button type="button" class="btn btn-success me-2" onclick="ShowIndustryList()">Submit</button>
                <button type="button" class="btn btn-warning" onclick="Reset()">Reset</button>
            </div>
        </div>
    </div>

    <div class="white-wrapper" style="padding-top:10px">
        <div class="data-detail-wrapper table-responsive">
            <table id="role" class="table">
                <thead>
                    <tr>
                        <th width="55%">Title</th>
                        <th width="10%">Product</th>
                        <th width="15%">Created</th>
                        <th width="5%">EDIT</th>
                       @if (ChemAnalyst.Common.Helpers.Global.AdminRole == Convert.ToString(Session["UserRole"]))
                       {
                        <th width="5%">DELETE</th>
                       }
                    </tr>
                </thead>
                <tbody class="tbodydata" id="tbodydata"></tbody>
            </table>
        </div>
        <div style="margin:20px 0px 0px 0px;">
            <input type="hidden" id="PageNumber" name="PageNumber" value="1" />
            <div class="box-footer clearfix" id="divPagging" style="border-top:0.5px solid #fff">
            </div>
        </div>
    </div>

</div>



