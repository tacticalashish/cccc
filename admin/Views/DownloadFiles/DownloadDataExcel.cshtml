    function ExportToExcel(type, fn, dl) {
        debugger;
        var RangeName = '';
        var FromDate = '';
        var ToDate = '';
        var Type = '';

        var Type = $("#Type").val();
        if (Type == 'Commentary' || Type == 'Pricing Approval') {
            RangeName = $("#Range2").val();
        }
        if (Type == 'Pricing') {
            RangeName = $("#Range1").val();
        }

        if (Type == 'Daily Performance' || Type == 'Daily Performance Update') {
            FromDate = $("#fromdate").val();
            ToDate = $("#Todate").val();
        }

        var filename = Type + "/" + RangeName + "/" + FromDate + "/" + ToDate + "." ;

        var elt = document.getElementById('tabledata');
        var headline = filename;
        var wb = XLSX.utils.table_to_book(elt, { sheet: "sheet1" });
        return dl ?
            XLSX.write(wb, { bookType: type, bookSST: true, type: 'base64' }) :
            XLSX.writeFile(wb, fn || (filename + (type || 'xlsx')));
        //XLSX.writeFile(wb, fn || ('MySheet.' + (type || 'xlsx')));  
            
    }

   
