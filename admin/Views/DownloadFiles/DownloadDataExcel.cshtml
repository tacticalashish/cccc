            $("#Range2").show();
        }
        if(type == 'Pricing')
        {
           $("#Range1").show();
        }

        if (type == 'Daily Performance') {
            $("#fromdate").show();
            $("#Todate").show();
            
        }
        if (type == 'Daily Performance Update') {
            $("#fromdate").show();
            $("#Todate").show();

        }

