                    // Options for html2pdf
                    var opt = {
                        filename: 'invoice.pdf',
                        image: { type: 'jpeg', quality: 0.98 }, // Image quality
                        html2canvas: { scale: 3 }, // Increase scale for higher resolution (default is 1)
                        jsPDF: { unit: 'in', format: 'letter', orientation: 'portrait' }
