            fileData.append("FileUpload", files[i]);
        }
        $.ajax({
            type: "POST",
            url: "/Invoice/UploadLeadFiles",
            dataType: "json",
            contentType: false, // Not to set any content header
            processData: false, // Not to process data
            data: fileData,
            success: function (result, status, xhr) { // alert(result);
            },
            error: function (xhr, status, error) { // alert(status);
            }
        });
    }  
    function numberToText(number) {
        const ones = [
            "", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine",
            "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen",
            "Seventeen", "Sighteen", "Nineteen"
        ];
        const tens = [
            "", "", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety"
        ];

        if (number === 0) return "Zero";

        function convertHundreds(num) {
            let result = "";
            if (num >= 100) {
                result += ones[Math.floor(num / 100)] + " Hundred ";
                num %= 100;
            }
            if (num >= 20) {
                result += tens[Math.floor(num / 10)] + " ";
                num %= 10;
            }
            if (num > 0) {
                result += ones[num] + " ";
            }
            return result.trim();
        }

        function convertNumber(num) {
            if (num < 1000) return convertHundreds(num);

            const parts = ["", "Thousand", "Million", "Billion"];
            let partIndex = 0;
            let result = "";

            while (num > 0) {
                if (num % 1000 !== 0) {
                    result = convertHundreds(num % 1000) + " " + parts[partIndex] + " " + result;
                }
                num = Math.floor(num / 1000);
                partIndex++;
            }
            return result.trim();
        }

        return convertNumber(number);
    }
