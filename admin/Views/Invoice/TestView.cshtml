<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.js"></script>
<script>
     $(document).ready(function () {
         // Handle the button click to download the PDF
         $('#downloadPdfBtn').click(function () {
             var element = document.getElementById('invoiceContent');

             // Use html2pdf.js to generate and download the PDF
             html2pdf()
                 .from(element)  // Specify the HTML content to convert to PDF
                 .save('invoice.pdf');  // Filename of the generated PDF
         });
     });
</script>