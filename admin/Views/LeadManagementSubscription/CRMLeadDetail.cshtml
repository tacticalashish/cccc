<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.13/css/intlTelInput.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.13/js/intlTelInput.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/2.1.0/sweetalert.min.js"></script>

<script>
    var CrdLeadId = @(ViewBag.LeadId ?? 0);
    var CrdLead = null;

    function CrdSwitchTab(tab) {
        $(".crd-tab").removeClass("crd-tab-active");
        $(".crd-tab[data-tab='" + tab + "']").addClass("crd-tab-active");
        $(".crd-tab-content").removeClass("crd-tab-content-active");
        $("#CrdTab" + tab.charAt(0).toUpperCase() + tab.slice(1)).addClass("crd-tab-content-active");
        if (tab === "emails") CrdLoadEmailDropdown();
        if (tab === "contacts") CrdRenderContacts();
    }

    function CrdRenderContacts() {
        if (!CrdLead || !CrdLead.CompanyName) {
            $("#CrdContactRows").html("<tr><td colspan='5' class='crd-empty-tab'>No contacts yet.</td></tr>");
            return;
        }
        $("#CrdContactRows").html("<tr><td colspan='5' class='crd-empty-tab'>Loading&hellip;</td></tr>");
        $.ajax({
            type: "GET",
            url: "/LeadManagementSubscription/GetCRMContacts",
            data: { companyName: CrdLead.CompanyName },
            dataType: "json"
        }).done(function (response) {
            var list = (response && response.DataList) || [];
            if (!list.length) {
                $("#CrdContactRows").html("<tr><td colspan='5' class='crd-empty-tab'>No contacts yet.</td></tr>");
                return;
            }
            var html = "";
            for (var i = 0; i < list.length; i++) {
                var c = list[i];
                var isPrimary = (c.Usertype || "").toLowerCase() === "primary";
                html += "<tr>";
                html += "  <td>" + CrdOrDash(c.Name) + "</td>";
                html += "  <td>" + CrdOrDash(c.Email) + "</td>";
                html += "  <td>" + CrdOrDash(c.Phone) + "</td>";
                html += "  <td>&mdash;</td>";
                html += "  <td><span class='crd-pill-blue'><span class='crd-pill-dot'></span>" + CrdOrDash(c.Usertype) + "</span></td>";
                html += "</tr>";
            }
            $("#CrdContactRows").html(html);
        }).fail(function () {
            $("#CrdContactRows").html("<tr><td colspan='5' class='crd-empty-tab'>Couldn't load contacts.</td></tr>");
        });
    }

    function CrdEsc(v) { return $("<div>").text(v == null ? "" : v).html(); }
    function CrdOrDash(v) { return (v == null || v === "") ? "&mdash;" : CrdEsc(v); }

    function CrdParseDate(v) {
        if (!v) return null;
        var s = String(v);
        var m = /\/Date\((-?\d+)\)\//.exec(s);
        var d = m ? new Date(parseInt(m[1], 10)) : new Date(s.indexOf("T") === -1 ? s.replace(" ", "T") : s);
        return isNaN(d.getTime()) ? null : d;
    }
    function CrdFmtDate(v) {
        var d = CrdParseDate(v);
        if (!d) return "&mdash;";
        var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        return d.getDate() + " " + months[d.getMonth()] + " " + d.getFullYear();
    }
    function CrdInitials(name) {
        if (!name) return "?";
        var p = $.trim(name).split(/\s+/);
        var i = p[0].charAt(0);
        if (p.length > 1) i += p[p.length - 1].charAt(0);
        return i.toUpperCase();
    }
    function CrdMoney(amount, currency) {
        if (amount == null || amount === "") return "&mdash;";
        var n = parseFloat(String(amount).replace(/[^0-9.\-]/g, ""));
        if (isNaN(n)) return "&mdash;";
        var sym = "$", code = (currency || "").toUpperCase();
        if (code === "INR") sym = "&#8377;"; else if (code === "EUR") sym = "&#8364;"; else if (code === "GBP") sym = "&#163;";
        return sym + Math.round(n).toLocaleString();
    }

    function CrdRender(lead) {
        if (!lead) {
            $("#CrdLoading").text("Lead not found.");
            return;
        }
        CrdLead = lead;
        $("#CrdLoading").hide();
        $("#CrdContent").show();

        var heading = lead.CompanyName || lead.Name || "(unnamed)";
        $("#CrdCrumbName").text(heading);
        $("#CrdAvatar").text(CrdInitials(heading));
        $("#CrdCompanyName").html(CrdOrDash(heading));

        var subParts = [];
        if (lead.Name) subParts.push(CrdEsc(lead.Name));
        if (lead.CorpEmail) subParts.push(CrdEsc(lead.CorpEmail));
        if (lead.CountryName) subParts.push(CrdEsc(lead.CountryName));
        $("#CrdSubText").html(subParts.length ? subParts.join(" &middot; ") : "&mdash;");
        $("#CrdStageText").text(lead.Status || "In discussion");
        if (lead.LeadType) { $("#CrdTypePill").text(lead.LeadType).show(); }
        // Won / Lost buttons - only while the lead is still Open (hidden once won/lost).
        var isOpen = /^\s*open\s*$/i.test(lead.Status || "");
        $("#CrdWonBtn").toggle(isOpen);
        $("#CrdLostBtn").toggle(isOpen);

        // Won (RenewWon) ho chuki lead edit nahi hogi — Edit button hide.
        var isWonLead = /won/i.test(lead.Status || "");
        $("#CrdEditBtn").toggle(!isWonLead);

        $("#CrdValue").html(CrdMoney(lead.Amount, lead.Currency));
        $("#CrdExpectedClose").html(CrdFmtDate(lead.ExpectedCloseDate));
        $("#CrdSource").html(CrdOrDash(lead.OutboundLeadSource));
        $("#CrdOwner").html(CrdOrDash(lead.createdby));

        $("#CrdSumStage").html(CrdOrDash(lead.Status));
        $("#CrdSumType").html(CrdOrDash(lead.LeadType));
        $("#CrdSumSource").html(CrdOrDash(lead.OutboundLeadSource));
        $("#CrdSumInterested").html(CrdOrDash(lead.DiscriptionMessage));
        $("#CrdSumValue").html(CrdMoney(lead.Amount, lead.Currency));
        $("#CrdSumClose").html(CrdFmtDate(lead.ExpectedCloseDate));
        $("#CrdSumFollowup").html(CrdFmtDate(lead.SetFollowUp));

        $("#CrdCoCompany").html(CrdOrDash(lead.CompanyName));
        $("#CrdCoContact").html(CrdOrDash(lead.Name));
        $("#CrdCoEmail").html(CrdOrDash(lead.CorpEmail));
        var phone = [lead.ContactCountryCode, lead.Phone].filter(function (x) { return !!x; }).join(" ");
        $("#CrdCoPhone").html(CrdOrDash($.trim(phone)));
        $("#CrdCoCountry").html(CrdOrDash(lead.CountryName));

        CrdRenderOrder(lead);
    }

    function CrdRenderOrder(lead) {
        if (!lead) return;
        $("#CrdOrderProducts").html(CrdOrDash(lead.DiscriptionMessage));
        $("#CrdOrderAmount").html(CrdMoney(lead.Amount, lead.Currency));
        $("#CrdOrderCurrency").html(CrdOrDash(lead.Currency));
        $("#CrdOrderPaymentTerms").html(lead.PaymentTerms ? CrdEsc(lead.PaymentTerms) : "To be set on win (PO Net 30/60 or advance)");
        var isWon = /won/i.test(lead.Status || "");
        $("#CrdClosingNotWon").toggle(!isWon);
        $("#CrdClosingWon").toggle(isWon);
    }

    // ---- Mark won - start closing modal (same as Sales) ------------------
    var CrdWonPaymentMethod = "PurchaseOrder";

    function CrdOpenWonModal() {
        if (!CrdLead) return;
        CrdWonPaymentMethod = "PurchaseOrder";
        $(".crd-type-btn[data-method]").removeClass("crd-type-btn-active");
        $(".crd-type-btn[data-method='PurchaseOrder']").addClass("crd-type-btn-active");
        $("#CrdWonAmount").val("");
        $("#CrdWonCurrency").val("");
        $("#CrdWonAmountINR").val("");
        $("#CrdWonAmountINRField").hide();
        $("#CrdWonPaymentTerms").val("Net 30");
        $("#CrdWonPaymentTermsField").show();
        $("#CrdWonInvoiceField").hide();
        $("#CrdWonInvoiceNumber").val("");
        $("#CrdWonFileUpload").val("");
        $("#CrdWonFileName").text("No file chosen");
        var heading = (CrdLead.CompanyName || CrdLead.Name) || "Lead";
        $("#CrdWonAvatar").text(CrdInitials(heading));
        $("#CrdWonSubtitle").text(heading);
        $("#CrdWonBackdrop").addClass("crd-modal-open");
    }

    function CrdCloseWonModal() {
        $("#CrdWonBackdrop").removeClass("crd-modal-open");
    }

    function CrdWonCurrencyChanged() {
        var isInr = $("#CrdWonCurrency").val() === "INR";
        $("#CrdWonAmountINRField").toggle(isInr);
        if (!isInr) $("#CrdWonAmountINR").val("");
    }

    function CrdSelectWonPaymentMethod(method) {
        CrdWonPaymentMethod = method;
        $(".crd-type-btn[data-method]").removeClass("crd-type-btn-active");
        $(".crd-type-btn[data-method='" + method + "']").addClass("crd-type-btn-active");
        $("#CrdWonPaymentTermsField").toggle(method === "PurchaseOrder");
        $("#CrdWonInvoiceField").toggle(method === "AdvancePayment");
    }

    function CrdWonFileSelected() {
        var input = $("#CrdWonFileUpload").get(0);
        $("#CrdWonFileName").text(input && input.files && input.files.length ? input.files[0].name : "No file chosen");
    }

    function CrdUploadWonFile() {
        var files = $("#CrdWonFileUpload").get(0).files;
        if (!files || !files.length) return;
        var fileData = new FormData();
        fileData.append("LeadId", CrdLeadId);
        for (var i = 0; i < files.length; i++) fileData.append("FileUpload", files[i]);
        $.ajax({
            type: "POST",
            url: "/SalesNew/UploadLeadFiles",
            dataType: "json",
            contentType: false,
            processData: false,
            data: fileData
        });
    }

    function CrdSaveWonModal() {
        var amount = $.trim($("#CrdWonAmount").val());
        if (amount === "") {
            if (window.swal) swal("Warning", "Please enter the final contract value (USD).", "error");
            else alert("Please enter the final contract value (USD).");
            return;
        }
        var currency = $("#CrdWonCurrency").val();
        if (!currency) {
            if (window.swal) swal("Warning", "Please select a currency.", "error");
            else alert("Please select a currency.");
            return;
        }
        var amountINR = $.trim($("#CrdWonAmountINR").val());
        var invoiceNumber = $.trim($("#CrdWonInvoiceNumber").val());
        if (CrdWonPaymentMethod === "AdvancePayment" && !invoiceNumber) {
            if (window.swal) swal("Warning", "Please enter the invoice number.", "error");
            else alert("Please enter the invoice number.");
            return;
        }
        var filesval = $("#CrdWonFileUpload").val();
        var files = "";
        if (filesval !== "") {
            var fileInput = $("#CrdWonFileUpload").get(0).files[0];
            var originalName = fileInput.name;
            var extension = originalName.substring(originalName.lastIndexOf('.'));
            var nameWithoutExt = originalName.substring(0, originalName.lastIndexOf('.'));
            var dateStamp = new Date().toISOString().slice(0, 10).replace(/-/g, "");
            files = nameWithoutExt + "_" + dateStamp + "_" + CrdLeadId + extension;
        }
        if (files === "") {
            if (window.swal) swal("Warning", "Please Upload Sales Order Form.", "error");
            else alert("Please Upload Sales Order Form.");
            return;
        }
        $("#CrdWonSaveBtn").prop("disabled", true).text("Saving...");
        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/MarkCRMWon",
            data: {
                id: CrdLeadId,
                amount: amount,
                currency: currency,
                amountINR: amountINR,
                paymentOption: CrdWonPaymentMethod,
                paymentTerms: CrdWonPaymentMethod === "PurchaseOrder" ? $("#CrdWonPaymentTerms").val() : "",
                invoiceNumber: invoiceNumber,
                OrderFrom: files
            }
        }).done(function (response) {
            $("#CrdWonSaveBtn").prop("disabled", false).text("Mark as won");
            if (response && response.Success) {
                CrdUploadWonFile();
                CrdCloseWonModal();
                var goPipeline = function () { window.location.href = "/LeadManagementSubscription/Pipeline"; };
                if (window.swal) swal("Marked won", "Moved to Renewal Won.", "success").then(goPipeline);
                else goPipeline();
            } else {
                if (window.swal) swal("Couldn't update", (response && response.Message) || "Please try again.", "error");
                else alert("Couldn't update. Please try again.");
            }
        }).fail(function () {
            $("#CrdWonSaveBtn").prop("disabled", false).text("Mark as won");
            if (window.swal) swal("Couldn't update", "Please try again.", "error");
            else alert("Couldn't update. Please try again.");
        });
    }

    // ---- Mark lost modal (same as Sales) ---------------------------------
    function CrdPickLostReason(text) {
        $("#CrdLostReasonText").val(text);
    }

    function CrdOpenLostModal() {
        if (!CrdLead) return;
        var heading = (CrdLead.CompanyName || CrdLead.Name) || "Lead";
        $("#CrdLostAvatar").text(CrdInitials(heading));
        $("#CrdLostSubtitle").text(heading);
        $("#CrdLostReasonText").val("");
        $("#CrdLostBackdrop").addClass("crd-modal-open");
    }

    function CrdCloseLostModal() {
        $("#CrdLostBackdrop").removeClass("crd-modal-open");
    }

    function CrdSaveLost() {
        var reason = $.trim($("#CrdLostReasonText").val());
        if (!reason) {
            if (window.swal) swal("Reason needed", "Please enter a reason for the loss.", "warning");
            else alert("Please enter a reason for the loss.");
            return;
        }
        $("#CrdLostSaveBtn").prop("disabled", true).text("Saving...");
        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/UpdateCRMOpenLead",
            data: {
                Id: CrdLeadId,
                Status: "Lost",
                LeadType: CrdLead.LeadType || "",
                OutboundLeadSource: CrdLead.OutboundLeadSource || "",
                DiscriptionMessage: CrdLead.DiscriptionMessage || "",
                Amount: CrdLead.Amount || "",
                Currency: CrdLead.Currency || "",
                ExpectedCloseDate: CrdDateInput(CrdLead.ExpectedCloseDate),
                SetFollowUp: CrdDateInput(CrdLead.SetFollowUp),
                LostReason: reason
            }
        }).done(function (response) {
            $("#CrdLostSaveBtn").prop("disabled", false).text("Mark as lost");
            if (response && response.Success) {
                CrdCloseLostModal();
                var goPipeline = function () { window.location.href = "/LeadManagementSubscription/Pipeline"; };
                if (window.swal) swal("Marked lost", "Moved to Renewal Lost.", "success").then(goPipeline);
                else goPipeline();
            } else {
                if (window.swal) swal("Couldn't save", "Please try again.", "error");
                else alert("Couldn't save. Please try again.");
            }
        }).fail(function () {
            $("#CrdLostSaveBtn").prop("disabled", false).text("Mark as lost");
            if (window.swal) swal("Couldn't save", "Please try again.", "error");
            else alert("Couldn't save. Please try again.");
        });
    }

    function CrdGoToProformaInvoice() {
        var isWon = CrdLead && /won/i.test(CrdLead.Status || "");
        if (!isWon) {
            if (window.swal) swal("Not available yet", "Win this renewal first before creating a proforma invoice.", "error");
            else alert("Win this renewal first before creating a proforma invoice.");
            return;
        }
        window.location.href = "@Url.Action("ChemAnalystProformaInvoiceList", "Invoice")";
    }

    // yyyy-MM-dd for <input type=date>
    function CrdDateInput(v) {
        var d = CrdParseDate(v);
        if (!d) return "";
        var m = ("0" + (d.getMonth() + 1)).slice(-2);
        var day = ("0" + d.getDate()).slice(-2);
        return d.getFullYear() + "-" + m + "-" + day;
    }

    function CrdStartEdit() {
        if (!CrdLead) return;
        $("#CrdEditStatus").val(CrdLead.Status || "Open");
        $("#CrdEditLeadType").val(CrdLead.LeadType || "");
        $("#CrdEditSource").val(CrdLead.OutboundLeadSource || "");
        $("#CrdEditMessage").val(CrdLead.DiscriptionMessage || "");
        $("#CrdEditAmount").val(CrdLead.Amount || "");
        $("#CrdEditCurrency").val(CrdLead.Currency || "");
        $("#CrdEditClose").val(CrdDateInput(CrdLead.ExpectedCloseDate));
        $("#CrdLeadSummaryCard").addClass("crd-editing");
        $("#CrdEditBtn").hide();
        $("#CrdCancelBtn, #CrdSaveBtn").show();
    }

    function CrdCancelEdit() {
        $("#CrdLeadSummaryCard").removeClass("crd-editing");
        $("#CrdCancelBtn, #CrdSaveBtn").hide();
        $("#CrdEditBtn").show();
    }

    function CrdSaveEdit() {
        $("#CrdSaveBtn").prop("disabled", true).text("Saving...");
        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/UpdateCRMOpenLead",
            data: {
                Id: CrdLeadId,
                Status: $("#CrdEditStatus").val(),
                LeadType: $("#CrdEditLeadType").val(),
                OutboundLeadSource: $.trim($("#CrdEditSource").val()),
                DiscriptionMessage: $.trim($("#CrdEditMessage").val()),
                Amount: $.trim($("#CrdEditAmount").val()),
                Currency: $("#CrdEditCurrency").val(),
                ExpectedCloseDate: $("#CrdEditClose").val(),
                SetFollowUp: CrdDateInput(CrdLead.SetFollowUp)
            }
        }).done(function (response) {
            $("#CrdSaveBtn").prop("disabled", false).text("Save");
            if (response && response.Success) {
                CrdCancelEdit();
                // reload fresh data
                $.ajax({
                    type: "GET",
                    url: "/LeadManagementSubscription/GetCRMOpenLeadData",
                    data: { id: CrdLeadId },
                    dataType: "json"
                }).done(function (r) { CrdRender(r && r.DataItem); });
            } else if (window.swal) {
                swal("Couldn't save", "Please try again.", "error");
            }
        }).fail(function () {
            $("#CrdSaveBtn").prop("disabled", false).text("Save");
            if (window.swal) swal("Couldn't save", "Please try again.", "error");
        });
    }

    function CrdActivityIcon(status) {
        var s = (status || "").toLowerCase();
        if (s.indexOf("won") !== -1) return "&#9989;";      // check
        if (s.indexOf("lost") !== -1) return "&#10060;";    // cross
        return "&#128172;";                                  // speech bubble
    }

    function CrdRenderActivity(list) {
        var $box = $("#CrdActivityList");
        var html = "";
        if (list && list.length) {
            for (var i = 0; i < list.length; i++) {
                var a = list[i];
                var sub = CrdOrDash(a.Discussion);
                if (a.CreatedBy) sub += " &middot; by " + CrdEsc(a.CreatedBy);
                if (a.SetFollowUp) sub += " &middot; next " + CrdFmtDate(a.SetFollowUp);
                html += "<div class='crd-act-row'>";
                html += "  <div class='crd-act-icon'>" + CrdActivityIcon(a.DiscussionStatus) + "</div>";
                html += "  <div style='flex:1;'><div class='crd-act-title'>" + (a.DiscussionStatus ? CrdEsc(a.DiscussionStatus) : "Follow-up logged") + "</div>";
                html += "  <div class='crd-act-sub'>" + sub + "</div></div>";
                html += "  <div class='crd-act-date'>" + CrdFmtDate(a.CreatedDate) + "</div>";
                html += "</div>";
            }
        }
        // "Lead created" anchor row at the bottom, like Sales
        if (CrdLead) {
            html += "<div class='crd-act-row'>";
            html += "  <div class='crd-act-icon'>&#128196;</div>";
            html += "  <div style='flex:1;'><div class='crd-act-title'>Lead created</div>";
            html += "  <div class='crd-act-sub'>Source: " + CrdOrDash(CrdLead.OutboundLeadSource) + "</div></div>";
            html += "  <div class='crd-act-date'>" + CrdFmtDate(CrdLead.CreatedDate) + "</div>";
            html += "</div>";
        }
        if (!html) html = '<div class="crd-empty-tab">No activity yet.</div>';
        $box.html(html);
    }

    function CrdLoadActivity() {
        $.ajax({
            type: "GET",
            url: "/LeadManagementSubscription/GetCRMFollowUps",
            data: { id: CrdLeadId },
            dataType: "json"
        }).done(function (response) {
            CrdRenderActivity(response && response.DataItem);
        }).fail(function () {
            $("#CrdActivityList").html('<div class="crd-empty-tab">Couldn\'t load activity.</div>');
        });
    }

    // ---- Emails tab (same as Sales) --------------------------------------
    var CrdEmailCurrentPage = 1;

    function CrdCompactPageList(activePage, numberOfPages) {
        if (numberOfPages <= 7) {
            var arr = [];
            for (var i = 1; i <= numberOfPages; i++) arr.push(i);
            return arr;
        }
        if (activePage <= 4) return [1, 2, 3, 4, 5, "...", numberOfPages];
        if (activePage >= numberOfPages - 3) return [1, "...", numberOfPages - 4, numberOfPages - 3, numberOfPages - 2, numberOfPages - 1, numberOfPages];
        return [1, "...", activePage - 1, activePage, activePage + 1, "...", numberOfPages];
    }

    function CrdRenderPager(containerId, activePage, numberOfPages, gotoFnName) {
        if (!numberOfPages || numberOfPages <= 1) { $("#" + containerId).html(""); return; }
        var pages = CrdCompactPageList(activePage, numberOfPages);
        var html = "";
        html += "<button type='button' class='crd-pg-btn' " + (activePage <= 1 ? "disabled" : "onclick='" + gotoFnName + "(" + (activePage - 1) + ")'") + ">&lsaquo;</button>";
        for (var i = 0; i < pages.length; i++) {
            var p = pages[i];
            if (p === "...") html += "<span class='crd-pg-dots'>&hellip;</span>";
            else html += "<button type='button' class='crd-pg-btn" + (p === activePage ? " crd-pg-active" : "") + "' onclick='" + gotoFnName + "(" + p + ")'>" + p + "</button>";
        }
        html += "<button type='button' class='crd-pg-btn' " + (activePage >= numberOfPages ? "disabled" : "onclick='" + gotoFnName + "(" + (activePage + 1) + ")'") + ">&rsaquo;</button>";
        $("#" + containerId).html(html);
    }

    function CrdLoadEmailDropdown() {
        if (!CrdLead || !CrdLead.CorpEmail) {
            $("#CrdEmailList").html("<div class='crd-empty-tab'>No email on this lead.</div>");
            return;
        }
        $.ajax({
            type: "POST",
            url: "/OutLookChatHistory/GetEmailDDL",
            data: { UserType: "NotAdmin", Email: CrdLead.CorpEmail },
            async: true
        }).done(function (json) {
            var list = (json && json.DateList) || [];
            var html = "<option value=''>Select User Emails</option>";
            for (var i = 0; i < list.length; i++) {
                html += "<option value='" + CrdEsc(list[i].Email) + "'>" + CrdEsc(list[i].Email) + "</option>";
            }
            $("#CrdEmailSelect").html(html);
            var emailToBind = CrdLead.CorpEmail;
            $("#CrdEmailSelect option[value='" + emailToBind + "']").remove();
            $("#CrdEmailSelect").append(new Option(emailToBind, emailToBind));
            $("#CrdEmailSelect").val(emailToBind);
            $("#CrdEmailPager").html("");
            $("#CrdEmailList").html("<div class='crd-empty-tab'>Select an email and click Search.</div>");
        }).fail(function () {
            $("#CrdEmailList").html("<div class='crd-empty-tab'>Couldn't load email list.</div>");
        });
    }

    function CrdRenderEmailRows(list) {
        if (!list || !list.length) {
            $("#CrdEmailList").html("<div class='crd-empty-tab'>No emails found.</div>");
            return;
        }
        var html = "";
        var bodies = [];
        for (var i = 0; i < list.length; i++) {
            var item = list[i];
            var isReceived = !item.SentDate;
            bodies.push(item.Body || "");
            html += "<div class='crd-email-row " + (isReceived ? "crd-email-row-received" : "crd-email-row-sent") + "'>";
            html += isReceived
                ? "<span class='crd-email-badge crd-email-badge-received'>Received mail</span>"
                : "<span class='crd-email-badge crd-email-badge-sent'>Sent mail</span>";
            html += "<div class='crd-email-field'><b>Sender:</b>" + CrdOrDash(item.Sender) + "</div>";
            html += "<div class='crd-email-field'><b>Subject:</b>" + CrdOrDash(item.Subject) + "</div>";
            html += "<div class='crd-email-field'><b>Recipient:</b>" + CrdOrDash(item.Recipient) + "</div>";
            if (item.CC_EMAil) html += "<div class='crd-email-field'><b>CC:</b>" + CrdEsc(item.CC_EMAil) + "</div>";
            if (item.BCC_EMail) html += "<div class='crd-email-field'><b>BCC:</b>" + CrdEsc(item.BCC_EMail) + "</div>";
            if (item.DateReceived) html += "<div class='crd-email-field'><b>Received date:</b>" + CrdEsc(item.DateReceived) + "</div>";
            if (item.SentDate) html += "<div class='crd-email-field'><b>Send date:</b>" + CrdEsc(item.SentDate) + "</div>";
            html += "<iframe class='crd-email-body-frame' id='CrdEmailFrame_" + i + "' sandbox=''></iframe>";
            if (item.attachmentFilePaths) {
                var files = item.attachmentFilePaths.split(",");
                var attHtml = "";
                for (var f = 0; f < files.length; f++) {
                    var fp = $.trim(files[f]);
                    var fileName = fp.split("\\").pop().split("/").pop();
                    var url = "/OutLookChatHistory/DownloadFile?filePath=E:\\EmailAttachments&fileName=" + encodeURIComponent(fileName);
                    attHtml += "<a href='" + url + "' target='_blank' style='display:block;'>" + CrdEsc(fileName) + "</a>";
                }
                html += "<div class='crd-email-field'><b>Attachments:</b></div>" + attHtml;
            }
            html += "</div>";
        }
        $("#CrdEmailList").html(html);
        for (var b = 0; b < bodies.length; b++) {
            var frame = document.getElementById("CrdEmailFrame_" + b);
            if (frame) frame.srcdoc = bodies[b];
        }
    }

    function CrdLoadEmailHistory() {
        var selectedEmail = $("#CrdEmailSelect").val() || (CrdLead && CrdLead.CorpEmail) || "";
        $("#CrdEmailList").html("<div class='crd-empty-tab'>Loading&hellip;</div>");
        var url = "/OutLookChatHistory/GetUserEmailAllhistoryDetails?searchKeyword='" + encodeURIComponent(selectedEmail) + "'&PageNumber=" + CrdEmailCurrentPage + "&Email=" + encodeURIComponent(selectedEmail);
        $.ajax({
            url: url,
            contentType: "application/json; charset=utf-8",
            dataType: "json"
        }).done(function (json) {
            var list = (json && json.DateList) || [];
            CrdRenderEmailRows(list);
            var activePage = (json && json.ActivePage) || 1;
            var numberOfPages = (json && json.NumberOfPages) || 0;
            CrdEmailCurrentPage = activePage;
            CrdRenderPager("CrdEmailPager", activePage, numberOfPages, "GoToCrdEmailPage");
        }).fail(function () {
            $("#CrdEmailList").html("<div class='crd-empty-tab'>Couldn't load email history.</div>");
        });
    }

    function GoToCrdEmailPage(page) {
        CrdEmailCurrentPage = page;
        CrdLoadEmailHistory();
    }

    // ---- Add contact modal (same as Sales) --------------------------------
    var CrdContactPhoneIti = null;

    function CrdOpenAddContact() {
        if (!CrdLead) return;
        var heading = CrdLead.CompanyName || CrdLead.Name;
        $("#CrdContactAvatar").text(CrdInitials(heading));
        $("#CrdContactSubtitle").text(heading || "");
        $("#CrdContactName").val("");
        $("#CrdContactEmail").val("");
        $("#CrdContactDesignation").val("");
        $("#CrdContactPhone").val("");

        if (window.intlTelInput) {
            if (CrdContactPhoneIti) { CrdContactPhoneIti.destroy(); CrdContactPhoneIti = null; }
            CrdContactPhoneIti = window.intlTelInput(document.getElementById("CrdContactPhone"), {
                initialCountry: "in",
                separateDialCode: true
            });
        }
        $("#CrdContactPhone").off("input.crdphone").on("input.crdphone", function () {
            var digits = $(this).val().replace(/\D/g, "");
            if (digits.length > 15) digits = digits.substring(0, 15);
            $(this).val(digits);
        });

        $("#CrdAddContactBackdrop").addClass("crd-modal-open");
    }

    function CrdCloseAddContact() {
        $("#CrdAddContactBackdrop").removeClass("crd-modal-open");
    }

    function CrdSaveAddContact() {
        var name = $.trim($("#CrdContactName").val());
        var email = $.trim($("#CrdContactEmail").val());
        var designation = $.trim($("#CrdContactDesignation").val());

        function warn(t, m) { if (window.swal) swal(t, m, "warning"); else alert(m); }

        if (!name) { warn("Add a name", "Contact name is required."); return; }
        if (!email) { warn("Add an email", "Corporate email is required."); return; }
        if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) { warn("Check the email", "That doesn't look like a valid email address."); return; }
        if (name.length > 80 || email.length > 80 || designation.length > 80) { warn("Too long", "Name, email and designation can be at most 80 characters."); return; }

        var countryCode = "";
        var contactNumber = $.trim($("#CrdContactPhone").val()).replace(/\D/g, "");
        if (CrdContactPhoneIti) {
            var countryData = CrdContactPhoneIti.getSelectedCountryData();
            countryCode = countryData && countryData.dialCode ? "+" + countryData.dialCode : "";
        }
        if (!contactNumber) { warn("Add a phone", "Phone number is required."); return; }
        if (contactNumber.length < 7 || contactNumber.length > 15) { warn("Check the phone", "Phone number should be 7 to 15 digits."); return; }

        $("#CrdContactSaveBtn").prop("disabled", true).text("Saving...");
        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/AddCRMContact",
            data: {
                id: CrdLeadId,
                name: name,
                corpEmail: email,
                contactCountryCode: countryCode,
                contactNumber: contactNumber,
                designation: designation
            }
        }).done(function (response) {
            $("#CrdContactSaveBtn").prop("disabled", false).text("Add contact");
            if (response && response.Success) {
                CrdCloseAddContact();
                CrdRenderContacts();
                if (window.swal) swal("Saved", "Contact added.", "success");
                else alert("Contact added.");
            } else {
                var msg = (response && response.Message) || "Please try again.";
                if (window.swal) swal("Couldn't save", msg, "error");
                else alert(msg);
            }
        }).fail(function () {
            $("#CrdContactSaveBtn").prop("disabled", false).text("Add contact");
            if (window.swal) swal("Couldn't save", "Please try again.", "error");
            else alert("Couldn't save. Please try again.");
        });
    }

    function CrdOpenFollowup() {
        if (!CrdLeadId) return;
        var heading = (CrdLead && (CrdLead.CompanyName || CrdLead.Name)) || "(unnamed)";
        $("#CrdFuAvatar").text(CrdInitials(heading));
        $("#CrdFuSubtitle").text(heading);
        $("#CrdFuDiscussion").val("");
        //$("#CrdFuStatus").val(CrdLead && CrdLead.Status && /renew/i.test(CrdLead.Status) ? CrdLead.Status : "Renew");
        $("#CrdFuNextDate").val(CrdDateInput(CrdLead && CrdLead.SetFollowUp));
        $("#CrdFollowupBackdrop").addClass("crd-modal-open");
    }

    function CrdCloseFollowup() {
        $("#CrdFollowupBackdrop").removeClass("crd-modal-open");
    }

    function CrdSaveFollowup() {
        var discussion = $.trim($("#CrdFuDiscussion").val());
        if (!discussion) {
            if (window.swal) swal("Add a note", "Describe what happened first.", "warning");
            else alert("Please describe what happened first.");
            return;
        }
        $("#CrdFuSaveBtn").prop("disabled", true).text("Saving...");
        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/AddCRMFollowUp",
            data: {
                openId: CrdLeadId,
                discussion: discussion,
                discussionStatus: $("#CrdFuStatus").val(),
                nextFollowUp: $("#CrdFuNextDate").val()
            }
        }).done(function (response) {
            $("#CrdFuSaveBtn").prop("disabled", false).text("Save");
            if (response && response.Success) {
                CrdCloseFollowup();
                CrdLoadActivity();
                if (window.swal) swal("Saved", "Follow-up added.", "success");
                else alert("Follow-up added.");
            } else {
                if (window.swal) swal("Couldn't save", "Please try again.", "error");
                else alert("Couldn't save. Please try again.");
            }
        }).fail(function () {
            $("#CrdFuSaveBtn").prop("disabled", false).text("Save");
            if (window.swal) swal("Couldn't save", "Please try again.", "error");
            else alert("Couldn't save. Please try again.");
        });
    }

    $(document).ready(function () {
        if (!CrdLeadId) { CrdRender(null); return; }
        $.ajax({
            type: "GET",
            url: "/LeadManagementSubscription/GetCRMOpenLeadData",
            data: { id: CrdLeadId },
            dataType: "json"
        }).done(function (response) {
            CrdRender(response && response.DataItem);
        }).fail(function () {
            $("#CrdLoading").text("Couldn't load this lead - please refresh.");
        });

        CrdLoadActivity();
    });
</script>
