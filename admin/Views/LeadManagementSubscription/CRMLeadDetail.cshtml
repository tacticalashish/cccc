@{
    ViewBag.Title = "Lead Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .crd-wrap { background: #f4f5f7; padding: 18px 28px 40px; }
    .crd-crumb { font-size: 13px; color: #7c828a; margin-bottom: 4px; }
    .crd-crumb a { color: #7c828a; text-decoration: none; }
    .crd-back { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: #33383f; text-decoration: none; margin-bottom: 14px; }
    .crd-card { background: #fff; border: 1px solid #eef0f2; border-radius: 12px; padding: 20px 22px; box-shadow: 0 1px 3px rgba(20,20,30,.05); }
    .crd-header-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; }
    .crd-header-left { display: flex; align-items: center; gap: 14px; }
    .crd-avatar { width: 46px; height: 46px; border-radius: 10px; background: #1f5a37; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 16px; flex-shrink: 0; }
    .crd-company-name { font-size: 20px; font-weight: 700; color: #22262b; }
    .crd-sub-line { font-size: 12.5px; color: #7c828a; margin-top: 3px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .crd-pill { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 600; padding: 2px 9px; border-radius: 10px; background: #eef0f2; color: #55595f; }
    .crd-pill .dot { width: 6px; height: 6px; border-radius: 50%; background: #9aa0a6; display: inline-block; }
    .crd-pill-type { background: #f1eafb; color: #6c47c9; }
    .crd-info-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 20px; border-top: 1px solid #eef0f2; padding-top: 16px; }
    .crd-info-label { font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: #a4aab3; font-weight: 600; margin-bottom: 4px; }
    .crd-info-value { font-size: 15px; font-weight: 700; color: #22262b; }
    .crd-tabs { display: flex; gap: 22px; border-bottom: 1px solid #e3e5e8; margin: 22px 0 18px; flex-wrap: wrap; }
    .crd-tab { padding: 8px 2px 12px; font-size: 13.5px; font-weight: 600; color: #7c828a; cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px; }
    .crd-tab.crd-tab-active { color: #22262b; border-bottom-color: #1f5a37; }
    .crd-tab-content { display: none; }
    .crd-tab-content.crd-tab-content-active { display: block; }
    .crd-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; align-items: start; }
    .crd-panel-title { font-size: 15px; font-weight: 700; color: #22262b; margin-bottom: 12px; }
    .crd-panel-row { display: flex; justify-content: space-between; align-items: center; padding: 11px 0; border-bottom: 1px solid #f2f3f5; font-size: 13.5px; }
    .crd-panel-row:last-child { border-bottom: none; }
    .crd-panel-label { color: #7c828a; }
    .crd-panel-value { color: #22262b; font-weight: 600; text-align: right; }
    .crd-empty-tab { text-align: center; color: #9aa0a6; font-size: 13px; padding: 30px 0; }
    /* Activity & follow-ups list - scroll after 5 rows (same as Sales) */
    .crd-act-list { max-height: 300px; overflow-y: auto; }
    .crd-act-row { display: flex; justify-content: space-between; align-items: flex-start; padding: 12px 0; border-bottom: 1px solid #f2f3f5; }
    .crd-act-row:last-child { border-bottom: none; }
    .crd-act-icon { width: 26px; height: 26px; border-radius: 6px; background: #f0f1f3; display: flex; align-items: center; justify-content: center; font-size: 12px; margin-right: 12px; flex-shrink: 0; }
    .crd-act-title { font-size: 13px; font-weight: 700; color: #22262b; }
    .crd-act-sub { font-size: 12px; color: #7c828a; margin-top: 2px; }
    .crd-act-date { font-size: 12px; color: #a4aab3; white-space: nowrap; margin-left: 10px; }
    /* Add follow-up modal - right side drawer (same as Sales) */
    .crd-modal-backdrop { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(20,20,30,.35); z-index: 300; justify-content: flex-end; }
    .crd-modal-backdrop.crd-modal-open { display: flex; }
    .crd-modal { background: #fff; width: 380px; max-width: 92vw; height: 100%; box-shadow: -4px 0 20px rgba(20,20,30,.15); display: flex; flex-direction: column; }
    .crd-modal-header { display: flex; justify-content: space-between; align-items: flex-start; padding: 16px 18px; border-bottom: 1px solid #f0f1f3; }
    .crd-modal-header-left { display: flex; align-items: center; gap: 10px; }
    .crd-modal-title { font-size: 14px; font-weight: 700; color: #22262b; }
    .crd-modal-subtitle { font-size: 12px; color: #a4aab3; }
    .crd-modal-close { cursor: pointer; color: #a4aab3; font-size: 20px; line-height: 1; }
    .crd-modal-body { padding: 16px 18px; flex: 1; overflow-y: auto; }
    .crd-modal-footer { display: flex; justify-content: flex-end; gap: 8px; padding: 14px 18px; border-top: 1px solid #f0f1f3; }
    .crd-field-label { font-size: 12px; font-weight: 600; color: #33383f; margin: 14px 0 6px; }
    .crd-field-label:first-child { margin-top: 0; }
    .crd-type-toggle { display: flex; border: 1px solid #d7dade; border-radius: 6px; overflow: hidden; }
    .crd-type-btn { flex: 1; border: none; background: #fff; padding: 8px 6px; font-size: 12px; font-weight: 600; color: #6b7078; cursor: pointer; border-right: 1px solid #d7dade; }
    .crd-type-btn:last-child { border-right: none; }
    .crd-type-btn.crd-type-btn-active { background: #f0f1f3; color: #22262b; }
    .crd-textarea, .crd-select, .crd-date-input { width: 100%; box-sizing: border-box; border: 1px solid #d7dade; border-radius: 6px; padding: 8px 10px; font-size: 12px; color: #33383f; }
    .crd-textarea { resize: vertical; min-height: 60px; font-family: inherit; }
    .crd-checkbox-row { display: flex; align-items: center; gap: 8px; font-size: 12px; color: #33383f; margin-top: 14px; cursor: pointer; }
    .crd-btn { border: 1px solid #d7dade; background: #fff; color: #33383f; border-radius: 6px; padding: 8px 14px; font-size: 12px; font-weight: 600; cursor: pointer; white-space: nowrap; }
    .crd-btn:hover { background: #f7f8f9; }
    .crd-btn-primary { background: #e07b1f; border-color: #e07b1f; color: #fff; }
    .crd-btn-primary:hover { background: #c96c16; }
    /* Emails tab (same as Sales) */
    .crd-email-toolbar { display: flex; gap: 8px; margin-bottom: 14px; }
    .crd-email-toolbar .crd-select { max-width: 320px; }
    .crd-email-row { border-radius: 8px; padding: 14px 16px; margin-bottom: 12px; border: 1px solid #eceef0; }
    .crd-email-row-sent { background: #f4f8f5; }
    .crd-email-row-received { background: #f7f8fa; }
    .crd-email-badge { display: inline-block; font-size: 10px; font-weight: 700; letter-spacing: .03em; text-transform: uppercase; padding: 2px 8px; border-radius: 20px; margin-bottom: 8px; }
    .crd-email-badge-sent { background: #eaf7ee; color: #2c8a4b; }
    .crd-email-badge-received { background: #eef2fb; color: #3f5fa8; }
    .crd-email-field { font-size: 12px; margin-bottom: 4px; color: #33383f; }
    .crd-email-field b { color: #7c828a; font-weight: 600; margin-right: 4px; }
    .crd-email-body-frame { display: block; width: 100%; height: 220px; border: none; border-top: 1px solid #f0f1f3; margin-top: 6px; background: #fff; }
    .crd-pager { display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 10px; padding-top: 10px; border-top: 1px solid #f2f3f5; }
    .crd-pg-btn { border: 1px solid #e2e4e8; background: #fff; color: #33383f; border-radius: 5px; min-width: 24px; height: 24px; padding: 0 6px; font-size: 11px; font-weight: 600; cursor: pointer; }
    .crd-pg-btn:hover:not(:disabled) { background: #f7f8f9; }
    .crd-pg-btn:disabled { opacity: .4; cursor: not-allowed; }
    .crd-pg-btn.crd-pg-active { background: #1f5a37; border-color: #1f5a37; color: #fff; }
    .crd-pg-dots { font-size: 11px; color: #a4aab3; padding: 0 2px; }
    /* Contacts tab (same as Sales) */
    table.crd-table { width: 100%; border-collapse: collapse; border: none; }
    table.crd-table thead th { text-align: left; font-size: 10px; letter-spacing: .04em; text-transform: uppercase; color: #a4aab3; font-weight: 600; padding: 8px 10px; border: none; border-bottom: 1px solid #edeef1; white-space: nowrap; }
    table.crd-table tbody td { padding: 10px 10px; font-size: 13px; color: #33383f; border: none; border-bottom: 1px solid #f2f3f5; vertical-align: middle; }
    table.crd-table tbody tr:last-child td { border-bottom: none; }
    .crd-pill-blue { display: inline-flex; align-items: center; font-size: 11px; font-weight: 600; border-radius: 20px; padding: 2px 9px; white-space: nowrap; background: #eef2fb; color: #3f5fa8; }
    .crd-pill-dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; margin-right: 5px; background: currentColor; opacity: .7; }
    .iti { width: 100%; display: block; }
    .iti__country-list { color: #22262b; max-height: 200px; z-index: 400; }
    /* Order & handover tab (same as Sales) */
    .crd-order-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .crd-order-row { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #f0f1f3; font-size: 13px; }
    .crd-order-label { color: #7c828a; }
    .crd-order-value { color: #22262b; font-weight: 600; }
    .crd-btn-success { background: #1f5a37; border-color: #1f5a37; color: #fff; }
    .crd-btn-success:hover { background: #17452a; }
    .crd-actions { display: flex; gap: 8px; align-items: center; }
    .crd-btn-danger { background: #fff; border-color: #e2453c; color: #e2453c; }
    .crd-btn-danger:hover { background: #fdecec; }
    .crd-info-banner { border-radius: 8px; padding: 12px 14px; font-size: 12.5px; line-height: 1.5; }
    .crd-info-banner-green { background: #eaf7ee; color: #1e7b3a; }
    .crd-info-banner-orange { background: #fdf3e3; color: #8a5a10; }
    @@media (max-width: 900px) { .crd-order-grid { grid-template-columns: 1fr; } }
    .crd-loading { text-align: center; color: #9aa0a6; font-size: 13px; padding: 50px 0; }
    /* Lead summary edit mode */
    .crd-panel-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
    .crd-mini-btn { border: 1px solid #e3e5e8; background: #fff; border-radius: 6px; padding: 4px 12px; font-size: 12px; font-weight: 600; color: #33383f; cursor: pointer; }
    .crd-mini-btn-primary { background: #1f5a37; border-color: #1f5a37; color: #fff; }
    .crd-edit-input { display: none; width: 55%; border: 1px solid #e3e5e8; border-radius: 6px; padding: 5px 8px; font-size: 13px; color: #33383f; }
    .crd-card.crd-editing .crd-panel-value { display: none; }
    .crd-card.crd-editing .crd-edit-input { display: inline-block; }
    /* Next follow-up editable nahi hai, to edit mode me bhi uski date dikhe */
    .crd-card.crd-editing #CrdSumFollowup { display: inline !important; }
    @@media (max-width: 900px) {
        .crd-two-col { grid-template-columns: 1fr; }
        .crd-info-row { grid-template-columns: repeat(2, 1fr); }
    }
</style>

<div class="crd-wrap">
    <div class="crd-crumb"><a href="@Url.Action("Pipeline", "LeadManagementSubscription")">Pipeline</a> / <span id="CrdCrumbName">&hellip;</span></div>
    <a class="crd-back" href="@Url.Action("Pipeline", "LeadManagementSubscription")">&larr; Back to pipeline</a>

    <div id="CrdLoading" class="crd-loading">Loading lead...</div>

    <div id="CrdContent" style="display:none;">
        <div class="crd-card">
            <div class="crd-header-row">
                <div class="crd-header-left">
                    <div class="crd-avatar" id="CrdAvatar">?</div>
                    <div>
                        <div class="crd-company-name" id="CrdCompanyName">&mdash;</div>
                        <div class="crd-sub-line">
                            <span id="CrdSubText">&mdash;</span>
                            <span class="crd-pill" id="CrdStagePill"><span class="dot"></span><span id="CrdStageText">&mdash;</span></span>
                            <span class="crd-pill crd-pill-type" id="CrdTypePill" style="display:none;"></span>
                        </div>
                    </div>
                </div>
                <div class="crd-actions">
                    <button type="button" class="crd-btn crd-btn-primary" id="CrdWonBtn" style="display:none;" onclick="CrdOpenWonModal()">&#10003; Mark won</button>
                    <button type="button" class="crd-btn crd-btn-danger" id="CrdLostBtn" style="display:none;" onclick="CrdOpenLostModal()">&#10007; Lost</button>
                </div>
            </div>

            <div class="crd-info-row">
                <div><div class="crd-info-label">Value</div><div class="crd-info-value" id="CrdValue">&mdash;</div></div>
                <div><div class="crd-info-label">Expected close</div><div class="crd-info-value" id="CrdExpectedClose">&mdash;</div></div>
                <div><div class="crd-info-label">Source</div><div class="crd-info-value" id="CrdSource">&mdash;</div></div>
                <div><div class="crd-info-label">Owner</div><div class="crd-info-value" id="CrdOwner">&mdash;</div></div>
            </div>
        </div>

        <div class="crd-tabs">
            <div class="crd-tab crd-tab-active" data-tab="overview" onclick="CrdSwitchTab('overview')">Overview</div>
            <div class="crd-tab" data-tab="activity" onclick="CrdSwitchTab('activity')">Activity &amp; follow-ups</div>
            <div class="crd-tab" data-tab="emails" onclick="CrdSwitchTab('emails')">Emails</div>
            <div class="crd-tab" data-tab="contacts" onclick="CrdSwitchTab('contacts')">Contacts</div>
            <div class="crd-tab" data-tab="order" onclick="CrdSwitchTab('order')">Order &amp; handover</div>
        </div>

        <div class="crd-tab-content crd-tab-content-active" id="CrdTabOverview">
            <div class="crd-two-col">
                <div class="crd-card" id="CrdLeadSummaryCard">
                    <div class="crd-panel-head">
                        <div class="crd-panel-title" style="margin:0;">Lead summary</div>
                        <div>
                            <button type="button" class="crd-mini-btn" id="CrdEditBtn" onclick="CrdStartEdit()">&#9998; Edit</button>
                            <button type="button" class="crd-mini-btn" id="CrdCancelBtn" style="display:none;" onclick="CrdCancelEdit()">Cancel</button>
                            <button type="button" class="crd-mini-btn crd-mini-btn-primary" id="CrdSaveBtn" style="display:none;" onclick="CrdSaveEdit()">Save</button>
                        </div>
                    </div>
                    <div class="crd-panel-row">
                        <span class="crd-panel-label">Stage</span>
                        <span class="crd-panel-value" id="CrdSumStage">&mdash;</span>
                        <select class="crd-edit-input" id="CrdEditStatus">
                            <option value="Open">Open</option>
                            <option value="Won">Won</option>
                            <option value="Lost">Lost</option>
                        </select>
                    </div>
                    <div class="crd-panel-row">
                        <span class="crd-panel-label">Type</span>
                        <span class="crd-panel-value" id="CrdSumType">&mdash;</span>
                        <select class="crd-edit-input" id="CrdEditLeadType">
                            <option value="">&mdash;</option>
                            <option value="Inbound">Inbound</option>
                            <option value="Outbound">Outbound</option>
                        </select>
                    </div>
                    <div class="crd-panel-row">
                        <span class="crd-panel-label">Source</span>
                        <span class="crd-panel-value" id="CrdSumSource">&mdash;</span>
                        <input type="text" class="crd-edit-input" id="CrdEditSource" placeholder="Source" />
                    </div>
                    <div class="crd-panel-row">
                        <span class="crd-panel-label">Interested in</span>
                        <span class="crd-panel-value" id="CrdSumInterested">&mdash;</span>
                        <input type="text" class="crd-edit-input" id="CrdEditMessage" placeholder="Interested in" />
                    </div>
                    <div class="crd-panel-row">
                        <span class="crd-panel-label">Value</span>
                        <span class="crd-panel-value" id="CrdSumValue">&mdash;</span>
                        <span class="crd-edit-input" style="white-space:nowrap;">
                            <input type="text" id="CrdEditAmount" placeholder="Amount" style="width:90px;border:1px solid #e3e5e8;border-radius:6px;padding:5px 8px;font-size:13px;" />
                            <select id="CrdEditCurrency" style="border:1px solid #e3e5e8;border-radius:6px;padding:5px 6px;font-size:13px;">
                                <option value="">--</option>
                                <option value="USD">USD</option>
                                <option value="INR">INR</option>
                            </select>
                        </span>
                    </div>
                    <div class="crd-panel-row">
                        <span class="crd-panel-label">Expected close</span>
                        <span class="crd-panel-value" id="CrdSumClose">&mdash;</span>
                        <input type="date" class="crd-edit-input" id="CrdEditClose" />
                    </div>
                    <div class="crd-panel-row">
                        <span class="crd-panel-label">Next follow-up</span>
                        <span class="crd-panel-value" id="CrdSumFollowup">&mdash;</span>
                    </div>
                </div>

                <div class="crd-card">
                    <div class="crd-panel-title">Company &amp; contact</div>
                    <div class="crd-panel-row"><span class="crd-panel-label">Company</span><span class="crd-panel-value" id="CrdCoCompany">&mdash;</span></div>
                    <div class="crd-panel-row"><span class="crd-panel-label">Contact</span><span class="crd-panel-value" id="CrdCoContact">&mdash;</span></div>
                    <div class="crd-panel-row"><span class="crd-panel-label">Email</span><span class="crd-panel-value" id="CrdCoEmail">&mdash;</span></div>
                    <div class="crd-panel-row"><span class="crd-panel-label">Phone</span><span class="crd-panel-value" id="CrdCoPhone">&mdash;</span></div>
                    <div class="crd-panel-row"><span class="crd-panel-label">Country</span><span class="crd-panel-value" id="CrdCoCountry">&mdash;</span></div>
                </div>
            </div>
        </div>

        <div class="crd-tab-content" id="CrdTabActivity"><div class="crd-card">
            <div class="crd-panel-head">
                <div class="crd-panel-title" style="margin:0;">Activity &amp; follow-ups</div>
                <button type="button" class="crd-btn crd-btn-primary" onclick="CrdOpenFollowup()">&#9998; Log follow-up</button>
            </div>
            <div class="crd-act-list" id="CrdActivityList"><div class="crd-empty-tab">Loading&hellip;</div></div>
        </div></div>
        <div class="crd-tab-content" id="CrdTabEmails"><div class="crd-card">
            <div class="crd-panel-title">Email history</div>
            <div class="crd-email-toolbar">
                <select id="CrdEmailSelect" class="crd-select"></select>
                <button type="button" class="crd-btn crd-btn-primary" onclick="CrdEmailCurrentPage=1; CrdLoadEmailHistory();">Search</button>
            </div>
            <div id="CrdEmailList"><div class="crd-empty-tab">Loading&hellip;</div></div>
            <div class="crd-pager" id="CrdEmailPager"></div>
        </div></div>
        <div class="crd-tab-content" id="CrdTabContacts"><div class="crd-card">
            <div class="crd-panel-title">Contacts</div>
            <table class="crd-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Designation</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="CrdContactRows">
                    <tr><td colspan="5" class="crd-empty-tab">Loading&hellip;</td></tr>
                </tbody>
            </table>
        </div></div>
        <div class="crd-tab-content" id="CrdTabOrder">
            <div class="crd-order-grid">
                <div class="crd-card">
                    <div class="crd-panel-title">Quote</div>
                    <div class="crd-order-row"><span class="crd-order-label">Products</span><span class="crd-order-value" id="CrdOrderProducts">&mdash;</span></div>
                    <div class="crd-order-row"><span class="crd-order-label">Amount</span><span class="crd-order-value" id="CrdOrderAmount">&mdash;</span></div>
                    <div class="crd-order-row"><span class="crd-order-label">Currency</span><span class="crd-order-value" id="CrdOrderCurrency">&mdash;</span></div>
                    <div class="crd-order-row"><span class="crd-order-label">Payment terms</span><span class="crd-order-value" id="CrdOrderPaymentTerms">&mdash;</span></div>
                    <button type="button" class="crd-btn crd-btn-success" id="CrdProformaBtn" style="margin-top:14px;" onclick="CrdGoToProformaInvoice()">Create proforma invoice</button>
                </div>
                <div class="crd-card">
                    <div class="crd-panel-title">Closing &amp; handover</div>
                    <div id="CrdClosingNotWon">
                        <div class="crd-empty-tab" style="padding:10px 0 16px;">
                            Win this renewal to begin closing.<br>
                            Renewal Won &rarr; proforma invoice &rarr; subscription renewed &amp; handed over.
                        </div>
                    </div>
                    <div id="CrdClosingWon" style="display:none;">
                        <div class="crd-empty-tab" style="padding:10px 0 4px;">This renewal is won &mdash; ready for invoicing and handover.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="crd-modal-backdrop" id="CrdFollowupBackdrop">
    <div class="crd-modal">
        <div class="crd-modal-header">
            <div class="crd-modal-header-left">
                <div class="crd-avatar" id="CrdFuAvatar" style="width:34px;height:34px;font-size:13px;">?</div>
                <div>
                    <div class="crd-modal-title">Log follow-up</div>
                    <div class="crd-modal-subtitle" id="CrdFuSubtitle">&mdash;</div>
                </div>
            </div>
            <span class="crd-modal-close" onclick="CrdCloseFollowup()">&times;</span>
        </div>
        <div class="crd-modal-body">
            <div class="crd-field-label">What happened?</div>
            <textarea id="CrdFuDiscussion" class="crd-textarea" placeholder="e.g. Discussed renewal scope and pricing"></textarea>

            <div class="crd-field-label">Move to stage</div>
            <select id="CrdFuStatus" class="crd-select">
                <option value="Select Stages"  selected="selected">Select Stages</option>
                <option value="Open For Renewal">Open For Renewal</option>
                <option value="In Discussion">In Discussion</option>
                <option value="RenewWon">Renew Won</option>
