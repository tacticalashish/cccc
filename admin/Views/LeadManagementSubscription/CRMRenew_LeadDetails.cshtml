<script>
    $(document).ready(function () {
        $("#Discussion").click(function () {
            $("#folloupDiscussion").slideToggle();
        });

        $("#chatDiscussion").click(function () {
            $("#ChatSection").slideToggle();
        });
        $("#ViewDemoDiscussion").click(function () {
            $("#DemoDiscussionList").slideToggle();
        });
        GetCountry();
        $('.iti__flag').hide();
        //$("#Telephone").intlTelInput({
        //    initialCountry: "in",
        //    separateDialCode: true


        //});
        //$("#ContactNumber").intlTelInput({
        //    initialCountry: "in",
        //    separateDialCode: true


        //});
        $('#ContactNumber').on('input', function (e) {
            // Replace any non-digit characters
            this.value = this.value.replace(/\D/g, '');
        });
        $('#Telephone').on('input', function (e) {
            // Replace any non-digit characters
            this.value = this.value.replace(/\D/g, '');
        });
        $('#CorpEmail').on('blur', function () {
            var email = $(this).val();
            if (email.includes('@@') && email.includes('.')) {

            }
            else {
                $("#CorpEmail").val('');
                swal("Warning", "Please Insert Valid Email", "error");
            }
        });
 
    });
    var Email = null;
    var StateID = null;

    function GetCountry() {
        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/GetClintCountry",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            success: function (data) {

                var innerHTML = "";
                innerHTML += "<option  value = ''>" + "Select Country" + "</option>";
                $(data.DataList).each(function (index, value) {
                    if (value.CountryName != null || value.CountryName != "" || value.CountryName != undefined) {
                        innerHTML += "<option class='option01' value = '" + value.CountryID + "'> " + value.CountryName + "</option>"
                    }
                });
                $('#Country').html(innerHTML);
                $('#ClientCountryName').html(innerHTML);
            },
            failure: function (response) {
                console.log(response)
            },
            error: function (response) {
                console.log(response)
            }
        });
    }

    $("#Country").change(function () {

        var CountryName = $("#Country").val();
        if (CountryName == "1") {
            GetStateDDL();
            $("#DivState").show();

        } else {
            $("#DivState").hide();
        }
    });

    function GetStateDDL() {
        var Country = $("#Country").val();

        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/GetStateDDL",
            data: "{CountryID: '" + Country + "' }",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var StateNameHTML = '';
                StateNameHTML += "<option  value = ''>" + "Select State" + "</option>";
                $(response).each(function (index, value) {
                    if (value.StateName != null || value.StateName != "" || value.StateName != undefined) {
                        StateNameHTML += "<option class='option01' value = '" + value.StateId + "'> " + value.StateName + "</option>"

                    }
                });
                $('#State').html(StateNameHTML);
                if (StateID != "") {
                    $('#State').val(StateID);
                }
            },
            failure: function (response) { },
            error: function (response) { }
        });
    }

    function GetDropdowndata() {

        var UserType = "";

        if (Email == "") {
            UserType = "Admin";
        }
        else {
            UserType = "NotAdmin";
        }

        $.ajax({
            type: "POST",
            url: "/OutLookChatHistory/GetEmailDDL",
            data: { UserType: UserType, Email: Email },
            async: true,
            success: function (data) {
                var Objdic = "";

                Objdic += "<option value=''>" + "Select User Emails" + "</option>";
                $(data.DateList).each(function (jsonIndex, Value) {
                    Objdic += "<option value='" + Value.Email + "'>" + Value.Email + "</option>";
                });

                $('#Email').html(Objdic);
                const emailToBind = Email;
                if (emailToBind) {
                    $('#Email option[value="' + emailToBind + '"]').remove();
                    const emailOption = new Option(emailToBind, emailToBind);
                    $('#Email').append(emailOption);
                    $('#Email').val(emailToBind);
                }

                $('#Email').selectpicker('refresh');
                GetEmailHistory();
            },
            failure: function (response) {
                console.log(response);
            },
            error: function (response) {
                console.log(response);
            }
        });


    }
    function GetsearchValues() {
        Search = $('#search').val();
        $('#search').html(GetPaginationHTML(Search));
        GetEmailHistory();
    }
    function GetEmailHistory() {

        var rowHTML = ""; var path = "/ChemPricingImportfile/SalesDocument";
        var pageNumber = $('#PageNumber').val();

        var selectedEmail = $('#Email').val();


        var URL = "/OutLookChatHistory/GetUserEmailAllhistoryDetails?searchKeyword='" + selectedEmail + "'";
        URL += '&PageNumber=' + pageNumber;
        URL += '&Email=' + selectedEmail;
        $.ajax({
            url: URL,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            success: function (json) {

                $('#containerdata').empty();
                if (json != null) {
                    $(json.DateList).each(function (idx, elm) {

                        var bgColor = "";
                        var checkdate = elm.SentDate;
                        lblcheck = "";
                        if (checkdate == "" || checkdate == null) {
                            bgColor = "#0a2a0f8a";
                            lblcheck = "Received Mail";
                        }
                        else {
                            bgColor = "#354c4687";
                            lblcheck = "";
                            lblcheck = "Send Mail";
                        }

                        var date = elm.CreatedDate;
                        var formattedDate = ($.formattedDate(new Date(parseInt(date.substr(6)))));

                        var attachmentsHTML = "";
                        if (elm.attachmentFilePaths) {
                            var filePaths = elm.attachmentFilePaths.split(",");
                            filePaths.forEach(function (filePath) {
                                // Extract file name from the path
                                var fileName = filePath.split("\\").pop();
                                var path = "E:\EmailAttachments";
                                // Generate the custom path
                                var customPath = "/OutLookChatHistory/DownloadFile?filePath=" + path + "&fileName=" + encodeURIComponent(fileName);

                                // Create a clickable link
                                attachmentsHTML += `<a target='_blank' href='${customPath}' style="display:block;">${fileName}</a>`;
                            });
                        } else {
