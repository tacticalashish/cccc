    function EditPopupSource(LeadId) {
        $('#LeadId').val(LeadId);
        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/BindCRMOpenLeadDetailsByid",
            data: { Id: LeadId },
            success: function (response) {
                var innerHTML = "";
                $(response).each(function (index, value) {
                    
                    StateID = value.StateId;
                    Email = value.CorpEmail;
                    var InvoiceNumber = value.Invoice;
                    var LostReason = value.LostReason;
                    var files = value.files;
                    $('#Source').val(files);
                    if (InvoiceNumber == null || InvoiceNumber == "") {
                        $('#InvoiveNumber').prop('disabled', false);
                        $('#InvoiveNumberDiv').hide();
                    }
                    else {
                        $('#InvoiveNumberDiv').show();
                        $('#InvoiveNumber').val(value.Invoice);
                        $('#InvoiveNumber').prop('disabled', true);
                    }
                    if (LostReason == null || LostReason == "") {
                        $('#LostReason').prop('disabled', false);
                        $('#LostReasonDiv').hide();
                    }
                    else {
                        $('#LostReasonDiv').show();
                        $('#LostReason').val(value.LostReason);
                        // $('#LostReason').prop('disabled', true);
                    }
                    var ExpectedCloseDate = value.ExpectedCloseDate;
                    var SetFollowUpdate = value.SetFollowUp;
                    if (ExpectedCloseDate != "" && ExpectedCloseDate != null) {
                        ExpectedCloseDate = ($.formattedDate(new Date(parseInt(ExpectedCloseDate.substr(6)))));
                    }
                    if (SetFollowUpdate != "" && SetFollowUpdate != null) {
                        SetFollowUpdate = ($.formattedDate(new Date(parseInt(SetFollowUpdate.substr(6)))));
                    }
                    $('#Name').val(value.Name);
                    $('#LeadStatus').val(value.Status);
                    $("#Designation").val(value.Designation);

                    //if (value.Status == "RenewWon") {
                    //    $('#LeadStatus').prop('disabled', true);
                    //}
                    //else {
                    //    $('#LeadStatus').prop('disabled', false);
                    //    $('#InvoiveNumber').prop('disabled', false);
                    //}

                    $('#CorpEmail').val(value.CorpEmail);
                    //$('#ContactNumber').val(value.Mobile);
                    $('#CompanyName').val(value.CompanyName);
                    //$('#Telephone').val(value.Phone);


                    if (value.ContactCountryCode == '' || value.ContactCountryCode == null) {
                        var telInputContactNumber = $("#ContactNumber").intlTelInput("getSelectedCountryData")
                        telInputContactNumber.val('+91');

                        telInputContactNumber.intlTelInput({
                            separateDialCode: true,
                            nationalMode: false,
                        });

                    } else {
                        var telInputContactNumber = $("#ContactNumber").intlTelInput("getSelectedCountryData")
                        telInputContactNumber.val('+' + value.ContactCountryCode);

                        telInputContactNumber.intlTelInput({
                            separateDialCode: true,
                            nationalMode: false,
                        });

                    }
                    $('#ContactNumber').val(value.Mobile);
                    if (value.TelephoneCountryCode == '' || value.TelephoneCountryCode == null) {


                        var telInputTelephone = $("#Telephone").intlTelInput("getSelectedCountryData")
                        telInputTelephone.val('+91');

                        telInputTelephone.intlTelInput({
                            separateDialCode: true,
                            nationalMode: false,
                        });
                    } else {


                        var telInputTelephone = $("#Telephone").intlTelInput("getSelectedCountryData")
                        telInputTelephone.val('+' + value.TelephoneCountryCode);

                        telInputTelephone.intlTelInput({
                            separateDialCode: true,
                            nationalMode: false,
                        });
                    }
                    $('#Telephone').val(value.Phone);


                    oldMobile = value.Mobile;
                    oldTelephone = value.Phone;

                    $('#Country').val(value.CountryID);
                    if (value.CountryID == "1") {
                        $("#DivState").show();

                        GetStateDDL();

                    } else {
                        $("#DivState").hide();
                    }

                    $('#OutboundLeadSource').val(value.OutboundLeadSource);
                    $('#LeadType').val(value.LeadType);
                    $('#Message').val(value.DiscriptionMessage);
                    $('#SetFollowUp').val(SetFollowUpdate);
                    $('#ExpectedCloseDate').val(ExpectedCloseDate);
                    $('#Amount').val(value.Amount);
                    $('#Currency').val(value.Currency);
                    $('#State').val(value.StateId);
                    GetDropdowndata();

                    if (value.Status == "RenewWon") {
                        $("#DivExpectedCloseDate").hide();
                        $("#PaymentOptionDiv").show();
                        $("#DivAttachmentsDocument").show();
                        $("#RemainingPaymentDateDiv").hide();
                        $("#PaymentTermsDiv").show();
                        $("#InvoiveNumberDiv").show();
                        $("#DivLastFollowupDiscussion").show();
                        $("#LostReasonDiv").hide();
                        $("#DivNextFollowupDate").hide();
                        $("#DivAmount").show();
                        $("#DivCurrency").show();
                        $("#LostReason").val('');
                        $("#SetFollowUp").val('');
                        $("#ExpectedCloseDate").val('');
                        $("#SetFollowUp").val('');

                    }
                    else if (value.Status == "RenewLost") {
                        $("#PaymentOptionDiv").hide();
                        $("#RemainingPaymentDateDiv").hide();
                        $("#PaymentTermsDiv").hide();
                        $("#LostReasonDiv").show();
                        $("#InvoiveNumberDiv").hide();
                        $("#DivExpectedCloseDate").hide();
                        $("#DivNextFollowupDate").hide();
                        $("#DivAmount").hide();
                        $("#DivCurrency").hide();
                        $("#DivLastFollowupDiscussion").hide();
                        $("#DivAttachmentsDocument").hide();

                        $("#PaymentOption").val('');
                        $("#RemainingPaymentDate").val('');
                        $("#PaymentTerms").val('');
                        $("#InvoiveNumber").val('');
                        $("#ExpectedCloseDate").val('');
                        $("#SetFollowUp").val('');
                        $("#Amount").val('');
                        $("#Currency").val('');
                        $("#Message").val('');
                    }
                    else {

                        $("#PaymentOptionDiv").hide();
                        $("#RemainingPaymentDateDiv").hide();
                        $("#PaymentTermsDiv").hide();
                        $("#DivExpectedCloseDate").show();
                        $("#InvoiveNumberDiv").hide();
                        $("#LostReasonDiv").hide();
                        $("#DivNextFollowupDate").show();
                        $("#DivAmount").show();
                        $("#DivCurrency").show();
                        $("#DivLastFollowupDiscussion").show();
                        $("#DivAttachmentsDocument").show();

                        $("#PaymentOption").val('');
                        $("#RemainingPaymentDate").val('');
                        $("#PaymentTerms").val('');
                        $("#InvoiveNumber").val('');
                        $("#LostReason").val('');
                    }
                    $('.iti__flag').hide();	


                });
            },
            failure: function (response) {
                console.log(response)
            },
            error: function (response) {
                console.log(response)
            }
        });

        $('.iti__flag').hide();	
        $(".popup-open").css("display", "block");
    }

</script>
