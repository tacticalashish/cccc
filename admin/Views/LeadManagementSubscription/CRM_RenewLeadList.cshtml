<script>
    var Search = "";
    $.formattedDate = function (dateToFormat) {
        var dateObject = new Date(dateToFormat);
        var day = dateObject.getDate();
        var month = dateObject.getMonth() + 1; // Full month name
        var year = dateObject.getFullYear();

        var formattedDate = day + "-" + month + "-" + year;
        return formattedDate;
    };
    function UploadFile() {

        var files = $("#FileUpload").get(0).files;
        var fileData = new FormData();
        for (var i = 0; i < files.length; i++) {
            fileData.append("FileUpload", files[i]);
        }
        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/UploadLeadFiles",
            dataType: "json",
            contentType: false, // Not to set any content header
            processData: false, // Not to process data
            data: fileData,
            success: function (result, status, xhr) { // alert(result);
            },
            error: function (xhr, status, error) { // alert(status);
            }
        });
    }
    $("#LeadStatus").change(function () {
        ;
        var LeadStatus = $("#LeadStatus").val();
        if (LeadStatus == "RenewWon") {
            $("#PaymentOptionDiv").show();
            $("#RemainingPaymentDateDiv").hide();
            $("#PaymentTermsDiv").show();
            $("#InvoiveNumberDiv").show();

            $("#LostReasonDiv").hide();
        }
        else if (LeadStatus == "RenewLost") {
            $("#PaymentOptionDiv").hide();
            $("#RemainingPaymentDateDiv").hide();
            $("#PaymentTermsDiv").hide();
            $("#LostReasonDiv").show();
            $("#InvoiveNumberDiv").hide();

        }
        else {

            $("#PaymentOptionDiv").hide();
            $("#RemainingPaymentDateDiv").hide();
            $("#PaymentTermsDiv").hide();


            $("#InvoiveNumberDiv").hide();
            $("#LostReasonDiv").hide();
        }

    });

    $("#PaymentOption").change(function () {
        var PaymentOption = $("#PaymentOption").val();
        if (PaymentOption == "RemainingPayment") {
            $("#RemainingPaymentDateDiv").show();
        }
        else {
            $("#RemainingPaymentDateDiv").hide();
        }
    });


    function UpdateOpenLeadData() {
        
        var SetFollowUp = $("#SetFollowUp").val();
        var Amount = $("#Amount").val();
        var ExpectedCloseDate = $("#ExpectedCloseDate").val();
        var Currency = $("#Currency").val();
        var LeadId = $("#LeadId").val();
        var LeadStatus = $("#LeadStatus").val();
        var filesval = $("#FileUpload").val();
        var InvoiveNumber = $("#InvoiveNumber").val();
        var LostReason = $("#LostReason").val();

        var PaymentTerms = $("#PaymentTerms").val();
        var PaymentOption = $("#PaymentOption").val();
        var RemainingPaymentDate = $("#RemainingPaymentDate").val();

        var files = "";
        if (filesval == "") {
        }
        else {
            files = $("#FileUpload").get(0).files[0].name;
        }
        var GetDetails = {
            SetFollowUp: SetFollowUp,
            Amount: Amount,
            ExpectedCloseDate: ExpectedCloseDate,
            Currency: Currency,
            Id: LeadId,
            files: files,
            Status: LeadStatus,
            InvoiceNumber: InvoiveNumber,
            LostReason: LostReason,
            PaymentTerms: PaymentTerms,
            PaymentOption: PaymentOption,
            RemainingPaymentDate: RemainingPaymentDate

        }
        if (SetFollowUp == "" && (LeadStatus != "Lost")) {
            swal("Warning", "Please Insert SetFollowUp", "error");
        }
        else if (Amount == "" && (LeadStatus != "Lost")) {
            swal("Warning", "Please Insert Amount", "error");
        }
        else if (ExpectedCloseDate == "" && (LeadStatus != "Lost")) {
            swal("Warning", "Please Insert ExpectedCloseDate", "error");
        }
        else if (Currency == "" && (LeadStatus != "Lost")) {
            swal("Warning", "Please Insert Currency", "error");
        }
        else if ((LeadStatus == "RenewWon") && (InvoiveNumber == "")) {
            swal("Warning", "Please Insert Invoive Number", "error");
        }
        else if ((PaymentOption == "RemainingPayment") && (RemainingPaymentDate == "")) {
            swal("Warning", "Please Insert Remaining Payment Date", "error");
        }
        else {

            $.ajax({
                type: "POST",
                url: "/LeadManagementSubscription/UpdateCRMOpenLeadDetails",
                data: JSON.stringify(GetDetails),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    
                    $(response).each(function (index, value) {
                        if (value.ValidationMessage == "SUCCESS") {
                            UploadFile();
                            swal(
                                { title: "Thank you!", text: "Updated Sucessfully.", type: "success" }).then(function () {
                                    window.location.reload();
                                });
                        }

                    });


                },
                failure: function (response) {
                    console.log(response)
                },
                error: function (response) {
                    console.log(response)
                }
            });

        }

    }
    $(document).ready(function () {
        $("#ExpectedCloseDate").datepicker({ dateFormat: "dd/MM/yy" });
        $("#SetFollowUp").datepicker({ dateFormat: "dd/MM/yy" });
        $("#RemainingPaymentDate").datepicker({ dateFormat: "dd/MM/yy" });

        GetLeadOnSearchFilter();

    });
    function GetsearchValues() {
        Search = $('#search').val();
        $('#search').html(GetPaginationHTML(Search));
        GetLeadOnSearchFilter();
    }
    function GetLeadOnSearchFilter() {
     
        var path = "/ChemPricingImportfile/LeadDocuments";
        var pageNumber = $('#PageNumber').val();
        var Search = $('#search').val();
        var URL = "/LeadManagementSubscription/GetCRM_RenewMaskEmailList_CustomSearch?searchKeyword='" + Search + "'";
        URL += '&PageNumber=' + pageNumber;
        $.ajax({
            url: URL,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            success: function (json) {
                var tbodyHTML = '';
                if (json != null) {
                    $(json.DateList).each(function (idx, elm) {
                        ;
                        var date = elm.CreatedDate;
                        var dateRequestedDate = elm.RequestedDate;
                        var formattedDate = ($.formattedDate(new Date(parseInt(date.substr(6)))));
                        var RequestedformattedDate = ($.formattedDate(new Date(parseInt(dateRequestedDate.substr(6)))));

                        tbodyHTML += "<tr>";
                        tbodyHTML += "<td hidden>" + elm.Id + "</td>";
                        tbodyHTML += "<td>" + elm.Name + "</td>";
                        tbodyHTML += "<td>" + elm.CorpEmail + "</td>";
                        tbodyHTML += "<td>" + elm.Phone + "</td>";

                        tbodyHTML += "<td>" + elm.CompanyName + "</td>";
                        tbodyHTML += "<td>" + elm.CountryName + "</td>";
                        tbodyHTML += "<td>" + elm.StateName + "</td>";
                        tbodyHTML += "<td>" + "<button class='btn btn-xs btn-primary' onclick='ShowDescription(`" + elm.DiscriptionMessage + "`)'>Read More..</button>" + '' + "</td>";
                        tbodyHTML += "<td>" + RequestedformattedDate + "</td>";
                        tbodyHTML += "<td>" + elm.Status + "</td>";
                        tbodyHTML += "<td>" + elm.OutboundLeadSource + "</td>";
                        tbodyHTML += `<td><input type="button" class="btn btn-xs btn-info" value="Get Email Chat" onclick="Getchat('${elm.CorpEmail}')"></td>`;

                        if (elm.files == "" || elm.files == null) {
                            tbodyHTML += "<td>" + '-' + "</td>";
                        }
                        else {
                            tbodyHTML += "<td>" + "<a target='_blank' href='/LeadManagementSubscription/DownloadFile?filePath=" + path + "/" + elm.files + "&fileName=" + elm.files + "'>" + elm.files + "</a>" + "</td>";
                        }
                        tbodyHTML += "<td>" + elm.Invoice + "</td>";
                      
                        tbodyHTML += "</tr>"
                    });
                    $('#divPagging').html(GetPaginationHTML(json));
                    $('#pageSize').val(json.PageSize);
                }
                else {
                    tbodyHTML = "<tr><td class='text-center' colspan='20'><span>No records found..!!</span> </td></tr>";
                }
                $('.tbodydata').html(tbodyHTML);
            }
        });
    }


