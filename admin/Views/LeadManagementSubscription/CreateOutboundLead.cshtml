
@{
    ViewBag.Title = "CreateOutboundLead";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .mt-2 {
        margin-top: 8px;
    }

    .iti__country-list {
        background: #0e1d26 !important;
        max-height: 292px;
        overflow-x: hidden;
        max-width: 250px;
    }

    .iti__flag {
        background-color: transparent !important;
    }

    .iti--separate-dial-code .iti__selected-dial-code {
        margin-left: 6px;
        color: red;
    }

    .iti__arrow {
        border-top: none !important
    }

    .iti--allow-dropdown {
        width: 100%;
    }
    /*.iti--separate-dial-code .iti__selected-flag {
        background-color: #a8a8a8!important;
    }*/
    .text-danger {
        color: red;
        font-size: 15px
    }
</style>
<link href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.13/css/intlTelInput.css" rel="stylesheet" />
<form id="frmChemicalPrice">
    <div class="container-fluid">
        <div class="row">
            <div class="" style="margin-top:10px">
                <div class="col-md-12">
                    <div class="padding-0"> <h4 style="color:#fff;text-align:center" class="mb-1">Create Inbound/Outbound Lead</h4></div>
                    <div class="col-md-12 padding-0">
                        <hr style="margin-top:5px!important" />
                    </div>
                </div>
                <div class=" ">
                    <div class="col-md-3 box-height">
                        <label>Lead Type <span class="text-danger">*</span></label>
                        <select class="form-control mb-1" id="LeadType" name="LeadType" title="LeadType">
                            <option value="">Select LeadType</option>
                            <option value="Inbound">Inbound</option>
                            <option value="Outbound" selected>Outbound</option>
                        </select>
                        @*<input type="text" class="form-control mb-1" placeholder="LeadType" id="LeadType" name="LeadType" autocomplete="off" />*@
                    </div>
                    <div class="col-md-3 box-height">
                        <label>Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control mb-1" placeholder="Name" id="Name" name="Name" autocomplete="off" />
                    </div>
                    <div class="col-md-3 box-height">
                        <label>Corp Email <span class="text-danger">*</span></label>
                        <input type="text" class="form-control mb-1" placeholder="CorpEmail" id="CorpEmail" name="CorpEmail" autocomplete="off" />
                    </div>
                    <div class="col-md-3 box-height">
                        <label>Mobile Number <span class="text-danger">*</span></label>
                        <input type="tel" maxlength="15" class="form-control mb-1" placeholder="ContactNumber" id="ContactNumber" name="ContactNumber" autocomplete="off" />
                    </div>
                    <div class="col-md-3 box-height">
                        <label>Telephone</label>
                        <input type="tel" maxlength="15" class="form-control mb-1" placeholder="Telephone" id="Telephone" name="Telephone" autocomplete="off" />
                    </div>
                    <div class="col-md-3 box-height">
                        <label>Designation <span class="text-danger">*</span></label>
                        <input type="text" class="form-control mb-1" placeholder="Designation" id="Designation" name="Designation" autocomplete="off" />
                    </div>
                    <div class="col-md-3 box-height">
                        <label>Company Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control mb-1" placeholder="CompanyName" id="CompanyName" name="CompanyName" autocomplete="off" />
                    </div>
                    <div class="col-md-3 box-height">
                        <label>Country <span class="text-danger">*</span></label>
                        <select class="form-control mb-1" id="Country" name="Country" title="Country">
                            <option value="">Select Country</option>
                        </select>
                    </div>

                    <div class="col-md-3 box-height" id="DivState">
                        <label>State <span class="text-danger">*</span></label>
                        <select id="State" class="form-control mb-1" name="State" title="State">
                            <option value="">Select State</option>
                        </select>

                    </div>
                    <div class="col-md-3 box-height">
                        <label>Lead Source <span class="text-danger">*</span></label>
                        <select class="form-control mb-1" id="OutboundLeadSource" name="OutboundLeadSource" title="OutboundLeadSource">
                            <option value="">Select LeadSource</option>
                            <option value="WebsiteForms">Website Forms</option>
                            <option value="Chat">Chat</option>
                            <option value="Email">Email</option>
                            <option value="SocialMedia">Social Media</option>
                            <option value="Event/Conference">Event/Conference</option>
                            <option value="Others">Others</option>
                        </select>
                        @*<input type="text" class="form-control mb-1" placeholder="OutboundLeadSource" id="OutboundLeadSource" name="OutboundLeadSource" autocomplete="off" />*@
                    </div>
                    @*<div class="col-md-3 box-height">
                            <label>Requested Date</label>
                            <input type="datetime" class="form-control mb-1" placeholder="RequestedDate" id="RequestedDate" name="RequestedDate" autocomplete="off" />
                        </div>*@

                    <div class="col-md-12 col-lg-12 ">
                        <label>Client Query <span class="text-danger">*</span></label>
                        <textarea id="Message" class="form-control mb-1 " rows="4" name="Message" placeholder="Message"></textarea>
                    </div>
                    <div class="col-md-12 mt-2 text-right">
                        <input class="btn btn-success" value="Submit" onclick="SaveChemanalystTaxInvoice()" type="button" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" />
<link href="https://ajax.googleapis.com/ajax/libs/jqueryui/1.8/themes/base/jquery-ui.css" rel="Stylesheet" type="text/css" />
<link rel="stylesheet" type="text/css" href="~/css/jquery.datetimepicker.css" />

<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
<script defer src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/2.1.0/sweetalert.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-datetimepicker/2.5.20/jquery.datetimepicker.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.13/js/intlTelInput-jquery.min.js"></script>
<script>
    $(document).ready(function () {
        $("#RequestedDate").datepicker({ dateFormat: "dd/MM/yy" });
        GetCountry();
        $('#ContactNumber').on('input', function () {
            // Replace any non-digit character with an empty string
            $(this).val($(this).val().replace(/\D/g, ''));
        });

        $("#Telephone").intlTelInput({
            initialCountry: "in",
            separateDialCode: true


        });
        $("#ContactNumber").intlTelInput({
            initialCountry: "in",
            separateDialCode: true
        });

        $('.iti__flag').hide();
    });

    function GetCountry() {
        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/GetClintCountry",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            success: function (data) {

                var innerHTML = "";
                innerHTML += "<option  value = ''>" + "Select Country" + "</option>";
                $(data.DataList).each(function (index, value) {
                    if (value.CountryName != null || value.CountryName != "" || value.CountryName != undefined) {
                        innerHTML += "<option class='option01' value = '" + value.CountryID + "'> " + value.CountryName + "</option>"
                    }
                });

                $('#Country').html(innerHTML);
                $('#ClientCountryName').html(innerHTML);

            },
            failure: function (response) {
                console.log(response)
            },
            error: function (response) {
                console.log(response)
            }
        });
    }

    $("#Country").change(function () {
        var CountryName = $("#Country").val();
        if (CountryName == "1") {
            $("#DivState").show();
            GetStateDDL();
        } else {
            $("#DivState").hide();
        }

    });

    function GetStateDDL() {
        var Country = $("#Country").val();
        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/GetStateDDL",
            data: "{CountryID: '" + Country + "' }",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var StateNameHTML = '';

                $(response).each(function (index, value) {
                    if (value.StateName != null || value.StateName != "" || value.StateName != undefined) {
                        StateNameHTML += "<option class='option01' value = '" + value.StateId + "'> " + value.StateName + "</option>"
                    }
                });
                $('#State').html(StateNameHTML);
            },
            failure: function (response) { },
            error: function (response) { }
        });
    }
    function SaveChemanalystTaxInvoice() {
        debugger;
        var Name = $("#Name").val();
        var CorpEmail = $("#CorpEmail").val();

        var Contactcode = $("#ContactNumber").intlTelInput("getSelectedCountryData").dialCode;
        var Mobile = $("#ContactNumber").val();

        var ContactNumberno = Contactcode + Mobile;

        var Telecode = $("#Telephone").intlTelInput("getSelectedCountryData").dialCode;

        var Telephone = $("#Telephone").val();
        var TelephoneNO = Telecode + Telephone;


        var CompanyName = $("#CompanyName").val();
        var Designation = $("#Designation").val();
        var Country = $('#Country option:selected').text().trim();
        if (Country != "India") {
            var State = null;
        } else {
            var State = $('#State option:selected').text().trim();
        }

        var OutboundLeadSource = $("#OutboundLeadSource").val();
        //var LeadType = $("#LeadType").val("Outbound");
        var RequestedDate = $("#RequestedDate").val();
        var Message = $("#Message").val();
        var LeadType = $("#LeadType").val();



        var GetDetails = {
            Name: Name,
            CorpEmail: CorpEmail,
            Phone: Telephone,
            Organisation: CompanyName,
            Country: Country,
            State: State,
            OutboundLeadSource: OutboundLeadSource,
            LeadType: LeadType, //"Outbound",
            RequestedDate: RequestedDate,
            DiscriptionMessage: Message,
            Mobile: Mobile,
            Designation: Designation,
            ContactCountryCode: Contactcode,
            TelephoneCountryCode: Telecode
        }

        if (Name == "") {
            swal("Warning", "Please Insert Name", "error");
        }
        else if (CorpEmail == "") {
            swal("Warning", "Please Insert CorpEmail", "error");
        }
        else if (Mobile == "") {
            swal("Warning", "Please Insert ContactNumber", "error");
        }
        else if (CompanyName == "") {
            swal("Warning", "Please Insert CompanyName", "error");
        }
        else if ($('#Country').val() == "") {
            swal("Warning", "Please Insert CountryName", "error");
        }
        else if ((Country == "India") && (State == "")) {
            swal("Warning", "Please Insert StateName", "error");
        }
        else if (OutboundLeadSource == "") {
            swal("Warning", "Please Insert LeadSource", "error");
        }
        else if (LeadType == "") {
            swal("Warning", "Please Insert LeadType", "error");
        }
        else if (RequestedDate == "") {
            swal("Warning", "Please Insert RequestedDate", "error");
        }
        else if (Message == "") {
            swal("Warning", "Please Insert DiscriptionMessage", "error");
        }
        else if (Designation == "") {
            swal("Warning", "Please Insert Designation", "error");
        }
        else {
            $.ajax({
                type: "POST",
                url: "/LeadManagementSubscription/SaveOutboundLeadDetails",
                data: JSON.stringify(GetDetails),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    $(response).each(function (index, value) {
                        if (value.ValidationMessage == "SUCCESS") {
                            swal(
                                { title: "Thank you!", text: "Created Successfully.", type: "success" }).then(function () {
                                    window.location.reload();
                                });
                        }
                    });
                },
                failure: function (response) {
                    console.log(response)
                },
                error: function (response) {
                    console.log(response)
                }
            });

        }

    }


</script>