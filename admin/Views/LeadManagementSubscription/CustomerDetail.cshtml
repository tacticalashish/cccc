    function submitUploadDocument() {
        if (!currentCompanyId) return;

        var fileInput = document.getElementById('docFile');
        if (!fileInput.files || fileInput.files.length === 0) {
            $('#docUploadAlert').html('Please choose a file to upload.');
            return;
        }

        var formData = new FormData();
        formData.append('CompanyId', currentCompanyId);
        formData.append('DocumentType', $('#docType').val());
        formData.append('ReferenceNote', $('#docReferenceNote').val());
        formData.append('File', fileInput.files[0]);

        $('#docUploadBtn').prop('disabled', true).text('Uploading...');

        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/UploadCustomerDocument",
            data: formData,
            contentType: false,
            processData: false,
            success: function (response) {
                $('#docUploadBtn').prop('disabled', false).text('Upload');
                if (response && response.success) {
                    closeUploadDocumentModal();
                    loadDocuments();
                } else {
                    $('#docUploadAlert').html((response && response.message) ? response.message : 'Failed to upload document.');
