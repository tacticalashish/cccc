    // rounds a max value up to a "nice" number (1, 2, 2.5, 5, 10 x 10^n) so axis labels look clean
    function niceAxisMax(value) {
        if (value <= 0) return 5;
        var exponent = Math.floor(Math.log(value) / Math.LN10);
        var fraction = value / Math.pow(10, exponent);
        var niceFraction;
        if (fraction <= 1) niceFraction = 1;
        else if (fraction <= 2) niceFraction = 2;
        else if (fraction <= 5) niceFraction = 5;
        else niceFraction = 10;
        return niceFraction * Math.pow(10, exponent);
    }

    function renderUsageChart(rows) {
        var rawMax = 1;
        $(rows).each(function (i, r) { if (r.LoginCount > rawMax) rawMax = r.LoginCount; });
        var max = niceAxisMax(rawMax);

        var CHART_HEIGHT = 190;
        var BAR_AREA_HEIGHT = 168;
        var TICKS = 5; // number of intervals (6 labels: max down to 0)

        // y-axis labels, max down to 0, evenly spaced round numbers
        var axisHtml = '<div style="display:flex; flex-direction:column; justify-content:space-between; height:' + CHART_HEIGHT + 'px; padding-bottom:22px; font-size:10px; color:var(--text-soft) !important; text-align:right; flex-shrink:0; margin-right:10px;">';
        for (var i = TICKS; i >= 0; i--) {
            axisHtml += '<div style="line-height:1; color:var(--text-soft) !important;">' + Math.round(max * i / TICKS) + '</div>';
        }
        axisHtml += '</div>';

        // gridlines — thin horizontal lines at each tick, spanning the full plot width
        var gridHtml = '<div style="position:absolute; top:0; left:0; right:0; height:' + BAR_AREA_HEIGHT + 'px;">';
        for (var g = 0; g <= TICKS; g++) {
            var topPos = Math.round(BAR_AREA_HEIGHT * g / TICKS);
            gridHtml += '<div style="position:absolute; left:0; right:0; top:' + topPos + 'px; height:1px; background:var(--border);"></div>';
        }
        gridHtml += '</div>';

        // bars
        var barsHtml = '<div style="position:relative; flex:1; display:flex; align-items:flex-end; gap:14px; height:' + CHART_HEIGHT + 'px; border-left:1px solid var(--border); border-bottom:1px solid var(--border); padding:0 4px;">' + gridHtml;
        $(rows).each(function (i, r) {
            var barHeight = max > 0 ? Math.round(r.LoginCount / max * BAR_AREA_HEIGHT) : 0;
            barsHtml += '<div style="position:relative; z-index:1; flex:1; display:flex; flex-direction:column; align-items:center; justify-content:flex-end; height:100%;">' +
                '<div ' +
                'onmousemove="moveChartTooltip(event)" ' +
                'onmouseover="showChartTooltip(event, \'' + r.MonthLabel + ': ' + r.LoginCount + ' login(s)\'); this.style.background=\'#f58220\'" ' +
                'onmouseout="hideChartTooltip(); this.style.background=\'#1a4d2e\'" ' +
                'style="width:70%; max-width:46px; height:0px; background:#1a4d2e; border-radius:2px 2px 0 0; cursor:pointer; transition:height 0.5s ease, background 0.2s ease;" ' +
                'data-target-height="' + barHeight + '">' +
                '</div>' +
                '<div style="font-size:10.5px; color:var(--text-soft) !important; margin-top:6px;">' + r.MonthLabel + '</div>' +
                '</div>';
        });
        barsHtml += '</div>';

        $('#usgChartRoot').html('<div style="display:flex;">' + axisHtml + barsHtml + '</div>');

        // animate bars growing in on load (smooth transition, not instant jump)
        setTimeout(function () {
            $('#usgChartRoot [data-target-height]').each(function () {
                var h = $(this).attr('data-target-height');
                $(this).css('height', h + 'px');
            });
        }, 30);
    }

