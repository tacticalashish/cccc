    function SaveCustomer() {
        var chkbox = $("#chkprimary").prop('checked') ? 1 : 0;
        var Name = $("#Name").val();
        var Email = $("#Email").val();
        var Phone = $("#Phone").val();
        var ClientCompanyId = $("#ClientCompany").val();
        var Designation = $("#Designation").val();

        if (Name == "") {
            $("#Alert").html("Fill Name!");
        } else if (Email == "") {
            $("#Alert").html("Fill Email!");
        } else if (Phone == "") {
            $("#Alert").html("Fill Phone!");
        } else if (ClientCompanyId == "") {
            $("#Alert").html("Select Company!");
        } else {
            $.ajax({
                type: "POST",
                url: "/LeadManagementSubscription/InsertrecordinSAcustomer",
                data: {
                    Name: Name,
                    Email: Email,
                    Phone: Phone,
                    ClientCompanyId: ClientCompanyId,
                    chkboxPrimary: chkbox,
                    Designation: Designation
                },
                success: function (response) {
                    if (response == "Success") {
                        $("#Name").val('');
                        $("#Email").val('');
                        $("#Phone").val('');
                        $("#Designation").val('');
                        $("#chkprimary").prop('checked', false);
                        $("#Alert").html("Created!");
                        loadContacts(); // refresh the Contacts tab table on this page
                    } else {
                        $("#Alert").html(response);
                    }
                },
                error: function (response) {
                    console.log(response);
                }
            });
        }
    }

    function selectReminderType(type) {
        selectedReminderType = type;
        if (type === 'Call') {
            $('#btnTypeCall').css({ background: '#1a4d2e', color: '#fff', 'border-color': '#1a4d2e' });
            $('#btnTypeEmail').css({ background: '#f5f5f5', color: '#333', 'border-color': '#ccc' });
        } else {
            $('#btnTypeEmail').css({ background: '#1a4d2e', color: '#fff', 'border-color': '#1a4d2e' });
            $('#btnTypeCall').css({ background: '#f5f5f5', color: '#333', 'border-color': '#ccc' });
        }
    }

    var reminderSaving = false;
    function saveReminder() {
        if (reminderSaving) return;          // double-submit guard
        var note = $('#reminderNote').val();
        var date = $('#reminderDate').val();
        var time = $('#reminderTime').val();
        var showMyDay = $('#reminderShowMyDay').is(':checked');

        if (!note || !date) {
            alert('Please fill in what the reminder is for, and pick a date.');
            return;
        }

        reminderSaving = true;
        var $saveBtn = $('#reminderSaveBtn').prop('disabled', true);

        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/SaveReminder",
            data: {
                CompanyId: currentCompanyId,
                ReminderType: selectedReminderType,
                Note: note,
                ReminderDate: date,
                ReminderTime: time,
                ShowOnMyDay: showMyDay
            },
            success: function (response) {
                if (response.success) {
                    closeReminderModal();
                    loadReminders(currentCompanyId);
                } else {
                    alert('Could not save reminder: ' + response.message);
                }
            },
            error: function (response) {
                console.log(response);
                alert('Something went wrong saving the reminder.');
            },
            complete: function () {
                reminderSaving = false;
                $saveBtn.prop('disabled', false);
            }
        });
    }

    function loadReminders(companyId) {
        if (!companyId) return;
        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/GetRemindersByCompany",
            data: { companyId: companyId },
            success: function (response) {
                renderReminders(response);
            },
            error: function (response) {
                console.log(response);
                $('#remindersListBody').html('<div class="text-center text-muted-sm" style="padding:30px">Failed to load reminders.</div>');
            }
        });
    }

    function relativeDayLabel(dateStr) {
        var d = new Date(String(dateStr).split('T')[0] + 'T00:00:00');
        var today = new Date();
        today.setHours(0, 0, 0, 0);
        var diffDays = Math.round((d - today) / 86400000);

        if (diffDays === 0) return 'Today';
        if (diffDays === 1) return 'Tomorrow';
        if (diffDays < 0) return 'Overdue';
        return formatDate(dateStr);
    }

    function renderReminders(rows) {
        if (!rows || rows.length === 0) {
            $('#remindersListBody').html('<div class="text-center text-muted-sm" style="padding:30px">No reminders set for this account yet.</div>');
            return;
        }

        var html = '<div class="table-responsive"><table class="table" style="margin-bottom:0">';
        $(rows).each(function (i, r) {
            var icon = (r.ReminderType === 'Call') ? '&#128222;' : '&#9993;';
            var timeStr = r.ReminderTime ? (' &middot; ' + r.ReminderTime) : '';
            html += '<tr>' +
                '<td style="width:34px">' + icon + '</td>' +
                '<td><div><b>' + r.Note + '</b></div><div class="text-muted-sm">' + formatDate(r.ReminderDate) + timeStr + '</div></td>' +
                '<td class="text-right"><span class="pill-soft gray">' + relativeDayLabel(r.ReminderDate) + '</span></td>' +
                '</tr>';
        });
        html += '</table></div>';
        $('#remindersListBody').html(html);
    }
</script>
