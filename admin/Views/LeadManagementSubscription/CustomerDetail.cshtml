    function ticketStatusPill(status) {
        var s = (status || '').toLowerCase();
        if (s === 'open') return '<span class="pill-soft warn"><span class="dot-b"></span>Open</span>';
        if (s === 'resolved' || s === 'closed') return '<span class="pill-soft ok"><span class="dot-b"></span>' + status + '</span>';
        return '<span class="pill-soft gray"><span class="dot-b"></span>' + (status || 'Unknown') + '</span>';
    }

    function renderTicketsTable(rows) {
        var html = '';
        $(rows || []).each(function (i, t) {
            html += '<tr onclick="openTicketHistory(' + t.ID + ')" style="cursor:pointer">' +
                '<td>#TK-' + t.ID + '</td>' +
                '<td>' + (t.Subject || '') + '</td>' +
                '<td>' + (t.RoleName || '') + '</td>' +
                '<td>' + ticketStatusPill(t.Status) + '</td>' +
                '<td class="text-muted">' + (t.UpdatedDate || t.CreatedDate || '') + '</td>' +
                '</tr>';
        });
        $('#ticketsTableBody').html(html || '<tr><td colspan="4" class="text-center text-muted-sm" style="padding:20px">No tickets found</td></tr>');
    }

    function renderTicketsPaging(response) {
        var from = response.ShowingFrom;
        var to = response.ShowingTo;
        var total = response.RecordsCount;
        var active = response.ActivePage;
        var totalPages = response.NumberOfPages;

        $('#ticketsPagingInfo').text(total > 0 ? ('Showing ' + from + ' to ' + to + ' of ' + total + ' records') : 'No records');
        $('#ticketsCountLabel').text(total + ' ticket(s)');

        var html = '';
        html += '<li class="' + (active <= 1 ? 'disabled' : '') + '"><a href="javascript:;" onclick="goToTicketsPage(' + (active - 1) + ')">&laquo;</a></li>';

        var windowSize = 10;
        var startPage = Math.max(1, active - Math.floor(windowSize / 2));
        var endPage = Math.min(totalPages, startPage + windowSize - 1);
        startPage = Math.max(1, endPage - windowSize + 1);

        for (var p = startPage; p <= endPage; p++) {
            html += '<li class="' + (p === active ? 'active' : '') + '"><a href="javascript:;" onclick="goToTicketsPage(' + p + ')">' + p + '</a></li>';
        }
        html += '<li class="' + (active >= totalPages ? 'disabled' : '') + '"><a href="javascript:;" onclick="goToTicketsPage(' + (active + 1) + ')">&raquo;</a></li>';
        html += '<li class="' + (active >= totalPages ? 'disabled' : '') + '"><a href="javascript:;" onclick="goToTicketsPage(' + (active + 1) + ')" style="font-size:16px">&#8594;</a></li>';

        $('#ticketsPagingControls').html(html);
    }

