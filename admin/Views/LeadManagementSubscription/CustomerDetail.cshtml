<!-- "View feedback history" popup (Overview tab, Renewal & automated emails panel) -->
<div id="feedbackHistoryModal" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; z-index:999999; background:rgba(0,0,0,0.6);">
    <div style="background:#ffffff; max-width:560px; margin:60px auto; border-radius:8px; box-shadow:0 10px 40px rgba(0,0,0,0.5); font-family:Arial, sans-serif; overflow:hidden; max-height:75vh; display:flex; flex-direction:column;">
        <div style="padding:16px 20px; border-bottom:1px solid #e5e5e5; display:flex; align-items:center; background:#ffffff; flex:0 0 auto;">
            <h4 style="margin:0; color:#1a1a1a; font-size:18px; font-weight:bold;">Feedback history</h4>
            <span onclick="closeFeedbackHistoryModal()" style="margin-left:auto; cursor:pointer; font-size:22px; color:#999; line-height:1;">&times;</span>
        </div>
        <div id="feedbackHistoryModalBody" style="padding:20px; overflow-y:auto; flex:1 1 auto;"></div>
    </div>
</div>
<script>
    function getQueryParam(name) {
        var params = new URLSearchParams(window.location.search);
        return params.get(name);
    }

    function initials(name) {
        return (name || '').replace(/[^A-Za-z ]/g, '')
            .split(' ').filter(Boolean).slice(0, 2)
            .map(function (w) { return w[0]; }).join('').toUpperCase();
    }

    function formatDate(d) {
        if (!d) return '—';
        return String(d).split(' ')[0];
    }

    function dedupeModules(moduleStr) {
        if (!moduleStr) return '—';
        var parts = moduleStr.split(',').map(function (s) { return s.trim(); });
        var seen = {};
        var unique = [];
        parts.forEach(function (p) {
            if (p && !seen[p]) { seen[p] = true; unique.push(p); }
        });
        return unique.join(', ');
    }

    function statusPillHtml(status) {
        if ((status || '').toLowerCase() === 'active') {
            return '<span class="pill-soft ok"><span class="dot-b"></span>Active</span>';
        }
        return '<span class="pill-soft bad"><span class="dot-b"></span>Inactive</span>';
    }

    function healthPillHtml(health) {
        if (health === 'at_risk') return '<span class="pill-soft bad"><span class="dot-b"></span>At risk</span>';
        if (health === 'renewal_due') return '<span class="pill-soft warn"><span class="dot-b"></span>Renewal due</span>';
        return '<span class="pill-soft ok"><span class="dot-b"></span>Healthy</span>';
    }

    function apiLabel(api, apiStatus) {
        if (api !== 'API') return 'Not enabled';
        return (apiStatus === 'active') ? 'Enabled' : 'Enabled (inactive)';
    }

    $(document).ready(function () {
        // Robust tab switching (highlight + pane) — independent of Bootstrap's
        // own tab plugin, so the active underline always matches the shown pane.
        $('.nav-tabs a[data-toggle="tab"]').on('click', function (e) {
            e.preventDefault();
            var target = $(this).attr('href');
            $(this).closest('.nav-tabs').find('li').removeClass('active');
            $(this).closest('li').addClass('active');
            $('.tab-content > .tab-pane').removeClass('active in');
            $(target).addClass('active in');
        });

        var id = getQueryParam('id');
        if (!id) {
            $('#cdCompanyName').text('No customer selected');
            return;
        }
        // Show the "Open" button only when we arrived here from the Pipeline
        // "Open For Renewal" column (?fromRenewal=1). Lead abhi open nahi hui,
        // isliye Renew/extend tab tak disable rakho jab tak "Open" na ho.
        if (getQueryParam('fromRenewal') === '1') {
            $('#CustOpenBtn').show();
            $('#CustRenewBtn, .CustRenewBtn')
                .prop('disabled', true)
                .css({ 'opacity': 0.5, 'cursor': 'not-allowed' })
                .attr('title', 'Pehle "Open" karo, tab renewal shuru hogi');
        }
        GetCustomerDetailById(id);
    });

    // "Open" - inserts this company's renewal into SA_MaskEmailOpen_CRM so it
    // moves into the Pipeline "In discussion" column, then goes back there.
    function custOpenRenewal() {
        var id = getQueryParam('id');
        if (!id) { return; }
        $('#CustOpenBtn').prop('disabled', true);
        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/OpenRenewalCompany",
            data: { companyId: id }
        }).done(function (response) {
            if (response && response.Success) {
                if (window.swal) {
                    swal({ title: "Opened", text: "Moved to In discussion.", type: "success" }).then(function () {
                        window.location.href = "/LeadManagementSubscription/Pipeline";
                    });
                } else {
                    window.location.href = "/LeadManagementSubscription/Pipeline";
                }
            } else {
                $('#CustOpenBtn').prop('disabled', false);
                if (window.swal) { swal("Couldn't open", "Please try again.", "error"); }
            }
        }).fail(function () {
            $('#CustOpenBtn').prop('disabled', false);
            if (window.swal) { swal("Couldn't open", "Please try again.", "error"); }
        });
    }

    function GetCustomerDetailById(id) {
        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/GetCustomerDetailById",
            data: { id: id },
            success: function (r) {
                if (!r) { $('#cdCompanyName').text('Customer not found'); return; }
                renderCustomerDetail(r);
            },
            error: function (response) {
                console.log(response);
                $('#cdCompanyName').text('Failed to load customer');
            }
        });
    }

    function renderCustomerDetail(r) {
        currentCompanyId = r.ID || r.Id;
        currentCompanyHealth = r.Health;
        currentCompanyRenewsDate = r.RenewsDate;
        currentCompanyName = r.CompanyName;

        $('#cdAvatar').text(initials(r.CompanyName));
        $('#cdCompanyName').text(r.CompanyName);
        $('#cdContact').text(r.PrimaryContact);
        $('#cdEmail').text(r.FirstContactEmail);
        $('#cdStatusPill').html(statusPillHtml(r.Status));

        $('#cdModules').text(dedupeModules(r.ModuleName));
        $('#cdSeats').text(r.Activeseats != null ? r.Activeseats : '—');
        $('#cdApi').text(apiLabel(r.api, r.ApiStatus));
        $('#cdRenews').text(formatDate(r.RenewsDate));

        $('#cdSumCompany').text(r.CompanyName);
        $('#cdCSM').text(r.AssignedCSM || '—');
        $('#cdAnalyst').text(r.Assignedanalyst || '—');
        $('#cdHealthPill').html(healthPillHtml(r.Health));
        $('#cdLastLogin').text(formatDate(r.LastLogin));
        $('#cdCreated').text(formatDate(r.Created));

        $('#cdContactName2').html('<b>' + r.PrimaryContact + '</b>');
        $('#cdContactEmail2').text(r.FirstContactEmail);
        $('#cdSeatsLabel').text((r.Activeseats != null ? r.Activeseats : '0') + ' active seat(s)');

        $('#cdTermEnds').text(formatDate(r.Currenttermends));
        $('#cdRenewalStatus').html(healthPillHtml(r.Health));

        loadReminders(currentCompanyId);
        loadContacts();
        loadSubscriptions();
        loadUsage();
        loadTickets();
        loadProformaInvoices(r.CompanyName);
        // Quote panel payment terms fallback (amount/currency fill from latest proforma)
        $('#cdQuotePaymentTerms').text('To be set on invoice (PO Net 30/60 or advance)');
        loadDeliverables();
        loadRecommendations();
        loadDocuments();
        loadHistorySummary();
        loadRenewalFeedback();
        loadExpiryNotification();
    }

    // "Renew / extend" - hands off to the New Subscription wizard with this
    // company pre-selected, so the Contact step autofills the same way it
    // would if picked manually there (see PrefillCompanyId in
    // SalesManagement/CreateSubscription.cshtml). currentCompanyId is only
    // set once renderCustomerDetail() has run, hence the guard.
    function goToRenewSubscription() {
        // Lead open hone se pehle renewal allowed nahi
        if (getQueryParam('fromRenewal') === '1') {
            if (window.swal) { swal("Lead not opened", "Pehle 'Open' karke lead ko In-discussion me laao, phir renewal shuru hogi.", "info"); }
            return;
        }
        var url = '@Url.Action("CreateSubscription", "SalesManagement")';
        if (currentCompanyId) {
            url += '?companyId=' + currentCompanyId;
        }
        location.href = url;
    }

    /* ---------- expiry notifications toggle (Overview tab) ---------- */
    function toggleOnOffPillHtml(isOn) {
        return isOn
            ? '<span class="pill-soft ok"><span class="dot-b"></span>On</span>'
            : '<span class="pill-soft gray"><span class="dot-b"></span>Off</span>';
    }

    function loadExpiryNotification() {
        if (!currentCompanyId) return;

        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/GetExpiryNotificationStatus",
            data: { companyId: currentCompanyId },
            success: function (response) {
                var isEnabled = response && response.success ? response.isEnabled : false;
                renderExpiryNotificationCell(isEnabled);
            },
            error: function (e) {
                console.log(e);
                $('#cdExpiryNotification').text('—');
            }
        });
    }

    function renderExpiryNotificationCell(isEnabled) {
        $('#cdExpiryNotification').html(
            '<span class="toggle-switch' + (isEnabled ? ' on' : '') + '" onclick="toggleExpiryNotification(' + (!isEnabled) + ')" title="Click to turn ' + (isEnabled ? 'off' : 'on') + '">' +
            '<span class="toggle-track"></span><span class="toggle-knob"></span>' +
            '</span>' +
            '<span class="text-muted-sm" style="margin-left:8px">' + (isEnabled ? 'On' : 'Off') + '</span>'
        );
    }

    function toggleExpiryNotification(newValue) {
        if (!currentCompanyId) return;

        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/UpdateExpiryNotification",
            data: { companyId: currentCompanyId, isEnabled: newValue },
            success: function (response) {
                if (response && response.success) {
                    renderExpiryNotificationCell(newValue);
                } else {
                    alert('Failed to update: ' + (response && response.message ? response.message : 'unknown error'));
                }
            },
            error: function (e) {
                console.log(e);
                alert('Failed to update expiry notifications.');
            }
        });
    }

    /* ---------- renewal & automated emails (feedback) ---------- */
    function ratingPillHtml(rating) {
        if (rating === null || rating === undefined || rating === '') return '';
        var cls = rating >= 7 ? 'ok' : (rating >= 4 ? 'warn' : 'bad');
        return ' &middot; <span class="pill-soft ' + cls + '"><span class="dot-b"></span>' + rating + ' / 10</span>';
    }

    function loadRenewalFeedback() {
        if (!currentCompanyId) return;

        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/GetCompanyFeedbackSettings",
            data: { companyId: currentCompanyId },
            success: function (response) {
                if (!response || !response.success) {
                    $('#cdQuarterlyFeedback').text('—');
                    $('#cdNextFeedbackEmail').text('—');
                    $('#cdLastFeedback').text('—');
                    return;
                }

                renderQuarterlyFeedbackCell(!!response.QuarterlyFeedbackEnabled);
                $('#cdNextFeedbackEmail').text(response.NextFeedbackEmail || '—');

                if (response.LastFeedbackDate) {
                    $('#cdLastFeedback').html(response.LastFeedbackDate + ratingPillHtml(response.LastFeedbackRating));
                } else {
                    $('#cdLastFeedback').text('—');
                }

                $('#fbEnabled').prop('checked', !!response.QuarterlyFeedbackEnabled);
                $('#fbNextFeedbackEmail').val(toInputDate(response.NextFeedbackEmail));
                $('#fbLastFeedbackDate').val(toInputDate(response.LastFeedbackDate));
                $('#fbLastFeedbackRating').val(response.LastFeedbackRating != null ? response.LastFeedbackRating : '');
                $('#fbNotes').val(response.Notes || '');
            },
            error: function (e) {
                console.log(e);
                $('#cdQuarterlyFeedback').text('—');
                $('#cdNextFeedbackEmail').text('—');
                $('#cdLastFeedback').text('—');
            }
        });
    }

    function renderQuarterlyFeedbackCell(isEnabled) {
        $('#cdQuarterlyFeedback').html(
            '<span class="toggle-switch' + (isEnabled ? ' on' : '') + '" onclick="toggleQuarterlyFeedbackClick(' + (!isEnabled) + ')" title="Click to turn ' + (isEnabled ? 'off' : 'on') + '">' +
            '<span class="toggle-track"></span><span class="toggle-knob"></span>' +
            '</span>' +
            '<span class="text-muted-sm" style="margin-left:8px">' + (isEnabled ? 'On' : 'Off') + ' &middot; every 3 months from start</span>'
        );
    }

    function toggleQuarterlyFeedbackClick(newValue) {
        if (!currentCompanyId) return;

        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/ToggleQuarterlyFeedback",
            data: { companyId: currentCompanyId, enabled: newValue },
            success: function (response) {
                if (response && response.success) {
                    renderQuarterlyFeedbackCell(newValue);
                    $('#fbEnabled').prop('checked', newValue);
                } else {
                    alert('Failed to update: ' + (response && response.message ? response.message : 'unknown error'));
                }
            },
            error: function (e) {
                console.log(e);
                alert('Failed to update quarterly feedback email.');
            }
        });
    }

    function toInputDate(displayDate) {
        // converts "dd MMM yyyy" (as sent by the controller) to yyyy-MM-dd for <input type="date">
        if (!displayDate) return '';
        var d = new Date(displayDate);
        if (isNaN(d.getTime())) return '';
        var mm = ('0' + (d.getMonth() + 1)).slice(-2);
        var dd = ('0' + d.getDate()).slice(-2);
        return d.getFullYear() + '-' + mm + '-' + dd;
    }

    function openFeedbackEditModal() {
        $('#fbAlert').text('');
        $('#feedbackEditModal').css('display', 'block');
    }

    function closeFeedbackEditModal() {
        $('#feedbackEditModal').css('display', 'none');
    }

    function saveFeedbackEntry() {
        if (!currentCompanyId) return;

        $('#fbSaveBtn').prop('disabled', true);
        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/SaveCompanyFeedbackEntry",
            data: {
                companyId: currentCompanyId,
                enabled: $('#fbEnabled').is(':checked'),
                nextFeedbackEmail: $('#fbNextFeedbackEmail').val(),
                lastFeedbackDate: $('#fbLastFeedbackDate').val(),
                lastFeedbackRating: $('#fbLastFeedbackRating').val() || null,
                notes: $('#fbNotes').val()
            },
            success: function (response) {
                $('#fbSaveBtn').prop('disabled', false);
                if (response && response.success) {
                    $('#fbNotes').val('');
                    closeFeedbackEditModal();
                    loadRenewalFeedback();
                } else {
                    $('#fbAlert').text('Failed to save: ' + (response && response.message ? response.message : 'unknown error'));
                }
            },
            error: function (e) {
                console.log(e);
                $('#fbSaveBtn').prop('disabled', false);
                $('#fbAlert').text('Failed to save feedback settings.');
            }
        });
    }

    function openFeedbackHistoryModal() {
        if (!currentCompanyId) return;

        $('#feedbackHistoryModalBody').html('<p class="text-muted-sm">Loading...</p>');
        $('#feedbackHistoryModal').css('display', 'block');

        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/GetCompanyFeedbackHistory",
            data: { companyId: currentCompanyId },
            success: function (response) {
                var list = response && response.success ? (response.DataList || []) : [];
                if (!list.length) {
                    $('#feedbackHistoryModalBody').html('<p class="text-muted-sm">No feedback recorded yet.</p>');
                    return;
                }

                var html = '<table class="table detail-table" style="margin-bottom:0">' +
