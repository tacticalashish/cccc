    /* ==============================================================
       Deliverables tab — backed by USP_GetDeliverablesByCompany via
       /LeadManagementSubscription/GetDeliverablesByCompany
       ============================================================== */

    var delivCurrentPage = 1;
    var delivIsLoading = false;

    function loadDeliverables() {
        if (!currentCompanyId) return;
        if (delivIsLoading) return;

        delivIsLoading = true;
        $('#delivLoadingOverlay').css('display', 'block');

        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/GetDeliverablesByCompany",
            data: {
                Id: currentCompanyId,
                PageNumber: delivCurrentPage
            },
            success: function (response) {
                console.log('DEBUG deliverables response:', response);
                if (response && response.error) {
                    $('#delivTableBody').html('<tr><td colspan="5" class="text-center text-danger" style="padding:20px">Error: ' + response.message + '</td></tr>');
                    return;
                }
                renderDeliverablesTable(response.DateList);
                renderDeliverablesPaging(response);
            },
            error: function (e) {
                console.log(e);
                $('#delivTableBody').html('<tr><td colspan="5" class="text-center text-muted-sm" style="padding:20px">Failed to load deliverables.</td></tr>');
            },
            complete: function () {
                delivIsLoading = false;
                $('#delivLoadingOverlay').css('display', 'none');
            }
        });
    }

    function renderDeliverablesTable(rows) {
        var path = "/WorkSpaceFile/";
        var tbodyHTML = '';
        $(rows || []).each(function (idx, elm) {
            tbodyHTML += "<tr>";
            tbodyHTML += "<td>" + elm.Email + "</td>";
            tbodyHTML += "<td>" + elm.Name + "</td>";
            tbodyHTML += "<td>" + "<a target='_blank' href='/AdminChemicalPricing/DownloadFile?filePath=" + path + "/" + elm.FileName + "&fileName=" + elm.FileName + "'>" + elm.FileName + "</a>" + "</td>";
            tbodyHTML += "<td>" + (elm.CreatedDate || '') + "</td>";
            tbodyHTML += "<td>" + (elm.CreatedBy || '') + "</td>";
            tbodyHTML += "</tr>";
        });
        $('#delivTableBody').html(tbodyHTML || '<tr><td colspan="5" class="text-center text-muted-sm" style="padding:20px">No deliverables found</td></tr>');
    }

    function renderDeliverablesPaging(response) {
        $('#delivCountLabel').text((response.RecordsCount || 0) + ' file(s)');
        $('#delivPagingInfo').html(GetPaginationHTML(response));
    }

    // GetPagination() hardcodes calling a function named "PaggingButton" in its
    // generated onclick — this drives our SP-backed page reload.
    function PaggingButton(elm) {
        var pageNumber = elm.attr('url');
        delivCurrentPage = parseInt(pageNumber, 10);
        loadDeliverables();
    }

    function GetPaginationHTML(json) {
        var pagingInnerHTML = "<span style='color:var(--text-soft);font-size:12px'>Showing " + json.ShowingFrom + " to " + json.ShowingTo + " of " + json.RecordsCount + " records</span>";
        // note: controller returns "PageSize" (not "PagerSize")
        var getPaginationButton = GetPagination(json.ActivePage, json.PageSize, json.NumberOfPages, "");
        pagingInnerHTML += getPaginationButton;
        return pagingInnerHTML;
    }

    function GetPagination(activePage, pagerSize, numberOfPages, URL) {
        var innerHTML = '';
        var startLi = pagerSize / pagerSize;
        var endLi = pagerSize;
        var multiplier = activePage / pagerSize;
        var modulo = activePage % pagerSize;
        var virtualLi = pagerSize - pagerSize;
        var previous = activePage / pagerSize * pagerSize - pagerSize + 1;
        var next = activePage / pagerSize * pagerSize + pagerSize + 1;

        if (modulo == 0) {
            next = next - pagerSize;
            previous = previous - pagerSize;
        }

        if (activePage > pagerSize) {
            for (var i = 1; i <= multiplier; i++) {
                virtualLi += pagerSize;
            }
            if (modulo > 0) {
                startLi = virtualLi + 1;
            } else {
                startLi = virtualLi - pagerSize + 1;
            }
            endLi = startLi + pagerSize - 1;
        }

        innerHTML = "<ul class='pagination pagination-sm no-margin pull-right' style='margin:0'>";
        if (activePage > 1 && activePage < pagerSize + 1) {
            if (activePage == 1) {
                innerHTML += "<li class='paginate_button previous disabled'><a href='javascript:void(0);'>&laquo;</a></li>";
            } else {
                innerHTML += "<li class='paginate_button previous'><a href='javascript:void(0);' url='" + URL + (activePage - 1) + "' onclick='PaggingButton($(this));'>&laquo;</a></li>";
            }
        } else if (activePage == 1) {
            innerHTML += "<li class='paginate_button previous disabled'><a href='javascript:void(0);'>&laquo;</a></li>";
        } else {
            innerHTML += "<li class='paginate_button previous'><a href='javascript:void(0);' url='" + URL + (previous) + "' onclick='PaggingButton($(this));'>&laquo;</a></li>";
            innerHTML += "<li class='paginate_button previous'><a href='javascript:void(0);' url='" + URL + (activePage - 1) + "' onclick='PaggingButton($(this));'>&laquo;</a></li>";
        }

        for (var i = startLi; i <= endLi && i <= numberOfPages; i++) {
            if (i == activePage) {
                innerHTML += "<li><a style='background-color:var(--green);color:#fff;' href='javascript:void(0);'>" + i + "</a></li>";
            } else {
                innerHTML += "<li class='paginate_button'><a onclick='PaggingButton($(this));' href='javascript:void(0);' url='" + URL + i + "'>" + i + "</a></li>";
            }
        }

        if (activePage == numberOfPages) {
            innerHTML += "<li class='paginate_button next disabled'><a href='javascript:void(0);'>&raquo;</a></li>";
        } else {
            innerHTML += "<li class='paginate_button next'><a href='javascript:void(0);' url='" + URL + (activePage + 1) + "' onclick='PaggingButton($(this));'>&raquo;</a></li>";
        }

        innerHTML += "</ul>";
        return innerHTML;
    }
