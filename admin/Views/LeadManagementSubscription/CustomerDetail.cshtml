            <button type="button" onclick="closeFeedbackEditModal()"
                    style="padding:8px 16px; border-radius:4px; border:1px solid #ccc; background:#fff; color:#333; cursor:pointer; margin-right:8px; font-size:13px;">
                Cancel
            </button>
            <button type="button" id="fbSaveBtn" onclick="saveFeedbackEntry()"
                    style="padding:8px 16px; border-radius:4px; border:none; background:#1a4d2e; color:#fff; cursor:pointer; font-size:13px;">
