<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.js"></script>
<script>
    $.formattedDate = function (dateToFormat) {
        var dateObject = new Date(dateToFormat);
        var day = dateObject.getDate();
        var month = dateObject.toLocaleString('default', { month: 'long' });
        var year = dateObject.getFullYear();
        return day + " " + month + " " + year;
    };

    function PopupInvoice(InvoiceID) {
        $.ajax({
            type: "POST",
            url: "/Invoice/BindProformaInvoiceDetailsByid",
            data: { InvoiceId: InvoiceID },
            success: function (response) {
                $(response).each(function (index, value) {
                    $("#pdfAccountNo").text('');
                    $("#pdfSWIFTCode").text('');
                    $("#pdfAccountName").text('');
                    $("#pdfBankName").text('');
                    $("#pdfBankAdd").text('');
                    var date = value.InvoiceDate;
                    var formattedDate = ($.formattedDate(new Date(parseInt(date.substr(6)))));

                    $("#pdfCountry").text(value.Country);
                    $("#pdfInvoiceDate").text(formattedDate);
                    $("#pdfReverseCharge").text(value.ReverseCharge);
                    $("#pdfPO").text(value.PO);
                    $("#pdfKindAttn").text(value.KindAttn);
