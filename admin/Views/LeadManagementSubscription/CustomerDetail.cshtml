<div id="feedbackEditModal" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; z-index:999999; background:rgba(0,0,0,0.6);">
    <div style="background:#ffffff; max-width:460px; margin:60px auto; border-radius:8px; box-shadow:0 10px 40px rgba(0,0,0,0.5); font-family:Arial, sans-serif; overflow:hidden;">
        <div style="padding:16px 20px; border-bottom:1px solid #e5e5e5; display:flex; align-items:center; background:#ffffff;">
            <h4 style="margin:0; color:#1a1a1a; font-size:18px; font-weight:bold;">Edit feedback settings</h4>
            <span onclick="closeFeedbackEditModal()" style="margin-left:auto; cursor:pointer; font-size:22px; color:#999; line-height:1;">&times;</span>
        </div>
        <div style="padding:20px; background:#ffffff;">
            @*<label style="color:#1a1a1a; font-size:13px;">
                <input type="checkbox" id="fbEnabled" style="margin-right:6px;">
                Quarterly feedback email <span class="text-muted-sm">(every 3 months from start)</span>
