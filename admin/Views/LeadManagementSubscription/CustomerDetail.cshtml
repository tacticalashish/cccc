<!-- Set Reminder popup — fully custom, ALL styles inline (no Bootstrap modal, no external CSS dependency at all) -->
<div id="reminderModal" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; z-index:999999; background:rgba(0,0,0,0.6);">
    <div style="background:#ffffff; max-width:460px; margin:60px auto; border-radius:8px; box-shadow:0 10px 40px rgba(0,0,0,0.5); font-family:Arial, sans-serif; overflow:hidden;">
        <div style="padding:16px 20px; border-bottom:1px solid #e5e5e5; display:flex; align-items:center; background:#ffffff;">
            <h4 style="margin:0; color:#1a1a1a; font-size:18px; font-weight:bold;">Set a reminder</h4>
            <span onclick="closeReminderModal()" style="margin-left:auto; cursor:pointer; font-size:22px; color:#999; line-height:1;">&times;</span>
        </div>
        <div style="padding:20px; background:#ffffff;">
            <div style="margin-bottom:15px;">
                <label style="display:block; color:#1a1a1a; font-weight:bold; margin-bottom:6px; font-size:13px;">Reminder type</label>
                <div style="display:flex; gap:8px;">
                    <button type="button" id="btnTypeCall" onclick="selectReminderType('Call')"
                            style="flex:1; padding:8px; border-radius:4px; border:1px solid #1a4d2e; background:#1a4d2e; color:#fff; cursor:pointer; font-size:13px;">
                        &#128222; Call
                    </button>
                    <button type="button" id="btnTypeEmail" onclick="selectReminderType('Email')"
                            style="flex:1; padding:8px; border-radius:4px; border:1px solid #ccc; background:#f5f5f5; color:#333; cursor:pointer; font-size:13px;">
                        &#9993; Email
                    </button>
                </div>
            </div>
            <div style="margin-bottom:15px;">
                <label style="display:block; color:#1a1a1a; font-weight:bold; margin-bottom:6px; font-size:13px;">What's it for?</label>
                <input type="text" id="reminderNote" placeholder="e.g. Follow up on renewal"
                       style="width:100%; box-sizing:border-box; padding:8px 10px; border:1px solid #ccc; border-radius:4px; color:#1a1a1a; background:#fff; font-size:13px;">
            </div>
            <div style="margin-bottom:15px;">
                <label style="display:block; color:#1a1a1a; font-weight:bold; margin-bottom:6px; font-size:13px;">Date</label>
                <input type="date" id="reminderDate"
                       style="width:100%; box-sizing:border-box; padding:8px 10px; border:1px solid #ccc; border-radius:4px; color:#1a1a1a; background:#fff; font-size:13px;">
            </div>
            <div style="margin-bottom:15px;">
                <label style="display:block; color:#1a1a1a; font-weight:bold; margin-bottom:6px; font-size:13px;">Time <span style="font-weight:normal; color:#888;">optional</span></label>
                <input type="time" id="reminderTime"
                       style="width:100%; box-sizing:border-box; padding:8px 10px; border:1px solid #ccc; border-radius:4px; color:#1a1a1a; background:#fff; font-size:13px;">
            </div>
            <div style="margin-bottom:5px;">
                <label style="color:#1a1a1a; font-size:13px;">
                    <input type="checkbox" id="reminderShowMyDay" checked style="margin-right:6px;">
                    Show on my My Day page that morning
                </label>
            </div>
        </div>
        <div style="padding:15px 20px; border-top:1px solid #e5e5e5; text-align:right; background:#fafafa;">
            <button type="button" onclick="closeReminderModal()"
                    style="padding:8px 16px; border-radius:4px; border:1px solid #ccc; background:#fff; color:#333; cursor:pointer; margin-right:8px; font-size:13px;">
                Cancel
            </button>
            <button type="button" id="reminderSaveBtn" onclick="saveReminder()"
                    style="padding:8px 16px; border-radius:4px; border:none; background:#1a4d2e; color:#fff; cursor:pointer; font-size:13px;">
