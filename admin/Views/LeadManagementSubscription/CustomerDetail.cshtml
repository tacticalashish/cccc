        $(rows).each(function (i, h) {
            var allProducts = (h.ProductsSubscribed || '')
                .split(',')
                .map(function (p) { return p.trim(); })
                .filter(function (p) { return p.length > 0; });
            subHistoryProductsByRow[i] = allProducts;

            var visibleCount = 4;
            var visibleText = allProducts.slice(0, visibleCount).join(', ');
            var remaining = allProducts.length - visibleCount;

            var productsCell = allProducts.length === 0
                ? '—'
                : visibleText + (remaining > 0
                    ? ' <a href="javascript:;" onclick="openProductListModal(' + i + ')">&hellip; (+' + remaining + ' more)</a>'
                    : '');

            var statusPill = h.Status === 'Active'
                ? '<span class="pill-soft info"><span class="dot-b"></span>Active</span>'
                : '<span class="pill-soft ok"><span class="dot-b"></span>' + (h.Status || 'Renewed') + '</span>';

            html += '<tr>' +
                '<td>' + h.Term + '</td>' +
                '<td>' + productsCell + '</td>' +
                '<td>' + (h.Users != null ? h.Users : '—') + '</td>' +
                '<td>—</td>' +
                '<td>' + statusPill + '</td>' +
                '</tr>';
        });
