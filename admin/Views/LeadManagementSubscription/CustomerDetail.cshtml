    function daysUntil(dateStr) {
        if (!dateStr) return null;
        var target = new Date(String(dateStr).split(' ')[0] + 'T00:00:00');
        var today = new Date();
        today.setHours(0, 0, 0, 0);
        return Math.round((target - today) / 86400000);
    }

    function renderRecommendations(s) {
        var cards = [];

        // 1) Cross-sell — top-viewed disruption product not yet subscribed as a priced product
        if (s.TopDisruptionProduct && !s.AlreadySubscribed) {
            cards.push({
                cls: '', icon: '&#8593;', badge: 'ok', badgeText: 'Cross-sell opportunity',
                title: 'Add ' + s.TopDisruptionProduct + ' pricing to their plan',
                body: 'They view the <b>' + s.TopDisruptionProduct + '</b> disruption tracker heavily (' + s.TopDisruptionViews + ' views, last 90 days), but don\'t subscribe to pricing for it. Clear intent — low-friction expansion.',
                actionLabel: 'Propose add-on',
                impact: 'Potential upsell'
            });
        }

        // 2) Adoption risk — unused seats / inactive users
        var unusedSeats = (s.TotalSeats || 0) - (s.ActiveSeats || 0);
        if (unusedSeats > 0 || (s.InactiveDays && s.InactiveDays > 30)) {
            var body = '';
            if (unusedSeats > 0) {
                body += 'Only <b>' + s.ActiveSeats + '</b> of <b>' + s.TotalSeats + '</b> seats are active. ';
            }
            if (s.InactiveUserName && s.InactiveDays != null) {
                body += '<b>' + s.InactiveUserName + '</b> hasn\'t logged in for <b>' + s.InactiveDays + ' days</b>. ';
            }
            body += 'Low adoption is the #1 predictor of non-renewal.';
            cards.push({
                cls: 'warn', icon: '&#9201;', badge: 'warn', badgeText: 'Adoption risk',
                title: unusedSeats + ' of ' + s.TotalSeats + ' seats unused — drive activation',
                body: body,
                actionLabel: 'Re-engage unused users',
                impact: 'Protects renewal'
            });
        }

        // 3) Renewal timing — reuses already-loaded company health/renewal date, no ₹ value
        var daysToRenewal = daysUntil(currentCompanyRenewsDate);
        if (currentCompanyHealth === 'renewal_due' || (daysToRenewal !== null && daysToRenewal >= 0 && daysToRenewal <= 100)) {
            cards.push({
                cls: 'bad', icon: '&#8635;', badge: 'bad', badgeText: 'Renewal timing',
                title: 'Start the renewal conversation now' + (daysToRenewal !== null ? ' (' + daysToRenewal + ' days out)' : ''),
                body: 'This account renews on <b>' + formatDate(currentCompanyRenewsDate) + '</b>. Accounts engaged ~90 days early renew on time far more often than last-minute ones.',
                actionLabel: 'Set renewal reminder',
                impact: 'On-time renewal'
            });
        }

        // 4) Open tickets backlog
        if (s.OpenTicketCount > 0) {
            cards.push({
                cls: 'info', icon: '&#9993;', badge: 'info', badgeText: 'Support backlog',
                title: s.OpenTicketCount + ' ticket(s) open' + (s.OldestOpenTicketDays ? ', oldest waiting ' + s.OldestOpenTicketDays + ' day(s)' : ''),
                body: 'Unresolved tickets left open too long are a common churn signal. Worth a quick check-in with the support team.',
                actionLabel: 'View tickets',
                impact: 'Reduces churn risk'
            });
        }

        // 5) No recent deliverables sent
        if (s.DaysSinceLastDeliverable == null || s.DaysSinceLastDeliverable > 60) {
            cards.push({
                cls: 'warn', icon: '&#128203;', badge: 'warn', badgeText: 'Engagement gap',
                title: s.DaysSinceLastDeliverable == null ? 'No reports sent yet' : 'No report sent in ' + s.DaysSinceLastDeliverable + '+ days',
                body: 'Regular deliverables keep the value of the subscription visible. It may be time to send a fresh report or market update.',
                actionLabel: 'Upload report',
                impact: 'Keeps value visible'
            });
        }

        // 6) Login trend declining
        if (s.LoginsThisMonth != null && s.LoginsLastMonth != null && s.LoginsLastMonth > 0 && s.LoginsThisMonth < s.LoginsLastMonth * 0.7) {
            var pctDrop = Math.round((1 - (s.LoginsThisMonth / s.LoginsLastMonth)) * 100);
            cards.push({
                cls: 'bad', icon: '&#8595;', badge: 'bad', badgeText: 'Usage decline',
                title: 'Logins down ' + pctDrop + '% vs the previous 30 days',
                body: '<b>' + s.LoginsThisMonth + '</b> logins in the last 30 days, down from <b>' + s.LoginsLastMonth + '</b> before that. Worth checking in before it becomes a renewal risk.',
                actionLabel: 'Set reminder',
                impact: 'Early warning'
            });
        }

        // 7) Stale reminders
        if (s.StaleReminderCount > 0) {
            cards.push({
                cls: 'gray', icon: '&#9200;', badge: 'gray', badgeText: 'Follow-up overdue',
                title: s.StaleReminderCount + ' reminder(s) overdue on this account',
                body: 'There are reminders set for this account whose date has passed without being marked done — worth a quick review.',
                actionLabel: 'View reminders',
                impact: 'Nothing falls through'
            });
        }

        if (cards.length === 0) {
            $('#recsBody').html('<div class="text-center text-muted-sm" style="padding:40px">No active recommendations for this account right now.</div>');
            return;
        }

        var html = '';
        $(cards).each(function (i, c) {
            html += '<div class="rec-card ' + c.cls + '">' +
                '<div class="d-flex align-center gap-2 mb-2">' +
                '<span style="font-size:18px">' + c.icon + '</span>' +
                '<h6 style="margin:0;font-weight:bold">' + c.title + '</h6>' +
                '<span class="pill-soft ' + c.badge + ' ml-auto"><span class="dot-b"></span>' + c.badgeText + '</span>' +
                '</div>' +
                '<div class="text-muted-sm" style="font-size:13px">' + c.body + '</div>' +
                '<div class="d-flex align-center gap-3 mt-3">' +
                '<button class="btn btn-sm" style="background:var(--green);color:#fff">' + c.actionLabel + '</button>' +
                '<span class="text-muted-sm" style="cursor:pointer">Dismiss</span>' +
                '<span class="text-muted-sm ml-auto">Impact &middot; ' + c.impact + '</span>' +
                '</div>' +
                '</div>';
        });
        $('#recsBody').html(html);
    }

