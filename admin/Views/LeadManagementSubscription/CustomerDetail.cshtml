    function renderLoginHistoryPager(activePage, numberOfPages) {
        if (!numberOfPages || numberOfPages <= 1) { $('#loginHistoryPager').html(''); return; }
        var btn = function (label, page, disabled, active) {
            var style = 'border:1px solid #e2e4e8; background:' + (active ? '#1f5a37' : '#fff') + '; color:' + (active ? '#fff' : '#33383f') + '; border-radius:5px; min-width:26px; height:26px; padding:0 6px; font-size:12px; cursor:' + (disabled ? 'not-allowed' : 'pointer') + '; opacity:' + (disabled ? '.4' : '1') + ';';
            return '<button type="button" ' + (disabled ? 'disabled' : 'onclick="goToLoginHistoryPage(' + page + ')"') + ' style="' + style + '">' + label + '</button>';
        };
        var html = btn('&laquo;', activePage - 1, activePage <= 1, false);
        var start = Math.max(1, activePage - 2), end = Math.min(numberOfPages, activePage + 2);
        for (var p = start; p <= end; p++) html += btn(p, p, false, p === activePage);
        html += btn('&raquo;', activePage + 1, activePage >= numberOfPages, false);
        $('#loginHistoryPager').html(html);
    }

