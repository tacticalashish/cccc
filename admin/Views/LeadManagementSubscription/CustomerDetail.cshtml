            <input type="date" id="fbLastFeedbackDate" class="form-control" style="margin-bottom:15px" />

            <label style="display:block; margin-bottom:6px; color:var(--text-soft); font-size:12px; text-transform:uppercase; letter-spacing:.02em;">Last feedback rating <span style="text-transform:none; font-style:italic;">0-10</span></label>
            <input type="number" id="fbLastFeedbackRating" class="form-control" min="0" max="10" style="margin-bottom:15px" />

            <label style="display:block; margin-bottom:6px; color:var(--text-soft); font-size:12px; text-transform:uppercase; letter-spacing:.02em;">Notes <span style="text-transform:none; font-style:italic;">optional</span></label>
            <textarea id="fbNotes" class="form-control" rows="3" style="margin-bottom:5px; resize:vertical;" placeholder="Comments from the customer's last feedback response..."></textarea>
            <p class="text-danger" id="fbAlert" style="margin:10px 0 0"></p>
