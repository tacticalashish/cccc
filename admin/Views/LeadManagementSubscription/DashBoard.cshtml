    // How many of STEP_ORDER (Sales, Operation, Finance, Dept Head, Login
    // active) are complete for a given subscription-request status.
    // Convert Lead_Master.StepCounter into completed-step count (0..5).
    // Returns -1 when the value isn't a known step so the caller can fall back.
    function ApsDoneFromStepCounter(sc) {
        sc = parseInt(sc, 10);
        if (isNaN(sc)) return -1;
        if (sc === 20) return 1;   // Disapproved from Operation  -> Sales done
        if (sc === 30) return 2;   // Disapproved from Accounts   -> Sales+Operation done
        if (sc === 40) return 3;   // Disapproved from Sales Mgr  -> +Finance done
        if (sc >= 1 && sc <= 5) return sc;  // 1..5 pending/created
        return -1;
    }

    function ApsCompletedStepCount(status) {
        var s = (status || "").toLowerCase();
        if (s.indexOf("created") !== -1 || s.indexOf("approved") !== -1) return 5;
        if (s.indexOf("dept") !== -1) return 3;
        if (s.indexOf("finance") !== -1) return 2;
        if (s.indexOf("operation") !== -1) return 1;
        return 1;
    }

    function ApsFmtDate(value) {
        if (!value) return "";
        var s = String(value);
        var m = /\/Date\((-?\d+)\)\//.exec(s);
        var d = m ? new Date(parseInt(m[1], 10)) : new Date(s.indexOf("T") === -1 ? s.replace(" ", "T") : s);
        if (isNaN(d.getTime())) return "";
        var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        return d.getDate() + " " + months[d.getMonth()] + " " + d.getFullYear();
    }

    function ApsToPipelineRows(list) {
        var STEPS = ["Sales", "Operation", "Finance", "Dept Head", "Login active"];
        var rows = [];
        for (var i = 0; i < list.length; i++) {
            var it = list[i];
            // Map the real StepCounter to how many of the 5 steps are DONE.
            // Pending: 1=>1(Sales done, Operation pending) ... 5=>5(all done).
            // Disapproved: 20=>1, 30=>2, 40=>3 (step before the rejection is done).
            var done = ApsDoneFromStepCounter(it.StepCounter);
            if (done < 0) { done = ApsCompletedStepCount(it.SalesIndexStatus); }
            var company = it.CompanyName || ("Request " + (it.RequestNumber || (i + 1)));
            // Company details shown under the name in the timeline header.
            var detailParts = [];
            if (it.PrimaryContactName) detailParts.push(it.PrimaryContactName);
            if (it.PackageSummary) detailParts.push(it.PackageSummary);
            if (it.CoverageSummary) detailParts.push(it.CoverageSummary);
            var received = ApsFmtDate(it.RequestCreatedDate);
            if (received) detailParts.push("received " + received);
            var detail = detailParts.join(" \u00B7 ");
            var isRenew = (it.Renew || "").toString().toLowerCase().indexOf("renew") !== -1;
            for (var j = 0; j < done; j++) {
                rows.push({
                    CompanyName: company,
                    LeadStatus: STEPS[j],
                    CreatedBy: it.CSM || it.PrimaryContactName || "Sales",
                    CreatedDate: it.RequestCreatedDate,
                    Detail: detail,
                    Renew: isRenew
                });
            }
        }
        return rows;
    }

    function renderApprovalPipeline(rows) {
        // group rows by CompanyName -> { LeadStatus: { by, date } }
        var companies = {};
        $(rows || []).each(function (i, r) {
            if (!companies[r.CompanyName]) companies[r.CompanyName] = {};
            companies[r.CompanyName][r.LeadStatus] = { by: r.CreatedBy, date: r.CreatedDate };
            if (r.Detail && !companies[r.CompanyName]._detail) {
                companies[r.CompanyName]._detail = r.Detail;
            }
            if (r.Renew) { companies[r.CompanyName]._renew = true; }
        });

        var html = '';
        var pendingCount = 0;
        var rendered = 0;

        $.each(companies, function (companyName, stepData) {
            // Only the top 10 accounts are shown here.
            if (rendered >= 10) { return false; }
            rendered++;
            // last step that HAS data = last completed step
            var lastDoneIdx = -1;
            for (var i = 0; i < STEP_ORDER.length; i++) {
                if (stepData[STEP_ORDER[i]]) lastDoneIdx = i;
            }
            var curIdx = lastDoneIdx + 1; // next step = current/pending

            if (curIdx < STEP_ORDER.length) pendingCount++;

            var headerBadge;
            if (curIdx >= STEP_ORDER.length) {
                headerBadge = '<span class="pill-soft ok ml-auto"><span class="dot-b"></span>Ready — create logins</span>';
            } else {
                headerBadge = '<span class="pill-soft warn ml-auto"><span class="dot-b"></span>Awaiting ' + STEP_ORDER[curIdx] + ' approval</span>';
            }

            // Company details (contact / package / coverage / received) under
            // the name; the per-step name/date stays removed.
            var subLine = stepData._detail || '';

            // Renewal accounts are tinted blue + tagged "Renewal"; brand-new
            // accounts are tinted green + tagged "New", so the two stand apart.
            var isRenew = !!stepData._renew;

            var stepsHtml = '';
            for (var i = 0; i < STEP_ORDER.length; i++) {
                var step = STEP_ORDER[i];
                // Renewal flow me pehla step "Sales" ki jagah "CRM" dikhega.
                var stepLabel = (isRenew && i === 0) ? 'CRM' : step;
                var info = stepData[step];
                var cls = 'tl-step';
                var dot = (i + 1);
                if (info) {
                    cls += ' done';
                    dot = '&#10003;';
                } else if (i === curIdx) {
                    cls += ' cur';
                }
                stepsHtml += '<div class="' + cls + '"><div class="tl-line"></div><div class="tl-dot">' + dot + '</div><div class="tl-label">' + stepLabel + '</div></div>';
            }

            var bodyCls = 'panel-body ' + (isRenew ? 'aps-renew' : 'aps-new');
            var renewTag = isRenew
                ? ' <span class="aps-renew-tag">Renewal</span>'
                : ' <span class="aps-new-tag">New</span>';

            html += '<div class="' + bodyCls + '" style="border-top:1px solid var(--border)">' +
                '<div class="d-flex align-center gap-2 mb-3 flex-wrap">' +
                '<span class="avatar">' + initials(companyName) + '</span>' +
                '<div><div><b>' + companyName + '</b>' + renewTag + '</div><div class="text-muted-sm">' + subLine + '</div></div>' +
                headerBadge +
                '</div>' +
                '<div class="d-flex">' + stepsHtml + '</div>' +
                '</div>';
        });

        $('#approvalPipelineBody').html(html || '<div class="panel-body text-center text-muted-sm" style="padding:20px">No pending approvals</div>');
        $('#approvalPipelineCount').text(pendingCount + ' awaiting decisions');
    }

