    //------------------step counter of subcription

    var STEP_ORDER = ["Sales", "Operation", "Finance", "Dept Head", "Login active"];

    function initials(name) {
        return name.replace(/[^A-Za-z ]/g, '').split(' ').filter(Boolean).slice(0, 2).map(function (w) { return w[0]; }).join('').toUpperCase();
    }

    function formatDate(d) {
        var dt = new Date(d);
        if (isNaN(dt)) return d;
        var day = ("0" + dt.getDate()).slice(-2);
        var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        return day + " " + months[dt.getMonth()];
    }

    // Feeds the timeline from the same working subscription-request list the
    // Sales "Subscriptions" page (GetSalesIndexList) shows, mapped into the
    // per-stage rows renderApprovalPipeline expects.
    function GetSubscription_status() {
        $.ajax({
            type: "GET",
            url: "/SalesManagement/GetCRMApprovalPipeline",
            dataType: "json"
        }).done(function (response) {
            var list = (response && response.DataList) || [];
            renderApprovalPipeline(ApsToPipelineRows(list));
        }).fail(function (response) {
            console.log(response);
            $('#approvalPipelineBody').html('<div class="panel-body text-center text-muted-sm" style="padding:20px">Failed to load.</div>');
        });
