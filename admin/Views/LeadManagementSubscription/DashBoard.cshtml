            },
            error: function (e) {
                console.log(e);
                $('#usrAddedLostChart').html('<div class="text-center text-muted-sm" style="padding:20px">Failed to load.</div>');
            }
        });
    }

    // fully inline-styled grouped bar chart (same bulletproof pattern used elsewhere)
    function renderAddedLostChart(containerId, months) {
        var rawMax = 1;
        $(months).each(function (i, m) {
            if (m.added > rawMax) rawMax = m.added;
            if (m.lost > rawMax) rawMax = m.lost;
        });
        var max = niceAxisMax(rawMax);

        var CHART_HEIGHT = 190;
        var BAR_AREA_HEIGHT = 168;
        var TICKS = 5;

        var axisHtml = '<div style="display:flex; flex-direction:column; justify-content:space-between; height:' + CHART_HEIGHT + 'px; padding-bottom:22px; font-size:10px; color:var(--text-soft) !important; text-align:right; flex-shrink:0; margin-right:10px;">';
        for (var i = TICKS; i >= 0; i--) {
            axisHtml += '<div style="line-height:1; color:var(--text-soft) !important;">' + Math.round(max * i / TICKS) + '</div>';
        }
        axisHtml += '</div>';

        var gridHtml = '<div style="position:absolute; top:0; left:0; right:0; height:' + BAR_AREA_HEIGHT + 'px;">';
        for (var g = 0; g <= TICKS; g++) {
            var topPos = Math.round(BAR_AREA_HEIGHT * g / TICKS);
            gridHtml += '<div style="position:absolute; left:0; right:0; top:' + topPos + 'px; height:1px; background:var(--border);"></div>';
        }
        gridHtml += '</div>';

        var barsHtml = '<div style="position:relative; flex:1; display:flex; align-items:flex-end; gap:10px; height:' + CHART_HEIGHT + 'px; border-left:1px solid var(--border); border-bottom:1px solid var(--border); padding:0 4px; overflow-x:auto;">' + gridHtml;

        $(months).each(function (i, m) {
            var addedHeight = max > 0 ? Math.round(m.added / max * BAR_AREA_HEIGHT) : 0;
            var lostHeight = max > 0 ? Math.round(m.lost / max * BAR_AREA_HEIGHT) : 0;
            barsHtml += '<div style="position:relative; z-index:1; min-width:34px; display:flex; flex-direction:column; align-items:center; justify-content:flex-end; height:100%;">' +
                '<div style="display:flex; align-items:flex-end; gap:3px; height:' + BAR_AREA_HEIGHT + 'px;">' +
                '<div onmousemove="moveChartTooltip(event)" onmouseover="showChartTooltip(event, \'' + m.label + ': ' + m.added + ' added\')" onmouseout="hideChartTooltip()" ' +
                'style="width:13px; height:' + addedHeight + 'px; background:var(--green); border-radius:2px 2px 0 0; cursor:pointer;"></div>' +
                '<div onmousemove="moveChartTooltip(event)" onmouseover="showChartTooltip(event, \'' + m.label + ': ' + m.lost + ' lost\')" onmouseout="hideChartTooltip()" ' +
                'style="width:13px; height:' + lostHeight + 'px; background:var(--orange); border-radius:2px 2px 0 0; cursor:pointer;"></div>' +
                '</div>' +
                '<div style="font-size:10px; color:var(--text-soft) !important; margin-top:6px; white-space:nowrap;">' + m.label + '</div>' +
                '</div>';
        });
        barsHtml += '</div>';

        $('#' + containerId).html('<div style="display:flex;">' + axisHtml + barsHtml + '</div>');
    }

    /* ---------- Renewal revenue vs revenue lost (dynamic) ---------- */
    function loadRenewalRevenue() {
        $.ajax({
            type: "POST",
            url: "/CrmDashboardWidgets/GetRenewalRevenueVsLostByMonth",
            data: {},
            success: function (rows) {
                renderRevenueChart('renewalRevChart', buildRevMonths(rows));
            },
            error: function (e) {
                console.log(e);
                $('#renewalRevChart').html('<div class="text-center text-muted-sm" style="padding:20px">Failed to load.</div>');
            }
        });
    }

    // Proc rows (Yr, Mo, RenewalRevenue, RevenueLost) -> last 24 months, values in Lakh.
    function buildRevMonths(rows) {
        var lookup = {};
        $(rows || []).each(function (i, r) { lookup[r.Yr + '-' + r.Mo] = r; });

        var result = [];
        var d = new Date();
        d.setDate(1);
        d.setMonth(d.getMonth() - 23);
        for (var i = 0; i < 24; i++) {
            var yr = d.getFullYear();
            var mo = d.getMonth() + 1;
            var found = lookup[yr + '-' + mo];
            result.push({
                label: MONTH_NAMES[mo - 1] + " " + String(yr).slice(2),
                renewal: found ? (Number(found.RenewalRevenue) / 100000) : 0,  // Lakh
                lost: found ? (Number(found.RevenueLost) / 100000) : 0
            });
            d.setMonth(d.getMonth() + 1);
        }
        return result;
    }

    function renderRevenueChart(containerId, months) {
        var rawMax = 1;
        $(months).each(function (i, m) {
            if (m.renewal > rawMax) rawMax = m.renewal;
            if (m.lost > rawMax) rawMax = m.lost;
        });
        var max = niceAxisMax(rawMax);

        var CHART_HEIGHT = 190, BAR_AREA_HEIGHT = 168, TICKS = 5;

        var axisHtml = '<div style="display:flex; flex-direction:column; justify-content:space-between; height:' + CHART_HEIGHT + 'px; padding-bottom:22px; font-size:10px; color:var(--text-soft) !important; text-align:right; flex-shrink:0; margin-right:10px;">';
        for (var i = TICKS; i >= 0; i--) {
            axisHtml += '<div style="line-height:1; color:var(--text-soft) !important;">' + Math.round(max * i / TICKS) + '</div>';
        }
        axisHtml += '</div>';

        var gridHtml = '<div style="position:absolute; top:0; left:0; right:0; height:' + BAR_AREA_HEIGHT + 'px;">';
        for (var g = 0; g <= TICKS; g++) {
            var topPos = Math.round(BAR_AREA_HEIGHT * g / TICKS);
            gridHtml += '<div style="position:absolute; left:0; right:0; top:' + topPos + 'px; height:1px; background:var(--border);"></div>';
        }
        gridHtml += '</div>';

        var barsHtml = '<div style="position:relative; flex:1; display:flex; align-items:flex-end; gap:10px; height:' + CHART_HEIGHT + 'px; border-left:1px solid var(--border); border-bottom:1px solid var(--border); padding:0 4px; overflow-x:auto;">' + gridHtml;

        $(months).each(function (i, m) {
            var rh = max > 0 ? Math.round(m.renewal / max * BAR_AREA_HEIGHT) : 0;
            var lh = max > 0 ? Math.round(m.lost / max * BAR_AREA_HEIGHT) : 0;
            var rTxt = m.renewal.toFixed(1), lTxt = m.lost.toFixed(1);
            barsHtml += '<div style="position:relative; z-index:1; min-width:34px; display:flex; flex-direction:column; align-items:center; justify-content:flex-end; height:100%;">' +
                '<div style="display:flex; align-items:flex-end; gap:3px; height:' + BAR_AREA_HEIGHT + 'px;">' +
                '<div onmousemove="moveChartTooltip(event)" onmouseover="showChartTooltip(event, \'' + m.label + ': ₹' + rTxt + 'L renewal revenue\')" onmouseout="hideChartTooltip()" ' +
                'style="width:13px; height:' + rh + 'px; background:var(--green); border-radius:2px 2px 0 0; cursor:pointer;"></div>' +
                '<div onmousemove="moveChartTooltip(event)" onmouseover="showChartTooltip(event, \'' + m.label + ': ₹' + lTxt + 'L lost\')" onmouseout="hideChartTooltip()" ' +
                'style="width:13px; height:' + lh + 'px; background:var(--red); border-radius:2px 2px 0 0; cursor:pointer;"></div>' +
                '</div>' +
                '<div style="font-size:10px; color:var(--text-soft) !important; margin-top:6px; white-space:nowrap;">' + m.label + '</div>' +
                '</div>';
        });
        barsHtml += '</div>';

        $('#' + containerId).html('<div style="display:flex;">' + axisHtml + barsHtml + '</div>');
    }

    /* ---------- Avg revenue & users per customer (dynamic) ---------- */
    function loadAvgRevUsers() {
        $.ajax({
            type: "POST",
            url: "/CrmDashboardWidgets/GetAvgRevenueUsersPerCustomerByMonth",
            data: {},
            success: function (rows) {
                renderAvgRevUsersChart('avgRevUsersChart', buildAvgMonths(rows));
            },
            error: function (e) {
                console.log(e);
                $('#avgRevUsersChart').html('<div class="text-center text-muted-sm" style="padding:20px">Failed to load.</div>');
            }
        });
    }

    // rows (Yr, Mo, AvgRevenue, AvgUsers) -> last 24 months; revenue in Lakh.
    function buildAvgMonths(rows) {
        var lookup = {};
        $(rows || []).each(function (i, r) { lookup[r.Yr + '-' + r.Mo] = r; });

        var result = [];
        var d = new Date();
        d.setDate(1);
        d.setMonth(d.getMonth() - 23);
        for (var i = 0; i < 24; i++) {
            var yr = d.getFullYear();
            var mo = d.getMonth() + 1;
            var found = lookup[yr + '-' + mo];
            result.push({
                label: MONTH_NAMES[mo - 1] + " " + String(yr).slice(2),
                revenue: found ? (Number(found.AvgRevenue) / 100000) : 0,  // Lakh
                users: found ? Number(found.AvgUsers) : 0
            });
            d.setMonth(d.getMonth() + 1);
        }
        return result;
    }

    // Revenue (Lakh) aur users ka scale alag hota hai, to dono ko apne-apne
    // max pe scale karke grouped bars dikhate hain; tooltip me actual value.
    function renderAvgRevUsersChart(containerId, months) {
        var revRaw = 1, usrRaw = 1;
        $(months).each(function (i, m) {
            if (m.revenue > revRaw) revRaw = m.revenue;
            if (m.users > usrRaw) usrRaw = m.users;
        });
        var revMax = niceAxisMax(revRaw);
        var usrMax = niceAxisMax(usrRaw);

        var CHART_HEIGHT = 190, BAR_AREA_HEIGHT = 168, TICKS = 5;

        // Left axis = revenue (₹L), right axis = users
        var axisL = '<div style="display:flex; flex-direction:column; justify-content:space-between; height:' + CHART_HEIGHT + 'px; padding-bottom:22px; font-size:10px; color:var(--text-soft) !important; text-align:right; flex-shrink:0; margin-right:8px;">';
        for (var i = TICKS; i >= 0; i--) { axisL += '<div style="line-height:1;">' + (revMax * i / TICKS).toFixed(1) + '</div>'; }
        axisL += '</div>';

        var gridHtml = '<div style="position:absolute; top:0; left:0; right:0; height:' + BAR_AREA_HEIGHT + 'px;">';
        for (var g = 0; g <= TICKS; g++) {
            var topPos = Math.round(BAR_AREA_HEIGHT * g / TICKS);
            gridHtml += '<div style="position:absolute; left:0; right:0; top:' + topPos + 'px; height:1px; background:var(--border);"></div>';
        }
        gridHtml += '</div>';

        var barsHtml = '<div style="position:relative; flex:1; display:flex; align-items:flex-end; gap:10px; height:' + CHART_HEIGHT + 'px; border-left:1px solid var(--border); border-bottom:1px solid var(--border); padding:0 4px; overflow-x:auto;">' + gridHtml;

        $(months).each(function (i, m) {
            var rh = revMax > 0 ? Math.round(m.revenue / revMax * BAR_AREA_HEIGHT) : 0;
            var uh = usrMax > 0 ? Math.round(m.users / usrMax * BAR_AREA_HEIGHT) : 0;
            barsHtml += '<div style="position:relative; z-index:1; min-width:34px; display:flex; flex-direction:column; align-items:center; justify-content:flex-end; height:100%;">' +
                '<div style="display:flex; align-items:flex-end; gap:3px; height:' + BAR_AREA_HEIGHT + 'px;">' +
                '<div onmousemove="moveChartTooltip(event)" onmouseover="showChartTooltip(event, \'' + m.label + ': ₹' + m.revenue.toFixed(2) + 'L avg revenue/customer\')" onmouseout="hideChartTooltip()" ' +
                'style="width:13px; height:' + rh + 'px; background:var(--green); border-radius:2px 2px 0 0; cursor:pointer;"></div>' +
                '<div onmousemove="moveChartTooltip(event)" onmouseover="showChartTooltip(event, \'' + m.label + ': ' + m.users.toFixed(1) + ' avg users/customer\')" onmouseout="hideChartTooltip()" ' +
                'style="width:13px; height:' + uh + 'px; background:var(--orange); border-radius:2px 2px 0 0; cursor:pointer;"></div>' +
                '</div>' +
                '<div style="font-size:10px; color:var(--text-soft) !important; margin-top:6px; white-space:nowrap;">' + m.label + '</div>' +
                '</div>';
        });
        barsHtml += '</div>';

        // Right axis = users scale
        var axisR = '<div style="display:flex; flex-direction:column; justify-content:space-between; height:' + CHART_HEIGHT + 'px; padding-bottom:22px; font-size:10px; color:var(--orange) !important; text-align:left; flex-shrink:0; margin-left:8px;">';
        for (var k = TICKS; k >= 0; k--) { axisR += '<div style="line-height:1;">' + (usrMax * k / TICKS).toFixed(1) + '</div>'; }
        axisR += '</div>';

        $('#' + containerId).html('<div style="display:flex;">' + axisL + barsHtml + axisR + '</div>');
    }
</script>