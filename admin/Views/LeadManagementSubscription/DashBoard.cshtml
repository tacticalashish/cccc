<script>
    /* ---------- shared chart tooltip (used by all graphs on this page) ---------- */
    function showChartTooltip(evt, text) {
        var tip = document.getElementById('sharedChartTooltip');
        if (!tip) {
            tip = document.createElement('div');
            tip.id = 'sharedChartTooltip';
            tip.style.cssText = 'position:fixed; z-index:999999; background:#1a1a1a; color:#fff; padding:6px 10px; border-radius:5px; font-size:12px; font-weight:600; pointer-events:none; white-space:nowrap; opacity:0; transition:opacity 0.15s ease; box-shadow:0 4px 12px rgba(0,0,0,.25);';
            document.body.appendChild(tip);
        }
        tip.textContent = text;
        tip.style.opacity = '1';
        positionChartTooltip(evt, tip);
    }
    // Tooltip ko viewport ke andar rakho — agar right/bottom edge se bahar
    // jaaye to cursor ke left/upar flip kar do (clip na ho).
    function positionChartTooltip(evt, tip) {
        var pad = 8, gap = 14;
        var w = tip.offsetWidth, h = tip.offsetHeight;
        var left = evt.clientX + gap;
        var top = evt.clientY + gap;
        if (left + w + pad > window.innerWidth) {
            left = evt.clientX - gap - w;          // right edge → flip left
            if (left < pad) { left = window.innerWidth - w - pad; }
        }
        if (top + h + pad > window.innerHeight) {
            top = evt.clientY - gap - h;            // bottom edge → flip up
            if (top < pad) { top = window.innerHeight - h - pad; }
        }
        tip.style.left = left + 'px';
        tip.style.top = top + 'px';
    }
    function moveChartTooltip(evt) {
        var tip = document.getElementById('sharedChartTooltip');
        if (tip) { positionChartTooltip(evt, tip); }
    }
    function hideChartTooltip() {
        var tip = document.getElementById('sharedChartTooltip');
        if (tip) tip.style.opacity = '0';
    }

    // detects which conic-gradient segment the mouse is over, based on angle from center
    // (matches CSS conic-gradient's convention: 0% = top, increasing clockwise)
    function donutHover(evt, el, segments) {
        var rect = el.getBoundingClientRect();
        var cx = rect.left + rect.width / 2;
        var cy = rect.top + rect.height / 2;
        var dx = evt.clientX - cx;
        var dy = evt.clientY - cy;
        var angle = (Math.atan2(dx, -dy) * 180 / Math.PI + 360) % 360;
        var pct = angle / 360 * 100;

        for (var i = 0; i < segments.length; i++) {
            if (pct >= segments[i].start && pct < segments[i].end) {
                var share = (segments[i].end - segments[i].start);
                showChartTooltip(evt, segments[i].label + ': ' + share.toFixed(2) + '%');
                return;
            }
        }
    }

