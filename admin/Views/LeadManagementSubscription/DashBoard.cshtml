    // rows: [{ Label, CustomerCount }, ...] — builds a conic-gradient donut + legend + hover tooltip
    function renderDonut(containerId, rows) {
        if (!rows || rows.length === 0) {
            $('#' + containerId).html('<div class="text-center text-muted-sm" style="padding:20px">No data available.</div>');
            return;
        }

        var total = 0;
        $(rows).each(function (i, r) { total += r.CustomerCount; });

        var gradientParts = [];
        var legendItems = [];
        var segments = [];
        var cursor = 0;

        $(rows).each(function (i, r) {
            var color = DONUT_COLORS[i % DONUT_COLORS.length];
            var pct = total > 0 ? (r.CustomerCount / total * 100) : 0;
            var start = cursor;
            var end = cursor + pct;
            gradientParts.push(color + ' ' + start.toFixed(2) + '% ' + end.toFixed(2) + '%');
            segments.push({ label: r.Label, start: start, end: end });
            legendItems.push(
                '<li onmousemove="moveChartTooltip(event)" onmouseover="showChartTooltip(event, \'' + r.Label + ': ' + Math.round(pct) + '%\')" onmouseout="hideChartTooltip()">' +
                '<span class="dot" style="background:' + color + '"></span>' + r.Label + ' <span class="text-muted-sm">(' + r.CustomerCount + ')</span>' +
                '</li>'
            );
            cursor = end;
        });

        var donutHtml =
            '<div style="position:relative">' +
            '<div class="donut" style="background:conic-gradient(' + gradientParts.join(', ') + ')" ' +
            'onmousemove="donutHover(event, this, ' + JSON.stringify(segments).replace(/"/g, '&quot;') + ')" ' +
            'onmouseout="hideChartTooltip()"></div>' +
            '<div class="donut-hole"></div>' +
            '</div>' +
            '<ul class="list-unstyled donut-legend" style="margin-bottom:0">' + legendItems.join('') + '</ul>';

        $('#' + containerId).html(donutHtml);
    }

    /* ---------- Customers / Users added vs lost (dynamic, last 24 months) ---------- */
    var MONTH_NAMES = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

    function niceAxisMax(value) {
        if (value <= 0) return 5;
        var exponent = Math.floor(Math.log(value) / Math.LN10);
        var fraction = value / Math.pow(10, exponent);
        var niceFraction;
        if (fraction <= 1) niceFraction = 1;
        else if (fraction <= 2) niceFraction = 2;
        else if (fraction <= 5) niceFraction = 5;
        else niceFraction = 10;
        return niceFraction * Math.pow(10, exponent);
    }

    // builds the full last-24-months (Yr, Mo) sequence, oldest first, and
    // fills in zero counts for months with no data from the server
    function buildLast24Months(rows) {
        var lookup = {};
        $(rows || []).each(function (i, r) { lookup[r.Yr + '-' + r.Mo] = r; });

        var result = [];
        var d = new Date();
        d.setDate(1);
        d.setMonth(d.getMonth() - 23);
        for (var i = 0; i < 24; i++) {
            var yr = d.getFullYear();
            var mo = d.getMonth() + 1;
            var key = yr + '-' + mo;
            var found = lookup[key];
            result.push({
                // no apostrophe here — an apostrophe inside this label breaks
                // the single-quoted JS string in the tooltip's onmouseover attribute,
                // which is why the tooltip wasn't firing at all
                label: MONTH_NAMES[mo - 1] + " " + String(yr).slice(2),
                added: found ? found.AddedCount : 0,
                lost: found ? found.LostCount : 0
            });
            d.setMonth(d.getMonth() + 1);
        }
        return result;
    }

