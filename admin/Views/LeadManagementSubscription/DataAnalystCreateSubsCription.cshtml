<script>

    function CreateSubscription(Leadid) {
        $('#loader').show();
        $("#CreateSubscription").css("display", "none");
        if ((Leadid == "") || (Leadid == null) || (Leadid == undefined) || (Leadid == "null")) {

            swal({
                title: "Something Went Wrong!",
                type: "success"
            }).then(function () {
            });
        }
        else {
            $.ajax({
                type: "POST",
                url: "/LeadManagementSubscription/CreateSubscriptionByDataAnalyst",
                data: { Leadid: Leadid},
                success: function (response) {
                    
                    if (response == "Success") {
                        $('#loader').hide();
                        swal({
                            title: "Subscription Success!",
                            type: "success"
                        }).then(function () {
                           GetLeadDataForDataAnalyst();
                        });
                    }
                    else {
                        $('#loader').hide();
                        swal({
                            title: "Subscription Failed!",
                            type: "success"
                        }).then(function () {
                        });
                    }
                },
                failure: function (response) {
                    console.log(response)
                },
                error: function (response) {
                    console.log(response)
                }
            });
        }
    } 


    function UpdateStatusofLead(Leadid) {
        
            $.ajax({
                type: "POST",
                url: "/LeadManagementSubscription/UpdatestatusofLead",
                data: { LeadId: Leadid },
                success: function (response) {
                    
                    if (response== "Success") {
                        $('#loader').hide();
                        swal({
                            title: "Status Updated!",
                            type: "success"
                        }).then(function () {
                            GetLeadDataForDataAnalyst();
                        });
                    }
                    else {
                        $('#loader').hide();
                        swal({
                            title: "Faild!",
                            type: "success"
                        }).then(function () {
                        });
                    }
                },
                failure: function (response) {
                    console.log(response)
                },
                error: function (response) {
                    console.log(response)
                }
            });
        }
    

    $("#CancelProducts").click(function () {
        $('#Discription').val('');
        $(".popup-open").css("display", "none");
    });
    $("#CancelSubsRemark").click(function () {
        $(".popup-open04").css("display", "none");
    });
    $("#CancelSecEmails").click(function () {
        $(".popup-open05").css("display", "none");
    });
    
</script>

