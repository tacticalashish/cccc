<script>
    var Search = "";
    $.formattedDate = function (dateToFormat) {
        var dateObject = new Date(dateToFormat);
        var day = dateObject.getDate();
        var month = dateObject.getMonth() + 1;
        var year = dateObject.getFullYear();
        day = day < 10 ? "0" + day : day;
        month = month < 10 ? "0" + month : month;
        var formattedDate = day + "/" + month + "/" + year;
        return formattedDate;
    };
    $(document).ready(function () {
        GetLeadDataForDataAnalyst();

    });
    function GetsearchValues() {
        Search = $('#search').val();
        $('#search').html(GetPaginationHTML(Search));
        GetLeadDataForDataAnalyst();
    }
    function GetLeadDataForDataAnalyst() {
        
        var pageNumber = $('#PageNumber').val();
        var Search = $('#search').val();
        var URL = "/LeadManagementSubscription/GetLeadDataForDataAnalyst?searchKeyword='" + Search + "'";
        URL += '&PageNumber=' + pageNumber;

        $.ajax({
            url: URL,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            success: function (json) {

                var tbodyHTML = '';
                if (json != null) {
                    $(json.DateList).each(function (idx, elm) {
                        
                        var date = elm.CreatedDate
                        var formattedDate = ($.formattedDate(new Date(parseInt(date.substr(6)))));
                        var updatedProductName = elm.UpdateProductsName;
                        var ChkStatus = elm.Status;
                        var ProductName = elm.ProductName;
                        var ModuleName = elm.ModuleName;
                        if (ProductName == "" || ProductName == null || ProductName == undefined) {
                            ProductName = elm.UpdateProductsName;
                        }
                        else {
                            ProductName = elm.ProductName;
                        }
                        if (ModuleName == "" || ModuleName == null || ModuleName == undefined) {
                            ModuleName = elm.UpdatedModulesName;
                        }
                        else {
                            ModuleName = elm.ModuleName;
                        }

                        tbodyHTML += "<tr>";
                        tbodyHTML += "<td hidden>" + elm.Id + "</td>";
                        tbodyHTML += "<td>" + elm.Name + "</td>";
                        tbodyHTML += "<td>" + elm.CorpEmail + "</td>";
                        tbodyHTML += "<td>" + elm.Organisation + "</td>";
                        tbodyHTML += "<td>" + elm.CountryName + "</td>";
                        tbodyHTML += "<td>" + elm.RegionName + "</td>";
                        //tbodyHTML += "<td>" + elm.ProductName + "</td>";
                        tbodyHTML += "<td style='text-align:left'>" + "<a  onclick=PopupSource(`" + encodeURIComponent(ProductName) + "`,`" + encodeURIComponent(updatedProductName)+"`)>" + "Read More" + "</a>" + "</td>"
                        tbodyHTML += "<td>" + ModuleName + "</td>";
                        tbodyHTML += "<td>" + elm.createdby + "</td>";
                        tbodyHTML += "<td>" + formattedDate + "</td>";
                        tbodyHTML += "<td>" + elm.Status + "</td>";
                        tbodyHTML += "<td>" + elm.Trader + "</td>";
                        tbodyHTML += "<td>" + elm.Credit + "</td>";
                        tbodyHTML += "<td>" + elm.Renew + "</td>";
                        tbodyHTML += "<td style='text-align:left'>" + "<a  onclick=PopupSourceSubsRemark(`" + encodeURIComponent(elm.SubSubscriptionRemark) + "`)>" + "Read More" + "</a>" + "</td>"
                        tbodyHTML += "<td style='text-align:left'>" + "<a  onclick=PopupSourceSecEmails(`" + encodeURIComponent(elm.SecondaryClintEmail) + "`)>" + "Read More" + "</a>" + "</td>"
                        tbodyHTML += "<td>" + "<a class='label label-info' href='../LeadManagementSubscription/LeadDetailsById?LeadId=" + elm.Id + "&StatusType=" + elm.Status + "'>" + 'VIEW DETAILS' + "</a>" + "</td>";

                        if (ChkStatus == "New") {
                            tbodyHTML += "<td>" + "<input type='button' class='btn btn-xs btn-danger' id='CreateSubscription' value='Add Subscription' onclick=CreateSubscription('" + elm.Id + "')>" + "</td>";
                            }
                            else {
                                tbodyHTML += "<td>" + "<a target='_blank' href='/LeadManagementSubscription/CreateSubscriptionbyParantClint?LeadId=" + elm.Id + "'>" + 'Add Subscription' + "</a>" + "</td>"; 
                               // tbodyHTML += "<td>" + "<input type='button' class='btn btn-xs btn-danger' id='CreateSubscription' value='Add Subscription' onclick=CreateSubscription('" + elm.Id + "')>" + "</td>";
                            }   
                        //if (ChkStatus == "Updated")
                        //{
                        //    tbodyHTML += "<td>" + "<a target='_blank' href='/LeadManagementSubscription/UpdateLeadByDataAnalyst?LeadId=" + elm.Id + "'>" + 'Update' + "</a>" + "</td>";
                        //    //tbodyHTML += "<td>" + "<input type='button' class='btn btn-xs btn-info' value='Update' onclick=CreateSubscription('" + elm.Id + "')>" + "</td>";
                        //}
                        //else {
                        //    if ((ChkStatus == "New") && ( updatedProductName != null)) {
                        //        tbodyHTML += "<td>" + "<a target='_blank' href='/LeadManagementSubscription/UpdateLeadByDataAnalyst?LeadId=" + elm.Id + "'>" + '<i style="color:red" class="fa fa-thumbs-down" aria-hidden="true"></i>' +' Update' + "</a>" + "</td>";
                        //    }
                        //    else {
                        //        tbodyHTML += "<td>" + "<a target='_blank' href='/LeadManagementSubscription/CreateSubscriptionbyParantClint?LeadId=" + elm.Id + "'>" + 'Add Subscription' + "</a>" + "</td>"; 
                        //       // tbodyHTML += "<td>" + "<input type='button' class='btn btn-xs btn-danger' id='CreateSubscription' value='Add Subscription' onclick=CreateSubscription('" + elm.Id + "')>" + "</td>";
                        //    }                         
                        //}

                        if (ChkStatus == "Existing") {
                            tbodyHTML += "<td>" + "<input type='button' class='btn btn-xs btn-danger' id='UpdateStatusofLead' value='Update Status' onclick=UpdateStatusofLead('" + elm.Id + "')>" + "</td>";
                        }
                        else {
                                tbodyHTML += "<td>"+""+"</td>";
                            }
                        
                        tbodyHTML += "</tr>"
                    });

                    $('#divPagging').html(GetPaginationHTML(json));
                    $('#pageSize').val(json.PageSize);

                }
                else {
                    tbodyHTML = "<tr><td class='text-center' colspan='20'><span>No records found..!!</span> </td></tr>";
                }
                $('.tbodydata').html(tbodyHTML);
            }
        });
    }
    function GetPaginationHTML(json) {

        var pagingInnerHTML = "<span class='pull-left' style='color:#fff'>(Showing " + json.ShowingFrom + " to " + json.ShowingTo + " of " + json.RecordsCount + " records)</span>";
        var getPaginationButton = GetPagination(json.ActivePage, json.PagerSize, json.NumberOfPages, "");
        pagingInnerHTML += getPaginationButton;

        return pagingInnerHTML;
    }
    function PaggingButton(elm) {

        var pageNumber = elm.attr('url');

        $('#PageNumber').val(pageNumber);

        GetLeadDataForDataAnalyst();

    }
    function GetPagination(activePage, pagerSize, numberOfPages, URL) {

        var innerHTML = '';
        var startLi = pagerSize / pagerSize;
        var endLi = pagerSize;
        var multiplier = activePage / pagerSize;
        var modulo = activePage % pagerSize;
        var virtualLi = pagerSize - pagerSize;
        var previous = activePage / pagerSize * pagerSize - pagerSize + 1;
        var next = activePage / pagerSize * pagerSize + pagerSize + 1;

        if (modulo == 0) {
            next = next - pagerSize;
            previous = previous - pagerSize;
        }

        if (activePage > pagerSize) {
            for (var i = 1; i <= multiplier; i++) {
                virtualLi += pagerSize;
            }

            if (modulo > 0) {
                startLi = virtualLi + 1;
            }
            else {
                startLi = virtualLi - pagerSize + 1;
            }
            endLi = startLi + pagerSize - 1;
        }

        innerHTML = "<ul class='pagination pagination-sm no-margin pull-right'>";
        if (activePage > 1 && activePage < pagerSize + 1) {
            innerHTML += "<li class='paginate_button previous disabled' style='display:none;'>";
            innerHTML += "<a href='javascript:void(0);"

            innerHTML += "'><i class='fa fa-fw fa-arrow-left'></i></a>";
            innerHTML += "</li>";

            if (activePage == 1) {
                innerHTML += "<li class='paginate_button previous disabled'>";
                innerHTML += "<a href='javascript:void(0);";
                innerHTML += "'>&laquo;</a>";
                innerHTML += "</li>";
            }
            else {
                innerHTML += "<li class='paginate_button previous'>";
                innerHTML += "<a href='javascript:void(0);'  url='";
                //innerHTML += URL + "&id=" + (activePage - 1);
                innerHTML += URL + (activePage - 1);
                innerHTML += "' onclick='PaggingButton($(this));'>&laquo;</a>";
                innerHTML += "</li>";
            }
        }
        else if (activePage == 1) {
            innerHTML += "<li class='paginate_button previous disabled' disabled style='display:none;'>";
            innerHTML += "<a href='javascript:void(0);";
            innerHTML += "'><i class='fa fa-fw fa-arrow-left'></i></a>";
            innerHTML += "</li>";
            innerHTML += "<li class='paginate_button previous disabled'>";
            innerHTML += "<a href='javascript:void(0);";
            innerHTML += "'>&laquo;</a>";
            innerHTML += "</li>";
        }
        else {
            innerHTML += "<li class='paginate_button previous'>";
            innerHTML += "<a href='javascript:void(0);'  url='";
            //innerHTML += URL + "&id=" + (previous);
            innerHTML += URL + (previous);
            innerHTML += "' onclick='PaggingButton($(this));'><i class='fa fa-fw fa-arrow-left'></i></a>";
            innerHTML += "</li>";
            innerHTML += "<li class='paginate_button previous'>";
            innerHTML += "<a href='javascript:void(0);'  url='";
            //innerHTML += URL + "&id=" + (activePage - 1);
            innerHTML += URL + (activePage - 1);
            innerHTML += "' onclick='PaggingButton($(this));'>&laquo;</a>";
            innerHTML += "</li>";
        }


        for (var i = startLi; i <= endLi && i <= numberOfPages; i++) {
            if (i == activePage) {
                innerHTML += "<li>";
                innerHTML += "<a style='background-color:gainsboro;' href='javascript:void(0);";
            }
            else {
                innerHTML += "<li class='paginate_button'>";
                innerHTML += "<a onclick='PaggingButton($(this));' href='javascript:void(0);'  url='";
                //innerHTML += URL + "&id=" + i;
                innerHTML += URL + i;
            }

            innerHTML += "' >";
            innerHTML += i;
            innerHTML += "</a>";
            innerHTML += "</li>";
        }

        if (activePage + pagerSize > numberOfPages) {
            if (activePage == numberOfPages) {
                innerHTML += "<li class='paginate_button next disabled'>";
                innerHTML += "<a href='javascript:void(0);";
                innerHTML += "'>&raquo;</a>";
                innerHTML += "</li>";
            }
            else {
                innerHTML += "<li class='paginate_button next'>";
                innerHTML += "<a href='javascript:void(0);'  url='";
                //innerHTML += URL + "&id=" + (activePage + 1);
                innerHTML += URL + (activePage + 1);

                innerHTML += "' onclick='PaggingButton($(this));'>&raquo;</a>";
                innerHTML += "</li>";
            }

            innerHTML += "<li class='paginate_button next disabled' style='display:none;'>";
            innerHTML += "<a href='javascript:void(0);";
            innerHTML += "'><i class='fa fa-fw fa-arrow-right'></i></a>";
            innerHTML += "</li>";
        }
        else if (activePage == numberOfPages) {
            innerHTML += "<li class='paginate_button next disabled'>";
            innerHTML += "<a href='javascript:void(0);";
            innerHTML += "'>&raquo;</a>";
            innerHTML += "</li>";
            innerHTML += "<li class='paginate_button next disabled'> style='display:none;'";
            innerHTML += "<a href='javascript:void(0);";
            innerHTML += "'><i class='fa fa-fw fa-arrow-right'></i></a>";
            innerHTML += "</li>";
        }
        else {
            innerHTML += "<li class='paginate_button next'>";
            innerHTML += "<a href='javascript:void(0);'  url='";
            //innerHTML += URL + "&id=" + (activePage + 1);
            innerHTML += URL + (activePage + 1);

            innerHTML += "' onclick='PaggingButton($(this));'>&raquo;</a>";
            innerHTML += "</li>";

            innerHTML += "<li class='paginate_button next'>";
            innerHTML += "<a href='javascript:void(0);'  url='";
            //innerHTML += URL + "&id=" + (next);
            innerHTML += URL + (next);

            innerHTML += "' onclick='PaggingButton($(this));'><i class='fa fa-fw fa-arrow-right'></i></a>";
            innerHTML += "</li>";
        }
        innerHTML += "</ul>";

        return innerHTML;
    }
    function PopupSource(Product, UpdatedProduct) {
        
        var Productold = decodeURIComponent(Product);
        var ProductUpdated = decodeURIComponent(UpdatedProduct);
        $("#Discription").html(Productold);
        $("#UpdatedProduct").html(ProductUpdated);
        $(".popup-open").css("display", "block");
    }
    function PopupSourceSubsRemark(Source) {

        var PopupSource = decodeURIComponent(Source);
        $("#SubsRemark").html(PopupSource);
        $(".popup-open04").css("display", "block");
    }
    function PopupSourceSecEmails(Source) {

        var PopupSource = decodeURIComponent(Source);
        $("#SecEmails").html(PopupSource);
        $(".popup-open05").css("display", "block");
    }

</script>

