<form id="frmChemicalPrice">
    <div class="white-wrapper">
        <div class="col-md-12 ">
            <div class="import-form ">
                <div class="col-md-12">
                    <h4 style="color:#fff" class="mb-1">Edit Lead</h4>
                </div>
                <div class="change-pass-box ">
                    <div class="col-md-3 ">
                        <label>Client Name</label>
                        <input type="text" class="form-control mb-1" placeholder="Client Name" id="ClientName" name="ClientName" autocomplete="off" disabled/>
                    </div>
                    <div class="col-md-3 ">
                        <label>Primary Email</label>
                        <input type="text" class="form-control mb-1" placeholder="Client Primary Email" id="ClientPrimaryEmail" name="ClientPrimaryEmail" autocomplete="off" disabled/>
                    </div>
                    <div class="col-md-3 ">
                        <label>Company Name</label>
                        <input type="text" class="form-control mb-1" placeholder="Client Company Name" id="ClientCompanyName" name="ClientCompanyName" autocomplete="off" disabled/>
                    </div>
                    <div class="col-md-3 ">
                        <label>Assign Analyst</label>
                        <select class="form-control mb-1" id="AssignAnalyst" name="AssignAnalyst" title="AssignAnalyst">
                            <option value="">Select Assign Analyst</option>
                        </select>
                    </div>
                    <div class="col-md-3 ">
                        <label>Date From</label>
                        <input type="text" class="form-control mb-1" placeholder="Date From" id="DateFrom" name="DateFrom" autocomplete="off" />
                    </div>
                    <div class="col-md-3 ">
                        <label>Date To</label>
                        <input type="text" class="form-control mb-1" placeholder="Date To" id="DateTo" name="DateTo" autocomplete="off" />
                    </div>
                    @*<div class="col-md-3 ">
                        <label>Subscription Region/Country</label>
                        <select class="form-control mb-1" id="SubscriptionRegionCountry" name="SubscriptionRegionCountry" title="SubscriptionRegionCountry">
                            <option value="">Select Subscription Region/Country</option>
                            <option value="region">Region Wise</option>
                            <option value="country">Country Wise</option>
                        </select>
                    </div>*@
                    <div class="col-md-3 " hidden id="RegionDiv">
                        <label>Region</label>
                        <select class="form-control mb-1" id="Region" name="Region" title="Region" disabled="disabled">
                           
                        </select>
                    </div>
                    <div class="col-md-3 " id="CountryDiv">
                        <label>Country</label>
                        <select class="form-control mb-1" id="Country" data-live-search="true" data-none-selected-text="Select Country" disabled="disabled"></select>
                    </div>
                    <div class="col-md-12 col-lg-12 padding-0">
                        <label>Exists Product</label>
                        <textarea id="ExistsProducts" class="form-control mb-1" rows="2" name="ExistsProducts" placeholder="Product Names" disabled="disabled"></textarea>
                        <label>Add New Product</label>
                        <textarea id="Products" class="form-control mb-1" rows="4" name="Products" placeholder="Product Names"></textarea>
                        @*<select class="form-control selectpicker" id="Product" data-live-search="true" data-none-selected-text="Select Product" multiple data-actions-box="true" data-selected-text-format="count > 3"></select>*@
                    </div>
                    <div class="col-md-12 col-lg-12 padding-0">
                        <label>Exists Module</label>
                        <textarea id="ExistsModules" class="form-control mb-1" rows="2" name="ExistsModules" placeholder="ExistsModules" disabled="disabled"></textarea>
                        <label>Add New Module</label>
                        <textarea id="Modules" class="form-control mb-1" rows="4" name="Modules" placeholder="Modules"></textarea>
                        @*<select class="selectpicker form-control" id="Module" data-live-search="true" data-none-selected-text="Select Module" multiple data-actions-box="true" data-selected-text-format="count > 3"></select>*@
                    </div>
                    <div class="col-md-12 col-lg-12 padding-0">
                        <label>Exists Secondary Email</label>
                        <textarea id="ExistsSecondaryClintEmail" class="form-control mb-1" rows="2" name="ExistsSecondaryClintEmail" placeholder="ExistsSecondaryClintEmail" disabled></textarea>
                        <label>Add New Secondary Email</label>
                        <textarea id="SecondaryClintEmail" class="form-control mb-1" rows="4" name="SecondaryClintEmail" placeholder="SecondaryClintEmail"></textarea>
                        @*<select class="selectpicker form-control" id="Module" data-live-search="true" data-none-selected-text="Select Module" multiple data-actions-box="true" data-selected-text-format="count > 3"></select>*@
                    </div>
                    <div class="col-md-12 col-lg-12 padding-0">
                        <label>Remarks</label>
                        <textarea id="Remark" class="form-control mb-1" rows="4" name="Remark" placeholder="Remarks"></textarea>
                    </div>
                    <div class="col-md-12">
                        <input class="btn btn-success" value="Update" onclick="SaveLeadRecord()" type="button" />
                        @*<button class="btn btn-success"  onclick="BindDatainGrid()">Add</button>*@
                    </div>
                </div>
            </div>
        </div>
    </div>
</form> 
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
<script defer src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/2.1.0/sweetalert.min.js"></script>
<script>
    var Id =@ViewBag.Id;
    var ModuleIds = "";
    $(document).ready(function () {
        $(function () {
            $('#DateFrom').datetimepicker();
            $('#DateTo').datetimepicker();
        });
       
        GetAllDropdowndata();
       
        GetOnloadDatabyLeadId();
    });
 function GetOnloadDatabyLeadId()
 {
       if (Id!=0) {
        var URL = "/LeadManagementSubscription/GetRecordByLeadIdForEdit/?Leadid=" + Id + "";
            $.ajax({
                type: "POST",
                url: URL,
                success: function (data) {
                    $(data).each(function (index, value) {
                       
                       var Todate = moment(value.DateTo).format("YYYY/MM/DD HH:mm");
                       var fromdate = moment(value.DateFrom).format("YYYY/MM/DD HH:mm");
                        $('#ClientName').val(value.Name);
                        $('#ClientPrimaryEmail').val(value.CorpEmail);
                        $('#ClientCompanyName').val(value.Organisation);
                        $('#AssignAnalyst').append($('<option>', { value: value.AssignAnalystId, text: value.AssignAnalyst }));
                        $('#AssignAnalyst').val(value.AssignAnalystId);
                      
                        var country = value.CountryID;
                        if (country == 0 || country == "" || country == undefined) {
                            
                            $('#RegionDiv').show();
                            $('#CountryDiv').hide();
                        }
                        else {
                            $('#RegionDiv').hide();
                            $('#CountryDiv').show();
                            
                        }
                        
                        
                        $('#Region').append($('<option>', { value: value.RegionId, text: value.SubscriptionType }));
                        $('#Region').val(value.RegionId);

                        $('#Country').append($('<option>', { value: value.CountryID, text: value.CountryName }));
                        $('#Country').val(value.CountryID);
                       
                        $('#DateFrom').val(fromdate);
                        $('#DateTo').val(Todate);
                        $('#ExistsProducts').val(value.ProductName);
                        $('#ExistsModules').val(value.ModuleName);
                        $('#ExistsSecondaryClintEmail').val(value.SecondaryClintEmail);
                        $('#Remark').val(value.SubSubscriptionRemark); 
                      
                    });
                }
            });
        }
    } 


   

