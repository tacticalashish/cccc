<div class="position-relative Dpopup-open Transferbox">
    <div class="child position-relative" style="margin-top:12%">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12 text-right">
                    <button class="btn btn-danger btn-sm ms-2" id="TransferCancelBtn"><i class="fa fa-times" aria-hidden="true"></i></button>
                </div>
                <input type="hidden" id="TransferCorpEmail" />
                <div class="col-md-12">
                    <label>Insert All Mail Chain(linkedin,Outlook,etc..)</label>
