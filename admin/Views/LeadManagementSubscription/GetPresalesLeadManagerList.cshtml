<script>
            var Search = "";
            $.formattedDate = function (dateToFormat) {
                var dateObject = new Date(dateToFormat);
                var day = dateObject.getDate();
                var month = dateObject.getMonth() + 1; // Full month name
                var year = dateObject.getFullYear();

                var formattedDate = day + "-" + month + "-" + year;
                return formattedDate;
            };
            function getFormattedDate(date) {
                return date.toISOString().split('T')[0];
            }

            const today = new Date();
            const fromDate = new Date();
            fromDate.setDate(today.getDate() - 31)
            const toDatePlusOne = new Date(today);
            toDatePlusOne.setDate(toDatePlusOne.getDate() + 1);

            document.getElementById('fromDatess').setAttribute('value', getFormattedDate(fromDate));
            document.getElementById('ToDatess').setAttribute('value', getFormattedDate(toDatePlusOne));

            $(document).ready(function () {

                $("#ExpectedCloseDate").datepicker({ dateFormat: "dd/MM/yy" });
                $("#SetFollowUp").datepicker({ dateFormat: "dd/MM/yy" });
                $("#RemainingPaymentDate").datepicker({ dateFormat: "dd/MM/yy" });
                $("#fromDatess").datepicker({ dateFormat: "yy-mm-dd" });
                $("#ToDatess").datepicker({ dateFormat: "yy-mm-dd" });
                GetLeadOnSearchFilter();

            });




            function GetsearchValues() {
                Search = $('#search').val();
                $('#search').html(GetPaginationHTML(Search));
                GetLeadOnSearchFilter();

            }

            function GetLeadOnSearchFilter() {
                var path = "/ChemPricingImportfile/LeadDocuments";
                var pageNumber = $('#PageNumber').val();
                var Search = $('#search').val();
                var FromDate = $('#fromDatess').val();
                var Todate = $('#ToDatess').val();
                var URL = "/LeadManagementSubscription/GetPreSalesLisManager_CustomSearch?searchKeyword='" + Search + "'";
                URL += '&PageNumber=' + pageNumber;
                URL += '&DateFrom=' + FromDate;
                URL += '&DateTo=' + Todate;
                $.ajax({
                    url: URL,
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    async: false,
                    success: function (json) {
                        var tbodyHTML = '';
                        if (json != null) {
                            $(json.DateList).each(function (idx, elm) {
                                ;
                                var date = elm.CreatedDate;
                                var dateRequestedDate = elm.RequestedDate;
                                var formattedDate = ($.formattedDate(new Date(parseInt(date.substr(6)))));
                                if (!dateRequestedDate) {

                                } else {
                                    var RequestedformattedDate = ($.formattedDate(new Date(parseInt(dateRequestedDate.substr(6)))));
                                }
                                var CreatedDate = ($.formattedDate(new Date(parseInt(elm.CreatedDate.substr(6)))));

                                tbodyHTML += "<tr>";
                                tbodyHTML += "<td hidden>" + elm.Id + "</td>";
                                tbodyHTML += "<td>" + elm.Name + "</td>";
                                tbodyHTML += "<td>" + elm.CorpEmail + "</td>";
                                tbodyHTML += "<td>" + elm.Phone + "</td>";

                               tbodyHTML += "<td>" + elm.CompanyName + "</td>";
                                tbodyHTML += "<td>" + elm.CountryName + "</td>";
                                tbodyHTML += "<td>" + elm.StateName + "</td>";

                                tbodyHTML += "<td style='text-align:center'>" + "<a  onclick=ShowDescription(`" + encodeURIComponent(elm.DiscriptionMessage) + "`)>" + "Read More.." + "</a>" + "</td>"

                                tbodyHTML += "<td>" + RequestedformattedDate + "</td>";
                                tbodyHTML += "<td>" + elm.Status + "</td>";
                                tbodyHTML += "<td>" + elm.OutboundLeadSource + "</td>";
                                tbodyHTML += "<td>" + elm.createdby + "</td>";
                                tbodyHTML += "<td>" + CreatedDate + "</td>";
                                tbodyHTML += "</tr>"
                            });

                            $('#divPagging').html(GetPaginationHTML(json));
                            $('#pageSize').val(json.PageSize);

                        }
                        else {
                            tbodyHTML = "<tr><td class='text-center' colspan='20'><span>No records found..!!</span> </td></tr>";
                        }
                        $('.tbodydata').html(tbodyHTML);
                    }
                });
            }

            function Getchat(Email)
            {

                window.open(`/OutLookChatHistory/EmailHistory?Email=${Email}`, '_blank');
            }
            $("#CancelDisRemark").click(function () {
                $(".popup-open").css("display", "none");
            });


            function ShowDescription(encodedMessage) {

                var decodedMessage = decodeURIComponent(encodedMessage);  // Decode the message to handle special characters

                $(".Dpopup-open").css("display", "block");  // Open the popup
                $('#Descriptiondata').text(decodedMessage);  // Set the decoded message into the popup content
            }

            $("#CancelBtn").click(function () {
                $(".Dpopup-open").css("display", "none");
            });


            function GetPaginationHTML(json) {

                var pagingInnerHTML = "<span class='pull-left' style='color:#fff'>(Showing " + json.ShowingFrom + " to " + json.ShowingTo + " of " + json.RecordsCount + " records)</span>";
                var getPaginationButton = GetPagination(json.ActivePage, json.PagerSize, json.NumberOfPages, "");
                pagingInnerHTML += getPaginationButton;

                return pagingInnerHTML;
            }
            function PaggingButton(elm) {

                var pageNumber = elm.attr('url');

                $('#PageNumber').val(pageNumber);

                GetLeadOnSearchFilter();

            }
            function GetPagination(activePage, pagerSize, numberOfPages, URL) {

                var innerHTML = '';
                var startLi = pagerSize / pagerSize;
                var endLi = pagerSize;
                var multiplier = activePage / pagerSize;
                var modulo = activePage % pagerSize;
                var virtualLi = pagerSize - pagerSize;
                var previous = activePage / pagerSize * pagerSize - pagerSize + 1;
                var next = activePage / pagerSize * pagerSize + pagerSize + 1;

                if (modulo == 0) {
                    next = next - pagerSize;
                    previous = previous - pagerSize;
                }

                if (activePage > pagerSize) {
                    for (var i = 1; i <= multiplier; i++) {
                        virtualLi += pagerSize;
                    }

                    if (modulo > 0) {
                        startLi = virtualLi + 1;
                    }
                    else {
                        startLi = virtualLi - pagerSize + 1;
                    }
                    endLi = startLi + pagerSize - 1;
                }

                innerHTML = "<ul class='pagination pagination-sm no-margin pull-right'>";
                if (activePage > 1 && activePage < pagerSize + 1) {
                    innerHTML += "<li class='paginate_button previous disabled' style='display:none;'>";
                    innerHTML += "<a href='javascript:void(0);"

                    innerHTML += "'><i class='fa fa-fw fa-arrow-left'></i></a>";
                    innerHTML += "</li>";

                    if (activePage == 1) {
                        innerHTML += "<li class='paginate_button previous disabled'>";
                        innerHTML += "<a href='javascript:void(0);";
                        innerHTML += "'>&laquo;</a>";
                        innerHTML += "</li>";
                    }
                    else {
                        innerHTML += "<li class='paginate_button previous'>";
                        innerHTML += "<a href='javascript:void(0);'  url='";
                        //innerHTML += URL + "&id=" + (activePage - 1);
                        innerHTML += URL + (activePage - 1);
                        innerHTML += "' onclick='PaggingButton($(this));'>&laquo;</a>";
                        innerHTML += "</li>";
                    }
                }
                else if (activePage == 1) {
                    innerHTML += "<li class='paginate_button previous disabled' disabled style='display:none;'>";
                    innerHTML += "<a href='javascript:void(0);";
                    innerHTML += "'><i class='fa fa-fw fa-arrow-left'></i></a>";
                    innerHTML += "</li>";
                    innerHTML += "<li class='paginate_button previous disabled'>";
                    innerHTML += "<a href='javascript:void(0);";
                    innerHTML += "'>&laquo;</a>";
                    innerHTML += "</li>";
                }
                else {
                    innerHTML += "<li class='paginate_button previous'>";
                    innerHTML += "<a href='javascript:void(0);'  url='";
                    //innerHTML += URL + "&id=" + (previous);
                    innerHTML += URL + (previous);
                    innerHTML += "' onclick='PaggingButton($(this));'><i class='fa fa-fw fa-arrow-left'></i></a>";
                    innerHTML += "</li>";
                    innerHTML += "<li class='paginate_button previous'>";
                    innerHTML += "<a href='javascript:void(0);'  url='";
                    //innerHTML += URL + "&id=" + (activePage - 1);
                    innerHTML += URL + (activePage - 1);
                    innerHTML += "' onclick='PaggingButton($(this));'>&laquo;</a>";
                    innerHTML += "</li>";
                }


                for (var i = startLi; i <= endLi && i <= numberOfPages; i++) {
                    if (i == activePage) {
                        innerHTML += "<li>";
                        innerHTML += "<a style='background-color:gainsboro;' href='javascript:void(0);";
                    }
                    else {
                        innerHTML += "<li class='paginate_button'>";
                        innerHTML += "<a onclick='PaggingButton($(this));' href='javascript:void(0);'  url='";
                        //innerHTML += URL + "&id=" + i;
                        innerHTML += URL + i;
                    }

                    innerHTML += "' >";
                    innerHTML += i;
                    innerHTML += "</a>";
                    innerHTML += "</li>";
                }

                if (activePage + pagerSize > numberOfPages) {
                    if (activePage == numberOfPages) {
                        innerHTML += "<li class='paginate_button next disabled'>";
                        innerHTML += "<a href='javascript:void(0);";
                        innerHTML += "'>&raquo;</a>";
                        innerHTML += "</li>";
                    }
                    else {
                        innerHTML += "<li class='paginate_button next'>";
                        innerHTML += "<a href='javascript:void(0);'  url='";
                        //innerHTML += URL + "&id=" + (activePage + 1);
                        innerHTML += URL + (activePage + 1);

                        innerHTML += "' onclick='PaggingButton($(this));'>&raquo;</a>";
                        innerHTML += "</li>";
                    }

                    innerHTML += "<li class='paginate_button next disabled' style='display:none;'>";
                    innerHTML += "<a href='javascript:void(0);";
                    innerHTML += "'><i class='fa fa-fw fa-arrow-right'></i></a>";
                    innerHTML += "</li>";
                }
                else if (activePage == numberOfPages) {
                    innerHTML += "<li class='paginate_button next disabled'>";
                    innerHTML += "<a href='javascript:void(0);";
                    innerHTML += "'>&raquo;</a>";
                    innerHTML += "</li>";
                    innerHTML += "<li class='paginate_button next disabled'> style='display:none;'";
                    innerHTML += "<a href='javascript:void(0);";
                    innerHTML += "'><i class='fa fa-fw fa-arrow-right'></i></a>";
                    innerHTML += "</li>";
                }
                else {
                    innerHTML += "<li class='paginate_button next'>";
                    innerHTML += "<a href='javascript:void(0);'  url='";
                    //innerHTML += URL + "&id=" + (activePage + 1);
                    innerHTML += URL + (activePage + 1);

                    innerHTML += "' onclick='PaggingButton($(this));'>&raquo;</a>";
                    innerHTML += "</li>";

                    innerHTML += "<li class='paginate_button next'>";
                    innerHTML += "<a href='javascript:void(0);'  url='";
                    //innerHTML += URL + "&id=" + (next);
                    innerHTML += URL + (next);

                    innerHTML += "' onclick='PaggingButton($(this));'><i class='fa fa-fw fa-arrow-right'></i></a>";
                    innerHTML += "</li>";
                }
                innerHTML += "</ul>";

                return innerHTML;
            }
            function EditPopupSource(id) {
                var LeadId = id;
                window.open(`/LeadManagementSubscription/SalesInbound_OutboundEditLeads?Id=${LeadId}`, '_blank');
            }
            function SalesInboundOutboundEditLeadsFullDetails(id) {
                var LeadId = id;
                window.open(`/LeadManagementSubscription/SalesInboundOutboundEditLeadsFullDetails?Id=${LeadId}`, '_blank');
            }

</script>

