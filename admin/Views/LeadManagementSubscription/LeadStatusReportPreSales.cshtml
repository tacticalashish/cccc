                            <td>${value.createdby || 0}</td>
                            <td>${value.OutboundLeadSource || 0}</td>   
                            <td>${formattedDate || 0}</td>  
                        </tr>
                    `;
                    $('#CountDetails').append(row);
                });

            },
            failure: function (response) {

            },
            error: function (response) {

            }
        });

    }

    function WonCountDetils(value, Month, Year) {
        debugger;
