    function TransferCountDetils(value, Month, Year) {
        debugger;
        $('#CountDetails').empty();
        $(".dpopup-open").css("display", "block");
        Month = (Month || '').trim();
        var fromDatess = $('#fromDatess').val().trim();
        var ToDatess = $('#ToDatess').val().trim();
        Year = (Year || '').toString().trim();

        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/PreSalesTransferCountDetils",
            data: { Name: value, FromDate: fromDatess, ToDate: ToDatess, Year: Year, MonthofMonth: Month },
            success: function (response) {
                $('#pretypes').html("Transfered Lead");
                $('#Cby').html("Transfered To");
                $(response).each(function (index, value) {
                    debugger;
                    var demoStatus = '';
                    var leadStatus = '';
                    if (value.DemoDiscussion == null || value.DemoDiscussion == '') {
                        demoStatus = 'Pending';
                    } else {
                        demoStatus = 'Yes';
                    }

                    if (value.Status == null || value.Status == '') {
                        leadStatus = 'Not Open';
                    } else {
                        leadStatus = value.Status;
                    }

                    let row = `
                        <tr>             
                            <td>${value.CountryName || ''}</td>
                            <td>${value.CorpEmail || ''} </td>
                            <td>${value.CompanyName || ''} </td>
                            <td>${value.createdby || ''}</td>
                            <td>${value.OutboundLeadSource || ''}</td> 
                            <td>${leadStatus || ''}</td>
                            <td>${demoStatus || ''}</td>
                        </tr>
                    `;
                    $('#CountDetails').append(row);

                    $('#LDemo').show();
                    $('#LStatus').show();
                    $('#DDate').hide();
                });


            },
            failure: function (response) {

            },
            error: function (response) {

            }
        });

    }



