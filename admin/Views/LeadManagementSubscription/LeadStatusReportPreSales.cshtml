    function ClearFilter() {

        $('#fromDatess').val('');
        $('#ToDatess').val('');
        getStatusReport();
    }
    $(document).ready(function () {
        $("#fromDatess").datepicker({ dateFormat: "yy-mm-dd" });
        $("#ToDatess").datepicker({ dateFormat: "yy-mm-dd" });
        GetEmployeeMasterOpenLeadData();

    });

    function getFormattedDate(date) {
        return date.toISOString().split('T')[0];
    }

    const today = new Date();
    const fromDate = new Date();
    fromDate.setDate(today.getDate() - 30)
    const toDatePlusOne = new Date(fromDate);
    toDatePlusOne.setDate(toDatePlusOne.getDate());



    //document.getElementById('fromDatess').setAttribute('value', getFormattedDate(toDatePlusOne));
    //document.getElementById('ToDatess').setAttribute('value', getFormattedDate(today));

    function GetEmployeeMasterOpenLeadData() {

        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/GetPreSalesEmployeeName",
            success: function (response) {
                debugger;
                var innerHTML = "";
                var innerHTML2 = "";
                innerHTML += "";

                $(response).each(function (index, value) {
                    if (value.Id != null || value.Id != "" || value.Id != undefined) {
                        innerHTML += "<option class='option01' value = '" + value.Name + "'> " + value.Name + "</option>"
                    }
                });
                if (response == '' || response == null) {
                    $('#salesName').html("<option value=''>Select Name</option>");
                    return true;
                }
                else {

                    $('#salesName').html(innerHTML);

                }
                $('#salesName').selectpicker('refresh');
            },

            failure: function (response) {
                console.log(response)
            },
            error: function (response) {
                console.log(response)

            }
        });
    }

    function getStatusReport() {
        debugger;
        var Name = $('#salesName').val();
        var fromDatess = $('#fromDatess').val().trim();
        var ToDatess = $('#ToDatess').val().trim();

        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/BindLeadStatusPreSalesReport",
            data: { Name: JSON.stringify(Name), FromDate: fromDatess, ToDate: ToDatess },
            success: function (response) {
                $('#PreSalesTableBody').empty(); // clear old rows

                if (!response || response.length === 0) {
                    $('#PreSalesBox').hide();
                } else {
                    $('#PreSalesBox').show();

                    $(response).each(function (index, value) {
                        let row = `
                        <tr>              
                             <td>${value.createdby || ''}</td>
                            <td>${value.Month || ''} ${value.Year || ''}</td>
                            <td>${value.TotalLead || 0}</td>
                            <td>${value.TotalOpenLead || 0}</td>
                            <td><div class="d-flex justify-content-between align-items-center">${value.LeadTransfer || 0}<button type="button" class="btn btn-sm btn-info px-4" onclick="TransferCountDetils('${value.createdby} ',' ${value.Month || ''}',' ${value.Year || ''}')"> <i class="fa fa-info"></i></button></div></td>
                            <td><div class="d-flex justify-content-between align-items-center">${value.WonLead || 0} <button type="button" class="btn btn-sm btn-info px-4" onclick="WonCountDetils('${value.createdby} ',' ${value.Month || ''}',' ${value.Year || ''}')"> <i class="fa fa-info"></i></button></div></td>
                            <td><div class="d-flex justify-content-between align-items-center">${value.DemoCount || 0} <button type="button" class="btn btn-sm btn-info  px-4" onclick="DemoCountDetils('${value.createdby}',' ${value.Month || ''}',' ${value.Year || ''}')"> <i class="fa fa-info"></i></button></div></td>      
                            <td><div class="d-flex justify-content-between align-items-center">${value.NewDemoCount || 0} <button type="button" class="btn btn-sm btn-info  px-4" onclick="DemoCountDetilsbyCreatedDate('${value.createdby}',' ${value.Month || ''}',' ${value.Year || ''}')"> <i class="fa fa-info"></i></button></div></td>                           
                        </tr>
                    `;
                        $('#PreSalesTableBody').append(row);
                    });
                }
            },
            failure: function (response) {
                console.log(response);
                $('#PreSalesBox').hide();
            },
            error: function (response) {
                console.log(response);
                $('#PreSalesBox').hide();
            }
        });
    }


    function DemoCountDetils(value, Month, Year) { 
       
        $('#CountDetails').empty();
        $(".dpopup-open").css("display", "block");
        var fromDatess = $('#fromDatess').val().trim();
        var ToDatess = $('#ToDatess').val().trim();
        Month = (Month || '').trim();
        Year = (Year || '').toString().trim();

        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/PreSalesDemocountDetails",
            data: { Name: value, FromDate: fromDatess, ToDate: ToDatess, Year: Year, MonthofMonth: Month },
            success: function (response) {    
                $('#pretypes').html("Demo Count");
                $('#Cby').html("Demo By");
                $('#LDemo').hide();
                $('#LStatus').hide();
                $('#DDate').show();
                $(response).each(function (index, value) {
                    var formattedDate = ($.formattedDate(new Date(parseInt(value.CreatedDate.substr(6)))));
                 let row = `
                        <tr>              
                            <td>${value.CountryName || ''}</td>
                            <td>${value.CorpEmail || ''} </td>
                            <td>${value.CompanyName || ''} </td>
                            <td>${value.createdby || 0}</td>
                            <td>${value.OutboundLeadSource || 0}</td>   
                            <td>${formattedDate || 0}</td>  
                        </tr>
                    `;
                 $('#CountDetails').append(row);
             });
            
            },
            failure: function (response) {
              
            },
            error: function (response) {
                
            }
        });

    }


