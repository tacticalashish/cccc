<script>
    function SaveDisapprovedMessage() {

        var DisapprovedMessage = $("#DisapprovedMessage").val();
           var LeadId = $("#hdLeadId").val();

        if (DisapprovedMessage == "" || DisapprovedMessage == null || DisapprovedMessage == undefined) {
            swal({
                title: "Please Enter Remarks!",
                type: "success"
            }).then(function () {
            });
        }
        else {
            $.ajax({
                
                type: "POST",
                url: "/LeadManagementSubscription/DisApprovalMessage",
                data: { LeadID: LeadId, DisapprovedMessage: DisapprovedMessage, StatusType:"SalesManagement"},
                success: function (response) {
                    $(".popup-open03").css("display", "none");
                    GetLeadDataForSalesHead();
                },
                failure: function (response) {
                    console.log(response)
                },
                error: function (response) {
                    console.log(response)
                }
            });
        }
    }

    function DisApproved(id, remarks) {

        var Remark = decodeURIComponent(remarks);
        if ((Remark == "") || (Remark == null) || (Remark == undefined) || (Remark == "null")) {

            swal({
                title: "Please Enter Remarks!",
                type: "success"
            }).then(function () {
            });

        }
        else {
            var StepCounter = 0;
            var ID = id;
            $.ajax({
                type: "POST",
                url: "/LeadManagementSubscription/UpdatedisApproval_ApprovalStatus",
                data: { ID: ID, StatusType:"SalesManagement"},
                success: function (response) {
                    if (response == "Update") {
                        swal({
                            title: "Data Disapproved!",
                            type: "success"
                        }).then(function () {
                            GetLeadDataForSalesHead();
                            });

                    }
                    else {
                        swal({
                            title: "Data Disapproval Faild!",
                            type: "success"
                        }).then(function () {
                        });
                    }
                },
                failure: function (response) {
                    console.log(response)
                },
                error: function (response) {
                    console.log(response)
                }
            });
        }
    }
    function Showpopup(id, Remark) {

        var Remarks = decodeURIComponent(Remark);
        if (Remark == "") {
            $("#DisapprovedMessage").val();
        }
        else {
            $("#DisapprovedMessage").val(Remarks);
        }
        $("#hdLeadId").val(id);

        var frm = $('#frmChemicalPrice');
        var disabled = frm.find(':input:disabled').removeAttr('disabled');
        var valdata = frm.serialize();
        disabled.attr('disabled', 'disabled');

        $(".popup-open03").css("display", "block");
    }

    $("#CancelProducts").click(function () {
        $('#Discription').val('');
        $(".popup-open").css("display", "none");
    });
    $("#CancelApproval").click(function () {
        $(".popup-open02").css("display", "none");
    });
    $("#Cancel").click(function () {
        $(".popup-open03").css("display", "none");
    });
    $("#CancelSubsRemark").click(function () {
        $(".popup-open04").css("display", "none");
    });
    $("#CancelClintEmail").click(function () {
        $(".popup-open06").css("display", "none");
    });
    
</script>
