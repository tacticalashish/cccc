<div class="white-wrapper">
    <div class="container-fluid" id="dvDefaultCommentary">
        <div class="row">
            <div class="col-md-4"><h3 style="color:white;margin-bottom:10px!important;line-height: inherit;">Package Expiry</h3></div>
            <div class="col-md-8 text-right">
                <div class="d-flex align-items-center justify-content-between">
                    <label>Filter By Days</label>
                    <select class="form-control mb-1 " id="Days" name="Days" title="Days" style="width:38%">
                        <option value="">Select Days</option>
                        <option value="30" selected>30 DAYS</option>
                        <option value="60">60 DAYS</option>
                        <option value="90">90 DAYS</option>
                        <option value="120">120 DAYS</option>
                        <option value="180">180 DAYS</option>
                        <option value="365">365 DAYS</option>
                    </select>
                   <input type="text" name="search" class="form-control form-control-sm" placeholder="Search..." id="search" aria-controls="Userlist" style="width:38%">
                    <input type="button" class="btn btn-success" value="Search" onclick="GetsearchValues()" />
                    <input type="hidden" id="PageNumber" name="PageNumber" value="1" />
                </div>
            </div>
        </div>
        <div class="data-detail-wrapper table-responsive scrolladmin01" style="overflow:auto">
            <table id="Leadlist" class="table tableStyle">
                <thead>
                    <tr>
                        <th>CompanyName</th>
                        <th>Client Name</th>
                        <th>CorpEmail</th>
                        <th>Todate</th>
                    </tr>
                </thead>
                <tbody class="tbodydata" id="tbodydata"></tbody>
            </table>
        </div>
        <div class="box-footer clearfix" id="divPagging"></div>
    </div>
