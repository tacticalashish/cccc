<form id="frmChemicalPrice">
    <div class="white-wrapper">
        <div class="col-md-12 ">
            <div class="import-form ">
                <div class="col-md-12">
                    <div class="col-md-6 padding-0"> <h4 style="color:#fff" class="mb-1">Edit Lead</h4></div>
                    <div class="col-md-6 padding-0"><input class="btn btn-success" id="Register" style="float:right" value="Register Customer" onclick="" type="button" /></div>
                    <div class="col-md-12 padding-0">
                        <hr style="margin-top:0px" />
                    </div>
                </div>
                <div class="change-pass-box ">
                    <div class="col-md-3 ">
                        <label>Primary Email</label>
                        <select class="form-control" id="ClientPrimaryEmail" data-live-search="true" data-none-selected-text="Client Primary Email" multiple data-actions-box="true" data-selected-text-format="count > 3"></select>
                        @*<select class="form-control" id="ClientPrimaryEmail" ></select>*@
                    </div>
                    <div class="col-md-3 ">
                        <label>Subscription Type</label>
                        <select class="form-control mb-1" id="SubscriptionType" name="SubscriptionType" title="SubscriptionType">
                            <option value="">Select Subscription Type</option>
                            <option value="1">Free Trial</option>
                            <option value="2">Package</option>
                        </select>
                    </div>
                    <div class="col-md-3 ">
                        <label>Date From</label>
                        <input type="text" class="form-control mb-1" placeholder="Date From" id="DateFrom" name="DateFrom" autocomplete="off" />
                    </div>
                    <div class="col-md-3 ">
                        <label>Date To</label>
                        <input type="text" class="form-control mb-1" placeholder="Date To" id="DateTo" name="DateTo" autocomplete="off" />
                    </div>
                    <div class="col-md-3 ">
                        <label>Subscription Region/Country</label>
                        <select class="form-control mb-1" id="SubscriptionRegionCountry" name="SubscriptionRegionCountry" title="SubscriptionRegionCountry">
                            <option value="">Select Subscription Region/Country</option>
                            <option value="region">Region Wise</option>
                            <option value="country">Country Wise</option>
                        </select>
                    </div>
                    <div class="col-md-3 " id="CountryDiv">
                        <label>Country</label>
                        <select class="form-control mb-1" id="Country" data-live-search="true" data-none-selected-text="Select Country"></select>
                    </div>
                    <div class="col-md-3 " hidden id="RegionDiv">
                        <label>Region</label>
                        <select class="form-control mb-1" id="Region" name="Region" title="Region">
                            <option value="">Select Region</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label>Product</label>
                        <select class="form-control mb-1" id="products" data-live-search="true" data-none-selected-text="Select product" multiple data-actions-box="true" data-selected-text-format="count > 3"></select>
                    </div>
                    <div class="col-md-3">
                        <label>Module</label>
                        <select class="form-control mb-1" id="Module" data-live-search="true" data-none-selected-text="Select Module" multiple data-actions-box="true" data-selected-text-format="count > 3"></select>
                    </div>
                    <div class="col-md-3 " id="dvChemicalPricingRange" hidden>
                        <label>Chemical Range</label>
                        <select class="form-control selectpicker mb-1" id="ChemicalRange" data-live-search="true" data-none-selected-text="Select Chemical Range" multiple data-actions-box="true" data-selected-text-format="count > 3">
                            <option value="">Select Chemical Range</option>
                        </select>
                    </div>
                    <div class="col-md-3 " id="dvMarketAnalysisRange" hidden>
                        <label>Market Analysis Range</label>
                        <select class="form-control selectpicker mb-1" id="MarketAnalysisRange" data-live-search="true" data-none-selected-text="Select Market Analysis Range" multiple data-actions-box="true" data-selected-text-format="count > 3">
                            <option value="">Select Market Analysis Range</option>
                        </select>
                    </div>

                    <div class="col-md-12">
                        <input class="btn btn-success" value="Update" onclick="UpdateRecordSalesPackageSubscriptions()" type="button" />
                        @*<button class="btn btn-success"  onclick="BindDatainGrid()">Add</button>*@
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
<script defer src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/2.1.0/sweetalert.min.js"></script>

<script>
    $("#Register").click(function () {
        $(".popup-open").css("display", "block");
    });
    $("#Cancel").click(function () {
        $(".popup-open").css("display", "none");
    });
    var LeadIdForUpdate= @ViewBag.LeadId;

    $("#SubscriptionRegionCountry").change(function () {
        var SubscriptionRegionCountry = $("#SubscriptionRegionCountry").val();
        if (SubscriptionRegionCountry == "region") {
            $("#CountryDiv").hide();
            $("#RegionDiv").show();
        }
        else {
            $("#CountryDiv").show();
            $("#RegionDiv").hide();
        }
    });
    $('#Module').on('changed.bs.select', function (e, clickedIndex) {
        var selectedValues = $(e.currentTarget).val();

        if (selectedValues != null) {
            if (selectedValues.indexOf('1') != -1) {
                $('#dvChemicalPricingRange').show();
                GetchemicalRange();
            }
            else {
                $('#dvChemicalPricingRange').hide();
                $('#ChemicalRange').selectpicker('val', '');
            }

            if (selectedValues.indexOf('2') != -1) {
                $('#dvMarketAnalysisRange').show();
                GetMarketAnalysisRange();
            }
            else {
                $('#dvMarketAnalysisRange').hide();
                $('#MarketAnalysisRange').selectpicker('val', '');
            }
        }
        else {
            $('#dvChemicalPricingRange').hide();
            $('#dvMarketAnalysisRange').hide();
        }

    });
    //$("#Product").on('changed.bs.select', function (e, clickedIndex) {
    //    GetMarketAnalysisRange();
    //});
    function GetchemicalRange() {
        var ProductList = "";
        ProductList = $('#products').val();
        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/GetChemicalRange",
            data: "{ productlist: '" + ProductList + "' }",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                var innerHTML = '';
                $(response).each(function (jsonIndex, Value) {
                    innerHTML += "<option product-value='" + Value.ProductId + "'range-value='" + Value.Chemical_RangeID + "' >  " + Value.Chemical_Range + "</option > ";
                });
                $('#ChemicalRange').html(innerHTML);
                $('#ChemicalRange').selectpicker('refresh');
            },
            failure: function (response) {
            },
            error: function (response) {
            }
        });
    }
    function GetMarketAnalysisRange() {
        var ProductList = "";
        ProductList = $('#products').val();
        //Loading(true);
        $.ajax({
            url: "/LeadManagementSubscription/GetMarketAnalysisRange",
            type: "POST",
            dataType: "json",
            async: true,
            data: "{ productlist: '" + ProductList + "' }",
            contentType: "application/json; charset=utf-8",
            success: function (response) {

                //Loading(false);
                var MarketAnalysisRangeinnerHTML = '';
                $(response.DataList).each(function (jsonIndex, Value) {
                    MarketAnalysisRangeinnerHTML += "<option product-value='" + Value.ProductId + "'range-value='" + Value.MarketRangeID + "' >  " + Value.MarketRangeName + "</option > ";
                });
                $('#MarketAnalysisRange').html(MarketAnalysisRangeinnerHTML);
                $('#MarketAnalysisRange').selectpicker('refresh');
            },
            failure: function (response) {

            },
            error: function (response) {

            }
        });
    }
    function UpdateRecordSalesPackageSubscriptions()
    {

        var CountryName = $("#Country option:selected").text();
        //var ProductName = $("#Product option:selected").text().Get().join(",");
        var ProductName = $("#products option:selected").map(function () { return $(this).text(); }).get().join(',');

        var ClientPrimaryEmail = $("#ClientPrimaryEmail").val();
        var SubscriptionType = $("#SubscriptionType").val();
        var DateFrom = $("#DateFrom").val();
        var DateTo = $("#DateTo").val();
        var SubscriptionRegionCountry = $("#SubscriptionRegionCountry").val();
        var Region = $("#Region").val();
        var Country = $("#Country").val();
        var Product = $("#products").val();

        if (ClientPrimaryEmail != null) {
            ClientPrimaryEmail = $("#ClientPrimaryEmail").val().join(",");
        }
        else {

        }

        if (Product != null) {
            Product = $("#products").val().join(",");
        }
        else {

        }
        var Module = $("#Module").val();
        if (Module != null) {
            Module = $("#Module").val().join(",");
        }
        else {
        }
        var ChemicalRange = $("#ChemicalRange").val();
        var MarketRange = $("#MarketAnalysisRange").val();
        var MarketAnalysisRange = "";
        var ChemicalPricingRange = "";

        if (ChemicalRange != "") {
            ChemicalPricingRange = GetRangeCheckbox('ChemicalRange');
        }
        if (MarketRange != "") {
            MarketAnalysisRange = GetRangeCheckbox('MarketAnalysisRange');
        }
        var selectedValues = $("#Module").val();


        var ObjLead = {
            Id: LeadIdForUpdate,
            Name: "",
            CorpEmail: ClientPrimaryEmail,
            Organisation: "",
            CountryName: "",
            CountryID: "",
            StateName: "",
            StateId: "",
            Phone: "",
            module: Module,
            InterestArea: "",
            UserType: "",
            Subject: "",
            Query: "",
            Status: "New",
            AssignTo: "",
            Designation: "",
            AssignDate: "",
            IPAddress: "",
            BillingEmail: "",
            SubscriptionType: SubscriptionType,
            AssignAnalyst: "",
            SecondaryClintEmail: "",
            SubscriptionDateFrom: DateFrom,
            SubscriptionDateTo: DateTo,
            Subscription_Country: Country,
            Subscription_Product: Product,
            Chemical_Range: ChemicalPricingRange,
            Market_Analysis_Range: MarketAnalysisRange,
            SubSubscriptionRemark: "",
            ProcedureName: "",
            ConnectionTime: "",
            RegionId: Region,
            RegionName: "",
            ModuleId: "",
            ModuleName: "",
            MarketRangeID: "",
            MarketRangeName: ""
        }
        if (SubscriptionRegionCountry == "region") {
            $("#Country").val('');
            Country = "";
        }
        else if (SubscriptionRegionCountry == "country") {
            $("#Region").val('');
            Region = "";
        }
        else {

        }
         if (ClientPrimaryEmail == "" || ClientPrimaryEmail == null || ClientPrimaryEmail == undefined) {
            swal("Warning", "Please Insert Client Primary Email", "error");
            return false;
        }
        else if (SubscriptionType == "" || SubscriptionType == null || SubscriptionType == undefined) {
            swal("Warning", "Please Insert Subscription Type", "error");
            return false;
        }
        else if (DateFrom == "" || DateFrom == null || DateFrom == undefined) {
            swal("Warning", "Please Insert Date From", "error");
            return false;
        }
        else if (DateTo == "" || DateTo == null || DateTo == undefined) {
            swal("Warning", "Please Insert Date To", "error");
            return false;
        }
        else if (SubscriptionRegionCountry == "" || SubscriptionRegionCountry == null || SubscriptionRegionCountry == undefined) {
            swal("Warning", "Please Insert Subscription Region Country", "error");
            return false;
        }
        else if ((SubscriptionRegionCountry == "region") && (Region == "" || Region == null || Region == undefined)) {
            swal("Warning", "Please Insert Region", "error");
            return false;

        }
        else if ((SubscriptionRegionCountry == "country") && (Country == "" || Country == null || Country == undefined)) {
            swal("Warning", "Please Insert Country", "error");
            return false;
        }
        else if (Product == "" || Product == null || Product == undefined) {
            swal("Warning", "Please Insert Product", "error");
            return false;
        }
        else if (Module == "" || Module == null || Module == undefined) {
            swal("Warning", "Please Insert Module", "error");
            return false;
        }
        else if ((selectedValues.indexOf('1') != -1) && (ChemicalRange == "" || ChemicalRange == null || ChemicalRange == undefined)) {
            swal("Warning", "Please Insert ChemicalRange", "error");
            return false;
        }
        else if ((selectedValues.indexOf('2') != -1) && (MarketRange == "" || MarketRange == null || MarketRange == undefined)) {

            swal("Warning", "Please Insert MarketRange", "error");
            return false;

        }
        else {
            $.ajax({
                type: "POST",
                url: "/LeadManagementSubscription/InsertrecordForSalesPackageSubscriptions",
                data: JSON.stringify(ObjLead),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    var responseMessage = response;
                    if (responseMessage == "success") {
                        swal({
                            title: "Thank you!",
                            text: "Updated Sucessfully.",
                            type: "success"
                        }).then(function () {
                            window.location.reload();
                        });
                    }
                    else {
                        swal({
                            title: "Failed!",
                            text: "Failed Try Again.",
                            type: "success"
                        }).then(function () {

                        });
                    }
                },
                Error: function (ErrMsg) {

                }
            })
        }
    }


</script>
<script>
    function GetRangeCheckbox(elm) {
        var data = []
        $($('#' + elm).find('option:selected')).each(function (idx, val) {
            var innerData = {};
            innerData['PID'] = $(this).attr('product-value');
            innerData['RID'] = $(this).attr('range-value');
            data.push(innerData);
        });
        var rangeCollection = JSON.stringify(data);
        if (rangeCollection == '[]')
            return '';
        else
            return rangeCollection;
    }
    function SaveCustomer() {

        var Name = $("#Name").val();
        var Email = $("#Email").val();
        var Phone = $("#Phone").val();
        if (Name == "") {
            $("#Alert").html("Fill Name!");
        }
        else if (Name == "") {
            $("#Alert").html("Fill Email!");
        }
        else if (Name == "") {
            $("#Alert").html("Fill Phone!");
        }
        else {

            $.ajax({
                type: "POST",
                url: "/LeadManagementSubscription/InsertrecordinSAcustomer",
                data: { Name: Name, Email: Email, Phone: Phone },
                success: function (response) {
                    if (response == "Success") {
                        $("#Name").val('');
                        $("#Email").val('');
                        $("#Phone").val('');
                        $("#Alert").html("Created!");
                    }
                    else {
                        $("#Alert").html("Faild!");
                    }
                },
                failure: function (response) {
                    console.log(response)

                },
                error: function (response) {
                    console.log(response)
                }
            });
        }
    }
</script>