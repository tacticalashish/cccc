<body oncontextmenu="return false;">
    <script>
        $(document).ready(function () {

            $(this).bind("contextmenu", function (e) {

                e.preventDefault();

            });

            //Note: get notification from ticket
            BindTicketBellNotification();
        });


        function BindTicketBellNotification() {


            $.ajax({
                type: "POST",
                url: "/ticket/TicketNotificationBell",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: true,
                success: function (response) {

                    var count = 0;
                    $(response).each(function (index, value) {
                        count = 1 + count;
                    });
                    $('#spnNotificationBell').text(count);

                },
                failure: function (response) {
                    console.log(response)
                },
                error: function (response) {
                    console.log(response)
                }
            });
        }

        function UpdateTicketBellNotification() {


            $.ajax({
                type: "POST",
                url: "/ticket/UpdateTicketNotificationBell",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                success: function (response) {
                    if (response == 's') {
                        window.location.href = "/ticket/list";
                    }
                    else {
                        console.log(response);
                    }
                },
                failure: function (response) {
                    console.log(response)
                },
                error: function (response) {
                    console.log(response)
                }
            });
        }


        //Note: Loading modal pop up
        function Loading(status) {
            if (status) {
                $('#loading').modal('show');
            }
            else {
                $('#loading').modal('hide');
            }
        }

    </script>
