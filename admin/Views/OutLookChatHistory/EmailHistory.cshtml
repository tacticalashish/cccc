<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.13.14/js/bootstrap-select.min.js"></script>

<script>
    var Email = null;
    $.formattedDate = function (dateToFormat) {
        var dateObject = new Date(dateToFormat);
        var day = dateObject.getDate();
        var month = dateObject.getMonth() + 1;
        var year = dateObject.getFullYear();
        day = day < 10 ? "0" + day : day;
        month = month < 10 ? "0" + month : month;
        var formattedDate = day + "/" + month + "/" + year;
        return formattedDate;
    };

    $(document).ready(function () {
        debugger
          Email = `@ViewBag.email`;
        GetDropdowndata();

        //if (Email != "" && Email != null) {
        //    GetEmailHistory();
        //}
        GetEmailHistory();


    });
    function getEMail()
    {
        debugger
        Email = $('#Email').val();
        window.location.href = "/OutLookChatHistory/EmailHistory?Email=" + Email;

    }
    function GetDropdowndata() {

        var UserType = "";
        debugger

        if (Email == "") {
            UserType = "Admin";
        }
        else {
            UserType = "NotAdmin";
        }

        $.ajax({
            type: "POST",
            url: "/OutLookChatHistory/GetEmailDDL",
            data: { UserType: UserType, Email: Email },
            async: true,
            success: function (data) {
                var Objdic = "";
                debugger
                Objdic += "<option value=''>" + "Select User Emails" + "</option>";
                $(data.DateList).each(function (jsonIndex, Value)
                {
                    Objdic += "<option value='" + Value.Email + "'>" + Value.Email + "</option>";
                });
                $('#Email').html(Objdic);
                const emailToBind = Email;
                if (emailToBind)
                {
                    $('#Email option[value="' + emailToBind + '"]').remove();
                    const emailOption = new Option(emailToBind, emailToBind);
                    $('#Email').append(emailOption);
                    $('#Email').val(emailToBind);
                }

                $('#Email').selectpicker('refresh');
            },
            failure: function (response) {
                console.log(response);
            },
            error: function (response) {
                console.log(response);
            }
        });


    }
    function GetsearchValues() {
        Search = $('#search').val();
        $('#search').html(GetPaginationHTML(Search));
        GetEmailHistory();
    }

    function GetEmailHistory() {
        debugger
        var rowHTML = "";var path = "/ChemPricingImportfile/SalesDocument";
        var pageNumber = $('#PageNumber').val();
        var Search = $('#search').val();
        if (Email == "" && email == null) {
            var email = $('#Email').val();
        }
        else {
            var email = Email;
        }
        var URL = "/OutLookChatHistory/GetUserEmailAllhistoryDetails?searchKeyword='" + Search + "'";
        URL += '&PageNumber=' + pageNumber;
        URL += '&Email=' + email;
        $.ajax({
            url: URL,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            success: function (json) {
                debugger
                $('#containerdata').empty();
                if (json != null) {
                    $(json.DateList).each(function (idx, elm) {
                        debugger
                        var bgColor = "";
                        var checkdate = elm.SentDate;
                        lblcheck = "";
                        if (checkdate == "" || checkdate == null)
                        {
                            bgColor = "#0a2a0f8a";
                            lblcheck = "Received Mail";
                        }
                        else {
                            bgColor = "#354c4687";
                            lblcheck = "";
                            lblcheck = "Send Mail";
                        }

                        var date = elm.CreatedDate;
                        var formattedDate = ($.formattedDate(new Date(parseInt(date.substr(6)))));

                        var attachmentsHTML = "";
                        if (elm.attachmentFilePaths) {
                            var filePaths = elm.attachmentFilePaths.split(",");
                            filePaths.forEach(function (filePath) {
                                // Extract file name from the path
                                var fileName = filePath.split("\\").pop();
                                var path = "E:\EmailAttachments";
                                // Generate the custom path
                                var customPath = "/OutLookChatHistory/DownloadFile?filePath=" + path + "&fileName=" + encodeURIComponent(fileName);

                                // Create a clickable link
                                attachmentsHTML += `<a target='_blank' href='${customPath}' style="display:block;">${fileName}</a>`;
                            });
                        } else {
                            attachmentsHTML = "No attachments available";
                        }


                         rowHTML = `
                            <div class="panel-body small border-bottom" style="background-color: ${bgColor}; border-radius: 4px;  box-shadow: 0px 1px 3px 4px #e1e1e1de; margin: 13px 0px; overflow-x: scroll;overflow-y: hidden;">
                                 <div  style="font-weight:600">
                                    <div style="text-align: center;color: #60e860;">${lblcheck}</span>
                                </div>
                                 <div class="d-flex">
                                    <span class="strong text-primary">Sender: </span> <span>${elm.Sender}</span>
                                </div>
                                <div class="d-flex">
                                    <span class="strong text-primary">Subject: </span> <span class="strong text-md">${elm.Subject}</span>
                                </div>
                                <div class="d-flex">
                                    <span class="strong text-primary ">Body: </span> <span>${elm.Body}</span>
                                </div>
                                <div class="d-flex">
                                    <span class="strong text-primary">CC: </span> <span>${elm.CC_EMAil}</span>
                                </div>
                                <div class="d-flex">
                                    <span class="strong text-primary">BCC: </span> <span>${elm.BCC_EMail}</span>
                                </div>
                                <div class="d-flex">
                                    <span class="strong text-primary">Recipient: </span> <span>${elm.Recipient}</span>
                                </div>
                                <div class="d-flex">
                                    <span class="strong text-primary">Received Date: </span> <span>${elm.DateReceived}</span>
                                </div>
                                <div class="d-flex">
                                    <span class="strong text-primary">Send Date: </span> <span>${elm.SentDate}</span>
                                </div>
                                 <div class="d-flex">
                                    <span class="strong text-primary">Attachments: </span> <span>${attachmentsHTML}</span>

                                </div>
                            </div>`;

                        // Append the generated HTML
                         $('#containerdata').append(rowHTML);
                    });
                     $('#divPagging').html(GetPaginationHTML(json));
                    $('#pageSize').val(json.PageSize);

                }
                else {
                    rowHTML = "<span>No records found..!!</span>";
                    $('#containerdata').append(rowHTML);
                }

            }
        });
    }
    function GetPaginationHTML(json) {

        var pagingInnerHTML = "<span class='pull-left' style='color:#fff'>(Showing " + json.ShowingFrom + " to " + json.ShowingTo + " of " + json.RecordsCount + " records)</span>";
        var getPaginationButton = GetPagination(json.ActivePage, json.PagerSize, json.NumberOfPages, "");
        pagingInnerHTML += getPaginationButton;

        return pagingInnerHTML;
    }
    function PaggingButton(elm) {

        var pageNumber = elm.attr('url');

        $('#PageNumber').val(pageNumber);

        GetEmailHistory();

    }
    function GetPagination(activePage, pagerSize, numberOfPages, URL) {

        var innerHTML = '';
        var startLi = pagerSize / pagerSize;
        var endLi = pagerSize;
        var multiplier = activePage / pagerSize;
        var modulo = activePage % pagerSize;
        var virtualLi = pagerSize - pagerSize;
        var previous = activePage / pagerSize * pagerSize - pagerSize + 1;
        var next = activePage / pagerSize * pagerSize + pagerSize + 1;

        if (modulo == 0) {
            next = next - pagerSize;
            previous = previous - pagerSize;
        }

        if (activePage > pagerSize) {
            for (var i = 1; i <= multiplier; i++) {
                virtualLi += pagerSize;
            }

            if (modulo > 0) {
                startLi = virtualLi + 1;
            }
            else {
                startLi = virtualLi - pagerSize + 1;
            }
            endLi = startLi + pagerSize - 1;
        }

        innerHTML = "<ul class='pagination pagination-sm no-margin pull-right'>";
        if (activePage > 1 && activePage < pagerSize + 1) {
            innerHTML += "<li class='paginate_button previous disabled' style='display:none;'>";
            innerHTML += "<a href='javascript:void(0);"

            innerHTML += "'><i class='fa fa-fw fa-arrow-left'></i></a>";
            innerHTML += "</li>";

            if (activePage == 1) {
                innerHTML += "<li class='paginate_button previous disabled'>";
                innerHTML += "<a href='javascript:void(0);";
                innerHTML += "'>&laquo;</a>";
                innerHTML += "</li>";
            }
            else {
                innerHTML += "<li class='paginate_button previous'>";
                innerHTML += "<a href='javascript:void(0);'  url='";
                //innerHTML += URL + "&id=" + (activePage - 1);
                innerHTML += URL + (activePage - 1);
                innerHTML += "' onclick='PaggingButton($(this));'>&laquo;</a>";
                innerHTML += "</li>";
            }
        }
        else if (activePage == 1) {
            innerHTML += "<li class='paginate_button previous disabled' disabled style='display:none;'>";
            innerHTML += "<a href='javascript:void(0);";
            innerHTML += "'><i class='fa fa-fw fa-arrow-left'></i></a>";
            innerHTML += "</li>";
            innerHTML += "<li class='paginate_button previous disabled'>";
            innerHTML += "<a href='javascript:void(0);";
            innerHTML += "'>&laquo;</a>";
            innerHTML += "</li>";
        }
        else {
            innerHTML += "<li class='paginate_button previous'>";
            innerHTML += "<a href='javascript:void(0);'  url='";
            //innerHTML += URL + "&id=" + (previous);
            innerHTML += URL + (previous);
            innerHTML += "' onclick='PaggingButton($(this));'><i class='fa fa-fw fa-arrow-left'></i></a>";
            innerHTML += "</li>";
            innerHTML += "<li class='paginate_button previous'>";
            innerHTML += "<a href='javascript:void(0);'  url='";
            //innerHTML += URL + "&id=" + (activePage - 1);
            innerHTML += URL + (activePage - 1);
            innerHTML += "' onclick='PaggingButton($(this));'>&laquo;</a>";
            innerHTML += "</li>";
        }


        for (var i = startLi; i <= endLi && i <= numberOfPages; i++) {
            if (i == activePage) {
                innerHTML += "<li>";
                innerHTML += "<a style='background-color:gainsboro;' href='javascript:void(0);";
            }
            else {
                innerHTML += "<li class='paginate_button'>";
                innerHTML += "<a onclick='PaggingButton($(this));' href='javascript:void(0);'  url='";
                //innerHTML += URL + "&id=" + i;
                innerHTML += URL + i;
            }

            innerHTML += "' >";
            innerHTML += i;
            innerHTML += "</a>";
            innerHTML += "</li>";
        }

        if (activePage + pagerSize > numberOfPages) {
            if (activePage == numberOfPages) {
                innerHTML += "<li class='paginate_button next disabled'>";
                innerHTML += "<a href='javascript:void(0);";
                innerHTML += "'>&raquo;</a>";
                innerHTML += "</li>";
            }
            else {
                innerHTML += "<li class='paginate_button next'>";
                innerHTML += "<a href='javascript:void(0);'  url='";
                //innerHTML += URL + "&id=" + (activePage + 1);
                innerHTML += URL + (activePage + 1);

                innerHTML += "' onclick='PaggingButton($(this));'>&raquo;</a>";
                innerHTML += "</li>";
            }

            innerHTML += "<li class='paginate_button next disabled' style='display:none;'>";
            innerHTML += "<a href='javascript:void(0);";
            innerHTML += "'><i class='fa fa-fw fa-arrow-right'></i></a>";
            innerHTML += "</li>";
        }
        else if (activePage == numberOfPages) {
            innerHTML += "<li class='paginate_button next disabled'>";
            innerHTML += "<a href='javascript:void(0);";
            innerHTML += "'>&raquo;</a>";
            innerHTML += "</li>";
            innerHTML += "<li class='paginate_button next disabled'> style='display:none;'";
            innerHTML += "<a href='javascript:void(0);";
            innerHTML += "'><i class='fa fa-fw fa-arrow-right'></i></a>";
            innerHTML += "</li>";
        }
        else {
            innerHTML += "<li class='paginate_button next'>";
            innerHTML += "<a href='javascript:void(0);'  url='";
            //innerHTML += URL + "&id=" + (activePage + 1);
            innerHTML += URL + (activePage + 1);

            innerHTML += "' onclick='PaggingButton($(this));'>&raquo;</a>";
            innerHTML += "</li>";

            innerHTML += "<li class='paginate_button next'>";
            innerHTML += "<a href='javascript:void(0);'  url='";
            //innerHTML += URL + "&id=" + (next);
            innerHTML += URL + (next);

            innerHTML += "' onclick='PaggingButton($(this));'><i class='fa fa-fw fa-arrow-right'></i></a>";
            innerHTML += "</li>";
        }
        innerHTML += "</ul>";

        return innerHTML;
    }

</script>
