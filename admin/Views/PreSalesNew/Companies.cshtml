                html += "<button class='" + (pages[i] === DemoedCurrentPage ? "active" : "") + "' onclick='GoToDemoedPage(" + pages[i] + ")'>" + pages[i] + "</button>";
            }
        }
        html += "<button " + (DemoedCurrentPage >= numberOfPages ? "disabled" : "onclick='GoToDemoedPage(" + (DemoedCurrentPage + 1) + ")'") + ">Next</button>";

        $("#DemoedPager").html(html);
    }

