    function RenderCompanyPager() {
        var numberOfPages = Math.max(1, Math.ceil(CompanyTotalCount / CompanyPageSize));
        if (numberOfPages <= 1) {
            $("#CompanyPager").html("");
            return;
        }
        var html = "";
        html += "<button " + (CompanyCurrentPage <= 1 ? "disabled" : "onclick='GoToCompanyPage(" + (CompanyCurrentPage - 1) + ")'") + ">Prev</button>";
        var pages = PcCompactPageList(CompanyCurrentPage, numberOfPages);
        for (var i = 0; i < pages.length; i++) {
            if (pages[i] === "...") {
                html += "<span class='pl-pager-ellipsis'>&hellip;</span>";
            } else {
                html += "<button class='" + (pages[i] === CompanyCurrentPage ? "active" : "") + "' onclick='GoToCompanyPage(" + pages[i] + ")'>" + pages[i] + "</button>";
            }
        }
        html += "<button " + (CompanyCurrentPage >= numberOfPages ? "disabled" : "onclick='GoToCompanyPage(" + (CompanyCurrentPage + 1) + ")'") + ">Next</button>";
        $("#CompanyPager").html(html);
    }

