    // ---- Create Pre-Sales lead drawer -------------------------------
    // Exact same fields/validation/save contract as
    // Views/PreSalesNew/Index.cshtml's CreateLeadBackdrop drawer, posting
    // to LeadManagementSubscription/SavePreSalesLeadDetails so a "+ New
    // contact" click here saves into SA_MaskEmail_PreSales the same way
    // the Leads page's "+ Create lead" button does. Prefills Company (and
    // Country, when the row's CountryName matches one of the loaded
    // options) from the "Demoed, not closed" row that was clicked.
    var CreateLeadCountriesLoaded = false;
    var CreateLeadPrefillCountryName = null;

    function OpenCreateLeadPanelFor(id) {
        var row = null;
        for (var i = 0; i < CurrentOpenLeadList.length; i++) {
            if (CurrentOpenLeadList[i].ID === id) { row = CurrentOpenLeadList[i]; break; }
        }
        OpenCreateLeadPanel(row);
    }

    function OpenCreateLeadPanel(prefillRow) {
        ResetCreateLeadForm();
        if (!CreateLeadCountriesLoaded) {
            LoadCreateLeadCountries(prefillRow);
        } else if (prefillRow && prefillRow.CountryName) {
            SelectCreateLeadCountryByName(prefillRow.CountryName);
        }
        if (prefillRow) {
            $("#CreateLeadCompany").val(prefillRow.CompanyName || "");
            $("#CreateLeadName").val(prefillRow.Name || "");
            $("#CreateLeadCorpEmail").val(prefillRow.CorpEmail || "");
            $("#CreateLeadDesignation").val(prefillRow.Designation || "");
        }
        $("#CreateLeadBackdrop").addClass("active");
    }

    function CloseCreateLeadPanel() {
        $("#CreateLeadBackdrop").removeClass("active");
    }

    function ResetCreateLeadForm() {
        $("#CreateLeadSource").val("");
        $("#CreateLeadName").val("");
        $("#CreateLeadCorpEmail").val("");
        $("#CreateLeadMobile").val("");
        $("#CreateLeadTelephone").val("");
        $("#CreateLeadDesignation").val("");
        $("#CreateLeadCompany").val("");
        $("#CreateLeadCountry").val("");
        $("#CreateLeadState").html("<option value='' disabled selected>Select State</option>");
        $("#CreateLeadStateField").hide();
        $("#CreateLeadMessage").val("");
    }

    $("#CreateLeadCloseBtn, #CreateLeadCancelBtn").click(function () {
        CloseCreateLeadPanel();
    });

    function SelectCreateLeadCountryByName(countryName) {
        var found = false;
        $("#CreateLeadCountry option").each(function () {
            if ($.trim($(this).text()).toLowerCase() === $.trim(countryName).toLowerCase()) {
                found = true;
                return false;
            }
        });
        if (found) {
            $("#CreateLeadCountry option").filter(function () {
                return $.trim($(this).text()).toLowerCase() === $.trim(countryName).toLowerCase();
            }).prop("selected", true);
            $("#CreateLeadCountry").trigger("change");
        }
    }

    function LoadCreateLeadCountries(prefillRow) {
        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/GetClintCountry",
            contentType: "application/json; charset=utf-8",
            dataType: "json"
        }).done(function (data) {
            CreateLeadCountriesLoaded = true;
            var html = "<option value='' disabled selected>Select Country</option>";
            $((data && data.DataList) || []).each(function (index, value) {
                if (value.CountryName) {
                    html += "<option value='" + value.CountryID + "'>" + $("<div>").text(value.CountryName).html() + "</option>";
                }
            });
            $("#CreateLeadCountry").html(html);
            if (prefillRow && prefillRow.CountryName) {
                SelectCreateLeadCountryByName(prefillRow.CountryName);
            }
        }).fail(function () {
            CreateLeadCountriesLoaded = false;
        });
    }

    $("#CreateLeadCountry").change(function () {
        var countryId = $(this).val();
        if (countryId == "1") {
            $("#CreateLeadStateField").show();
            $.ajax({
                type: "GET",
                url: "/PreSalesNew/GetStateList",
                data: { countryId: countryId },
                dataType: "json"
            }).done(function (response) {
                var list = (response && response.DataList) || [];
                var html = "<option value='' disabled selected>Select State</option>";
                $.each(list, function (index, value) {
                    if (value.Text) {
                        html += "<option value='" + value.Value + "'>" + $("<div>").text(value.Text).html() + "</option>";
                    }
                });
                $("#CreateLeadState").html(html);
            });
        } else {
            $("#CreateLeadStateField").hide();
            $("#CreateLeadState").html("<option value='' disabled selected>Select State</option>");
        }
    });

    $("#CreateLeadMobile, #CreateLeadTelephone").intlTelInput({
        initialCountry: "in",
        separateDialCode: true
    });

    $("#CreateLeadMobile").on('input', function () {
        $(this).val($(this).val().replace(/\D/g, ''));
    });

    $("#CreateLeadSaveBtn").click(function () {
        var Name = $.trim($("#CreateLeadName").val());
        var CorpEmail = $.trim($("#CreateLeadCorpEmail").val());
        var CompanyName = $.trim($("#CreateLeadCompany").val());
        var OutboundLeadSource = $("#CreateLeadSource").val();
        var CountryText = $("#CreateLeadCountry option:selected").text().trim();
        var CountryVal = $("#CreateLeadCountry").val();

        if (Name === "") { swal("Warning", "Please Insert Name", "error"); return; }
        if (CorpEmail === "") { swal("Warning", "Please Insert CorpEmail", "error"); return; }
        if (CompanyName === "") { swal("Warning", "Please Insert CompanyName", "error"); return; }
        if (!CountryVal) { swal("Warning", "Please Insert CountryName", "error"); return; }
        if (!OutboundLeadSource) { swal("Warning", "Please Insert LeadSource", "error"); return; }

        var Contactcode = $("#CreateLeadMobile").intlTelInput("getSelectedCountryData").dialCode;
        var Mobile = $("#CreateLeadMobile").val();
        var Telecode = $("#CreateLeadTelephone").intlTelInput("getSelectedCountryData").dialCode;
        var Telephone = $("#CreateLeadTelephone").val();
        var State = (CountryText === "India") ? $("#CreateLeadState option:selected").text().trim() : null;

        var GetDetails = {
            Name: Name,
            CorpEmail: CorpEmail,
            Phone: Telephone,
            Organisation: CompanyName,
            Country: CountryText,
            State: State,
            OutboundLeadSource: OutboundLeadSource,
            LeadType: "Outbound",
            DiscriptionMessage: $.trim($("#CreateLeadMessage").val()),
            Mobile: Mobile,
            Designation: $.trim($("#CreateLeadDesignation").val()),
            ContactCountryCode: Contactcode,
            TelephoneCountryCode: Telecode
        };

        $("#CreateLeadSaveBtn").prop("disabled", true).text("Saving...");
        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/SavePreSalesLeadDetails",
            data: JSON.stringify(GetDetails),
            contentType: "application/json; charset=utf-8"
        }).done(function (response) {
            $("#CreateLeadSaveBtn").prop("disabled", false).text("Save lead");
            var success = false, alreadyExists = false;
            $(response || []).each(function (index, value) {
                if (value.ValidationMessage === "SUCCESS") { success = true; }
                else if (value.ValidationMessage === "Already exists") { alreadyExists = true; }
            });
            if (success) {
                swal({ title: "Thank you!", text: "Created Successfully.", type: "success" }).then(function () {
                    ResetCreateLeadForm();
                    CloseCreateLeadPanel();
                });
            } else if (alreadyExists) {
                swal("Already exists!", "Already exists.", "error");
            } else {
                swal("Error", "Could not save lead - please try again.", "error");
            }
        }).fail(function () {
            $("#CreateLeadSaveBtn").prop("disabled", false).text("Save lead");
            swal("Error", "Could not save lead - please try again.", "error");
        });
    });

