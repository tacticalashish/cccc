@{
    ViewBag.Title = "Companies";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .pc-wrap {
        background: #f4f5f7;
        padding: 22px 28px 40px;
    }

    .pc-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

    .pc-title {
        font-size: 19px;
        font-weight: 700;
        color: #22262b;
    }

    .pc-card {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 1px 4px rgba(20, 20, 30, .06);
        padding: 26px 28px;
    }

    .pc-card-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 16px;
    }

    .pc-card-title {
        font-size: 15px;
        font-weight: 700;
        color: #22262b;
    }

    .pc-card-note {
        font-size: 12px;
        color: #a4aab3;
    }

    .pc-tabs {
        display: flex;
        gap: 8px;
        margin-bottom: 16px;
    }

    .pc-tab {
        border: 1px solid #e3e5e9;
        background: #fbfbfc;
        color: #55595f;
        border-radius: 6px;
        padding: 8px 14px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

        .pc-tab.active {
            background: #fff;
            border-color: #d7dade;
            color: #22262b;
        }

    .pc-banner {
        display: flex;
        gap: 8px;
        align-items: flex-start;
        border-radius: 8px;
        padding: 12px 16px;
        font-size: 13px;
        margin-bottom: 16px;
    }

    .pc-banner-red {
        background: #fdecec;
        color: #a13b3b;
    }

    .pc-banner-green {
        background: #eaf7ee;
        color: #2c6b3f;
    }

    .pc-search {
        position: relative;
        max-width: 340px;
        margin-bottom: 16px;
    }

        .pc-search i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #a4aab3;
            font-size: 13px;
        }

        .pc-search input {
            width: 100%;
            border: 1px solid #e3e5e9;
            border-radius: 6px;
            padding: 8px 12px 8px 32px;
            font-size: 13px;
            color: #444;
            background: #fbfbfc;
        }

            .pc-search input:focus {
                outline: none;
                border-color: #c7cad0;
                background: #fff;
            }

    table.pc-table {
        width: 100%;
        border: none;
        border-collapse: collapse;
        border-spacing: 0;
    }

        table.pc-table th,
        table.pc-table td {
            border: none;
        }

        table.pc-table thead th {
            text-align: left;
            font-size: 11px;
            letter-spacing: .04em;
            text-transform: uppercase;
            color: #a4aab3;
            font-weight: 600;
            padding: 12px 14px;
            border-bottom: 1px solid #edeef1;
            white-space: nowrap;
        }

        table.pc-table tbody td {
            padding: 15px 14px;
            font-size: 13px;
            color: #33383f;
            border-bottom: 1px solid #f2f3f5;
            vertical-align: top;
        }

        table.pc-table tbody tr {
            cursor: pointer;
        }

            table.pc-table tbody tr:hover {
                background: #fafbfc;
            }

        /* Inactive customers table has no row click-through -- keep the
           cursor/hover from implying it's clickable. */
        table.pc-table.pc-table-static tbody tr {
            cursor: default;
        }

            table.pc-table.pc-table-static tbody tr:hover {
                background: transparent;
            }

    .pc-name {
        font-weight: 700;
        color: #22262b;
    }

    .pc-dash {
        color: #c2c6cc;
    }

    .pc-pill {
        display: inline-block;
        font-size: 12px;
        font-weight: 600;
        border-radius: 20px;
        padding: 3px 10px;
        white-space: nowrap;
    }

    .pc-pill-red {
        background: #fdecec;
        color: #b3453f;
    }

    .pc-pill-blue {
        background: #eef2fb;
        color: #3f5fa8;
        margin: 0 4px 4px 0;
    }

    .pc-empty {
        text-align: center;
        padding: 40px 0;
        color: #a4aab3;
        font-size: 13px;
    }

    .pc-filter-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .pc-filter-search {
        position: relative;
        width: 240px;
    }

        .pc-filter-search i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #a4aab3;
            font-size: 13px;
        }

        .pc-filter-search input {
            width: 100%;
            border: 1px solid #e3e5e9;
            border-radius: 6px;
            padding: 8px 12px 8px 32px;
            font-size: 13px;
            color: #444;
            background: #fbfbfc;
        }

            .pc-filter-search input:focus {
                outline: none;
                border-color: #c7cad0;
                background: #fff;
            }

    .pc-filter-select {
        border: 1px solid #e3e5e9;
        border-radius: 6px;
        padding: 8px 10px;
        font-size: 13px;
        color: #444;
        background: #fbfbfc;
    }

    .pc-filter-date-label {
        font-size: 12px;
        color: #8a8f98;
    }

    .pc-filter-date {
        border: 1px solid #e3e5e9;
        border-radius: 6px;
        padding: 7px 10px;
        font-size: 13px;
        color: #444;
        background: #fbfbfc;
    }

    .pc-demo-card {
        background: #fdecd8;
        border: 1px solid #f3d9b3;
        border-radius: 8px;
        padding: 14px 16px;
        margin-bottom: 12px;
    }

    .pc-demo-card-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 10px;
    }

    .pc-demo-title-line {
        font-size: 14px;
    }

    .pc-demo-company {
        font-weight: 700;
        color: #22262b;
    }

    .pc-demo-meta {
        color: #8a8f98;
        font-weight: 400;
        margin-left: 4px;
    }

    .pc-demo-status {
        font-weight: 700;
        font-size: 12px;
        margin-left: 8px;
    }

    .pc-demo-status-open { color: #c1810f; }
    .pc-demo-status-transferred { color: #3f6fd4; }
    .pc-demo-status-won { color: #2c8a4b; }
    .pc-demo-status-lost { color: #c0392b; }
    .pc-demo-status-default { color: #8a8f98; }

    .pc-demo-line {
        font-size: 13px;
        color: #3a3f46;
        margin-top: 6px;
    }

        .pc-demo-line b {
            font-weight: 700;
        }

        .pc-demo-line span.pc-demo-sub {
            color: #8a8f98;
        }

    .pc-demo-note {
        font-size: 13px;
        color: #5b6068;
        margin-top: 4px;
    }

    .pl-pager {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 6px;
        margin-top: 16px;
    }

        .pl-pager button {
            border: 1px solid #e3e5e9;
            background: #fff;
            color: #444;
            border-radius: 6px;
            padding: 5px 11px;
            font-size: 12px;
            cursor: pointer;
        }

            .pl-pager button.active {
                background: #1f5a37;
                border-color: #1f5a37;
                color: #fff;
            }

            .pl-pager button:disabled {
                color: #c2c6cc;
                cursor: default;
            }

        .pl-pager-ellipsis {
            color: #a4aab3;
            font-size: 12px;
            padding: 0 2px;
        }

    .pc-modal-backdrop {
        display: none;
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(20, 20, 30, .35);
        z-index: 4000;
        align-items: center;
        justify-content: center;
    }

        .pc-modal-backdrop.active {
            display: flex;
        }

    .pc-modal {
        background: #fff;
        border-radius: 10px;
        padding: 22px 24px;
        width: 900px;
        max-width: 94vw;
        max-height: 82vh;
        display: flex;
        flex-direction: column;
    }

    .pc-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
        flex: 0 0 auto;
    }

    .pc-modal-body-scroll {
        overflow-y: auto;
        flex: 1 1 auto;
    }

    .pc-modal-title {
        font-size: 15px;
        font-weight: 700;
        color: #22262b;
    }

    .pc-modal-close {
        background: none;
        border: none;
        font-size: 18px;
        line-height: 1;
        color: #a4aab3;
        cursor: pointer;
        padding: 0;
    }

    .pc-contact-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-bottom: 12px;
    }

    .pc-contact-block {
        border: 1px solid #edeef1;
        border-radius: 8px;
        padding: 14px 16px;
        margin-bottom: 12px;
    }

        .pc-contact-row .pc-contact-block {
            margin-bottom: 0;
        }

        .pc-contact-row .pc-field-label {
            margin-top: 8px;
        }

            .pc-contact-row .pc-field-label:first-of-type {
                margin-top: 0;
            }

        .pc-contact-block:last-child {
            margin-bottom: 0;
        }

    .pc-contact-label {
        font-size: 11px;
        letter-spacing: .03em;
        text-transform: uppercase;
        color: #a4aab3;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .pc-contact-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px 16px;
    }

    @@media (max-width: 720px) {
        .pc-contact-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    .pc-field-label {
        font-size: 11px;
        color: #a4aab3;
        margin-bottom: 2px;
    }

    .pc-field-value {
        font-size: 13px;
        color: #33383f;
        font-weight: 600;
    }

    .pc-section-gap {
        margin-top: 6px;
    }

    .pl-btn {
        border-radius: 6px;
        padding: 6px 12px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        border: 1px solid transparent;
        cursor: pointer;
    }

    .pl-btn-outline {
        background: #fff;
        color: #33383f;
        border-color: #d7dade;
    }

        .pl-btn-outline:hover {
            background: #f7f8f9;
            color: #33383f;
            text-decoration: none;
        }

    .pl-btn-primary {
        background: #1f5a37;
        color: #fff;
    }

        .pl-btn-primary:hover {
            background: #17452b;
            color: #fff;
            text-decoration: none;
        }

    .pl-drawer-backdrop {
        display: none;
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(20, 20, 30, .35);
        z-index: 4500;
    }

        .pl-drawer-backdrop.active {
            display: block;
        }

    .pl-drawer {
        position: fixed;
        top: 0; right: 0; bottom: 0;
        width: 420px;
        max-width: 92vw;
        background: #fff;
        box-shadow: -2px 0 12px rgba(20, 20, 30, .12);
        display: flex;
        flex-direction: column;
    }

    .pl-drawer-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 20px 22px;
        border-bottom: 1px solid #edeef1;
    }

    .pl-drawer-title {
        font-size: 15px;
        font-weight: 700;
        color: #22262b;
    }

    .pl-drawer-close {
        background: none;
        border: none;
        font-size: 18px;
        line-height: 1;
        color: #a4aab3;
        cursor: pointer;
        padding: 0;
    }

    .pl-drawer-body {
        flex: 1 1 auto;
        overflow-y: auto;
        padding: 20px 22px;
    }

    .pl-drawer-field {
        margin-bottom: 14px;
    }

        .pl-drawer-field label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            color: #55595f;
            margin-bottom: 5px;
        }

        .pl-drawer-field label .req {
            color: #d9534f;
        }

        .pl-drawer-field input[type="text"],
        .pl-drawer-field input[type="tel"],
        .pl-drawer-field select,
        .pl-drawer-field textarea {
            width: 100%;
            border: 1px solid #e3e5e9;
            border-radius: 6px;
            padding: 8px 10px;
            font-size: 13px;
            color: #33383f;
            background: #fbfbfc;
        }

            .pl-drawer-field input:focus,
            .pl-drawer-field select:focus,
            .pl-drawer-field textarea:focus {
                outline: none;
                border-color: #c7cad0;
                background: #fff;
            }

    .pl-drawer-row {
        display: flex;
        gap: 10px;
    }

        .pl-drawer-row .pl-drawer-field {
            flex: 1 1 0;
        }

    .pl-drawer-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 16px 22px;
        border-top: 1px solid #edeef1;
    }
</style>
<div class="pc-wrap">
    <div class="pc-header">
        <div class="pc-title">Companies</div>
    </div>

    <div class="pc-card">
        <div class="pc-card-head">
            <div class="pc-card-title">Companies</div>
            <div class="pc-card-note">cross-checks before you reach out</div>
        </div>

        <div class="pc-tabs">
            <button type="button" class="pc-tab active" id="TabActiveCustomers" onclick="SwitchCompanyTab('active')">&#9873; Active customers &mdash; don't pitch</button>
            <button type="button" class="pc-tab" id="TabDemoedNotClosed" onclick="SwitchCompanyTab('demoed')">&#8635; Demoed, not closed &mdash; re-target</button>
            <button type="button" class="pc-tab" id="TabInactiveCustomers" onclick="SwitchCompanyTab('inactive')">&#8635; Inactive customers &mdash; re-engage</button>
        </div>

        <div id="ActiveCustomersPanel">
            <div class="pc-banner pc-banner-red">
                <span>&#9873;</span>
                <span>These companies are already paying customers (synced from active subscriptions). Don't cold-pitch them &mdash; loop in their Customer Success Manager instead.</span>
            </div>

            <div class="pc-search">
                <i class="fa fa-search"></i>
                <input type="text" id="CompanySearch" placeholder="Search company name..." />
            </div>

            <table class="pc-table pc-table-static">
                <thead>
                    <tr>
                        <th>Company</th>
                        <th>Country</th>
                        <th>Customer since</th>
                        <th>Plan</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="CompanyRows">
                    <tr><td colspan="5" class="pc-empty">Loading...</td></tr>
                </tbody>
            </table>
            <div class="pl-pager" id="CompanyPager"></div>
        </div>

        <div id="DemoedNotClosedPanel" style="display:none">
            <div class="pc-banner pc-banner-green">
                <span>&#8635;</span>
                <span>Sales ran a demo here but it didn't close. The person already demoed is shown &mdash; go after a different contact at the same company.</span>
            </div>

            <div class="pc-filter-row">
                <div class="pc-filter-search">
                    <i class="fa fa-search"></i>
                    <input type="text" id="DemoedSearch" placeholder="Search company..." />
                </div>
                <select class="pc-filter-select" id="DemoedCountryFilter">
                    <option value="">All countries</option>
                </select>
                <span class="pc-filter-date-label">Demoed from</span>
                <input type="date" class="pc-filter-date" id="DemoedDateFrom" />
                <span class="pc-filter-date-label">to</span>
                <input type="date" class="pc-filter-date" id="DemoedDateTo" />
            </div>

            <div id="DemoedNotClosedCards">
                <div class="pc-empty">Loading...</div>
            </div>

            <div class="pl-pager" id="DemoedPager"></div>
        </div>

        <div id="InactiveCustomersPanel" style="display:none">
            <div class="pc-banner pc-banner-green">
                <span>&#8635;</span>
                <span>These companies' subscription has expired &mdash; they're former customers, good candidates to re-engage and win back.</span>
            </div>

            <div class="pc-search">
                <i class="fa fa-search"></i>
                <input type="text" id="InactiveCompanySearch" placeholder="Search company name..." />
            </div>

            <table class="pc-table pc-table-static">
                <thead>
                    <tr>
                        <th>Company</th>
                        <th>Customer since</th>
                        <th>Expired on</th>
                        <th>Plan</th>
                    </tr>
                </thead>
                <tbody id="InactiveCompanyRows">
                    <tr><td colspan="4" class="pc-empty">Loading...</td></tr>
                </tbody>
            </table>
            <div class="pl-pager" id="InactiveCompanyPager"></div>
        </div>
    </div>
</div>

<div class="pc-modal-backdrop" id="CompanyDetailBackdrop">
    <div class="pc-modal">
        <div class="pc-modal-header">
            <div class="pc-modal-title" id="CompanyDetailTitle">Company</div>
            <button type="button" class="pc-modal-close" id="CompanyDetailCloseBtn">&times;</button>
        </div>
        <div class="pc-modal-body-scroll">
            <div id="CompanyDetailBody"></div>
        </div>
    </div>
</div>

<div class="pl-drawer-backdrop" id="CreateLeadBackdrop">
    <div class="pl-drawer">
        <div class="pl-drawer-header">
            <div class="pl-drawer-title">+ Create Pre-Sales lead</div>
            <button type="button" class="pl-drawer-close" id="CreateLeadCloseBtn">&times;</button>
        </div>
        <div class="pl-drawer-body">
            <div class="pl-drawer-field">
                <label>Lead source <span class="req">*</span></label>
                <select id="CreateLeadSource">
                    <option value="" disabled selected>Select LeadSource</option>
                    <option value="WebsiteForms">Website Forms</option>
                    <option value="Chat">Live Chat</option>
                    <option value="Email">Email</option>
                    <option value="SocialMedia">Social Media</option>
                    <option value="Event/Conference">Event/Conference</option>
                    <option value="Others">Others</option>
                </select>
            </div>
            <div class="pl-drawer-field">
                <label>Name <span class="req">*</span></label>
                <input type="text" id="CreateLeadName" placeholder="Full name" autocomplete="off" />
            </div>
            <div class="pl-drawer-field">
                <label>Corp email <span class="req">*</span></label>
                <input type="text" id="CreateLeadCorpEmail" placeholder="name@company.com" autocomplete="off" oninput="this.value = this.value.replace(/\s/g, '')" />
            </div>
            <div class="pl-drawer-row">
                <div class="pl-drawer-field">
                    <label>Mobile number</label>
                    <input type="tel" id="CreateLeadMobile" maxlength="15" autocomplete="off" />
                </div>
                <div class="pl-drawer-field">
                    <label>Telephone</label>
                    <input type="tel" id="CreateLeadTelephone" maxlength="15" autocomplete="off" />
                </div>
            </div>
            <div class="pl-drawer-field">
                <label>Designation</label>
                <input type="text" id="CreateLeadDesignation" placeholder="Designation" autocomplete="off" />
            </div>
            <div class="pl-drawer-field">
                <label>Company <span class="req">*</span></label>
                <input type="text" id="CreateLeadCompany" placeholder="Company name" autocomplete="off" />
            </div>
            <div class="pl-drawer-field">
                <label>Country <span class="req">*</span></label>
                <select id="CreateLeadCountry">
                    <option value="" disabled selected>Select Country</option>
                </select>
            </div>
            <div class="pl-drawer-field" id="CreateLeadStateField" style="display:none">
                <label>State</label>
                <select id="CreateLeadState">
                    <option value="" disabled selected>Select State</option>
                </select>
            </div>
            <div class="pl-drawer-field">
                <label>Client query</label>
                <textarea id="CreateLeadMessage" rows="4" placeholder="What does the client want?"></textarea>
            </div>
        </div>
        <div class="pl-drawer-footer">
            <button type="button" class="pl-btn pl-btn-outline" id="CreateLeadCancelBtn">Cancel</button>
            <button type="button" class="pl-btn pl-btn-primary" id="CreateLeadSaveBtn">Save lead</button>
        </div>
    </div>
</div>

<link href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.13/css/intlTelInput.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.13/js/intlTelInput-jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/2.1.0/sweetalert.min.js"></script>
<style>
    /* The admin theme's global list/dropdown CSS bleeds white text into
       intlTelInput's country picker, making the highlighted/selected row
       unreadable. Force dark text explicitly, same fix pattern as the
       Activity timeline's white-text bug. */
    .iti__country-list, .iti__country-list li, .iti__country-name, .iti__dial-code {
        color: #33383f !important;
    }
    .iti__country.iti__highlight {
        background-color: #f0f1f3 !important;
    }
    .iti__country.iti__highlight .iti__country-name,
    .iti__country.iti__highlight .iti__dial-code {
        color: #33383f !important;
    }
    /* Same theme-CSS bleed also strips intlTelInput's own max-height/
       overflow rules off the country list, so it renders full-length and
       spills over the rest of the drawer instead of scrolling. Force it
       back to a fixed, scrollable height. */
    .iti__country-list {
        max-height: 200px !important;
        overflow-y: auto !important;
    }
</style>

<script>
    function CoEscape(val) {
        return val ? $("<div>").text(val).html() : "";
    }

    function CoValueOrDash(val) {
        return val ? CoEscape(val) : "<span class='pc-dash'>&mdash;</span>";
    }

    function CoFormatDate(dotNetDate) {
        if (!dotNetDate) return "";
        var match = /\/Date\((\d+)\)\//.exec(dotNetDate);
        var d = match ? new Date(parseInt(match[1], 10)) : new Date(dotNetDate);
        if (isNaN(d.getTime())) return "";
        var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        return d.getDate() + " " + months[d.getMonth()] + " " + d.getFullYear();
    }

    function CoModulePills(moduleNames) {
        if (!moduleNames) return "<span class='pc-dash'>&mdash;</span>";
        var parts = moduleNames.split(",");
        var html = "";
        for (var i = 0; i < parts.length; i++) {
            var name = $.trim(parts[i]);
            if (!name) continue;
