@{
    ViewBag.Title = "Lead Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .pld-wrap {
        background: #f4f5f7;
        padding: 22px 28px 40px;
    }

    .pld-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        color: #55595f;
        text-decoration: none;
        margin-bottom: 14px;
    }

        .pld-back:hover {
            color: #22262b;
            text-decoration: none;
        }

    .pld-card {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 1px 4px rgba(20, 20, 30, .06);
        padding: 22px 26px;
    }

    .pld-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
    }

    .pld-header-left {
        display: flex;
        gap: 14px;
        align-items: flex-start;
    }

    .pld-avatar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: #1f2d24;
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .pld-name {
        font-size: 17px;
        font-weight: 700;
        color: #22262b;
    }

        .pld-name .pld-company {
            font-weight: 400;
            color: #7c828a;
        }

    .pld-badges {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 6px;
        flex-wrap: wrap;
    }

    .pld-header-actions {
        display: flex;
        gap: 8px;
        flex-shrink: 0;
    }

    .pld-btn {
        border-radius: 6px;
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 600;
        border: 1px solid #d7dade;
        background: #fff;
        color: #33383f;
        cursor: pointer;
        white-space: nowrap;
    }

        .pld-btn:hover {
            background: #f7f8f9;
        }

    .pld-btn-primary {
        background: #1f5a37;
        color: #fff;
        border-color: #1f5a37;
    }

        .pld-btn-primary:hover {
            background: #17452b;
        }

    .pl-source-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 12px;
        font-weight: 600;
        color: #55595f;
        background: #fff;
        border: 1px solid #e3e5e9;
        border-radius: 20px;
        padding: 3px 10px;
    }

    .pld-demo-banner {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        background: #eef4fd;
        border: 1px solid #dbe6f8;
        border-radius: 10px;
        padding: 14px 18px;
        margin-bottom: 18px;
        font-size: 13px;
        color: #33383f;
    }

    .pld-demo-banner .check {
        color: #3f6fd4;
        font-weight: 700;
        flex-shrink: 0;
    }

    .pld-demo-banner-title {
        font-weight: 700;
        color: #22262b;
        margin-bottom: 2px;
    }

    .pl-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        font-weight: 600;
        border-radius: 20px;
        padding: 3px 10px 3px 8px;
    }

        .pl-status .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            display: inline-block;
        }

    .pl-status-new { background: #eef2fb; color: #3f5fa8; }
    .pl-status-new .dot { background: #3f5fa8; }

    .pl-status-done { background: #eaf7ee; color: #2f9e50; }
    .pl-status-done .dot { background: #2f9e50; }

    .pl-status-unknown { background: #f1f2f4; color: #7c828a; }
    .pl-status-unknown .dot { background: #a4aab3; }

    .pld-country-text {
        font-size: 13px;
        color: #7c828a;
    }

    .pld-info-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border: 1px solid #e3e5e9;
        border-radius: 8px;
        margin-top: 18px;
        overflow: hidden;
    }

    .pld-info-cell {
        padding: 12px 16px;
        border-right: 1px solid #e3e5e9;
        border-bottom: 1px solid #e3e5e9;
    }

        .pld-info-cell:nth-child(4n) {
            border-right: none;
        }

        .pld-info-cell:nth-child(n+5) {
            border-bottom: none;
        }

    .pld-info-label {
        font-size: 11px;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: #a4aab3;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .pld-info-value {
        font-size: 14px;
        font-weight: 600;
        color: #22262b;
    }

    .pld-dash {
        color: #c2c6cc;
        font-weight: 400;
    }

    .pld-columns {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 18px;
        margin-top: 18px;
        align-items: start;
    }

    @@media (max-width: 900px) {
        .pld-columns {
            grid-template-columns: 1fr;
        }

        .pld-info-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .pld-info-cell:nth-child(4n) {
            border-right: 1px solid #e3e5e9;
        }

        .pld-info-cell:nth-child(2n) {
            border-right: none;
        }

        .pld-info-cell:nth-child(n+5) {
            border-bottom: 1px solid #e3e5e9;
        }

        .pld-info-cell:nth-last-child(-n+2) {
            border-bottom: none;
        }
    }

    .pld-box {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 1px 4px rgba(20, 20, 30, .06);
        padding: 18px 22px;
        margin-bottom: 18px;
    }

    .pld-box-title {
        font-size: 14px;
        font-weight: 700;
        color: #22262b;
        margin-bottom: 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .pld-box-body {
        font-size: 13px;
        color: #33383f;
        line-height: 1.6;
    }

        .pld-box-body,
        .pld-box-body span,
        .pld-box-body div,
        .pld-box-body strong {
            color: #33383f;
        }

        .pld-box-body span.pld-muted {
            color: #a4aab3;
        }

    .pld-empty-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .pld-muted {
        color: #a4aab3;
        font-size: 13px;
    }

    .pld-timeline {
        list-style: none;
        margin: 0;
        padding: 0;
    }

        .pld-timeline li {
            display: flex;
            gap: 20px;
            padding: 9px 0;
            border-bottom: none;
            font-size: 14px;
            color: #33383f;
            align-items: baseline;
        }

            .pld-timeline li strong,
            .pld-timeline li span {
                color: #33383f;
                font-weight: 400;
            }

            .pld-timeline li:last-child {
                border-bottom: none;
            }

    .pld-timeline-date {
        color: #a4aab3;
        flex-shrink: 0;
        width: 82px;
        white-space: nowrap;
    }

    /* Follow-up box shows the full history now, not just the latest one --
       cap it to roughly 3 rows and let it scroll instead of growing the
       card unbounded when a lead has a long follow-up history. */
    .pld-followup-list {
        max-height: 130px;
        overflow-y: auto;
    }

    .pld-loading {
        text-align: center;
        padding: 60px 0;
        color: #a4aab3;
        font-size: 13px;
    }

    .pld-drawer-backdrop {
        display: none;
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(20, 20, 30, .35);
        z-index: 4000;
    }

        .pld-drawer-backdrop.active {
            display: block;
        }

    .pld-drawer {
        position: fixed;
        top: 0; right: 0; bottom: 0;
        width: 400px;
        max-width: 92vw;
        background: #fff;
        box-shadow: -2px 0 12px rgba(20, 20, 30, .12);
        display: flex;
        flex-direction: column;
    }

    .pld-drawer-header {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        padding: 20px 22px;
        border-bottom: 1px solid #edeef1;
    }

    .pld-drawer-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #1f2d24;
        color: #fff;
        font-size: 12px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .pld-drawer-title {
        font-size: 15px;
        font-weight: 700;
        color: #22262b;
    }

    .pld-drawer-subtitle {
        font-size: 12px;
        color: #7c828a;
        margin-top: 1px;
    }

    .pld-drawer-close {
        background: none;
        border: none;
        font-size: 18px;
        line-height: 1;
        color: #a4aab3;
        cursor: pointer;
        padding: 0;
        margin-left: auto;
        align-self: flex-start;
    }

    .pld-drawer-body {
        flex: 1 1 auto;
        overflow-y: auto;
        padding: 20px 22px;
    }

    .pld-drawer-field {
        margin-bottom: 16px;
    }

        .pld-drawer-field label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            color: #55595f;
            margin-bottom: 6px;
        }

        .pld-drawer-field input,
        .pld-drawer-field textarea,
        .pld-drawer-field select {
            width: 100%;
            border: 1px solid #e3e5e9;
            border-radius: 6px;
            padding: 9px 10px;
            font-size: 13px;
            color: #33383f;
            background: #fbfbfc;
        }

            .pld-drawer-field input:focus,
            .pld-drawer-field textarea:focus,
            .pld-drawer-field select:focus {
                outline: none;
                border-color: #c7cad0;
                background: #fff;
            }

    .pld-drawer-note {
        display: flex;
        gap: 8px;
        background: #f4f5f7;
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 12px;
        color: #7c828a;
        line-height: 1.5;
    }

        .pld-drawer-note strong {
            color: #55595f;
        }

    .pld-drawer-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 16px 22px;
        border-top: 1px solid #edeef1;
    }
</style>
<div class="pld-wrap">
    <a href="@Url.Action("Index", "PreSalesNew")" class="pld-back">&larr; Back to Leads</a>

    <div id="LeadDetailContent">
        <div class="pld-loading">Loading...</div>
    </div>
</div>

<div class="pld-drawer-backdrop" id="FollowupModalBackdrop">
    <div class="pld-drawer">
        <div class="pld-drawer-header">
            <div class="pld-drawer-avatar" id="FollowupAvatar">?</div>
            <div>
                <div class="pld-drawer-title">Set follow-up</div>
                <div class="pld-drawer-subtitle" id="FollowupSubtitle"></div>
            </div>
            <button type="button" class="pld-drawer-close" id="FollowupCloseBtn">&times;</button>
        </div>
        <div class="pld-drawer-body">
            <div class="pld-drawer-field">
                <label>Follow-up date</label>
                <input type="date" id="FollowupDate" />
            </div>
            <div class="pld-drawer-field">
                <label>Reminder note</label>
                <textarea id="FollowupNote" rows="4" placeholder="What to do on this date..."></textarea>
            </div>
            <div class="pld-drawer-note">
                <span>&#8505;</span>
                <span>Follow-ups due today or overdue surface at the top of <strong>My Day</strong>.</span>
            </div>
        </div>
        <div class="pld-drawer-footer">
            <button type="button" class="pld-btn" id="FollowupCancelBtn">Cancel</button>
            <button type="button" class="pld-btn pld-btn-primary" id="FollowupSaveBtn">Save follow-up</button>
        </div>
    </div>
</div>

<div class="pld-drawer-backdrop" id="ActivityModalBackdrop">
    <div class="pld-drawer">
        <div class="pld-drawer-header">
            <div class="pld-drawer-avatar" id="ActivityAvatar">?</div>
            <div>
                <div class="pld-drawer-title">Log activity</div>
                <div class="pld-drawer-subtitle" id="ActivitySubtitle"></div>
            </div>
            <button type="button" class="pld-drawer-close" id="ActivityCloseBtn">&times;</button>
        </div>
        <div class="pld-drawer-body">
            <div class="pld-drawer-field">
                <label>Type</label>
                <select id="ActivityType">
                    <option value="Email">Email</option>
                    <option value="Call">Call</option>
                    <option value="Live chat">Live chat</option>
                    <option value="Meeting">Meeting</option>
                    <option value="LinkedIn">LinkedIn</option>
                    <option value="Note">Note</option>
                    <option value="Other">Other</option>
                </select>
            </div>
            <div class="pld-drawer-field">
                <label>What happened</label>
                <textarea id="ActivityNote" rows="4" placeholder="Summary of the interaction..."></textarea>
            </div>
            <div class="pld-drawer-field">
                <label>Outcome (optional)</label>
                <select id="ActivityOutcome">
                    <option value="">&mdash; none &mdash;</option>
                    <option value="Interested - nurturing">Interested - nurturing</option>
                    <option value="Demo agreed">Demo agreed</option>
                    <option value="No response">No response</option>
                    <option value="Not interested">Not interested</option>
                    <option value="Other">Other</option>
                </select>
            </div>
        </div>
        <div class="pld-drawer-footer">
            <button type="button" class="pld-btn" id="ActivityCancelBtn">Cancel</button>
            <button type="button" class="pld-btn pld-btn-primary" id="ActivitySaveBtn">Save activity</button>
        </div>
    </div>
</div>

<div class="pld-drawer-backdrop" id="EditLeadModalBackdrop">
    <div class="pld-drawer">
        <div class="pld-drawer-header">
            <div class="pld-drawer-avatar" id="EditLeadAvatar">?</div>
            <div>
                <div class="pld-drawer-title">Edit lead</div>
                <div class="pld-drawer-subtitle" id="EditLeadSubtitle"></div>
            </div>
            <button type="button" class="pld-drawer-close" id="EditLeadCloseBtn">&times;</button>
        </div>
        <div class="pld-drawer-body">
            <div class="pld-drawer-field">
                <label>Lead source <span style="color:#d9534f">*</span></label>
                <select id="EditLeadSource">
                    <option value="" disabled>Select LeadSource</option>
                    <option value="WebsiteForms">Website Forms</option>
                    <option value="Chat">Live Chat</option>
                    <option value="Email">Email</option>
                    <option value="SocialMedia">Social Media</option>
                    <option value="Event/Conference">Event/Conference</option>
                    <option value="Others">Others</option>
                </select>
            </div>
            <div class="pld-drawer-field">
                <label>Name <span style="color:#d9534f">*</span></label>
                <input type="text" id="EditLeadName" placeholder="Full name" autocomplete="off" />
            </div>
            <div class="pld-drawer-field">
                <label>Corp email <span style="color:#d9534f">*</span></label>
                <input type="text" id="EditLeadCorpEmail" placeholder="name@company.com" autocomplete="off" oninput="this.value = this.value.replace(/\s/g, '')" />
            </div>
            <div style="display:flex; gap:10px;">
                <div class="pld-drawer-field" style="flex:1 1 0">
                    <label>Mobile number</label>
                    <input type="tel" id="EditLeadMobile" maxlength="15" autocomplete="off" />
                </div>
                <div class="pld-drawer-field" style="flex:1 1 0">
                    <label>Telephone</label>
                    <input type="tel" id="EditLeadTelephone" maxlength="15" autocomplete="off" />
                </div>
            </div>
            <div class="pld-drawer-field">
                <label>Designation</label>
                <input type="text" id="EditLeadDesignation" placeholder="Designation" autocomplete="off" />
            </div>
            <div class="pld-drawer-field">
                <label>Company <span style="color:#d9534f">*</span></label>
                <input type="text" id="EditLeadCompany" placeholder="Company name" autocomplete="off" />
            </div>
            <div class="pld-drawer-field">
                <label>Country <span style="color:#d9534f">*</span></label>
                <select id="EditLeadCountry">
                    <option value="" disabled>Select Country</option>
                </select>
            </div>
            <div class="pld-drawer-field" id="EditLeadStateField" style="display:none">
                <label>State</label>
                <select id="EditLeadState">
                    <option value="" disabled>Select State</option>
                </select>
            </div>
            <div class="pld-drawer-field">
                <label>Client query</label>
                <textarea id="EditLeadMessage" rows="4" placeholder="What does the client want?"></textarea>
            </div>
        </div>
        <div class="pld-drawer-footer">
            <button type="button" class="pld-btn" id="EditLeadCancelBtn">Cancel</button>
            <button type="button" class="pld-btn pld-btn-primary" id="EditLeadSaveBtn">Save changes</button>
        </div>
    </div>
</div>

<link href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.13/css/intlTelInput.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.13/js/intlTelInput-jquery.min.js"></script>
<style>
    /* Same theme-CSS-bleed fix as Companies.cshtml's create-lead drawer --
       the admin theme's global list/dropdown CSS makes intlTelInput's
       country picker unreadable (white text) and un-scrollable without
       this override. */
    .iti__country-list, .iti__country-list li, .iti__country-name, .iti__dial-code {
        color: #33383f !important;
    }
    .iti__country.iti__highlight {
        background-color: #f0f1f3 !important;
    }
    .iti__country.iti__highlight .iti__country-name,
    .iti__country.iti__highlight .iti__dial-code {
        color: #33383f !important;
    }
    .iti__country-list {
        max-height: 200px !important;
        overflow-y: auto !important;
    }

    .pld-btn:disabled {
        opacity: .5;
        cursor: not-allowed;
    }

        .pld-btn:disabled:hover {
            background: #fff;
        }
</style>

<script>
    var LeadDetailId = @(ViewBag.LeadId ?? 0);

    function LddSourceBadge(source) {
        if (!source) return "<span class='pld-dash'>&mdash;</span>";
        return "<span class='pl-source-badge'>&#9993; " + $("<div>").text(source).html() + "</span>";
    }

    function LddFormatDate(dotNetDate) {
        if (!dotNetDate) return "";
        var match = /\/Date\((\d+)\)\//.exec(dotNetDate);
        var d = match ? new Date(parseInt(match[1], 10)) : new Date(dotNetDate);
        if (isNaN(d.getTime())) return "";
        var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        return d.getDate() + " " + months[d.getMonth()] + " " + d.getFullYear();
    }

    // Same visual treatment as the mockup's blue "Demo completed" banner,
    // but built from real columns only (Status/CreatedBy/UpdateDate) — no
    // salesperson name or credited amount, since SA_MaskEmail_PreSales has
    // no such data. Shown only once a lead has actually been transferred.
    function LddStatusBanner(lead) {
        if (lead.Status !== "Transferred") return "";
        var dateText = LddFormatDate(lead.UpdateDate || lead.CreatedDate);
        var byText = lead.CreatedBy ? $("<div>").text(lead.CreatedBy).html() : "the presales team";
        var html = "<div class='pld-demo-banner'>";
        html += "<span class='check'>&#10003;</span>";
        html += "<div><div class='pld-demo-banner-title'>Lead transferred</div>";
        html += "<div>Transferred to sales by " + byText + (dateText ? " on " + dateText : "") + ".</div></div>";
        html += "</div>";
        return html;
    }

    function LddStatusClass(status) {
        var s = (status || "").toLowerCase();
        if (!s || s === "new") return "pl-status-new";
        if (s === "transferred") return "pl-status-done";
        return "pl-status-unknown";
    }

    function LddStatusBadge(status) {
        var label = status ? $("<div>").text(status).html() : "Unknown";
        return "<span class='pl-status " + LddStatusClass(status) + "'><span class='dot'></span>" + label + "</span>";
    }

    function LddInitials(name) {
        if (!name) return "?";
        var parts = $.trim(name).split(/\s+/);
        var initials = parts[0].charAt(0);
        if (parts.length > 1) initials += parts[parts.length - 1].charAt(0);
        return initials.toUpperCase();
    }

    function LddValueOrDash(val) {
        return val ? $("<div>").text(val).html() : "<span class='pld-dash'>&mdash;</span>";
    }

    var CurrentLead = null;

    function RenderLeadDetail(lead) {
        if (!lead) {
            $("#LeadDetailContent").html("<div class='pld-card'><div class='pld-loading'>Lead not found.</div></div>");
            return;
        }
        CurrentLead = lead;

        var nameText = lead.Name ? $("<div>").text(lead.Name).html() : "(unnamed)";
        var companyText = lead.CompanyName ? $("<div>").text(lead.CompanyName).html() : "";
        var phoneText = (lead.ContactCountryCode ? "+" + lead.ContactCountryCode + " " : "") + (lead.ContactNumber || "");

        var html = '';
        html += "<div class='pld-card'>";
        html += "  <div class='pld-header'>";
        html += "    <div class='pld-header-left'>";
        html += "      <div class='pld-avatar'>" + LddInitials(lead.Name) + "</div>";
        html += "      <div>";
        html += "        <div class='pld-name'>" + nameText + (companyText ? " <span class='pld-company'>&middot; " + companyText + "</span>" : "") + "</div>";
        html += "        <div class='pld-badges'>";
        html += "          " + LddSourceBadge(lead.OutboundLeadSource);
        html += "          " + LddStatusBadge(lead.Status);
        if (lead.CountryName) {
            html += "          <span class='pld-country-text'>" + $("<div>").text(lead.CountryName).html() + "</span>";
        }
        html += "        </div>";
        html += "      </div>";
        html += "    </div>";
        html += "    <div class='pld-header-actions'>";
        if (lead.Status === "Transferred") {
            html += "      <button type='button' class='pld-btn' disabled title=\"Already transferred to sales - can't be edited anymore\">Edit lead</button>";
        } else {
            html += "      <button type='button' class='pld-btn' onclick='OpenEditLeadModal()'>Edit lead</button>";
        }
        html += "      <button type='button' class='pld-btn' onclick='OpenActivityModal()'>Log activity</button>";
        html += "      <button type='button' class='pld-btn pld-btn-primary' onclick='OpenFollowupModal()'>Set follow-up</button>";
        html += "    </div>";
        html += "  </div>";

        html += "  <div class='pld-info-grid'>";
        html += "    <div class='pld-info-cell'><div class='pld-info-label'>Email</div><div class='pld-info-value'>" + LddValueOrDash(lead.CorpEmail) + "</div></div>";
        html += "    <div class='pld-info-cell'><div class='pld-info-label'>Phone</div><div class='pld-info-value'>" + LddValueOrDash($.trim(phoneText)) + "</div></div>";
        html += "    <div class='pld-info-cell'><div class='pld-info-label'>Designation</div><div class='pld-info-value'>" + LddValueOrDash(lead.Designation) + "</div></div>";
        html += "    <div class='pld-info-cell'><div class='pld-info-label'>Company</div><div class='pld-info-value'>" + LddValueOrDash(lead.CompanyName) + "</div></div>";
        html += "    <div class='pld-info-cell'><div class='pld-info-label'>Country</div><div class='pld-info-value'>" + LddValueOrDash(lead.CountryName) + "</div></div>";
        html += "    <div class='pld-info-cell'><div class='pld-info-label'>Sales Rep</div><div class='pld-info-value' id='AssignedToValue'><span class='pld-muted'>Loading...</span></div></div>";
        html += "    <div class='pld-info-cell'><div class='pld-info-label'>Employees</div><div class='pld-info-value'><span class='pld-dash'>&mdash;</span></div></div>";
        html += "    <div class='pld-info-cell'><div class='pld-info-label'>Revenue</div><div class='pld-info-value'><span class='pld-dash'>&mdash;</span></div></div>";
        html += "  </div>";
        html += "</div>";

        html += "<div class='pld-columns'>";
        html += "  <div>";
        html += "    <div class='pld-box'>";
        html += "      <div class='pld-box-title'>Client query</div>";
        html += "      <div class='pld-box-body'>" + (lead.Message ? $("<div>").text(lead.Message).html() : "<span class='pld-muted'>No client query recorded.</span>") + "</div>";
        html += "    </div>";
        html += "  </div>";
        html += "  <div>";
        html += "    " + LddStatusBanner(lead);
        html += "    <div class='pld-box'>";
        html += "      <div class='pld-empty-row'>";
        html += "        <div class='pld-box-title' style='margin-bottom:0'>Activity</div>";
        html += "      </div>";
        html += "      <div class='pld-box-body' id='ActivityBoxBody' style='margin-top:10px'><span class='pld-muted'>Loading...</span></div>";
        html += "    </div>";
        html += "  </div>";
        html += "</div>";

        $("#LeadDetailContent").html(html);
        LoadFollowup(); 
        LoadActivity();
        LoadAssignPerson(lead.CountryName);
    }

    // "Assigned to" — the sales person mapped to this lead's country in
    // SA_AssignSalesPersonCountry. Loaded as a small second call keyed off
    // the lead's country name once the lead is on screen.
    function LoadAssignPerson(country) {
        var $cell = $("#AssignedToValue");
        if (!country) {
            $cell.html("<span class='pld-dash'>&mdash;</span>");
            return;
        }
        $.ajax({
            type: "GET",
            url: "/PreSalesNew/GetAssignPersonByCountry",
            data: { country: country },
            dataType: "json"
        }).done(function (response) {
            var name = response && response.AssignPerson;
            $cell.html(name ? $("<div>").text(name).html() : "<span class='pld-dash'>&mdash;</span>");
        }).fail(function () {
            $cell.html("<span class='pld-dash'>&mdash;</span>");
        });
    }

    function LddComingSoon() {
        swal("Coming soon", "This will be wired up once activity tracking is built.", "info");
    }

    function LoadLeadDetail() {
        if (!LeadDetailId) {
            RenderLeadDetail(null);
            return;
        }
        $.ajax({
            type: "GET",
            url: "/PreSalesNew/GetLeadById",
            data: { id: LeadDetailId },
            dataType: "json"
        }).done(function (response) {
            RenderLeadDetail(response && response.DataItem);
        }).fail(function () {
            $("#LeadDetailContent").html("<div class='pld-card'><div class='pld-loading'>Couldn't load this lead - please refresh.</div></div>");
        });
    }

    // ---- Follow-up (SA_MaskEmail_PreSalesFollowup) --------------------
    // Shows the whole follow-up history for this lead (newest first), not
    // just the single most-recent one -- GetFollowupByLeadId is still used
    // elsewhere, this box now calls the plural GetFollowupsByLeadId list.
    function LoadFollowup() {
        if (!LeadDetailId) return;
        $.ajax({
            type: "GET",
            url: "/PreSalesNew/GetFollowupsByLeadId",
            data: { leadId: LeadDetailId },
            dataType: "json"
        }).done(function (response) {
            RenderFollowupBox(response && response.DataList);
        }).fail(function () {
            RenderFollowupBox(null);
        });
    }

    function RenderFollowupBox(list) {
        if (!list || !list.length) {
            $("#FollowupBoxBody").html("<span class='pld-muted'>No follow-up scheduled.</span>");
            return;
        }
        var html = "<ul class='pld-timeline pld-followup-list'>";
        for (var i = 0; i < list.length; i++) {
            var followup = list[i];
            var dateText = LddFormatDate(followup.FollowUpDate);
            var noteText = followup.Note ? $("<div>").text(followup.Note).html() : "";
            html += "<li><span class='pld-timeline-date'>" + (dateText || "") + "</span><span>" + (noteText || "<span class='pld-muted'>No note</span>") + "</span></li>";
        }
        html += "</ul>";
        $("#FollowupBoxBody").html(html);
    }

    function OpenFollowupModal() {
        $("#FollowupDate").val("");
        $("#FollowupNote").val("");
        if (CurrentLead) {
            $("#FollowupAvatar").text(LddInitials(CurrentLead.Name));
            var subtitleHtml = $("<div>").text(CurrentLead.Name || "").html();
            if (CurrentLead.CompanyName) subtitleHtml += " &middot; " + $("<div>").text(CurrentLead.CompanyName).html();
            $("#FollowupSubtitle").html(subtitleHtml);
        }
        $("#FollowupModalBackdrop").addClass("active");
    }

    function CloseFollowupModal() {
        $("#FollowupModalBackdrop").removeClass("active");
    }

    $("#FollowupCancelBtn, #FollowupCloseBtn").click(function () {
        CloseFollowupModal();
    });

    $("#FollowupSaveBtn").click(function () {
        var followUpDate = $("#FollowupDate").val();
        var note = $.trim($("#FollowupNote").val());
        if (!followUpDate) {
            swal("Warning", "Please pick a follow-up date", "error");
            return;
        }
        $.ajax({
            type: "POST",
            url: "/PreSalesNew/SaveFollowup",
            data: { LeadID: LeadDetailId, FollowUpDate: followUpDate, Note: note }
        }).done(function () {
            CloseFollowupModal();
            LoadFollowup();
        }).fail(function () {
            swal("Error", "Could not save follow-up - please try again.", "error");
        });
    });

    // ---- Activity (SA_MaskEmail_PreSales_LogActivity) ------------------
    function LoadActivity() {
        if (!LeadDetailId) return;
        $.ajax({
            type: "GET",
            url: "/PreSalesNew/GetActivityByLeadId",
            data: { leadId: LeadDetailId },
            dataType: "json"
        }).done(function (response) {
            RenderActivityBox(response && response.DataList);
        }).fail(function () {
            RenderActivityBox(null);
        });
    }

    function RenderActivityBox(list) {
        if (!list || !list.length) {
            $("#ActivityBoxBody").html("<span class='pld-muted'>No activity logged yet.</span>");
            return;
        }
        var html = "<ul class='pld-timeline'>";
        for (var i = 0; i < list.length; i++) {
            var item = list[i];
            var dateText = LddFormatDate(item.CreatedDate);
            var typeText = item.ActivityType ? $("<div>").text(item.ActivityType).html() : "";
            var noteText = item.ActivityNote ? $("<div>").text(item.ActivityNote).html() : "";
            var outcomeText = item.Outcome ? $("<div>").text(item.Outcome).html() : "";
            var body = typeText + (noteText ? (typeText ? " &mdash; " : "") + noteText : "");
            if (outcomeText) body += " (" + outcomeText + ")";
            html += "<li><span class='pld-timeline-date'>" + dateText + "</span><span>" + body + "</span></li>";
        }
        html += "</ul>";
        $("#ActivityBoxBody").html(html);
    }

    function OpenActivityModal() {
        $("#ActivityType").val("Email");
        $("#ActivityNote").val("");
        $("#ActivityOutcome").val("");
        if (CurrentLead) {
            $("#ActivityAvatar").text(LddInitials(CurrentLead.Name));
            var subtitleHtml = $("<div>").text(CurrentLead.Name || "").html();
            if (CurrentLead.CompanyName) subtitleHtml += " &middot; " + $("<div>").text(CurrentLead.CompanyName).html();
            $("#ActivitySubtitle").html(subtitleHtml);
        }
        $("#ActivityModalBackdrop").addClass("active");
    }

    function CloseActivityModal() {
        $("#ActivityModalBackdrop").removeClass("active");
    }

    $("#ActivityCancelBtn, #ActivityCloseBtn").click(function () {
        CloseActivityModal();
    });

    $("#ActivitySaveBtn").click(function () {
        var activityType = $("#ActivityType").val();
        var note = $.trim($("#ActivityNote").val());
        var outcome = $("#ActivityOutcome").val();
        if (!note) {
            swal("Warning", "Please describe what happened", "error");
            return;
        }
        $.ajax({
            type: "POST",
            url: "/PreSalesNew/SaveActivity",
            data: { LeadID: LeadDetailId, ActivityType: activityType, ActivityNote: note, Outcome: outcome }
        }).done(function () {
            CloseActivityModal();
            LoadActivity();
        }).fail(function () {
            swal("Error", "Could not save activity - please try again.", "error");
        });
    });

    // ---- Edit lead (SA_MaskEmail_PreSales) -----------------------------
    // Only reachable while the lead's Status isn't "Transferred" -- the
    // header button is hidden/disabled once transferred (see
    // RenderLeadDetail above), and the server-side proc refuses the update
    // too (belt-and-braces, in case a stale page is used to bypass the
    // button state).
    var EditLeadCountriesLoaded = false;

    // The dropdown only lists a fixed set of source values (WebsiteForms /
    // Chat / Email / SocialMedia / Event-Conference / Others), same as the
    // "Create lead" drawer -- but real leads can carry other literal values
    // (e.g. "Website") that were set outside this form, which don't match
    // any <option>. Without this, .val() would silently select nothing,
    // the dropdown would show the blank placeholder, and saving would then
    // wipe out the lead's real source. Inject a matching option first so
    // the existing value is preserved and actually shows as selected.
    function EditLeadEnsureSourceOption(sourceValue) {
        if (!sourceValue) return;
        var exists = false;
        $("#EditLeadSource option").each(function () {
            if ($(this).val() === sourceValue) { exists = true; return false; }
        });
        if (!exists) {
            var safeValue = $("<div>").text(sourceValue).html();
            $("#EditLeadSource").prepend("<option value='" + safeValue + "'>" + safeValue + "</option>");
        }
    }

    function OpenEditLeadModal() {
        if (!CurrentLead) return;
        if (CurrentLead.Status === "Transferred") {
            swal("Can't edit", "This lead has already been transferred to sales and can no longer be edited.", "warning");
            return;
        }

        $("#EditLeadAvatar").text(LddInitials(CurrentLead.Name));
        var subtitleHtml = $("<div>").text(CurrentLead.Name || "").html();
        if (CurrentLead.CompanyName) subtitleHtml += " &middot; " + $("<div>").text(CurrentLead.CompanyName).html();
        $("#EditLeadSubtitle").html(subtitleHtml);

        EditLeadEnsureSourceOption(CurrentLead.OutboundLeadSource);
        $("#EditLeadSource").val(CurrentLead.OutboundLeadSource || "");
        $("#EditLeadName").val(CurrentLead.Name || "");
        $("#EditLeadCorpEmail").val(CurrentLead.CorpEmail || "");
        $("#EditLeadDesignation").val(CurrentLead.Designation || "");
        $("#EditLeadCompany").val(CurrentLead.CompanyName || "");
        $("#EditLeadMessage").val(CurrentLead.Message || "");

        $("#EditLeadMobile").val(CurrentLead.ContactNumber || "");
        $("#EditLeadTelephone").val(CurrentLead.Telephone || "");
        if (CurrentLead.ContactCountryCode) {
            try { $("#EditLeadMobile").intlTelInput("setNumber", "+" + CurrentLead.ContactCountryCode + (CurrentLead.ContactNumber || "")); } catch (e) { }
        }
        if (CurrentLead.TelephoneCountryCode) {
            try { $("#EditLeadTelephone").intlTelInput("setNumber", "+" + CurrentLead.TelephoneCountryCode + (CurrentLead.Telephone || "")); } catch (e) { }
        }

        if (!EditLeadCountriesLoaded) {
            LoadEditLeadCountries();
        } else if (CurrentLead.CountryName) {
            SelectEditLeadCountryByName(CurrentLead.CountryName);
        }

        $("#EditLeadModalBackdrop").addClass("active");
    }

    function CloseEditLeadModal() {
        $("#EditLeadModalBackdrop").removeClass("active");
    }

    $("#EditLeadCancelBtn, #EditLeadCloseBtn").click(function () {
        CloseEditLeadModal();
    });

    function SelectEditLeadCountryByName(countryName) {
        var found = false;
        $("#EditLeadCountry option").each(function () {
            if ($.trim($(this).text()).toLowerCase() === $.trim(countryName).toLowerCase()) {
                found = true;
                return false;
            }
        });
        if (found) {
            $("#EditLeadCountry option").filter(function () {
                return $.trim($(this).text()).toLowerCase() === $.trim(countryName).toLowerCase();
            }).prop("selected", true);
            $("#EditLeadCountry").trigger("change");
        }
    }

    function LoadEditLeadCountries() {
        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/GetClintCountry",
            contentType: "application/json; charset=utf-8",
            dataType: "json"
        }).done(function (data) {
            EditLeadCountriesLoaded = true;
            var html = "<option value='' disabled>Select Country</option>";
            $((data && data.DataList) || []).each(function (index, value) {
                if (value.CountryName) {
                    html += "<option value='" + value.CountryID + "'>" + $("<div>").text(value.CountryName).html() + "</option>";
                }
            });
            $("#EditLeadCountry").html(html);
            if (CurrentLead && CurrentLead.CountryName) {
                SelectEditLeadCountryByName(CurrentLead.CountryName);
            }
        }).fail(function () {
            EditLeadCountriesLoaded = false;
        });
    }

    $("#EditLeadCountry").change(function () {
        var countryId = $(this).val();
        if (countryId == "1") {
            $("#EditLeadStateField").show();
            $.ajax({
                type: "GET",
                url: "/PreSalesNew/GetStateList",
                data: { countryId: countryId },
                dataType: "json"
            }).done(function (response) {
                var list = (response && response.DataList) || [];
                var html = "<option value='' disabled>Select State</option>";
                $.each(list, function (index, value) {
                    if (value.Text) {
                        html += "<option value='" + value.Value + "'>" + $("<div>").text(value.Text).html() + "</option>";
                    }
                });
                $("#EditLeadState").html(html);
                if (CurrentLead && CurrentLead.StateName) {
                    $("#EditLeadState option").filter(function () {
                        return $.trim($(this).text()).toLowerCase() === $.trim(CurrentLead.StateName).toLowerCase();
                    }).prop("selected", true);
                }
            });
        } else {
            $("#EditLeadStateField").hide();
            $("#EditLeadState").html("<option value='' disabled>Select State</option>");
        }
    });

    $("#EditLeadMobile, #EditLeadTelephone").intlTelInput({
        initialCountry: "in",
        separateDialCode: true
    });

    $("#EditLeadMobile").on('input', function () {
        $(this).val($(this).val().replace(/\D/g, ''));
    });

    $("#EditLeadSaveBtn").click(function () {
        var name = $.trim($("#EditLeadName").val());
        var corpEmail = $.trim($("#EditLeadCorpEmail").val());
        var companyName = $.trim($("#EditLeadCompany").val());
        var source = $("#EditLeadSource").val();
        var countryVal = $("#EditLeadCountry").val();
        var countryText = $("#EditLeadCountry option:selected").text().trim();

        if (name === "") { swal("Warning", "Please enter the name", "error"); return; }
        if (corpEmail === "") { swal("Warning", "Please enter the corp email", "error"); return; }
        if (companyName === "") { swal("Warning", "Please enter the company name", "error"); return; }
        if (!countryVal) { swal("Warning", "Please select a country", "error"); return; }
        if (!source) { swal("Warning", "Please select a lead source", "error"); return; }

        var mobileCode = $("#EditLeadMobile").intlTelInput("getSelectedCountryData").dialCode;
        var mobile = $("#EditLeadMobile").val();
        var telCode = $("#EditLeadTelephone").intlTelInput("getSelectedCountryData").dialCode;
        var telephone = $("#EditLeadTelephone").val();
        var stateText = (countryText === "India") ? $("#EditLeadState option:selected").text().trim() : "";

        var payload = {
            ID: LeadDetailId,
            Name: name,
            CorpEmail: corpEmail,
            ContactCountryCode: mobileCode,
            ContactNumber: mobile,
            TelephoneCountryCode: telCode,
            Telephone: telephone,
            Designation: $.trim($("#EditLeadDesignation").val()),
            CompanyName: companyName,
            CountryFID: countryVal,
            CountryName: countryText,
            StateFID: (countryText === "India") ? $("#EditLeadState").val() : null,
            StateName: stateText,
            Message: $.trim($("#EditLeadMessage").val()),
            OutboundLeadSource: source
        };

        $("#EditLeadSaveBtn").prop("disabled", true).text("Saving...");
        $.ajax({
            type: "POST",
            url: "/PreSalesNew/UpdateLead",
            data: payload
        }).done(function (response) {
            $("#EditLeadSaveBtn").prop("disabled", false).text("Save changes");
            if (response && response.Success) {
                CloseEditLeadModal();
                LoadLeadDetail();
            } else {
                swal("Couldn't save", (response && response.Message) || "Please try again.", "error");
            }
        }).fail(function () {
            $("#EditLeadSaveBtn").prop("disabled", false).text("Save changes");
            swal("Error", "Could not update lead - please try again.", "error");
        });
    });

    $(document).ready(function () {
        LoadLeadDetail();
    });
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/2.1.0/sweetalert.min.js"></script>
