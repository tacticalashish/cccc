<script>

        $(document).ready(function () {
           
            populateYearDropdown();

            $('#selectmonth').val(new Date().toLocaleString('default', { month: 'long' }));
        });

        function populateYearDropdown() {
            const currentYear = new Date().getFullYear();
            const $yearDropdown = $('#selectYear');

            $yearDropdown.empty(); // Clear existing options
            $yearDropdown.append(`<option value="">--Select Year--</option>`);

            // Add previous 5 years and current year
            for (let i = 5; i >= 0; i--) {
                const year = currentYear - i;
                const isSelected = year === currentYear ? 'selected' : ''; // Mark current year as selected
                $yearDropdown.append(`<option value="${year}" ${isSelected}>${year}</option>`);
            }
        }

        function GetManagersearchValues() {
            Search = $('#Managersearch').val();
            $('#Managersearch').html(GetPaginationHTML(Search));
            GetManagerViewBasedOnSearchFilter();
        }

        $.formattedDate = function (dateToFormat) {
            var dateObject = new Date(dateToFormat);
            var day = dateObject.getDate();
            var month = dateObject.getMonth() + 1;
            var year = dateObject.getFullYear();
            day = day < 10 ? "0" + day : day;
            month = month < 10 ? "0" + month : month;
            var formattedDate = day + "/" + month + "/" + year;
            return formattedDate;
        };

        $(document).ready(function () {

            GetManagerViewBasedOnSearchFilter();
        });
        function GetPaginationHTML(json) {

            var pagingInnerHTML = "<span class='pull-left py-5' style='color:#fff'>(Showing " + json.ShowingFrom + " to " + json.ShowingTo + " of " + json.RecordsCount + " records)</span>";
            var getPaginationButton = GetPagination(json.ActivePage, json.PagerSize, json.NumberOfPages, "");
            pagingInnerHTML += getPaginationButton;

            return pagingInnerHTML;
        }
        function PaggingButton(elm) {

            var pageNumber = elm.attr('url');

            $('#ManagerPageNumber').val(pageNumber);

            GetManagerViewBasedOnSearchFilter();

        }

        function GetPagination(activePage, pagerSize, numberOfPages, URL) {

            var innerHTML = '';
            var startLi = pagerSize / pagerSize;
            var endLi = pagerSize;
            var multiplier = activePage / pagerSize;
            var modulo = activePage % pagerSize;
            var virtualLi = pagerSize - pagerSize;
            var previous = activePage / pagerSize * pagerSize - pagerSize + 1;
            var next = activePage / pagerSize * pagerSize + pagerSize + 1;

            if (modulo == 0) {
                next = next - pagerSize;
                previous = previous - pagerSize;
            }

            if (activePage > pagerSize) {
                for (var i = 1; i <= multiplier; i++) {
                    virtualLi += pagerSize;
                }

                if (modulo > 0) {
                    startLi = virtualLi + 1;
                }
                else {
                    startLi = virtualLi - pagerSize + 1;
                }
                endLi = startLi + pagerSize - 1;
            }

            innerHTML = "<ul class='pagination pagination-sm no-margin pull-right'>";
            if (activePage > 1 && activePage < pagerSize + 1) {
                innerHTML += "<li class='paginate_button previous disabled' style='display:none;'>";
                innerHTML += "<a href='javascript:void(0);"

                innerHTML += "'><i class='fa fa-fw fa-arrow-left'></i></a>";
                innerHTML += "</li>";

                if (activePage == 1) {
                    innerHTML += "<li class='paginate_button previous disabled'>";
                    innerHTML += "<a href='javascript:void(0);";
                    innerHTML += "'>&laquo;</a>";
                    innerHTML += "</li>";
                }
                else {
                    innerHTML += "<li class='paginate_button previous'>";
                    innerHTML += "<a href='javascript:void(0);'  url='";
                    //innerHTML += URL + "&id=" + (activePage - 1);
                    innerHTML += URL + (activePage - 1);
                    innerHTML += "' onclick='PaggingButton($(this));'>&laquo;</a>";
                    innerHTML += "</li>";
                }
            }
            else if (activePage == 1) {
                innerHTML += "<li class='paginate_button previous disabled' disabled style='display:none;'>";
                innerHTML += "<a href='javascript:void(0);";
                innerHTML += "'><i class='fa fa-fw fa-arrow-left'></i></a>";
                innerHTML += "</li>";
                innerHTML += "<li class='paginate_button previous disabled'>";
                innerHTML += "<a href='javascript:void(0);";
                innerHTML += "'>&laquo;</a>";
                innerHTML += "</li>";
            }
            else {
                innerHTML += "<li class='paginate_button previous'>";
                innerHTML += "<a href='javascript:void(0);'  url='";
                //innerHTML += URL + "&id=" + (previous);
                innerHTML += URL + (previous);
                innerHTML += "' onclick='PaggingButton($(this));'><i class='fa fa-fw fa-arrow-left'></i></a>";
                innerHTML += "</li>";
                innerHTML += "<li class='paginate_button previous'>";
                innerHTML += "<a href='javascript:void(0);'  url='";
                //innerHTML += URL + "&id=" + (activePage - 1);
                innerHTML += URL + (activePage - 1);
                innerHTML += "' onclick='PaggingButton($(this));'>&laquo;</a>";
                innerHTML += "</li>";
            }


            for (var i = startLi; i <= endLi && i <= numberOfPages; i++) {
                if (i == activePage) {
                    innerHTML += "<li>";
                    innerHTML += "<a style='background-color:gainsboro;' href='javascript:void(0);";
                }
                else {
                    innerHTML += "<li class='paginate_button'>";
                    innerHTML += "<a onclick='PaggingButton($(this));' href='javascript:void(0);'  url='";
                    //innerHTML += URL + "&id=" + i;
                    innerHTML += URL + i;
                }

                innerHTML += "' >";
                innerHTML += i;
                innerHTML += "</a>";
                innerHTML += "</li>";
            }

            if (activePage + pagerSize > numberOfPages) {
                if (activePage == numberOfPages) {
                    innerHTML += "<li class='paginate_button next disabled'>";
                    innerHTML += "<a href='javascript:void(0);";
                    innerHTML += "'>&raquo;</a>";
                    innerHTML += "</li>";
                }
                else {
                    innerHTML += "<li class='paginate_button next'>";
                    innerHTML += "<a href='javascript:void(0);'  url='";
                    //innerHTML += URL + "&id=" + (activePage + 1);
                    innerHTML += URL + (activePage + 1);

                    innerHTML += "' onclick='PaggingButton($(this));'>&raquo;</a>";
                    innerHTML += "</li>";
                }

                innerHTML += "<li class='paginate_button next disabled' style='display:none;'>";
                innerHTML += "<a href='javascript:void(0);";
                innerHTML += "'><i class='fa fa-fw fa-arrow-right'></i></a>";
                innerHTML += "</li>";
            }
            else if (activePage == numberOfPages) {
                innerHTML += "<li class='paginate_button next disabled'>";
                innerHTML += "<a href='javascript:void(0);";
                innerHTML += "'>&raquo;</a>";
                innerHTML += "</li>";
                innerHTML += "<li class='paginate_button next disabled'> style='display:none;'";
                innerHTML += "<a href='javascript:void(0);";
                innerHTML += "'><i class='fa fa-fw fa-arrow-right'></i></a>";
                innerHTML += "</li>";
            }
            else {
                innerHTML += "<li class='paginate_button next'>";
                innerHTML += "<a href='javascript:void(0);'  url='";
                //innerHTML += URL + "&id=" + (activePage + 1);
                innerHTML += URL + (activePage + 1);

                innerHTML += "' onclick='PaggingButton($(this));'>&raquo;</a>";
                innerHTML += "</li>";

                innerHTML += "<li class='paginate_button next'>";
                innerHTML += "<a href='javascript:void(0);'  url='";
                //innerHTML += URL + "&id=" + (next);
                innerHTML += URL + (next);

                innerHTML += "' onclick='PaggingButton($(this));'><i class='fa fa-fw fa-arrow-right'></i></a>";
                innerHTML += "</li>";
            }
            innerHTML += "</ul>";

            return innerHTML;
        }


        function Showpopup(ID, value) {

            $("#AddMoreRating").css("display", "block");
            $("#ID").val(ID);
            $("#AssociateRating").val(value);
        }

        $("#Cancelparameters").click(function () {
            $("#AddMoreRating").css("display", "none");
        });

        $("#CancelDetails").click(function () {
            $("#ShowDetails").css("display", "none");
        });

        function GetManagerViewBasedOnSearchFilter() {
            var TotalCount = 0;
            var pageNumber = $('#ManagerPageNumber').val();
            var Search = $('#Managersearch').val();
            var FromDate = $('#FromDate').val();
            var ToDate = $('#Todate').val();
            var Month = $('#selectmonth').val();
            var Year = $('#selectYear').val();
            var URL = "/PricingRating/GetManagerViewRatingList?searchKeyword='" + Search + "'";
            URL += '&Year=' + Year;
            URL += '&Month=' + Month;
            URL += '&PageNumber=' + pageNumber;
            URL += '&FromDate=' + FromDate;
            URL += '&ToDate=' + ToDate;

            $.ajax({
                url: URL,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                success: function (json) {
                    var tbodyHTML = '';
                    if (json != null) {
                        $(json.DateList).each(function (idx, elm) {
                            var formattedDate = ($.formattedDate(new Date(parseInt(elm.CreatedDate.substr(6)))));
                            tbodyHTML += "<tr>";
                            tbodyHTML += "<td hidden>" + elm.ID + "</td>";
                            tbodyHTML += "<td>" + elm.AssociateName + "</td>";
                            tbodyHTML += "<td>" + elm.Year + "</td>";
                            tbodyHTML += "<td>" + elm.Month + "</td>";
                            tbodyHTML += "<td>" + "<input type='button' class='btn btn-xs btn-info' value='Show' onclick=ShowDetails('" + elm.Id + "')>" + "</td>";
                            tbodyHTML += "<td>" + elm.AssociateRating + "</td>";
                            tbodyHTML += "<td>" + elm.CreatedBy + "</td>";
                            tbodyHTML += "<td>" + formattedDate + "</td>";
                            tbodyHTML += "<td>" + elm.TotalRating + "</td>";
                            if (elm.TotalRating == null || elm.TotalRating == ""){
                                tbodyHTML += "<td>" + "<input type='button' class='btn btn-xs btn-info' value='Add More Rating' onclick=Showpopup('" + elm.Id + "','" + elm.AssociateRating + "')>" + "</td>";
                            }
                           
                            tbodyHTML += "</tr>"
                        });

                        $('#ManagerdivPagging').html(GetPaginationHTML(json));
                        $('#pageSize').val(json.PageSize);

                    }
                    else {
                        tbodyHTML = "<tr><td class='text-center' colspan='20'><span>No records found..!!</span> </td></tr>";
                    }

                    //$('#CountAssignProduct').text('Assign Products : ' + TotalCount + '');
                    $('.Managertbodydata').html(tbodyHTML);
                }
            });
        }



        function SubmitRating() {
            debugger;
           
            var ProductQualityQuery = $("#ProductQualityQuery").val();
            var ID = $("#ID").val();
            var Discipline = $("#Discipline").val();
            var ProductAddon = $("#ProductAddon").val();
            var ProductQualityQueryFeedback = $("#ProductQualityQueryFeedback").val();
            var DisciplineFeedback = $("#DisciplineFeedback").val();
            var ProductAddonFeedback = $("#ProductAddonFeedback").val();
            var TotalRating = $("#TotalRatings").html();           
            var Desc = {
                Id: ID,
                ProductQualityQuery: ProductQualityQuery,
                Discipline: Discipline,
                ProductAddon: ProductAddon,
                TotalRating: TotalRating,
                ProductQualityQueryFeedback: ProductQualityQueryFeedback,
                DisciplineFeedback: DisciplineFeedback,
                ProductAddonFeedback: ProductAddonFeedback


            };
            if (ProductQualityQuery == "") {
                Swal.fire({
                    title: "Please select Product Quality !",
                    type: "success",
                    customClass: {
                        popup: 'small-popup'
                    }
                }).then(function () {
                });
            }
            else if (Discipline == "") {
                Swal.fire({
                    title: "Please select Discipline !",
                    type: "success"
                }).then(function () {
                });
            } else if (ProductQualityQueryFeedback == "") {
                Swal.fire({
                    title: "Please Enter Product QualityFeedback !",
                    type: "success"
                }).then(function () {
                });
            } else if (DisciplineFeedback == "") {
                Swal.fire({
                    title: "Please Enter Discipline Feedback !",
                    type: "success"
                }).then(function () {
                });
            }
            else if (TotalRating == "") {
                Swal.fire({
                    title: "Please Enter Total Rating !",
                    type: "success"
                }).then(function () {
                });
            }

            else if (ProductAddon != "" && ProductAddonFeedback=="") {
                Swal.fire({
                    title: "Please Enter Product Addon Feedback !",
                    type: "success"
                }).then(function () {
                });
            } else if (ProductAddon == "" && ProductAddonFeedback != "") {
                Swal.fire({
                    title: "Please select  Product Addon !",
                    type: "success"
                }).then(function () {
                });
            }

            else {
                $.ajax({
                    type: "POST",
                    url: "/PricingRating/InsertManagerRating",
                    data: '{Desc: ' + JSON.stringify(Desc) + '}',
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (response) {
                        debugger;
                        var responseMessage = response;
                        if (responseMessage == "Success") {
                            Swal.fire({
                                title: "Thank you!",
                                text: "Insert Sucessfully.",
                                icon: "success"
                            }).then(function () {
                                //window.location.href = "../../PricingRating/ManagerViewRating";
                            });

                        }
                        else if (responseMessage == "Already Exist") {
                            Swal.fire({
                                title: "Failed!",
                                text: "Already Exist.",
                                icon: "error"
                            }).then(function () {
                                //window.location.href = "../../PricingRating/ManagerViewRating";
                            });
                        }

                        else {
                            swal({
                                title: "Failed!",
                                text: "Failed Try Again.",
                                type: "success"
                            }).then(function () {
                                //window.location.href = "../../PricingRating/AssociatePricingRating";
                            });
                        }
                    },
                    Error: function (ErrMsg) {
                        //window.location.href = "../../PricingRating/AssociatePricingRating";
                    }
                });



             }
            $("#Discipline").val('')
            $("#ProductAddon").val('')
            $("#ProductQualityQuery").val('')
            $("#ProductQualityQueryFeedback").val('')
            $("#DisciplineFeedback").val('')
            $("#ProductAddonFeedback").val('')
            $("#TotalRatings").html('')
        }

        function ShowDetails(value) {
            var URL = "/PricingRating/GetRatingDetails?id=" + value;
            $.ajax({
                url: URL,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                success: function (json) {
                    debugger;
                    if (json != null) {
                        $(json).each(function (idx, elm) {
                            CKEDITOR.instances.Description.setData(elm.Details);
                            $('#DassociateName').html(elm.AssociateName);
                            $("#ShowDetails").css("display", "block");
                        });
                    }
                }
            });
        }


        function CALTotalRating() {
            debugger;
            var qcRating = parseFloat($('#AssociateRating').val()) || 0;
            var productQuality = parseFloat($('#ProductQualityQuery').val()) || 0;
            var discipline = parseFloat($('#Discipline').val()) || 0;
            var ProductAddon = parseFloat($('#ProductAddon').val()) || 0;

            // Apply weights
            var totalScore = (qcRating * 0.70) + (productQuality * 0.20) + (discipline * 0.10) + (ProductAddon * 0.10);
            $('#TotalRatings').text(totalScore.toFixed(3));

        }

</script>
