
@{
    ViewBag.Title = "ViewAllEmpRatingView";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/ckeditor/ckeditor.js" type="text/javascript"></script>
<style>
    .circle-text {
        width: 25px;
        height: 25px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 100px;
        background: black;
        font-size: 14px;
        font-weight: bold;
    }
</style>
<div class="update-profile-wrapper">
    <div class="white-wrapper pt-0 mt-0 container-fluid">
        <div class="row">

            <div class="col-sm-12 col-md-12 mt-2 pb-2">
                <h4 class="text-white pb-2">Check Rating List</h4>
                <div class="mt-2" style="background: #00000066;
    padding: 6px 6px;
    margin: 16px 1px;
    border-radius: 6px;">
                   
                    <h6 class="h5 text-white"><span class="circle-text">1</span> <span> Enter the employee's name in the search box and press the search button to get the average ratings and deduction Percent for a single employee.</span></h6>
                    <h5 class="h5 text-white"><span class="circle-text">2</span><span> To date must be the same as the appraisal cycle date.</span></h5>
                </div>
            
            </div>
            
            <div class="col-sm-12 col-md-4">
                <div class="d-flex align-items-center">
                    <div class="input-group">
                        <input type="text" class="form-control" id="FromDate" autocomplete="off" />
                        <div class="input-group-addon p-1"><i class="fa fa-calendar"></i></div>
                    </div>
                    <div class="input-group ms-2">
                        <input type="text" class="form-control ms-2" id="Todate" autocomplete="off" />
                        <div class="input-group-addon p-1"><i class="fa fa-calendar"></i></div>
                    </div>
                </div>
            </div>
            <div class="col-sm-12  col-md-4">
                <div  class="d-flex align-items-center">
                    <select id="Type" class="form-control ms-2" onchange="GetViewBasedOnSearchFilter()">
                        <option value="Pricing">Pricing</option>
                        <option value="Insight">Insight</option>
                    </select>
                    <select id="Employe" class="form-control ms-2" onchange="GetViewBasedOnSearchFilter()">
                        <option value="Associate">Associate</option>
                        <option value="Consultant">Consultant</option>
                        <option value="QC">QC</option>
                    </select>
                </div>
                </div>
            <div class="col-sm-12 col-md-4 d-flex align-items-center justify-content-between">
                <label><input type="text" name="search" class="form-control form-control-sm " placeholder="Search..." id="Managersearch" aria-controls="Userlist"></label>
                <input type="button" class="btn btn-success px-4 ms-2" value="Search" onclick="GetManagersearchValues()" />
                <button onclick="downloadExcel()" class="btn btn-primary btn-sm"><i class="fa fa-file-excel-o" aria-hidden="true" style="font-size:18px;"></i></button>
                <input type="hidden" id="ManagerPageNumber" name="ManagerPageNumber" value="1" />
            </div>
            </div>       
        <div class="data-detail-wrapper table-responsive scrolladmin01  mt-2">
            <table id="Associateratinglist" class="table table-sm table-bordered mb-0">
                <thead class="bg-dark text-nowrap">
                    <tr>
                      
                        <th>Name</th>
                        <th>year</th>
                        <th>Month</th>                       
                        <th>Total Rating</th>
                        <th id="Avgrat" style="display:none">AVGRating</th>
                        <th id="Amount" style="display:none">Appraisal + Incentive (Amount)</th>
                        <th id="Percent" style="display:none">Deducation Percent</th>
                        <th id="TotalAmount" style="display:none">Remaining Appraisal Amount</th>
                        <th id="IncentiveAmount" style="display:none">Remaining Incentive Amount</th>
                    </tr>
                </thead>
                <tbody class="Managertbodydata" id="Managertbodydata"></tbody>
            </table>

        </div>
    </div>
    <div class="box-footer clearfix" id="ManagerdivPagging"></div>
</div>
<div class="position-relative popup-open1" id="AddMoreRating" style="display:none">
    <div class="child01" style="padding:5px!important">
        <textarea rows="4" name="Description" placeholder="Description *"></textarea>
        <script type="text/javascript">
            CKEDITOR.replace("Description");
        </script>
        <div class="col-md-12 mt-2">
            <button class="btn btn-danger btn-sm" style="float:right" id="Cancelparameters" type="button">Cancel</button>
        </div>
    </div>
</div>
<link rel="stylesheet" type="text/css" href="~/css/jquery.datetimepicker.css" />
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" />
<link href="https://ajax.googleapis.com/ajax/libs/jqueryui/1.8/themes/base/jquery-ui.css" rel="Stylesheet" type="text/css" />
<script src="~/js/bootstrap-select.js"></script>
<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-datetimepicker/2.5.20/jquery.datetimepicker.js"></script>

<script>
            function downloadExcel() {
                // Get the table
                let table = document.getElementById("Associateratinglist");
                let wb = XLSX.utils.book_new(); // Create a new workbook

                // Convert table to worksheet
                let ws = XLSX.utils.table_to_sheet(table);

                // Append worksheet to workbook
                XLSX.utils.book_append_sheet(wb, ws, "Sheet1");

                // Save the file
                XLSX.writeFile(wb, "table_data.xlsx");
            }


            $("#Cancelparameters").click(function () {
                $("#AddMoreRating").css("display", "none");
            });
            $(document).ready(function () {

                populateYearDropdown();
                $("#Todate").datepicker({ dateFormat: "dd/MM/yy" });
                $("#FromDate").datepicker({ dateFormat: "dd/MM/yy" });

                $('#selectmonth').val(new Date().toLocaleString('default', { month: 'long' }));
            });

            function populateYearDropdown() {
                const currentYear = new Date().getFullYear();
                const $yearDropdown = $('#selectYear');

                $yearDropdown.empty(); // Clear existing options
                $yearDropdown.append(`<option value="">--Select Year--</option>`);

                // Add previous 5 years and current year
                for (let i = 5; i >= 0; i--) {
                    const year = currentYear - i;
                    const isSelected = year === currentYear ? 'selected' : ''; // Mark current year as selected
                    $yearDropdown.append(`<option value="${year}" ${isSelected}>${year}</option>`);
                }
            }


            function getFormattedDate(date) {
                return date.toISOString().split('T')[0];
            }

            const today = new Date();

            // Set 'fromDate' to the 1st of the previous month
            const fromDate = new Date(today.getFullYear(), today.getMonth() - 1, 1);

            const toDatePlusOne = new Date(today);
            toDatePlusOne.setDate(toDatePlusOne.getDate() + 1);

            document.getElementById('FromDate').setAttribute('value', getFormattedDate(fromDate));
            document.getElementById('Todate').setAttribute('value', getFormattedDate(toDatePlusOne));



            function GetManagersearchValues() {
                Search = $('#Managersearch').val();
                $('#Managersearch').html(GetPaginationHTML(Search));
                GetViewBasedOnSearchFilter();
            }

            $.formattedDate = function (dateToFormat) {
                var dateObject = new Date(dateToFormat);
                var day = dateObject.getDate();
                var month = dateObject.getMonth() + 1;
                var year = dateObject.getFullYear();
                day = day < 10 ? "0" + day : day;
                month = month < 10 ? "0" + month : month;
                var formattedDate = day + "/" + month + "/" + year;
                return formattedDate;
            };

            $(document).ready(function () {

                GetViewBasedOnSearchFilter();
            });
            function GetPaginationHTML(json) {

                var pagingInnerHTML = "<span class='pull-left py-5' style='color:#fff'>(Showing " + json.ShowingFrom + " to " + json.ShowingTo + " of " + json.RecordsCount + " records)</span>";
                var getPaginationButton = GetPagination(json.ActivePage, json.PagerSize, json.NumberOfPages, "");
                pagingInnerHTML += getPaginationButton;

                return pagingInnerHTML;
            }
            function PaggingButton(elm) {

                var pageNumber = elm.attr('url');

                $('#ManagerPageNumber').val(pageNumber);

                GetViewBasedOnSearchFilter();

            }

            function GetPagination(activePage, pagerSize, numberOfPages, URL) {

                var innerHTML = '';
                var startLi = pagerSize / pagerSize;
                var endLi = pagerSize;
                var multiplier = activePage / pagerSize;
                var modulo = activePage % pagerSize;
                var virtualLi = pagerSize - pagerSize;
                var previous = activePage / pagerSize * pagerSize - pagerSize + 1;
                var next = activePage / pagerSize * pagerSize + pagerSize + 1;

                if (modulo == 0) {
                    next = next - pagerSize;
                    previous = previous - pagerSize;
                }

                if (activePage > pagerSize) {
                    for (var i = 1; i <= multiplier; i++) {
                        virtualLi += pagerSize;
                    }

                    if (modulo > 0) {
                        startLi = virtualLi + 1;
                    }
                    else {
                        startLi = virtualLi - pagerSize + 1;
                    }
                    endLi = startLi + pagerSize - 1;
                }

                innerHTML = "<ul class='pagination pagination-sm no-margin pull-right'>";
                if (activePage > 1 && activePage < pagerSize + 1) {
                    innerHTML += "<li class='paginate_button previous disabled' style='display:none;'>";
                    innerHTML += "<a href='javascript:void(0);"

                    innerHTML += "'><i class='fa fa-fw fa-arrow-left'></i></a>";
                    innerHTML += "</li>";

                    if (activePage == 1) {
                        innerHTML += "<li class='paginate_button previous disabled'>";
                        innerHTML += "<a href='javascript:void(0);";
                        innerHTML += "'>&laquo;</a>";
                        innerHTML += "</li>";
                    }
                    else {
                        innerHTML += "<li class='paginate_button previous'>";
                        innerHTML += "<a href='javascript:void(0);'  url='";
                        //innerHTML += URL + "&id=" + (activePage - 1);
                        innerHTML += URL + (activePage - 1);
                        innerHTML += "' onclick='PaggingButton($(this));'>&laquo;</a>";
                        innerHTML += "</li>";
                    }
                }
                else if (activePage == 1) {
                    innerHTML += "<li class='paginate_button previous disabled' disabled style='display:none;'>";
                    innerHTML += "<a href='javascript:void(0);";
                    innerHTML += "'><i class='fa fa-fw fa-arrow-left'></i></a>";
                    innerHTML += "</li>";
                    innerHTML += "<li class='paginate_button previous disabled'>";
                    innerHTML += "<a href='javascript:void(0);";
                    innerHTML += "'>&laquo;</a>";
                    innerHTML += "</li>";
                }
                else {
                    innerHTML += "<li class='paginate_button previous'>";
                    innerHTML += "<a href='javascript:void(0);'  url='";
                    //innerHTML += URL + "&id=" + (previous);
                    innerHTML += URL + (previous);
                    innerHTML += "' onclick='PaggingButton($(this));'><i class='fa fa-fw fa-arrow-left'></i></a>";
                    innerHTML += "</li>";
                    innerHTML += "<li class='paginate_button previous'>";
                    innerHTML += "<a href='javascript:void(0);'  url='";
                    //innerHTML += URL + "&id=" + (activePage - 1);
                    innerHTML += URL + (activePage - 1);
                    innerHTML += "' onclick='PaggingButton($(this));'>&laquo;</a>";
                    innerHTML += "</li>";
                }


                for (var i = startLi; i <= endLi && i <= numberOfPages; i++) {
                    if (i == activePage) {
                        innerHTML += "<li>";
                        innerHTML += "<a style='background-color:gainsboro;' href='javascript:void(0);";
                    }
                    else {
                        innerHTML += "<li class='paginate_button'>";
                        innerHTML += "<a onclick='PaggingButton($(this));' href='javascript:void(0);'  url='";
                        //innerHTML += URL + "&id=" + i;
                        innerHTML += URL + i;
                    }

                    innerHTML += "' >";
                    innerHTML += i;
                    innerHTML += "</a>";
                    innerHTML += "</li>";
                }

                if (activePage + pagerSize > numberOfPages) {
                    if (activePage == numberOfPages) {
                        innerHTML += "<li class='paginate_button next disabled'>";
                        innerHTML += "<a href='javascript:void(0);";
                        innerHTML += "'>&raquo;</a>";
                        innerHTML += "</li>";
                    }
                    else {
                        innerHTML += "<li class='paginate_button next'>";
                        innerHTML += "<a href='javascript:void(0);'  url='";
                        //innerHTML += URL + "&id=" + (activePage + 1);
                        innerHTML += URL + (activePage + 1);

                        innerHTML += "' onclick='PaggingButton($(this));'>&raquo;</a>";
                        innerHTML += "</li>";
                    }

                    innerHTML += "<li class='paginate_button next disabled' style='display:none;'>";
                    innerHTML += "<a href='javascript:void(0);";
                    innerHTML += "'><i class='fa fa-fw fa-arrow-right'></i></a>";
                    innerHTML += "</li>";
                }
                else if (activePage == numberOfPages) {
                    innerHTML += "<li class='paginate_button next disabled'>";
                    innerHTML += "<a href='javascript:void(0);";
                    innerHTML += "'>&raquo;</a>";
                    innerHTML += "</li>";
                    innerHTML += "<li class='paginate_button next disabled'> style='display:none;'";
                    innerHTML += "<a href='javascript:void(0);";
                    innerHTML += "'><i class='fa fa-fw fa-arrow-right'></i></a>";
                    innerHTML += "</li>";
                }
                else {
                    innerHTML += "<li class='paginate_button next'>";
                    innerHTML += "<a href='javascript:void(0);'  url='";
                    //innerHTML += URL + "&id=" + (activePage + 1);
                    innerHTML += URL + (activePage + 1);

                    innerHTML += "' onclick='PaggingButton($(this));'>&raquo;</a>";
                    innerHTML += "</li>";

                    innerHTML += "<li class='paginate_button next'>";
                    innerHTML += "<a href='javascript:void(0);'  url='";
                    //innerHTML += URL + "&id=" + (next);
                    innerHTML += URL + (next);

                    innerHTML += "' onclick='PaggingButton($(this));'><i class='fa fa-fw fa-arrow-right'></i></a>";
                    innerHTML += "</li>";
                }
                innerHTML += "</ul>";

                return innerHTML;
            }

            function GetViewBasedOnSearchFilter() {
                var TotalCount = 0;
                var pageNumber = $('#ManagerPageNumber').val();
                var Search = $('#Managersearch').val();
                var FromDate = $('#FromDate').val();
                var Todate = $('#Todate').val();
                var Type = $('#Type').val();
                var Employe = $('#Employe').val();
                var URL = "/PricingRating/AllEmpRatingListView?searchKeyword='" + Search + "'";
                URL += '&FromDate=' + FromDate;
                URL += '&Todate=' + Todate;
                URL += '&PageNumber=' + pageNumber;
                URL += '&Type=' + Type;
                URL += '&Type2=' + Employe;

                $.ajax({
                    url: URL,
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    async: false,
                    success: function (json) {
                        var tbodyHTML = '';
                        if (json != null) {
                            $(json.DateList).each(function (idx, elm) {                              
                                tbodyHTML += "<tr>";                              
                                tbodyHTML += "<td>" + elm.AssociateName + "</td>";
                                tbodyHTML += "<td>" + elm.Year + "</td>";
                                tbodyHTML += "<td>" + elm.Month + "</td>";                               
                                tbodyHTML += "<td>" + elm.TotalRating + "</td>";
                                if (elm.AVGRating!='0.000'){
                                    tbodyHTML += "<td>" + elm.AVGRating + "</td>";
                                    tbodyHTML += "<td>" + elm.Amount + "+" + elm.Incentive + "</td>";
                                    tbodyHTML += "<td>" + elm.Percent + "%</td>";
                                    tbodyHTML += "<td>" + elm.TotalAmount + "</td>";
                                    tbodyHTML += "<td>" + elm.IncentiveAmount + "</td>";

                                    $('#Avgrat').show();
                                    $('#Amount').show();
                                    $('#Percent').show();
                                    $('#TotalAmount').show();
                                    $('#IncentiveAmount').show();
                                } else {
                                    $('#Avgrat').hide();
                                    $('#Amount').hide();
                                    $('#Percent').hide();
                                    $('#TotalAmount').hide();
                                    $('#IncentiveAmount').hide();
                                }
                              
                                tbodyHTML += "</tr>"
                            });

                            $('#ManagerdivPagging').html(GetPaginationHTML(json));
                            $('#pageSize').val(json.PageSize);

                        }
                        else {
                            tbodyHTML = "<tr><td class='text-center' colspan='20'><span>No records found..!!</span> </td></tr>";
                        }

                        //$('#CountAssignProduct').text('Assign Products : ' + TotalCount + '');
                        $('.Managertbodydata').html(tbodyHTML);
                    }
                });
            }





            function ShowDetails(value) {
                var URL = "/PricingRating/GetRatingDetails?id=" + value;
                $.ajax({
                    url: URL,
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    async: false,
                    success: function (json) {
                        debugger;
                        if (json != null) {
                            $(json).each(function (idx, elm) {
                                CKEDITOR.instances.Description.setData(elm.Details);
                                $('#DassociateName').html(elm.AssociateName)
                                $("#AddMoreRating").css("display", "block");
                            });
                        }
                    }
                });
            }


</script>
