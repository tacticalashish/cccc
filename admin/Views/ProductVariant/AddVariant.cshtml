@using ChemAnalyst.DAL
@{
    ViewBag.Title = "AddVariant";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.13.14/css/bootstrap-select.min.css" />
    <link href="https://cdn.datatables.net/1.10.15/css/dataTables.bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/responsive/2.1.1/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <script defer src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/2.1.0/sweetalert.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.15/js/dataTables.bootstrap4.min.js "></script>
  
    <style>
        .card {
            border: solid .5px gray;
            border-radius: 6px;
            padding: 12px 6px;
        }
        table {
            font-size: 12px !important;
        }

            table th table td {
                padding: 3px !important;
            }

        .table-sm th {
            font-size: 12px;
            font-weight: 600;
            padding: 3px !important;
            color: #449d44;
            background-color: black;
        }

        .data-detail-wrapper button.btn.btn-danger {
            padding: 0px 12px;
            font-size: 11px;
            border-radius: 30px;
            line-height: 16px;
        }
    </style>
</head>

<div class="update-profile-wrapper">
    <div class="white-wrapper">
      <div class="container-fluid">
          <div class="row px-2">
              <div class="col-md-12"><h3 class="text-white">Add Product Variant</h3></div>
          </div>
          <div class="card">
              <div class="row px-2">
                  <div class="col-md-3">
                      <select name="product" id="product" class="selectpicker" data-live-search="true" data-max-options="1" data-selected-text-format="count > 1" data-none-selected-text="Select Country"></select>
                  </div>
                  <div class="col-md-3">
                      <select name="country" id="country" class="selectpicker" data-live-search="true" data-max-options="1" data-selected-text-format="count > 1" data-none-selected-text="Select Country"></select>
                  </div>
                  <div class="col-md-5">
                      <input type="text" class="form-control" placeholder="Variant" id="Variant" name="Variant" autocomplete="off" />
                  </div>
                  <div class="col-md-1">
                      <input type="submit" onclick="SaveVariant()" class="btn btn-primary btn-sm " value="Save">
                  </div>
              </div>
          </div>
          <div class="card  mt-2">
              <div class="row">
                  <div class="col-md-12">
                      <h6 class="text-white pb-2">Current Available Data</h6>
                      <div class="data-detail-wrapper table-responsive scrolladmin01" style="overflow:auto">
                          <table id="Leadlist" class="table tableStyle table-bordered table-sm text-nowrap ">
                              <thead>
                                  <tr>
                                      <th>CountryName</th>
                                      <th>ProductName</th>
                                      <th>ProductVariant</th>
                                     
                                  </tr>
                              </thead>
                              <tbody class="tbodydatabackend" id="tbodydatabackend"></tbody>
                          </table>
                      </div>
                  </div>
              </div>
          </div>
      </div>
       
    </div>
</div>
@section scripts{
    <script type="text/javascript">

        $(document).ready(function () {

            GetProduct();
            GetCountry();
        });

        function GetCountry() {
            $.ajax({
                type: "POST",
                url: "/LeadManagementSubscription/GetClintCountry",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                success: function (data) { 

                    var innerHTML = "";
                    innerHTML += "<option  value = ''>" + "Select Country" + "</option>";
                    $(data.DataList).each(function (index, value) {
                        if (value.CountryName != null || value.CountryName != "" || value.CountryName != undefined) {
                            innerHTML += "<option class='option01' value = '" + value.CountryID + "'> " + value.CountryName + "</option>"
                        }
                    });

                    $('#country').html(innerHTML);
                    $('#country').selectpicker('refresh');

                },
                failure: function (response) {
                    console.log(response)
                },
                error: function (response) {
                    console.log(response)
                }
            });
        }
        function GetProduct() {
            $.ajax({
                type: "POST",
                url: "/AdminChemicalPricing/GetProduct",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                success: function (data) {

                    var innerHTML = "";
                    innerHTML += "<option  value = ''>" + "Select ProductName" + "</option>";
                    $(data.DateList).each(function (index, value) {
                        if (value.ProductName != null || value.ProductName != "" || value.ProductName != undefined) { 
                            innerHTML += "<option class='option01' value = '" + value.ID + "'> " + value.ProductName + "</option>"
                        }
                    });

                    $('#product').html(innerHTML);
                    $('#product').selectpicker('refresh');

                },
                failure: function (response) {
                    console.log(response)
                },
                error: function (response) {
                    console.log(response)
                }
            });
        } 
        $('#product').change(function () {
            GetCountry();
            $("#Variant").val('');
        });

        $('#country').change(function () {
            
            GetavilableProductCountryUnit();
            $("#Variant").val('');
        });

        function GetavilableProductCountryUnit() {
            
            var CountryName = $("#country option:selected").text();
            CountryName= CountryName.replace(/^\s+/, '');
            var Product = $("#product").val();
            $.ajax({
                type: "POST",
                url: "/AdminChemicalPricing/Getavilability_ProductCountryVarient",
                data: { CountryName: CountryName, Product: Product },
                //  contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                success: function (json) {

                    var tbodyHTML = '';
                    if (json != null) {
                        $(json).each(function (idx, elm) {

                            tbodyHTML += "<tr>";
                            tbodyHTML += "<td>" + elm.CountryName + "</td>";
                            tbodyHTML += "<td>" + elm.ProductName + "</td>";
                            tbodyHTML += "<td>" + elm.ProductVariant + "</td>";
                            tbodyHTML += "</tr>"
                        });
                    }
                    else {
                        tbodyHTML = "<tr><td class='text-center' colspan='20'><span>No records found..!!</span> </td></tr>";
                    }
                    $('.tbodydatabackend').html(tbodyHTML);
                }
            });

        } 
    </script>
}


<script>
    function SaveVariant()
    {
        var Variant = $("#Variant").val();
        var CountryId = $("#country").val();
        var ProductId = $("#product").val();
     
        if (Variant == "" || Variant == null || Variant == undefined) {
            swal({
                title: "Please Enter Variant!",
                type: "success"
            }).then(function () {
            });
        } 
         if (CountryId == "" || CountryId == null || CountryId == undefined) {
            swal({
                title: "Please Enter Country!",
                type: "success"
            }).then(function () {
            });
        }
         if (ProductId == "" || ProductId == null || ProductId == undefined) {
            swal({
                title: "Please Enter Product!",
                type: "success"
            }).then(function () {
            });
        }
        else {
            $.ajax({
                type: "POST",
                url: "/ProductVariant/AddProductVariant",
                data: { Variant: Variant, CountryId: CountryId, ProductId: ProductId},
                success: function (response) {
                    var responseData = "";
                    $(response).each(function (idx, elm) {   
                        responseData = elm.ValidationMessage;
                    });
                    if (responseData != "" || responseData != null || responseData != undefined) {
                        
                        swal({
                            title: responseData,
                            //text: "Data Al.",
                            type: "success"
                        }).then(function () {
                            window.location.href = "../../ProductVariant/AddVariant";
                        });
                    }
                        else {
                            swal({
                                title: 'Failed',
                                //text: "Data Al.",
                                type: "success"
                            }).then(function () {
                                window.location.href = "../../ProductVariant/AddVariant";
                            });
                        }
                    
                },
                failure: function (response) {
                    console.log(response)
                },
                error: function (response) {
                    console.log(response)
                }
            });
        }

    }
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.13.14/js/bootstrap-select.min.js"></script>