    <div class="update-profile-wrapper">
        <div class="eq-form" style="margin-top: 1em;">
            <form id="frmSearchFilter">
                <input type="hidden" id="PageNumber" name="PageNumber" value="1" />


                <div class="row">
                    <div class="col-lg-3 form-group">
                        <select id="Source" name="Source" class="form-control">
                            <option value="">Select Source</option>
                            <option value="Chemical Pricing">Chemical Pricing</option>
                            <option value="Contact Us">Contact Us</option>
                            <option value="Free Trial">Free Trial</option>
                            <option value="Industry Report">Industry Report</option>
                            <option value="News Letter">News Letter</option>
                        </select>
                    </div>
                   
                    @*<div class="col-lg-3 form-group">
                        <select id="IsEmail" name="IsEmail" class="form-control" onchange="ResetFilter('market-type');">
                            <option value="">Select Email Trigger</option>
                            <option value="true">Yes</option>
                            <option value="false">No</option>
                        </select>
                    </div>*@
                    <div class="col-lg-3 form-group">
                        <input id="Name" name="Name" class="form-control" placeholder="Contact Name" />
                    </div>

                    <div class="col-lg-3 form-group">
                        <input id="Email" name="Email" class="form-control" placeholder="Contact Email" />
