    // ---------- Transfer to CSM (real save into Lead_Master) ----------
    // Reuses the already-working /LeadManagementSubscription endpoints
    // (GetChemicalRange, GetMarketAnalysisRange, UploadFiles, SaveLeadRecord)
    // instead of writing new insert SQL.
    //
    // Row grouping matches how the old page actually saved: pick a country,
    // every product that has data for that country lands in ONE row, with
    // Subscription_Product comma-separated and Chemical_Range/Market_Analysis_Range
    // holding the combined [{PID,RID}...] list for all of those products. So
    // here it's the other way round from a per-product loop: group by
    // country/region FIRST, across every selected product, then one row per
    // country (still one row per country even for the same product, since
    // that's Lead_Master's structure) and one extra row per Market region
    // that isn't already covered by one of the country rows. Chemical pricing
    // has no region concept - only Market Analysis can be region-based.
    // Product kis tab me select hua — coverage/module isi se decide hota hai.
    function IsProductInPricing(id) { return $(".ns-product-chk[value='" + id + "']").is(':checked'); }
    function IsProductInMarket(id) { return $(".ns-market-chk[value='" + id + "']").is(':checked'); }

    function GetEffectiveCoverageForProduct(productId) {
        var $row = $(".ns-coverage-row[data-product-id='" + productId + "']");
        // Chemical coverage sirf tab jab product Pricing me select ho; Market
        // coverage sirf tab jab Market me select ho. Warna wo empty rahe (jaise
        // Market-only product ko Chemical countries/range nahi milni chahiye).
        var chemCountries = IsProductInPricing(productId) ? (CoverageCountryCache[productId] || []) : [];
        var marketData = IsProductInMarket(productId) ? (MarketCoverageCache[productId] || { Countries: [], Regions: [] }) : { Countries: [], Regions: [] };
        // Market ke Countries me "Global" kabhi DB me nahi jana chahiye — wo sirf Regions me
        var marketCountries = $.grep(marketData.Countries || [], function (c) {
            return $.trim((c.Text || '')).toLowerCase() !== 'global';
        });
        var marketRegions = marketData.Regions || [];

        var allChecked = $row.find('.ns-coverage-all-chk').is(':checked');
        if (allChecked) {
            // Chemical: saari tracked countries. Market: sirf Global region (default).
            return { chemCountries: chemCountries, marketCountries: [], marketRegions: DefaultMarketRegions(marketData) };
        }

        var checkedChemIds = $row.find('.ns-coverage-country-chk:checked').map(function () { return String($(this).val()); }).get();
        var effChem = $.grep(chemCountries, function (c) { return checkedChemIds.indexOf(String(c.Value)) !== -1; });

        var effMarketCountries, effMarketRegions;
        if ($row.find('.ns-coverage-market-country-chk, .ns-coverage-market-region-chk').length > 0) {
            var checkedMCountryIds = $row.find('.ns-coverage-market-country-chk:checked').map(function () { return String($(this).val()); }).get();
            effMarketCountries = $.grep(marketCountries, function (c) { return checkedMCountryIds.indexOf(String(c.Value)) !== -1; });

            var checkedMRegionIds = $row.find('.ns-coverage-market-region-chk:checked').map(function () { return String($(this).val()); }).get();
            effMarketRegions = $.grep(marketRegions, function (r) { return checkedMRegionIds.indexOf(String(r.Value)) !== -1; });
        } else {
            // Grid abhi render nahi hua — default: sirf Global region.
            effMarketCountries = [];
            effMarketRegions = DefaultMarketRegions(marketData);
        }

        return { chemCountries: effChem, marketCountries: effMarketCountries, marketRegions: effMarketRegions };
    }

    function BuildCoverageRowJobs(productIds) {
        var countryMap = {}; // countryId -> { id, name, chemProductIds: [], marketProductIds: [] }
        var regionMap = {};  // regionId -> { id, name, marketProductIds: [] }

        $.each(productIds, function (i, productId) {
            var cov = GetEffectiveCoverageForProduct(productId);

            $.each(cov.chemCountries, function (j, c) {
                var key = String(c.Value);
                countryMap[key] = countryMap[key] || { id: c.Value, name: c.Text, chemProductIds: [], marketProductIds: [] };
                if (countryMap[key].chemProductIds.indexOf(productId) === -1) countryMap[key].chemProductIds.push(productId);
            });
            $.each(cov.marketCountries, function (j, c) {
                var key = String(c.Value);
                countryMap[key] = countryMap[key] || { id: c.Value, name: c.Text, chemProductIds: [], marketProductIds: [] };
                if (countryMap[key].marketProductIds.indexOf(productId) === -1) countryMap[key].marketProductIds.push(productId);
            });
            $.each(cov.marketRegions, function (j, r) {
                var key = String(r.Value);
                regionMap[key] = regionMap[key] || { id: r.Value, name: r.Text, marketProductIds: [] };
                if (regionMap[key].marketProductIds.indexOf(productId) === -1) regionMap[key].marketProductIds.push(productId);
            });
        });

        var jobs = [];
        $.each(countryMap, function (key, entry) {
            jobs.push({
                countryId: entry.id, countryName: entry.name, regionId: '', regionName: '',
                chemProductIds: entry.chemProductIds, marketProductIds: entry.marketProductIds
            });
        });
        $.each(regionMap, function (key, entry) {
            jobs.push({
                countryId: '', countryName: '', regionId: entry.id, regionName: entry.name,
                chemProductIds: [], marketProductIds: entry.marketProductIds
            });
        });

        return jobs;
    }

    function SubmitLeadRows(rowJobs, ctx) {
        var fileInput = $("#PaymentDocument").get(0);
        var files = fileInput ? fileInput.files : null;
        var fileName = files && files.length ? files[0].name : '';

        var uploadDone = $.Deferred();
        if (files && files.length) {
            var fileData = new FormData();
            for (var i = 0; i < files.length; i++) {
                fileData.append("FileUpload", files[i]);
            }
            $.ajax({
                type: "POST",
                url: "/LeadManagementSubscription/UploadFiles",
                dataType: "json",
                contentType: false,
                processData: false,
                data: fileData
            }).always(function () { uploadDone.resolve(); });
        } else {
            uploadDone.resolve();
        }

        uploadDone.done(function () {
            var arrayOfLead = [];

            // News (5) / Capacity Tracker (8) product selections — inki id
            // coverage row ke module me comma-append hogi (alag row nahi).
            var newsIds = $(".ns-news-chk:checked").map(function () { return String($(this).val()); }).get();
            var capacityIds = $(".ns-capacity-chk:checked").map(function () { return String($(this).val()); }).get();
            var coveredIds = {}; // jo product ids coverage rows me aa gaye

            // Ek country/region ke andar products ko unke module-signature se
            // group karo: jo product Chemical+Market dono me hai -> ek "1,2" row
            // (pehle jaisa), market-only product -> alag "2" row, chem-only ->
            // alag "1" row. Isse har product ko sirf uska sahi module milta hai.
            $.each(rowJobs, function (i, job) {
                var chemSet = {}; $.each(job.chemProductIds || [], function (k, id) { chemSet[String(id)] = true; });
                var marketSet = {}; $.each(job.marketProductIds || [], function (k, id) { marketSet[String(id)] = true; });

                var allProductIds = (job.chemProductIds || []).concat(
                    $.grep(job.marketProductIds || [], function (id) { return (job.chemProductIds || []).indexOf(id) === -1; })
                );

                // signature -> { products:[], hasChem, hasMarket }
                var groups = {};
                $.each(allProductIds, function (k, pid) {
                    var sid = String(pid);
                    coveredIds[sid] = true;
                    var inChem = !!chemSet[sid], inMarket = !!marketSet[sid];
                    var sig = (inChem ? "1" : "0") + (inMarket ? "1" : "0");
                    if (!groups[sig]) groups[sig] = { products: [], hasChem: inChem, hasMarket: inMarket };
                    groups[sig].products.push(sid);
                });

                $.each(groups, function (sig, g) {
                    var rowHasNews = false, rowHasCapacity = false;
                    $.each(g.products, function (k, sid) {
                        if (newsIds.indexOf(sid) !== -1) rowHasNews = true;
                        if (capacityIds.indexOf(sid) !== -1) rowHasCapacity = true;
                    });

                    var moduleParts = [];
                    if (g.hasChem) moduleParts.push("1");
                    if (g.hasMarket) moduleParts.push("2");
                    if (rowHasNews) moduleParts.push("5");
                    if (rowHasCapacity) moduleParts.push("8");

                    arrayOfLead.push({
                        Id: arrayOfLead.length + 1,
                        Name: ctx.primaryName,
                        CorpEmail: ctx.primaryEmail,
                        Organisation: ctx.companyName,
                        CountryName: "",
                        CountryID: ctx.clientCountryId || 0,
                        StateName: "",
                        StateId: 0,
                        Phone: ctx.phone,
                        module: moduleParts.join(","),
                        InterestArea: ctx.requestId ? String(ctx.requestId) : "",
                        UserType: ctx.userType,
                        Subject: "",
                        Query: "",
                        Status: ctx.clientType,
                        AssignTo: "",
                        Designation: ctx.designation,
                        AssignDate: null,
                        IPAddress: "",
                        BillingEmail: ctx.billingEmail,
                        SubscriptionType: "Package",
                        AssignAnalyst: ctx.assignAnalyst || 0,
                        SecondaryClintEmail: ctx.secondaryEmails,
                        SubscriptionDateFrom: ctx.fromDate,
                        SubscriptionDateTo: ctx.toDate,
                        Subscription_Country: job.countryId,
                        Subscription_Product: g.products.join(','),
                        Chemical_Range: g.hasChem ? (job.chemicalRangeJson || '') : '',
                        Market_Analysis_Range: g.hasMarket ? (job.marketRangeJson || '') : '',
                        SubSubscriptionRemark: ctx.remark,
                        ProcedureName: "",
                        ConnectionTime: 0,
                        RegionId: job.regionId,
                        RegionName: "",
                        ModuleId: 0,
                        ModuleName: "",
                        MarketRangeID: 0,
                        MarketRangeName: "",
                        files: fileName,
                        PaymentMode: ctx.approvalBasis,
                        CRM: ctx.assignCrm,
                        Trader: ctx.trader,
                        Credit: (arrayOfLead.length === 0 ? ctx.credit : ""),
                        Renew: ctx.renew
                    });
                });
            });

            // News (MenuId 5) aur Capacity Tracker (MenuId 8) ke products me
            // country/region coverage nahi hota, isliye ye rowJobs me nahi aate.
            // Inhe module-level rows ke roop me alag se add karte hain, warna
            // ye DB me insert hi nahi hote.
            function PushModuleOnlyRow(moduleId, productIds) {
                if (!productIds || !productIds.length) return;
                arrayOfLead.push({
                    Id: arrayOfLead.length + 1,
                    Name: ctx.primaryName,
                    CorpEmail: ctx.primaryEmail,
                    Organisation: ctx.companyName,
                    CountryName: "",
                    CountryID: ctx.clientCountryId || 0,
                    StateName: "",
                    StateId: 0,
                    Phone: ctx.phone,
                    module: moduleId,
                    InterestArea: ctx.requestId ? String(ctx.requestId) : "",
                    UserType: ctx.userType,
                    Subject: "",
                    Query: "",
                    Status: ctx.clientType,
                    AssignTo: "",
                    Designation: ctx.designation,
                    AssignDate: null,
                    IPAddress: "",
                    BillingEmail: ctx.billingEmail,
                    SubscriptionType: "Package",
                    AssignAnalyst: ctx.assignAnalyst || 0,
                    SecondaryClintEmail: ctx.secondaryEmails,
                    SubscriptionDateFrom: ctx.fromDate,
                    SubscriptionDateTo: ctx.toDate,
                    Subscription_Country: "",
                    Subscription_Product: productIds.join(','),
                    Chemical_Range: '',
                    Market_Analysis_Range: '',
                    SubSubscriptionRemark: ctx.remark,
                    ProcedureName: "",
                    ConnectionTime: 0,
                    RegionId: "",
                    RegionName: "",
                    ModuleId: 0,
                    ModuleName: "",
                    MarketRangeID: 0,
                    MarketRangeName: "",
                    files: fileName,
                    PaymentMode: ctx.approvalBasis,
                    CRM: ctx.assignCrm,
                    Trader: ctx.trader,
                    Credit: "",
                    Renew: ctx.renew
                });
            }

            // Ab News/Capacity ki id coverage rows ke module me comma-append
            // ho chuki hai. Sirf un products ke liye alag row banao jo kisi bhi
            // coverage row me nahi aaye (yaani jo Pricing/Market me nahi hain).
            var uncoveredNews = $.grep(newsIds, function (id) { return !coveredIds[id]; });
            var uncoveredCapacity = $.grep(capacityIds, function (id) { return !coveredIds[id]; });
            PushModuleOnlyRow("5", uncoveredNews);      // News-only products
            PushModuleOnlyRow("8", uncoveredCapacity);  // Capacity-only products

            console.log("SaveLeadRecord payload", arrayOfLead);

            // ASP.NET MVC's JsonValueProviderFactory caps how many JSON
            // "members" it will bind per request (default 1000). Each lead
            // row here has ~44 properties, and "All tracked countries"
            // fans out into one row per country -- so a single POST of the
            // whole array can blow past that cap and fail with
            // "The JSON request was too large to be deserialized." before
            // the action even runs. Rather than raise the framework limit
            // (web.config), split into small batches and save sequentially.
            var SaveBatchSize = 15;
            var saveBatches = [];
            for (var sb = 0; sb < arrayOfLead.length; sb += SaveBatchSize) {
                saveBatches.push(arrayOfLead.slice(sb, sb + SaveBatchSize));
            }

            var savedRowCount = 0;

            function ParseSaveErrorDetail(xhr) {
                // The server returned the full "Oops" error HTML page (our
                // global exception handler). A plain tag-strip leaves the
                // <style> block's CSS text behind, so strip <script>/<style>
                // blocks (content and all) first, then prefer the
                // #DebugExceptionBlock (the real ex.ToString() we surface
                // there) over the generic wrapper text.
                var raw = xhr.responseText || "";
                var cleaned = raw.replace(/<script[\s\S]*?<\/script>/gi, ' ')
                                  .replace(/<style[\s\S]*?<\/style>/gi, ' ');
                var detail;
                var debugMatch = /<div id=['"]DebugExceptionBlock['"][^>]*>([\s\S]*?)<\/div>/i.exec(cleaned);
                if (debugMatch) {
                    detail = debugMatch[1]
                        .replace(/<[^>]*>/g, ' ')
                        .replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>')
                        .replace(/\s+/g, ' ').trim();
                } else {
                    detail = cleaned.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
                }
                return detail || ("HTTP " + xhr.status);
            }

            function SendSaveBatch(batchIndex) {
                if (batchIndex >= saveBatches.length) {
                    swal({ title: "Success", text: "Subscription transferred to CSM successfully.", type: "success" }).then(function () {
                        GoToSubscriptionsList();
                    });
                    return;
                }

                $.ajax({
                    type: "POST",
                    url: "/LeadManagementSubscription/SaveLeadRecord",
                    data: JSON.stringify(saveBatches[batchIndex]),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (response) {
                        console.log("SaveLeadRecord response (batch " + (batchIndex + 1) + "/" + saveBatches.length + ")", response);
                        // The controller returns the plain string message from
                        // the last row it processed in this batch - "Success"
                        // (case can vary) when it went through, anything else
                        // (often blank, if Name / Subscription_Product /
                        // BillingEmail / CorpEmail came through empty) means a
                        // row was skipped without saving.
                        var ok = typeof response === "string" && response.toLowerCase().indexOf("success") !== -1;
                        if (ok) {
                            savedRowCount += saveBatches[batchIndex].length;
                            SendSaveBatch(batchIndex + 1);
                        } else {
                            // Table naam / row / payload details nahi — sirf clean error
                            var msg = (typeof response === "string" && $.trim(response)) ? $.trim(response) : "Could not transfer to CSM. Please try again.";
                            NsEndSaving();
                            swal("Failed", msg, "error");
                        }
                    },
                    error: function (xhr) {
                        console.log("SaveLeadRecord error", xhr.status, xhr.responseText);
                        var detail = ParseSaveErrorDetail(xhr);
                        NsEndSaving();
                        // Table naam / row-count wrapper nahi — sirf error message
                        swal("Failed", (detail || "Could not transfer to CSM. Please try again.").substring(0, 600), "error");
                    }
                });
            }

            SendSaveBatch(0);
        });
    }

    function BuildAndSaveLeadRows() {
        var packageType = $("#PackageType").val();
        // Full package now auto-checks every product and gets the exact same
        // real .ns-coverage-row elements + Range dropdowns as A la carte, so
        // it saves through this same path with no special-casing needed.

        var companyId = GetSelectedCompanyId();
        var companyName = GetSelectedCompanyName();
        var primaryName = $.trim($("#PrimaryContactName").val());
        var primaryEmail = $.trim($("#PrimaryEmail").val());
        var billingEmail = $.trim($("#BillingEmail").val());

        // CRM must pick a real, existing Company (companyId required) -
        // Sales-convert mode has no Company record yet, so the typed name
        // is what's required there instead (companyId stays "" -> 0 below).
        // Billing email is optional (validated on Step 1 for the required
        // fields only), so it's not required here anymore.
        var companyOk = IsSalesConvertFlow ? !!companyName : !!companyId;
        if (!companyOk || !primaryName || !primaryEmail) {
            NsEndSaving();
            swal("Missing info", "Company, primary contact name and primary email are required before saving.", "error");
            return;
        }

        var ctx = {
            companyName: companyName,
            primaryName: primaryName,
            primaryEmail: primaryEmail,
            // Billing email is optional for the user, but the save requires a
            // value - fall back to the primary email when it's left blank so
            // the row never goes out with an empty BillingEmail.
            billingEmail: billingEmail || primaryEmail,
            phone: $.trim($("#Phone").val()),
            designation: $.trim($("#Designation").val()),
            clientType: $("#ClientType").val() || "",
            clientCountryId: $("#Country").val(),
            secondaryEmails: GetSecondaryEmails().join(','),
            fromDate: $("#TermsFromDate").val(),
            toDate: $("#TermsToDate").val(),
            approvalBasis: $("#ApprovalBasis").val() || "",
            userType: $("#TermsUserType").val() || "",
            assignAnalyst: parseInt($("#AssignAnalyst").val(), 10) || 0,
            assignCrm: $("#AssignCrmCsm").val() || "",
            remark: $.trim($("#RemarksForCsm").val()),
            trader: $("#TraderAccount").is(':checked') ? 'Trader' : '',
            renew: $("#Renewal").is(':checked') ? 'Renew' : '',
            credit: $("#TraderAccount").is(':checked') ? $.trim($("#CreditPoints").val()) : ''
        };

        // Credit points is mandatory when Trader account is selected.
        if ($("#TraderAccount").is(':checked') && ctx.credit === '') {
            NsEndSaving();
            swal("Missing info", "Credit points are required when Trader account is selected.", "error");
            return;
        }

        var products = [];
        $(".ns-coverage-row").each(function () {
            products.push($(this).data('product-id'));
        });

        // News/Capacity-only subscription me coverage rows nahi hote, par phir
        // bhi valid hai (unke products fallback rows se save honge).
        var hasNewsOrCapacityProducts = $(".ns-news-chk:checked, .ns-capacity-chk:checked").length > 0;
        if (products.length === 0 && !hasNewsOrCapacityProducts) {
            NsEndSaving();
            swal("Missing info", "No products were selected on the Package step.", "error");
            return;
        }

        // Market coverage is normally already cached from Step 3 (fetched
        // eagerly for the Range dropdowns) - this is just a safety net in
        // case a product somehow reached here without it.
        var precache = [];
        $.each(products, function (i, productId) {
            if (!MarketCoverageCache[productId]) {
                precache.push(
                    $.ajax({
                        type: "GET",
                        url: "/SalesManagement/GetMarketCoverageByProduct",
                        data: { productId: productId },
                        dataType: "json"
                    }).done(function (response) {
                        MarketCoverageCache[productId] = response;
                    })
                );
            }
        });

        $.when.apply($, precache).always(function () {
            var rowJobs = BuildCoverageRowJobs(products);

            // News/Capacity products ke liye country coverage nahi hota, to
            // rowJobs empty ho sakta hai par phir bhi save valid hai.
            var hasNewsOrCapacity = $(".ns-news-chk:checked").length > 0 || $(".ns-capacity-chk:checked").length > 0;
            if (rowJobs.length === 0 && !hasNewsOrCapacity) {
                NsEndSaving();
                swal("Missing info", "No countries or regions are covered for the selected products.", "error");
                return;
            }

            swal({ title: "Transferring to CSM...", text: "Please wait while the subscription is being created.", showConfirmButton: false, allowOutsideClick: false });

            // One SA_SubscriptionRequest row per submission - this is what the
            // Subscriptions list reads from. Its Id then gets stamped onto
            // every Lead_Master row from this submission (via InterestArea)
            // so the two can still be traced back to each other.
            var subscriptionRequest = {
                CompanyId: parseInt(companyId, 10) || 0,
                CompanyName: ctx.companyName,
                PrimaryContactName: ctx.primaryName,
                PackageType: packageType,
                PackageSummary: ComputePackageSummary(),
                CoverageSummary: ComputeCoverageSummary(rowJobs),
                CSM: $("#AssignCrmCsm option:selected").text() || ""
            };

            $.ajax({
                type: "POST",
                url: "/SalesManagement/CreateSubscriptionRequest",
                data: JSON.stringify(subscriptionRequest),
                contentType: "application/json; charset=utf-8",
                dataType: "json"
            }).done(function (response) {
                ctx.requestId = (response && response.RequestId) ? response.RequestId : 0;
            }).always(function () {
                RunRangeFetchAndSave(rowJobs, ctx);
            });
        });
    }

    function ComputePackageSummary() {
        var hasMarket = $(".ns-market-chk:checked").length > 0;
        return hasMarket ? "Chemical Pricing + Market Analysis" : "Chemical Pricing";
    }

    function ComputeCoverageSummary(rowJobs) {
        var allTracked = $(".ns-coverage-all-chk").length > 0 &&
            $(".ns-coverage-all-chk").length === $(".ns-coverage-all-chk:checked").length;

        if (allTracked) {
            return "All tracked countries";
        }

        var countryCount = 0, regionCount = 0;
        $.each(rowJobs, function (i, job) {
            if (job.countryId) countryCount++;
            if (job.regionId) regionCount++;
        });

        var parts = [];
        if (countryCount > 0) parts.push(countryCount + (countryCount === 1 ? " country" : " countries"));
        if (regionCount > 0) parts.push(regionCount + (regionCount === 1 ? " region" : " regions"));
        return parts.length ? parts.join(', ') : "No coverage selected";
    }

    // Reads whatever's selected in the three GLOBAL Range dropdowns (each
    // option's value is "productId_rangeId") and splits it back out per row
    // job by product id - no AJAX needed here, Step 3 already fetched every
    // available range option and the Continue-button validation already
    // guarantees a dropdown that had options isn't left empty. A
    // country-type row draws from the country-wise Market dropdown, a
    // region-type row from the region-wise one.
    function GetGlobalRangeSelections($select) {
        var values = $select.val() || [];
        return $.map(values, function (v) {
            var parts = String(v).split('_');
            return { PID: parts[0], RID: parts.slice(1).join('_') };
        });
    }

    function RunRangeFetchAndSave(rowJobs, ctx) {
        var chemSelected = GetGlobalRangeSelections($('#GlobalRangeChemical'));
        var mcSelected = GetGlobalRangeSelections($('#GlobalRangeMarketCountry'));
        var mrSelected = GetGlobalRangeSelections($('#GlobalRangeMarketRegion'));

        $.each(rowJobs, function (i, job) {
            var chemProductIds = $.map(job.chemProductIds || [], function (pid) { return String(pid); });
            var chemArr = $.map($.grep(chemSelected, function (item) { return chemProductIds.indexOf(String(item.PID)) !== -1; }),
                function (item) { return { PID: item.PID, RID: item.RID }; });
            job.chemicalRangeJson = chemArr.length ? JSON.stringify(chemArr) : '';

            var marketSelected = job.countryId ? mcSelected : mrSelected;
            var marketProductIds = $.map(job.marketProductIds || [], function (pid) { return String(pid); });
            var marketArr = $.map($.grep(marketSelected, function (item) { return marketProductIds.indexOf(String(item.PID)) !== -1; }),
                function (item) { return { PID: item.PID, RID: item.RID }; });
            job.marketRangeJson = marketArr.length ? JSON.stringify(marketArr) : '';
        });

        SubmitLeadRows(rowJobs, ctx);
    }

    var NsSaving = false;
    function NsEndSaving() {
        NsSaving = false;
        $("#BtnTransfer").prop("disabled", false).css({ opacity: 1, cursor: "pointer" });
    }
    $("#BtnTransfer").click(function () {
        if (NsSaving) return;                 // double-click guard
        NsSaving = true;
        $("#BtnTransfer").prop("disabled", true).css({ opacity: 0.6, cursor: "not-allowed" });
        BuildAndSaveLeadRows();
    });

    // ---------- Coverage details popup ----------
    // Always shows the actual country/region names — not just "All tracked
    // countries" — for both Chemical and Market. When a row is still on
    // "All tracked countries" (default), that means every name from the
    // cached list; when it's à la carte, it's whatever's checked in that
    // row's grid. Market data gets fetched here if a product's Market tab
    // was never opened, so the list is never empty just because nobody
    // clicked into it.
    function joinNames(list) {
        return $.map(list || [], function (item) { return item.Text; }).join(', ');
    }

    function BuildCoverageDetailPopup() {
        var packageType = $("#PackageType").val();

        $("#CoverageDetailOverlay").css('display', 'flex');

        if (packageType === 'Full') {
            $("#CoverageDetailBody").html("<div class='ns-modal-scope-value'>Full package - every tracked product, all tracked countries and regions (Chemical + Market).</div>");
            return;
        }

        var $rows = $(".ns-coverage-row");
        var pending = [];

        $rows.each(function () {
            var productId = $(this).data('product-id');
            // Market data sirf un products ke liye fetch karo jo Market tab me
            // actually select hain — warna Pricing-only product ke liye bhi
            // popup Market coverage dikha deta tha jo DB me jaata hi nahi.
            if (IsProductInMarket(productId) && !MarketCoverageCache[productId]) {
                pending.push(
                    $.ajax({
                        type: "GET",
                        url: "/SalesManagement/GetMarketCoverageByProduct",
                        data: { productId: productId },
                        dataType: "json"
                    }).done(function (response) {
                        MarketCoverageCache[productId] = response;
                    })
                );
            }
        });

        $("#CoverageDetailBody").html("<div class='ns-modal-scope-value'>Loading...</div>");

        $.when.apply($, pending).always(function () {
            RenderCoverageDetailPopup($rows);
        });
    }

    function RenderCoverageDetailPopup($rows) {
        var html = '';

        $rows.each(function () {
            var $row = $(this);
            var productId = $row.data('product-id');
            var productName = $.trim($row.find('.ns-coverage-product-name').text());
            var allChecked = $row.find('.ns-coverage-all-chk').is(':checked');
            var marketData = MarketCoverageCache[productId] || { Countries: [], Regions: [] };

            // Popup wahi dikhaye jo DB me actually jayega: Chemical sirf jab
            // product Pricing me select ho, Market sirf jab Market me select ho.
            var inPricing = IsProductInPricing(productId);
            var inMarket = IsProductInMarket(productId);

            var chemicalText = null, marketCountryText = null, marketRegionText = null;

            if (allChecked) {
                if (inPricing) {
                    chemicalText = joinNames(CoverageCountryCache[productId]) || 'No countries tracked';
                }
                if (inMarket) {
                    // Default: Market me sirf Global region jaata hai, koi country nahi.
                    marketCountryText = 'None selected';
                    marketRegionText = joinNames(DefaultMarketRegions(marketData)) || 'None selected';
                }
            } else {
                if (inPricing) {
                    var chemCountries = $row.find('.ns-coverage-country-chk:checked').map(function () {
                        return $.trim($(this).parent().text());
                    }).get();
                    chemicalText = chemCountries.length ? chemCountries.join(', ') : 'None selected';
                }

                if (inMarket) {
                    if ($row.find('.ns-coverage-market-country-chk, .ns-coverage-market-region-chk').length > 0) {
                        // Market tab was opened for this row — use what's actually checked.
                        var marketCountries = $row.find('.ns-coverage-market-country-chk:checked').map(function () {
                            return $.trim($(this).parent().text());
                        }).get();
                        marketCountryText = marketCountries.length ? marketCountries.join(', ') : 'None selected';

                        var marketRegions = $row.find('.ns-coverage-market-region-chk:checked').map(function () {
                            return $.trim($(this).parent().text());
                        }).get();
                        marketRegionText = marketRegions.length ? marketRegions.join(', ') : 'None selected';
                    } else {
                        // Market tab abhi tak khola nahi gaya — default sirf Global region.
                        marketCountryText = 'None selected';
                        marketRegionText = joinNames(DefaultMarketRegions(marketData)) || 'None selected';
                    }
                }
            }

            var blockHtml = "<div class='ns-modal-product-name'>" + productName + "</div>";
            if (chemicalText !== null) {
                blockHtml += "<div class='ns-modal-scope-label'>Chemical &middot; countries</div>" +
                             "<div class='ns-modal-scope-value'>" + chemicalText + "</div>";
            }
            if (marketCountryText !== null) {
                blockHtml += "<div class='ns-modal-scope-label'>Market &middot; countries</div>" +
                             "<div class='ns-modal-scope-value'>" + marketCountryText + "</div>" +
                             "<div class='ns-modal-scope-label'>Market &middot; regions</div>" +
                             "<div class='ns-modal-scope-value'>" + marketRegionText + "</div>";
            }

            html += "<div class='ns-modal-product'>" + blockHtml + "</div>";
        });

        $("#CoverageDetailBody").html(html || "<div class='ns-modal-scope-value'>No products were selected on the Package step.</div>");
    }

    $("#BtnViewCoverageDetails").click(function () {
        BuildCoverageDetailPopup();
    });

    $("#CoverageDetailClose").click(function () {
        $("#CoverageDetailOverlay").hide();
    });

    $("#CoverageDetailOverlay").click(function (e) {
        if (e.target === this) {
            $(this).hide();
        }
    });
</script>
