<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.13.14/js/bootstrap-select.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/2.1.0/sweetalert.min.js" defer></script>
<script src="~/js/jquery.datetimepicker.full.min.js"></script>
<script>
    // ---------- Loaders ----------
    // Full-page overlay - shown whenever a step is waiting on data (initial
    // load, and the Step 2 -> Step 3 coverage/range fetch). Hidden again
    // only once every underlying AJAX call has actually resolved.
    var NsLoaderTrickle = null;
    var NsLoaderStart = 0;

    function NsSetBar(pct, sub) {
        pct = Math.max(0, Math.min(100, Math.round(pct)));
        $("#NsLoaderBarFill").css("width", pct + "%");
        $("#NsLoaderPercent").text(pct + "%" + (sub ? " \u00B7 " + sub : ""));
    }

    function ShowNsLoader(text) {
        $("#NsLoaderText").text(text || "Loading...");
        $("#NsLoaderOverlay").addClass('active');
        NsLoaderStart = new Date().getTime();
        NsSetBar(0, "");
        // Unknown-length work (single bulk request / page load) still shows
        // movement - a trickle that eases toward 90% until real progress
        // (SetNsLoaderProgress) or completion (HideNsLoader) takes over.
        clearInterval(NsLoaderTrickle);
        var fake = 0;
        NsLoaderTrickle = setInterval(function () {
            fake += (90 - fake) * 0.08;
            NsSetBar(fake, "");
        }, 300);
    }

    // Real progress: done of total, with a rough time-left estimate.
    function SetNsLoaderProgress(done, total) {
        clearInterval(NsLoaderTrickle);
        NsLoaderTrickle = null;
        if (!total) { return; }
        var pct = done / total * 100;
        var sub = done + " / " + total;
        var elapsed = (new Date().getTime() - NsLoaderStart) / 1000;
        if (done > 0 && done < total) {
            var left = Math.ceil(elapsed / done * (total - done));
            sub += " \u00B7 ~" + left + "s left";
        }
        NsSetBar(pct, sub);
    }

    function HideNsLoader() {
        clearInterval(NsLoaderTrickle);
        NsLoaderTrickle = null;
        NsSetBar(100, "");
        $("#NsLoaderOverlay").removeClass('active');
    }

    // Small inline loader on the Range card - used while its dropdowns are
    // being refreshed from a coverage change within Step 3, without
    // blocking the whole page like the full overlay does.
    function ShowRangeLoading() {
        $("#RangeLoadingIndicator, #RangeLoadingOverlay").addClass('active');
        // Jab tak ranges bind na ho jaayein, Continue disable rahe.
        $("#BtnContinueStep3").prop('disabled', true).addClass('ns-btn-disabled');
    }
    function HideRangeLoading() {
        $("#RangeLoadingIndicator, #RangeLoadingOverlay").removeClass('active');
        $("#BtnContinueStep3").prop('disabled', false).removeClass('ns-btn-disabled');
    }

    $(document).ready(function () {
        ShowNsLoader("Loading subscription form...");
        $('#GlobalRangeChemical, #GlobalRangeMarketCountry, #GlobalRangeMarketRegion').selectpicker();

        // Full package me Range dropdown khul kar list dikhe (details), par kuch
        // unselect na ho — koi item hatte hi sabhi wapas select ho jate hain.
        $('#GlobalRangeChemical, #GlobalRangeMarketCountry, #GlobalRangeMarketRegion')
            .on('changed.bs.select', function () {
                if ($("#PackageType").val() !== 'Full') { return; }
                var $s = $(this);
                var total = $s.find('option').length;
                if (total > 0 && ($s.val() || []).length !== total) {
                    $s.selectpicker('selectAll');
                }
            });

        // Terms From/To dates use the same xdsoft datetimepicker calendar as
        // leadJS.js, with the time picker on (format Y-m-d H:i). Year-first
        // format keeps the existing string "from > to" comparison working.
        if ($.fn.datetimepicker) {
            $('#TermsFromDate, #TermsToDate').datetimepicker({
                timepicker: true,
                format: 'Y-m-d H:i',
                step: 15,
                scrollInput: false
            });
        }

        // Sales role's popup marks the page ?salesFlow=1 on both "Convert"
        // and "Start a blank subscription" - this needs to run up front,
        // not wait on FetchRenewLeadPrefill, so a blank subscription (no
        // leadId at all) still gets the free-text Company/Secondary-emails
        // fields instead of the CRM-only dropdowns.
        // Robust sales-flow detection: the URL uses ?salesFlow=1 (numeric),
        // which the controller's bool param can't always parse - so read the
        // raw query param here too instead of relying only on InitialSalesFlow.
        var SalesFlowParam = (function () {
            var m = /[?&]salesFlow=([^&]+)/i.exec(window.location.search);
            return m ? decodeURIComponent(m[1]) : "";
        })();
        var IsSalesFlowNow = InitialSalesFlow || SalesFlowParam === "1" || SalesFlowParam.toLowerCase() === "true";

        if (IsSalesFlowNow) {
            SetCompanyFieldMode(true);
            // Renewal is a CRM-only concept - hide it in the Sales flow.
            $("#RenewalCheckboxItem").hide();
            $("#Renewal").prop('checked', false);
        }

        // Credit points show only when "Trader account" is ticked (and is
        // mandatory then). Unchecking hides and clears it.
        $("#TraderAccount").on('change', function () {
            if ($(this).is(':checked')) {
                $("#CreditPointsField").show();
            } else {
                $("#CreditPointsField").hide();
                $("#CreditPoints").val('');
            }
        });

        $.when(
            GetCompanyList(),
            GetCountryListForForm(),
            GetProductListForPackage(),
            GetMarketProductListForPackage(),
            GetNewsProductListForPackage(),
            GetCapacityTrackerProductListForPackage(),
            GetSubscriptionRegionAndCrmList(),
            GetAssignAnalystListForTerms(),
            FetchRenewLeadPrefill()
        ).always(function () {
            HideNsLoader();
            renderStepper(1);

            // PrefillCompanyId's own 'change' trigger (inside GetCompanyList's
            // success handler above) can fire before the product grids built
            // by GetProductListForPackage/GetMarketProductListForPackage/etc.
            // above have finished rendering, since all of these run in
            // parallel - so BindSubscribedProductsForCompany's checkbox
            // lookups could find nothing yet. Calling it again here, now that
            // every promise in this $.when has settled, guarantees the grids
            // exist first. Harmless no-op when there's no company selected.
            BindSubscribedProductsForCompany($("#CompanyId").val());
        });
    });

    // ---------- Stepper ---------- (Contact, Package, Coverage, Users, Terms, Review)
    function renderStepper(step) {
        for (var i = 1; i <= 6; i++) {
            var $block = $("#StepBlock" + i);
            var $circle = $("#StepCircle" + i);
            $block.removeClass('active done');
            if (i < step) {
                $block.addClass('done');
                $circle.html('<i class="fa fa-check"></i>');
            } else if (i === step) {
                $block.addClass('active');
                $circle.text(i);
            } else {
                $circle.text(i);
            }
        }
        for (var j = 1; j <= 5; j++) {
            if (j < step) {
                $("#Connector" + j).addClass('done');
            } else {
                $("#Connector" + j).removeClass('done');
            }
        }
    }

    function showStep(step) {
        $("#Step1Panel, #Step2Panel, #Step3Panel, #Step4Panel, #Step5Panel, #Step6Panel").hide();
        $("#Step" + step + "Panel").show();
        renderStepper(step);
        // Users step: the primary contact (from Step 1) is auto-bound as a
        // disabled, non-removable first row.
        if (step === 4) {
            RenderPrimaryUserRow();
        }
        window.scrollTo(0, 0);
    }

    // ---------- Step 1: Primary contact & company ----------
    // PrefillCompanyId comes from "Renew / extend" on CustomerDetail.cshtml
    // (?companyId=... on this page's URL) - once the Company dropdown is
    // populated, select it and fire the same change handler manually picking
    // a company would, so the autofill runs exactly the same way either way.
    // with a null-coalesce so this always renders a valid number
    // (0 when there's no company context) even if ViewBag.PrefillCompanyId
    // somehow comes through unset - an empty Razor output here would leave
    // "var PrefillCompanyId = ;", a JS syntax error that silently breaks
    // every dropdown on this page (Company, Country, Products, etc.), not
    // just the prefill.
    var PrefillCompanyId = @(ViewBag.PrefillCompanyId ?? 0);

    // PrefillLeadId comes from the Update button on
    // LeadManagementSubscription/CRMRenew_LeadDetails.cshtml when a lead is
    // marked "Renew Won" (?leadId=... on this page's URL). Same null-coalesce
    // reasoning as PrefillCompanyId above - this must always render a valid
    // number even if ViewBag.PrefillLeadId is ever unset.
    var PrefillLeadId = @(ViewBag.PrefillLeadId ?? 0);
    var RenewLeadData = null;

    // True when this page was reached via the "New subscription" popup on
    // SalesManagement/SalesIndex.cshtml (Sales role only) - set on both its
    // "Convert" and "Start a blank subscription" buttons (?salesFlow=1), so
    // Company/Secondary-emails start in free-text mode even for a blank
    // subscription with no leadId to fall back on. Same null-coalesce
    // reasoning as PrefillCompanyId/PrefillLeadId above.
    var InitialSalesFlow = @(ViewBag.IsSalesFlow == true ? "true" : "false");

    // Also set (redundantly, harmlessly) once FetchSalesLeadPrefill finds a
    // lead via the CRM-proc-empty fallback - see SetCompanyFieldMode below.
    var IsSalesConvertFlow = false;

    function SetCompanyFieldMode(isSalesFlow) {
        IsSalesConvertFlow = isSalesFlow;
        $("#CompanyId").toggle(!isSalesFlow);
        $("#CompanyNameText").toggle(isSalesFlow);
    }

    // Secondary client emails are no longer entered on this step at all -
    // they're just whatever emails were entered in the Users step
    // (AdditionalUsersList, Step 4) further down the wizard.
    function GetSecondaryEmails() {
        return $.map(AdditionalUsersList, function (user) {
            return $.trim(user.Email) || null;
        });
    }

    // Set by CreateCompanyAndUsersForSalesFlow (Step 5 Continue, Sales-convert
    // mode only) once the new SA_CompanyMaster row's ID is looked up - 0
    // until then.
    var SalesConvertCompanyId = 0;

    // Company/name accessors used everywhere the wizard needs "the company"
    // - branch on IsSalesConvertFlow so the CRM dropdown path stays exactly
    // as it was.
    function GetSelectedCompanyId() {
        return IsSalesConvertFlow ? (SalesConvertCompanyId || "") : $("#CompanyId").val();
    }
    function GetSelectedCompanyName() {
        return IsSalesConvertFlow ? $.trim($("#CompanyNameText").val()) : $("#CompanyId option:selected").text();
    }

    // Pulls the won renewal lead's own details via the exact same
    // BindCRMOpenLeadDetailsByid endpoint CRMRenew_LeadDetails.cshtml
    // already uses to bind its own fields - no new backend code needed.
    // Included in the page-load $.when(...) below so the full-page loader
    // covers this fetch too.
    //
    // BindCRMOpenLeadDetailsByid comes back empty for a lead that was
    // marked Won straight from the Sales "New subscription" -> Convert flow
    // (SalesManagement/SalesIndex.cshtml) rather than through CRM's own
    // renewal flow - confirmed by running it directly against a lead like
    // that (nothing came back). Rather than guess at that proc's own
    // filtering, this falls back to SalesNew's own SA_MaskEmail_Open lookup
    // (the exact same one LeadDetail.cshtml already uses) whenever the CRM
    // one has nothing for this ID.
    function FetchRenewLeadPrefill() {
        var dfd = $.Deferred();
        if (!PrefillLeadId) { dfd.resolve(); return dfd.promise(); }

        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/BindCRMOpenLeadDetailsByid",
            data: { Id: PrefillLeadId }
        }).done(function (response) {
            RenewLeadData = (response && response.length) ? response[0] : null;
            if (RenewLeadData) {
                ApplyRenewLeadTextFields(RenewLeadData);
                TryApplyRenewLeadCompanyAndCountry();
                dfd.resolve();
            } else {
                FetchSalesLeadPrefill().always(function () {
                    dfd.resolve();
                });
            }
        }).fail(function () {
            FetchSalesLeadPrefill().always(function () {
                dfd.resolve();
            });
        });

        return dfd.promise();
    }

    // Fallback source for FetchRenewLeadPrefill above - reuses SalesNew's
    // own GetLeadDetail endpoint (SA_MaskEmail_Open by ID, source="Open"
    // since this only ever runs for a Won lead) instead of the CRM proc.
    // Reshaped into the same {Name, Designation, CorpEmail,
    // ContactCountryCode, Mobile, CompanyName, CountryName} shape
    // ApplyRenewLeadTextFields/TryApplyRenewLeadCompanyAndCountry already
    // expect, so neither of those needed to change for the CRM path.
    function FetchSalesLeadPrefill() {
        var dfd = $.Deferred();

        $.ajax({
            type: "GET",
            url: "/SalesNew/GetLeadDetail",
            data: { id: PrefillLeadId, source: "Open" },
            dataType: "json"
        }).done(function (response) {
            var lead = response && response.DataItem;
            if (lead) {
                SetCompanyFieldMode(true);
                $("#CompanyNameText").val(lead.CompanyName || '');

                RenewLeadData = {
                    Name: lead.Name,
                    Designation: '',
                    CorpEmail: lead.CorpEmail,
                    ContactCountryCode: lead.ContactCountryCode,
                    Mobile: lead.ContactNumber,
                    CompanyName: lead.CompanyName,
                    CountryName: lead.CountryName
                };
                ApplyRenewLeadTextFields(RenewLeadData);
                // Country still comes off the real dropdown - only Company
                // switched to free text (SetCompanyFieldMode above), so this
                // still needs to run to match Country by name.
                TryApplyRenewLeadCompanyAndCountry();
            }
        }).always(function () {
            dfd.resolve();
        });

        return dfd.promise();
    }

    // Free-text fields don't need the Company/Country dropdowns to be
    // loaded first, so these get set the moment the lead's data comes back.
    function ApplyRenewLeadTextFields(lead) {
        $("#PrimaryContactName").val(lead.Name || '');
        $("#Designation").val(lead.Designation || '');
        $("#PrimaryEmail").val(lead.CorpEmail || '');
        $("#Phone").val((lead.ContactCountryCode || '') + (lead.Mobile || ''));

        // This whole prefill only runs for a won renewal, so Renewal is
        // ticked here - but never in the Sales flow (Renewal is CRM-only).
        if (!IsSalesConvertFlow) {
            $("#Renewal").prop('checked', true);
        }
    }

    // Company/Country are populated by their own separate AJAX calls
    // (GetCompanyList / GetCountryListForForm) that can finish before or
    // after the renewal lead's own data does - called from both places
    // below plus from FetchRenewLeadPrefill's own success handler, so
    // whichever finishes last is what actually applies the selection.
    function TryApplyRenewLeadCompanyAndCountry() {
        if (!RenewLeadData) return;

        if (!PrefillCompanyId && RenewLeadData.CountryID && $("#Country option").length > 1) {
            $("#Country").val(String(RenewLeadData.CountryID));
        }
        // The Sales-flow fallback (FetchSalesLeadPrefill) only has a country
        // name, not the ID BindCRMOpenLeadDetailsByid returns - match by
        // text instead, same approach as the Company match just below.
        else if (!PrefillCompanyId && RenewLeadData.CountryName && $("#Country option").length > 1) {
            var targetCountry = $.trim(RenewLeadData.CountryName).toLowerCase();
            $("#Country option").each(function () {
                if ($.trim($(this).text()).toLowerCase() === targetCountry) {
                    $("#Country").val($(this).val());
                    return false;
                }
            });
        }

        // Selected silently (no 'change' trigger) so the company's own
        // stored contact doesn't overwrite this specific renewal lead's
        // contact details set in ApplyRenewLeadTextFields above. Skipped
        // entirely in Sales-convert mode - Company is a free-text field
        // there (SetCompanyFieldMode), already filled directly.
        if (!IsSalesConvertFlow && !PrefillCompanyId && RenewLeadData.CompanyName && $("#CompanyId option").length > 1) {
            var targetName = $.trim(RenewLeadData.CompanyName).toLowerCase();
            $("#CompanyId option").each(function () {
                if ($.trim($(this).text()).toLowerCase() === targetName) {
                    $("#CompanyId").val($(this).val());
                    return false;
                }
            });
        }
    }

    function GetCompanyList() {
        return $.ajax({
            type: "GET",
            url: "/SalesManagement/GetCompanyList",
            dataType: "json",
            success: function (response) {
                var html = "<option value=''>Select Company</option>";
                $(response.DataList).each(function (index, item) {
                    html += "<option value='" + item.Value + "'>" + item.Text + "</option>";
                });
                $("#CompanyId").html(html);

                if (PrefillCompanyId) {
                    $("#CompanyId").val(String(PrefillCompanyId)).trigger('change');
                } else {
                    TryApplyRenewLeadCompanyAndCountry();
                }
            },
            error: function (response) {
                console.log(response);
            }
        });
    }

    function GetCountryListForForm() {
        return $.ajax({
            type: "GET",
            url: "/SalesManagement/GetCountryList",
            dataType: "json",
            success: function (response) {
                var html = "<option value=''>Select Country</option>";
                $(response.DataList).each(function (index, item) {
                    html += "<option value='" + item.Value + "'>" + item.Text + "</option>";
                });
                $("#Country").html(html);
                TryApplyRenewLeadCompanyAndCountry();
            },
            error: function (response) {
                console.log(response);
            }
        });
    }

    // Autofill: on company change, pull that company's primary contact
    // name/email/phone/designation into the form.
    $("#CompanyId").on("change", function () {
        var companyId = $(this).val();
        if (companyId === "") {
            $("#PrimaryContactName, #Designation, #PrimaryEmail, #Phone").val('');
            return;
        }
        $.ajax({
            type: "GET",
            url: "/SalesManagement/GetCompanyDetails",
            data: { companyId: companyId },
            dataType: "json",
            success: function (response) {
                var d = response.DataList;
                if (d) {
                    $("#PrimaryContactName").val(d.PrimaryContactName);
                    $("#Designation").val(d.Designation);
                    $("#PrimaryEmail").val(d.PrimaryEmail);
                    $("#Phone").val(d.Phone);
                }
            },
            error: function (response) {
                console.log(response);
            }
        });
        BindExistingSecondaryUsersForCompany(companyId);
        BindSubscribedProductsForCompany(companyId);
    });

    // Step 4 (Additional users) — CRM only. Once a company is picked, pull
    // its already-active secondary users (SA_CompanyMaster/SA_Customer/
    // SalesPackageSubscriptions) so CRM doesn't have to retype people who
    // are already on the account. Skipped entirely in the Sales-convert
    // flow (IsSalesConvertFlow) — Sales always starts from the two blank
    // rows AddUserRow() seeds on page load.
    function BindExistingSecondaryUsersForCompany(companyId) {
        if (IsSalesConvertFlow || !companyId) {
            return;
        }
        $.ajax({
            type: "GET",
            url: "/SalesManagement/GetExistingSecondaryUsers",
            data: { companyId: companyId },
            dataType: "json",
            success: function (response) {
                var users = response.DataList;
                $("#AdditionalUsersRows").empty();
                if (users && users.length > 0) {
                    $(users).each(function (index, u) {
                        AddUserRow(u.Name, u.Email, u.Phone, u.Designation);
                    });
                } else {
                    AddUserRow();
                    AddUserRow();
                }
            },
            error: function (response) {
                console.log(response);
            }
        });
    }

    // CRM role keeps going to the old Index list; everyone else (Sales)
    // lands on the SalesIndex "Subscriptions" page - same branch the
    // save-success redirect further down already uses, just shared here so
    // every Cancel button (all 6 steps) goes to the right place too.
    function GoToSubscriptionsList() {
        window.location.href = "@(Session["UserRole"] != null && Session["UserRole"].ToString().ToUpper() == "CRM" ? Url.Action("Index", "SalesManagement") : Url.Action("SalesIndex", "SalesManagement"))";
    }

    $("#BtnCancelStep1, #BtnCancelStep2, #BtnCancelStep3").click(function () {
        GoToSubscriptionsList();
    });

    $("#BtnContinueStep1").click(function () {
        var companyOk = IsSalesConvertFlow ? $.trim($("#CompanyNameText").val()) !== "" : $("#CompanyId").val() !== "";
        var primaryContactName = $.trim($("#PrimaryContactName").val());
        var primaryEmail = $.trim($("#PrimaryEmail").val());

        if (!companyOk) {
            swal("Warning", IsSalesConvertFlow ? "Please enter a Company name" : "Please select a Company", "error");
            return;
        }
        if (primaryContactName === "") {
            swal("Warning", "Please enter Primary contact name", "error");
            return;
        }
        if (primaryEmail === "") {
            swal("Warning", "Please enter Primary email", "error");
            return;
        }
        if (!$("#Country").val()) {
            swal("Warning", "Please select a Country", "error");
            return;
        }
        showStep(2);
    });

    // ---------- Step 2: Subscription package ----------
    function GetProductListForPackage() {
        return $.ajax({
            type: "GET",
            url: "/SalesManagement/GetProductList",
            dataType: "json",
            success: function (response) {
                var list = (response && response.DataList) || [];
                // Pricing products alphabetically (A→Z, case-insensitive) dikhein.
                list.sort(function (a, b) {
                    return $.trim(a.Text || '').toLowerCase().localeCompare($.trim(b.Text || '').toLowerCase());
                });
                var html = '';
                $(list).each(function (index, item) {
                    html += "<label class='ns-product-item'><input type='checkbox' class='ns-product-chk' value='" + item.Value + "' /> " + item.Text + "</label>";
                });
                $("#ProductGrid").html(html);
            },
            error: function (response) {
                console.log(response);
            }
        });
    }

    // Market tab — kept in sync from Pricing selections (see the
    // .ns-product-chk change handler below).
    function GetMarketProductListForPackage() {
        return $.ajax({
            type: "GET",
            url: "/SalesManagement/GetMarketProductList",
            dataType: "json",
            success: function (response) {
                var html = '';
                $(response.DataList).each(function (index, item) {
                    html += "<label class='ns-product-item'><input type='checkbox' class='ns-market-chk' value='" + item.Value + "' /> " + item.Text + "</label>";
                });
                $("#ProductGridMarket").html(html);
            },
            error: function (response) {
                console.log(response);
            }
        });
    }

    function GetNewsProductListForPackage() {
        return $.ajax({
            type: "GET",
            url: "/SalesManagement/GetNewsProductList",
            dataType: "json",
            success: function (response) {
                var html = '';
                $(response.DataList).each(function (index, item) {
                    html += "<label class='ns-product-item'><input type='checkbox' class='ns-news-chk' value='" + item.Value + "' /> " + item.Text + "</label>";
                });
                $("#ProductGridNews").html(html);
            },
            error: function (response) {
                console.log(response);
            }
        });
    }

    function GetCapacityTrackerProductListForPackage() {
        return $.ajax({
            type: "GET",
            url: "/SalesManagement/GetCapacityTrackerProductList",
            dataType: "json",
            success: function (response) {
                var html = '';
                $(response.DataList).each(function (index, item) {
                    html += "<label class='ns-product-item'><input type='checkbox' class='ns-capacity-chk' value='" + item.Value + "' /> " + item.Text + "</label>";
                });
                $("#ProductGridCapacity").html(html);
            },
            error: function (response) {
                console.log(response);
            }
        });
