@{
    ViewBag.Title = "New Subscription";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.13.14/css/bootstrap-select.min.css" />
<link rel="stylesheet" type="text/css" href="~/css/jquery.datetimepicker.css" />
<style>
    .ns-wrap {
        background: #f4f5f7;
        padding: 22px 28px 40px;
    }

    /* ---- Full-page loader - shown while a step's data is being fetched ---- */
    .ns-loader-overlay {
        position: fixed;
        inset: 0;
        background: rgba(255, 255, 255, .8);
        display: none;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 12px;
        z-index: 5000;
    }

    .ns-loader-overlay.active {
        display: flex;
    }

    .ns-loader-spinner {
        width: 38px;
        height: 38px;
        border: 4px solid #dde1e6;
        border-top-color: #1e4a3c;
        border-radius: 50%;
        animation: ns-spin .8s linear infinite;
    }

    .ns-loader-text {
        font-size: 13.5px;
        font-weight: 600;
        color: #444;
    }

    @@keyframes ns-spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* Determinate progress bar shown in the full-page loader instead of a
       spinner - the fill width reflects how much of the step's data has
       loaded (real per-product progress where we have it, a smooth trickle
       otherwise). */
    .ns-loader-bar {
        width: 300px;
        max-width: 60vw;
        height: 8px;
        background: #dde1e6;
        border-radius: 999px;
        overflow: hidden;
        position: relative;
    }

    .ns-loader-bar-fill {
        height: 100%;
        width: 0;
        background: #1e4a3c;
        border-radius: 999px;
        transition: width .25s ease;
    }

    .ns-loader-percent {
        font-size: 12px;
        font-weight: 600;
        color: #6b7178;
    }

    /* Small inline loader used inside the Range card while its dropdowns
       are being refreshed (coverage changes) without blocking the page. */
    .ns-range-loading {
        display: none;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: #8a9099;
    }

    .ns-range-loading.active {
        display: inline-flex;
    }

    /* Prominent blocking loader over the Range dropdowns — rehta hai jab tak
       coverage change ke baad teeno Range dropdowns dobara bind nahi ho jaate. */
    .ns-range-card { position: relative; }
    .ns-range-overlay {
        display: none;
        position: absolute;
        inset: 0;
        background: rgba(255, 255, 255, 0.7);
        z-index: 5;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 13px;
        font-weight: 600;
        color: #1e4a3c;
        border-radius: inherit;
    }
    .ns-range-overlay.active { display: flex; }
    .ns-range-overlay .ns-mini-spinner { width: 18px; height: 18px; border-width: 3px; }

    .ns-mini-spinner {
        width: 12px;
        height: 12px;
        border: 2px solid #dde1e6;
        border-top-color: #1e4a3c;
        border-radius: 50%;
        animation: ns-spin .8s linear infinite;
    }

    .ns-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

    .ns-title {
        font-size: 19px;
        font-weight: 700;
        color: #22262b;
    }

    .ns-breadcrumb {
        color: #a4aab3;
        font-weight: 400;
        font-size: 14px;
        margin-left: 6px;
    }

    .ns-header-right {
        display: flex;
        align-items: center;
    }

    .ns-search {
        position: relative;
    }

        .ns-search i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #a4aab3;
            font-size: 13px;
        }

        .ns-search input {
            width: 280px;
            border: 1px solid #e3e5e9;
            border-radius: 6px;
            padding: 8px 12px 8px 32px;
            font-size: 13px;
            color: #444;
            background: #fff;
        }

            .ns-search input:focus {
                outline: none;
                border-color: #c7cad0;
            }

    .ns-bell {
        position: relative;
        margin-left: 18px;
        color: #7c828a;
        font-size: 17px;
    }

        .ns-bell i.dot {
            position: absolute;
            top: -2px;
            right: -2px;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #e8752f;
        }

    .ns-card {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 1px 4px rgba(20, 20, 30, .06);
        padding: 22px 26px;
        margin-bottom: 20px;
    }

    /* ---- Stepper ---- */
    .ns-stepper {
        display: flex;
        align-items: flex-start;
        padding: 4px 10px;
    }

    .ns-step {
        flex: 0 0 76px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .ns-step-circle {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 2px solid #d7dae0;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        color: #a4aab3;
    }

    .ns-step-label {
        margin-top: 8px;
        font-size: 12.5px;
        color: #a4aab3;
        white-space: nowrap;
    }

    .ns-step.active .ns-step-circle {
        border-color: #e8752f;
        color: #e8752f;
    }

    .ns-step.active .ns-step-label {
        color: #e8752f;
        font-weight: 600;
    }

    .ns-step.done .ns-step-circle {
        border-color: #1e4a3c;
        background: #1e4a3c;
        color: #fff;
        font-size: 12px;
    }

    .ns-step.done .ns-step-label {
        color: #1e4a3c;
        font-weight: 600;
    }

    .ns-connector {
        flex: 1 1 auto;
        height: 2px;
        background: #e3e5e9;
        margin-top: 15px;
    }

        .ns-connector.done {
            background: #1e4a3c;
        }

    /* ---- Card heading row ---- */
    .ns-card-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        padding-bottom: 14px;
        border-bottom: 1px solid #eef0f2;
        margin-bottom: 18px;
    }

        .ns-card-head b {
            font-size: 15px;
            color: #22262b;
        }

        .ns-card-head span {
            font-size: 12.5px;
            color: #a4aab3;
            font-style: italic;
        }

    .ns-info {
        background: #eef1fb;
        border-radius: 6px;
        padding: 11px 14px;
        font-size: 13px;
        color: #4a5568;
        margin-bottom: 22px;
        display: flex;
        gap: 8px;
        align-items: flex-start;
    }

        .ns-info i {
            color: #4c6ef5;
            margin-top: 2px;
        }

    /* ---- Step 1 fields ---- */
    .ns-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px 26px;
    }

    .ns-field label {
        display: block;
        font-size: 12.5px;
        color: #6b7280;
        margin-bottom: 6px;
    }

    .ns-field input, .ns-field select {
        width: 100%;
        border: 1px solid #e3e5e9;
        border-radius: 6px;
        padding: 9px 12px;
        font-size: 13.5px;
        color: #222;
        background: #fff;
    }

        .ns-field input:focus, .ns-field select:focus, .ns-field textarea:focus {
            outline: none;
            border-color: #2f9e6e;
            box-shadow: 0 0 0 1px rgba(47, 158, 110, .25);
        }

    .ns-field textarea {
        width: 100%;
        border: 1px solid #e3e5e9;
        border-radius: 6px;
        padding: 9px 12px;
        font-size: 13.5px;
        color: #222;
        background: #fff;
        resize: vertical;
        font-family: inherit;
    }

    .ns-field-hint {
        font-size: 11px;
        color: #a4aab3;
        margin-top: 5px;
    }

    .ns-checkbox-row {
        display: flex;
        gap: 24px;
        margin-top: 18px;
    }

    .ns-checkbox-item {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 13px;
        color: #444;
        cursor: pointer;
    }

        .ns-checkbox-item input {
            margin: 0;
        }

    /* bootstrap-select (Secondary client emails) styled to match the
       plain ns-field inputs/selects around it. */
    .ns-field .bootstrap-select {
        width: 100% !important;
    }

        .ns-field .bootstrap-select > .dropdown-toggle {
            border: 1px solid #e3e5e9 !important;
            border-radius: 6px !important;
            background: #fff !important;
            font-size: 13.5px !important;
            color: #222 !important;
            padding: 9px 12px !important;
            box-shadow: none !important;
        }

            .ns-field .bootstrap-select > .dropdown-toggle:focus {
                outline: none !important;
                border-color: #2f9e6e !important;
            }

        .ns-field .bootstrap-select .dropdown-menu {
            font-size: 13px;
        }

        .ns-field .bootstrap-select .bs-searchbox input {
            border: 1px solid #e3e5e9;
            border-radius: 6px;
        }

    /* ---- Step 2 package ---- */
    .ns-pkg-options {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 18px;
    }

    .ns-pkg-card {
        border: 1px solid #e3e5e9;
        border-radius: 8px;
        padding: 16px 18px;
        display: flex;
        gap: 12px;
        align-items: flex-start;
        cursor: pointer;
        background: #fff;
    }

        .ns-pkg-card.selected {
            border-color: #2f9e6e;
            background: #eef8f1;
        }

    .ns-pkg-radio {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        border: 2px solid #c7cad0;
        margin-top: 2px;
        flex: 0 0 16px;
        position: relative;
        background: #fff;
    }

    .ns-pkg-card.selected .ns-pkg-radio {
        border-color: #1e4a3c;
    }

        .ns-pkg-card.selected .ns-pkg-radio:after {
            content: '';
            position: absolute;
            top: 2px;
            left: 2px;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #1e4a3c;
        }

    .ns-pkg-title {
        font-weight: 600;
        font-size: 14px;
        color: #22262b;
        margin-bottom: 3px;
    }

    .ns-pkg-desc {
        font-size: 12.5px;
        color: #8a9099;
    }

    .ns-pkg-fullinfo {
        background: #fdf1e2;
        border: 1px solid #f3d9ad;
        color: #7a5a1e;
        border-radius: 6px;
        padding: 10px 14px;
        font-size: 13px;
        margin-bottom: 18px;
    }

        .ns-pkg-fullinfo i {
            color: #c76a1e;
            margin-right: 6px;
        }

    .ns-select-products-label {
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: .06em;
        color: #8a9099;
        margin-bottom: 12px;
    }

    .ns-subtabs {
        display: flex;
        border-bottom: 1px solid #eef0f2;
        margin-bottom: 16px;
    }

    .ns-subtab {
        background: none;
        border: none;
        border-bottom: 2px solid transparent;
        padding: 8px 4px;
        margin-right: 20px;
        font-size: 13px;
        color: #8a9099;
        cursor: pointer;
    }

        .ns-subtab.active {
            color: #1e4a3c;
            font-weight: 600;
            border-bottom-color: #1e4a3c;
        }

    .ns-product-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px 20px;
        margin-bottom: 14px;
        max-height: 280px;
        overflow-y: auto;
        border: 1px solid #e3e5e9;
        border-radius: 8px;
        padding: 14px;
    }

    .ns-product-item {
        border: 1px solid #e3e5e9;
        border-radius: 6px;
        padding: 9px 12px;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13.5px;
        color: #333;
        font-weight: 400;
        margin: 0;
        cursor: pointer;
    }

        .ns-product-item input {
            margin: 0;
        }

    .ns-product-count {
        font-size: 12.5px;
        color: #4c6ef5;
    }

    /* ---- Step 3 coverage ---- */
    .ns-coverage-fullnote {
        background: #eef1fb;
        border-radius: 6px;
        padding: 11px 14px;
        font-size: 13px;
        color: #4a5568;
    }

    /* Scrolls internally instead of the page growing indefinitely once a
       company's product count runs into the hundreds (CRM auto-bind of an
       existing subscription, or a large A la carte / Full pick) - ~20 rows'
       worth of height before a scrollbar kicks in, same pattern as
       .ns-product-grid above. */
    #CoverageRows {
        max-height: 1700px;
        overflow-y: auto;
        padding-right: 6px;
    }

    .ns-coverage-row {
        border: 1px solid #eef0f2;
        border-radius: 8px;
        padding: 16px 18px;
        margin-bottom: 14px;
    }

    .ns-coverage-row-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
    }

    .ns-coverage-product-name {
        font-weight: 600;
        font-size: 14px;
        color: #22262b;
    }

    .ns-coverage-product-sub {
        font-size: 12.5px;
        color: #8a9099;
        margin-top: 2px;
    }

    .ns-coverage-toggle {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 1px solid #e3e5e9;
        border-radius: 6px;
        padding: 6px 12px;
        font-size: 12.5px;
        color: #333;
        cursor: pointer;
        user-select: none;
        white-space: nowrap;
        flex: 0 0 auto;
    }

        .ns-coverage-toggle input {
            margin: 0;
        }

        .ns-coverage-toggle.checked {
            background: #1e4a3c;
            border-color: #1e4a3c;
            color: #fff;
        }

    .ns-coverage-countries {
        margin-top: 14px;
    }

    .ns-coverage-countries-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
        margin-bottom: 10px;
    }

    .ns-coverage-country-item {
        border: 1px solid #e3e5e9;
        border-radius: 6px;
        padding: 9px 12px;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13.5px;
        color: #333;
        font-weight: 400;
        margin: 0;
        cursor: pointer;
    }

        .ns-coverage-country-item input {
            margin: 0;
            accent-color: #2f9e6e;
        }

        .ns-coverage-country-item.selected {
            border-color: #2f9e6e;
            background: #eef8f1;
        }

    .ns-coverage-selected-count {
        font-size: 12.5px;
        color: #4c6ef5;
    }

    .ns-coverage-subtabs {
        display: flex;
        border-bottom: 1px solid #eef0f2;
        margin-bottom: 14px;
    }

    .ns-coverage-subtab {
        background: none;
        border: none;
        border-bottom: 2px solid transparent;
        padding: 6px 4px;
        margin-right: 18px;
        font-size: 12.5px;
        color: #8a9099;
        cursor: pointer;
    }

        .ns-coverage-subtab.active {
            color: #1e4a3c;
            font-weight: 600;
            border-bottom-color: #1e4a3c;
        }

    .ns-coverage-market-label {
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: .05em;
        color: #8a9099;
        margin-bottom: 8px;
    }

    .ns-coverage-market-loading {
        font-size: 12.5px;
        color: #8a9099;
        padding: 6px 0;
    }

    /* ---- Range selection card (Chemical Range / Market Analysis Range) ----
       One shared card at the TOP of Step 3, above the per-product country
       coverage list - not repeated per product. All three dropdowns cover
       every selected product at once (each option is labelled with its own
       product name by the server, so a combined list stays unambiguous). */
    .ns-range-card {
        border: 1px solid #dde1e6;
        border-top: 3px solid #1e4a3c;
        border-radius: 8px;
        background: #fff;
        padding: 16px 18px;
        margin-bottom: 16px;
        box-shadow: 0 1px 4px rgba(20, 30, 25, .06);
    }

    .ns-range-card-head {
        display: flex;
        align-items: baseline;
        gap: 8px;
        margin-bottom: 6px;
        flex-wrap: wrap;
    }

    .ns-range-title {
        font-size: 12.5px;
        font-weight: 700;
        letter-spacing: .04em;
        color: #1e4a3c;
        text-transform: uppercase;
    }

    .ns-range-card-sub {
        font-size: 12.5px;
        color: #8a9099;
        margin-bottom: 14px;
    }

    .ns-range-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
    }

    .ns-range-field label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        color: #555;
        margin-bottom: 6px;
    }

    .ns-range-field .bootstrap-select {
        width: 100% !important;
    }

    .ns-range-field .btn-default {
        background: #fff;
        border: 1px solid #d7dae0;
        font-size: 13px;
    }

    .ns-range-empty-note {
        font-size: 12px;
        color: #a4aab3;
        font-style: italic;
        padding: 6px 0;
    }

    .ns-range-error .ns-range-field .btn-default {
        border-color: #d9534f;
    }

    @@media (max-width: 900px) {
        .ns-range-grid {
            grid-template-columns: 1fr;
        }
    }

    /* ---- Action row ---- */
    .ns-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .ns-actions-right {
        display: flex;
        gap: 10px;
    }

    .ns-btn-cancel {
        background: #fff;
        border: 1px solid #d7dae0;
        color: #444;
        padding: 9px 22px;
        border-radius: 6px;
        font-size: 13.5px;
    }

        .ns-btn-cancel:hover {
            background: #f7f8f9;
        }

    .ns-btn-continue {
        background: #1e4a3c;
        border: 1px solid #1e4a3c;
        color: #fff;
        padding: 9px 24px;
        border-radius: 6px;
        font-size: 13.5px;
    }

        .ns-btn-continue:hover {
            background: #17392e;
        }

    .ns-btn-continue.ns-btn-disabled,
    .ns-btn-continue:disabled {
        background: #9bb3aa;
        border-color: #9bb3aa;
        cursor: not-allowed;
        opacity: .75;
    }

    .ns-btn-transfer {
        background: #e8752f;
        border: 1px solid #e8752f;
        color: #fff;
        padding: 9px 24px;
        border-radius: 6px;
        font-size: 13.5px;
    }

        .ns-btn-transfer:hover {
            background: #d5661f;
        }

    /* ---- Step 4 users ---- */
    .ns-users-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 4px;
    }

        .ns-users-table th {
            background: #f6f7f9;
            text-align: left;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .3px;
            color: #8a94a6;
            padding: 10px 12px;
            border-bottom: 1px solid #eef0f2;
        }

        .ns-users-table td {
            padding: 8px 12px;
            border-bottom: 1px solid #eef0f2;
            vertical-align: middle;
        }

        .ns-users-table input {
            width: 100%;
            border: 1px solid #e3e5e9;
            border-radius: 6px;
            padding: 8px 10px;
            font-size: 13px;
            color: #222;
            background: #fff;
        }

            .ns-users-table input:focus {
                outline: none;
                border-color: #2f9e6e;
                box-shadow: 0 0 0 1px rgba(47, 158, 110, .25);
            }

    .ns-btn-remove-user {
        background: #fff;
        border: 1px solid #d7dae0;
        color: #444;
        padding: 7px 16px;
        border-radius: 6px;
        font-size: 12.5px;
        white-space: nowrap;
    }

        .ns-btn-remove-user:hover {
            background: #f7f8f9;
        }

    .ns-btn-add-user {
        background: #1e4a3c;
        border: 1px solid #1e4a3c;
        color: #fff;
        padding: 8px 18px;
        border-radius: 6px;
        font-size: 13px;
        margin-top: 14px;
    }

        .ns-btn-add-user:hover {
            background: #17392e;
        }

    /* ---- Step 6 review ---- */
    .ns-review-grid {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        gap: 20px;
        align-items: start;
        margin-bottom: 20px;
    }

    .ns-review-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid #f2f3f5;
        font-size: 13px;
    }

        .ns-review-row:last-child {
            border-bottom: none;
        }

    .ns-review-label {
        color: #6b7280;
    }

    .ns-review-value {
        color: #22262b;
        font-weight: 500;
        text-align: right;
    }

    .ns-review-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #fdf1e2;
        color: #7a5a1e;
        border-radius: 20px;
        padding: 4px 12px;
        font-size: 12px;
        font-weight: 600;
    }

    .ns-user-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 20px;
        padding: 3px 10px;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }

    .ns-user-badge-primary {
        background: #eef1fb;
        color: #4c6ef5;
    }

    .ns-user-badge-secondary {
        background: #eef8f1;
        color: #2f9e6e;
    }

    .ns-review-note {
        background: #fdf1e2;
        border-radius: 8px;
