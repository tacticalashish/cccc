            async: true
        }).done(function (data) {
            var html = "<option value=''>Select User Emails</option>";
            var list = (data && data.DateList) || [];
            for (var i = 0; i < list.length; i++) {
                html += "<option value='" + SldEscape(list[i].Email) + "'>" + SldEscape(list[i].Email) + "</option>";
            }
            $("#SldEmailSelect").html(html);
            var emailToBind = SldCurrentLead.CorpEmail;
            $("#SldEmailSelect option[value='" + emailToBind + "']").remove();
            $("#SldEmailSelect").append(new Option(emailToBind, emailToBind));
