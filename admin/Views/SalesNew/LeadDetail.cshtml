    // ---- Activity & follow-ups tab ----------------------------------------
    var SldActivityCurrentPage = 1;

    function SldActivityIcon(type) {
        if (type === "Email") return "&#9993;";
        if (type === "Meeting") return "&#9635;";
        return "&#128222;";
    }

    // Pure display windowing over an ActivePage/NumberOfPages the server
    // already computed -- this does not calculate a page count itself, it
    // only decides which of the already-known page numbers to show.
    function SldCompactPageList(activePage, numberOfPages) {
        if (numberOfPages <= 7) {
            var arr = [];
            for (var i = 1; i <= numberOfPages; i++) arr.push(i);
            return arr;
        }
        if (activePage <= 4) return [1, 2, 3, 4, 5, "...", numberOfPages];
        if (activePage >= numberOfPages - 3) return [1, "...", numberOfPages - 4, numberOfPages - 3, numberOfPages - 2, numberOfPages - 1, numberOfPages];
        return [1, "...", activePage - 1, activePage, activePage + 1, "...", numberOfPages];
    }

    // Shared by every paged list on this page (Activity tab, Emails tab, ...)
    // -- purely a renderer over ActivePage/NumberOfPages the server already
    // computed, driven by a caller-supplied "go to page" function name.
    function SldRenderPager(containerId, activePage, numberOfPages, gotoFnName) {
        if (!numberOfPages || numberOfPages <= 1) { $("#" + containerId).html(""); return; }
        var pages = SldCompactPageList(activePage, numberOfPages);
        var html = "";
        html += "<button type='button' class='sld-pg-btn' " + (activePage <= 1 ? "disabled" : "onclick='" + gotoFnName + "(" + (activePage - 1) + ")'") + ">&lsaquo;</button>";
        for (var i = 0; i < pages.length; i++) {
            var p = pages[i];
            if (p === "...") html += "<span class='sld-pg-dots'>&hellip;</span>";
            else html += "<button type='button' class='sld-pg-btn" + (p === activePage ? " sld-pg-active" : "") + "' onclick='" + gotoFnName + "(" + p + ")'>" + p + "</button>";
        }
        html += "<button type='button' class='sld-pg-btn' " + (activePage >= numberOfPages ? "disabled" : "onclick='" + gotoFnName + "(" + (activePage + 1) + ")'") + ">&rsaquo;</button>";
        $("#" + containerId).html(html);
    }

    function GoToSldActivityPage(page) {
        SldActivityCurrentPage = page;
        SldLoadActivity();
    }

    function SldLoadActivity() {
        var search = $.trim($("#SldActivitySearch").val());
        $("#SldActivityList").html("<div class='sld-empty-tab'>Loading...</div>");
        $.ajax({
            type: "GET",
            url: "/SalesNew/GetLeadActivity",
            data: { id: SldLeadId, search: search, pageNumber: SldActivityCurrentPage },
            dataType: "json"
        }).done(function (response) {
            var list = (response && response.DataList) || [];
            var activePage = (response && response.ActivePage) || 1;
            var numberOfPages = (response && response.NumberOfPages) || 0;
            var isLastPage = numberOfPages === 0 || activePage >= numberOfPages;

            SldActivityCurrentPage = activePage;

            var html = "";
            for (var i = 0; i < list.length; i++) {
                var item = list[i];
                html += "<div class='sld-activity-row'>";
                html += "  <div class='sld-activity-icon'>" + SldActivityIcon(item.FollowupType) + "</div>";
                html += "  <div style='flex:1;'><div class='sld-activity-title'>Follow-up logged</div>";
                html += "  <div class='sld-activity-sub'>" + SldValueOrDash(item.Discussion) + "</div>";
                if (item.SetFollowUp) {
                    html += "  <div class='sld-activity-sub'>Next follow-up: " + SldFormatDate(item.SetFollowUp, true) + "</div>";
                }
                html += "  </div>";
                html += "  <div class='sld-activity-date'>" + SldFormatDate(item.CreatedDate) + "</div>";
                html += "</div>";
            }
            if (isLastPage && !search && SldCurrentLead) {
                html += "<div class='sld-activity-row'>";
                html += "  <div class='sld-activity-icon'>&#128196;</div>";
                html += "  <div style='flex:1;'><div class='sld-activity-title'>Lead created</div>";
                html += "  <div class='sld-activity-sub'>Source: " + SldValueOrDash(SldCurrentLead.Source) + "</div></div>";
                html += "  <div class='sld-activity-date'>" + SldFormatDate(SldCurrentLead.CreatedDate) + "</div>";
                html += "</div>";
            }
            if (!html) html = "<div class='sld-empty-tab'>" + (search ? "No matches found." : "No activity yet.") + "</div>";
            $("#SldActivityList").html(html);
            SldRenderPager("SldActivityPager", activePage, numberOfPages, "GoToSldActivityPage");
        }).fail(function () {
            $("#SldActivityList").html("<div class='sld-empty-tab'>Couldn't load activity.</div>");
        });
    }

    var SldActivitySearchTimer = null;
    $(document).on("input", "#SldActivitySearch", function () {
        clearTimeout(SldActivitySearchTimer);
        SldActivitySearchTimer = setTimeout(function () {
            SldActivityCurrentPage = 1;
            SldLoadActivity();
        }, 300);
    });

    // ---- Emails tab --------------------------------------------------------
    // Reuses the existing /OutLookChatHistory endpoints as-is (no new
    // controller/DAL/proc here) -- those already return the exact same
    // ShowingFrom/ShowingTo/RecordsCount/ActivePage/PagerSize/NumberOfPages
    // contract, just restyled to match this page.
    var SldEmailCurrentPage = 1;

    function SldLoadEmailDropdown() {
        if (!SldCurrentLead || !SldCurrentLead.CorpEmail) {
            $("#SldEmailList").html("<div class='sld-empty-tab'>No email on this lead.</div>");
            return;
