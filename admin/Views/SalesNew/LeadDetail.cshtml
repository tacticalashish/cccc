    function SldOpenAddContactModal() {
        if (!SldCurrentLead) return;
        var heading = SldCurrentLead.CompanyName || SldCurrentLead.Name;
        $("#SldContactModalAvatar").text(SldInitial(heading));
        $("#SldContactModalSubtitle").text(heading || "");
        $("#SldContactName").val("");
        $("#SldContactEmail").val("");
        $("#SldContactDesignation").val("");
        $("#SldContactPhone").val("");

        if (window.intlTelInput) {
            if (SldContactPhoneIti) {
                SldContactPhoneIti.destroy();
                SldContactPhoneIti = null;
            }
            SldContactPhoneIti = window.intlTelInput(document.getElementById("SldContactPhone"), {
                initialCountry: "in",
                separateDialCode: true
            });
        }

        // Digits only, capped at 15 - stop "kitna bhi number" free entry.
        $("#SldContactPhone").off("input.sldphone").on("input.sldphone", function () {
            var digits = $(this).val().replace(/\D/g, "");
            if (digits.length > 15) digits = digits.substring(0, 15);
            $(this).val(digits);
        });

        $("#SldAddContactModalBackdrop").addClass("sld-modal-open");
    }

    function SldCloseAddContactModal() {
        $("#SldAddContactModalBackdrop").removeClass("sld-modal-open");
    }

    function SldSaveAddContact() {
        var name = $.trim($("#SldContactName").val());
        var email = $.trim($("#SldContactEmail").val());
        var designation = $.trim($("#SldContactDesignation").val());

        if (!name) {
            if (window.swal) swal("Add a name", "Contact name is required.", "warning");
            return;
        }
        if (!email) {
            if (window.swal) swal("Add an email", "Corporate email is required.", "warning");
            return;
        }
        if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) {
            if (window.swal) swal("Check the email", "That doesn't look like a valid email address.", "warning");
            return;
        }
        if (name.length > 80 || email.length > 80 || designation.length > 80) {
            if (window.swal) swal("Too long", "Name, email and designation can be at most 80 characters.", "warning");
            return;
        }

        var countryCode = "";
        var contactNumber = $.trim($("#SldContactPhone").val()).replace(/\D/g, "");
        if (SldContactPhoneIti) {
            var countryData = SldContactPhoneIti.getSelectedCountryData();
            countryCode = countryData && countryData.dialCode ? "+" + countryData.dialCode : "";
        }

        if (!contactNumber) {
            if (window.swal) swal("Add a phone", "Phone number is required.", "warning");
            return;
        }
        if (contactNumber.length < 7 || contactNumber.length > 15) {
            if (window.swal) swal("Check the phone", "Phone number should be 7 to 15 digits.", "warning");
            return;
        }

        $.ajax({
            type: "POST",
            url: "/SalesNew/AddLeadContact",
            data: {
                id: SldLeadId,
                name: name,
                corpEmail: email,
                contactCountryCode: countryCode,
                contactNumber: contactNumber,
                designation: designation
            }
        }).done(function (response) {
            if (response && response.Success) {
                SldCloseAddContactModal();
                SldLoadContacts();
            } else if (window.swal) {
                swal("Couldn't add contact", (response && response.Message) || "Please try again.", "error");
            }
        }).fail(function () {
            if (window.swal) swal("Couldn't add contact", "Please try again.", "error");
        });
    }

    // ---------- Mark won - start closing modal ----------
    var SldWonPaymentMethod = "PurchaseOrder";

    function SldOpenWonModal() {
        // Button-level disable can be bypassed via dev tools - re-check here
        // so the underlying action still can't run on a still-New lead.
        if (SldSource === "New") {
            if (window.swal) swal("Not available yet", "Open this lead first before marking it won.", "error");
            return;
        }
        SldWonPaymentMethod = "PurchaseOrder";
        $("#SldWonAmount").val("");
        $("#SldWonCurrency").val("");
        $("#SldWonAmountINR").val("");
        $("#SldWonAmountINRField").hide();
        $("#SldWonPaymentTerms").val("Net 30");
        $("#SldWonInvoiceNumber").val("");
        $(".sld-type-btn[data-method]").removeClass("sld-type-btn-active");
        $(".sld-type-btn[data-method='PurchaseOrder']").addClass("sld-type-btn-active");
        $("#SldWonPaymentTermsField").show();
        $("#SldWonInvoiceField").hide();

        $("#FileUpload").val("");
        $("#SldWonFileName").text("No file chosen");

        var heading = (SldCurrentLead && (SldCurrentLead.CompanyName || SldCurrentLead.Name)) || "Lead";
        $("#SldWonModalAvatar").text(SldInitial(heading));
        $("#SldWonModalSubtitle").text(heading);
        $("#SldWonModalBackdrop").addClass("sld-modal-open");
    }

    function SldCloseWonModal() {
        $("#SldWonModalBackdrop").removeClass("sld-modal-open");
    }

    // USD stays the mandatory figure regardless of which Currency is picked -
    // this INR field is just an optional secondary amount, only relevant
    // (so only shown) when Currency = INR.
    function SldWonCurrencyChanged() {
        var isInr = $("#SldWonCurrency").val() === "INR";
        $("#SldWonAmountINRField").toggle(isInr);
        if (!isInr) {
            $("#SldWonAmountINR").val("");
        }
    }

    function SldSelectWonPaymentMethod(method) {
        SldWonPaymentMethod = method;
        $(".sld-type-btn[data-method]").removeClass("sld-type-btn-active");
        $(".sld-type-btn[data-method='" + method + "']").addClass("sld-type-btn-active");
        $("#SldWonPaymentTermsField").toggle(method === "PurchaseOrder");
        $("#SldWonInvoiceField").toggle(method === "AdvancePayment");
     
    }


    function UploadFile() {
        var LeadId = SldLeadId;
        var files = $("#FileUpload").get(0).files;
        var fileData = new FormData();
        fileData.append("LeadId", LeadId);
        for (var i = 0; i < files.length; i++) {
            fileData.append("FileUpload", files[i]);
        }
        $.ajax({
            type: "POST",
            url: "/SalesNew/UploadLeadFiles",
            dataType: "json",
            contentType: false,
            processData: false,
            data: fileData,
            success: function (result, status, xhr) {
            },
            error: function (xhr, status, error) {
            }
        });
    } 

    function SldWonFileSelected() {
        var input = $("#FileUpload").get(0);
        if (input && input.files && input.files.length > 0) {
            $("#SldWonFileName").text(input.files[0].name);
        } else {
            $("#SldWonFileName").text("No file chosen");
        }
    }

    function SldSaveWonModal() {
        var amount = $.trim($("#SldWonAmount").val());
        if (amount === "") {
            if (window.swal) swal("Warning", "Please enter the final contract value (USD).", "error");
            return;
        }
        var currency = $("#SldWonCurrency").val();
        if (!currency) {
            if (window.swal) swal("Warning", "Please select a currency.", "error");
            return;
        }
        var amountINR = $.trim($("#SldWonAmountINR").val());
        var invoiceNumber = $.trim($("#SldWonInvoiceNumber").val());
        if (SldWonPaymentMethod === "AdvancePayment" && !invoiceNumber) {
            if (window.swal) swal("Warning", "Please enter the invoice number.", "error");
            return;
        }
        var filesval = $("#FileUpload").val();

        var files = "";
    
        if (filesval == "") {
        }
        else {
            var fileInput = $("#FileUpload").get(0).files[0];
            var originalName = fileInput.name;
            var extension = originalName.substring(originalName.lastIndexOf('.'));
            var nameWithoutExt = originalName.substring(0, originalName.lastIndexOf('.'));
            var dateStamp = new Date().toISOString().slice(0, 10).replace(/-/g, "")
            files = nameWithoutExt + "_" + dateStamp + "_" + SldLeadId + extension;
        }
        if (files == "") {
            if (window.swal) swal("Warning", "Please Upload Sales Order Form.", "error");
            return;
        }
        $.ajax({
            type: "POST",
            url: "/SalesNew/MarkLeadWon",
            data: {
                id: SldLeadId,
                amount: amount,
                currency: currency,
                amountINR: amountINR,
                paymentOption: SldWonPaymentMethod,
                paymentTerms: SldWonPaymentMethod === "PurchaseOrder" ? $("#SldWonPaymentTerms").val() : "",
                invoiceNumber: invoiceNumber,
                OrderFrom: files

            }
        }).done(function (response) {
            if (response && response.Success) {
                UploadFile();
                SaveContractSign();
                SldCloseWonModal();
                LoadLeadDetail();
            } else if (window.swal) {
                swal("Couldn't update", (response && response.Message) || "Please try again.", "error");
            }
        }).fail(function () {
            if (window.swal) swal("Couldn't update", "Please try again.", "error");
        });
    }

    // Contract-sign dates from the "Mark won" modal -> SA_ContractSign
    // (SalesNew controller). Fired alongside MarkLeadWon on a successful win.
    function SaveContractSign() {
        var startDate = $("#SldWonContractStart").val();
        var endDate = $("#SldWonContractEnd").val();
        if (!startDate && !endDate) return;
        $.ajax({
            type: "POST",
            url: "/SalesNew/SaveContractSign",
            data: { id: SldLeadId, startDate: startDate, endDate: endDate }
        });
    }

    function RenderLeadDetail(lead) {
        SldCurrentLead = lead;
        $("#SldLoading").hide();
        $("#SldContent").show();

        var heading = lead.CompanyName || lead.Name;
        $("#SldCrumbName").text(heading || "Lead");
        $("#SldAvatar").text(SldInitial(heading));
        $("#SldCompanyName").html(SldValueOrDash(heading));

        var subParts = [];
        if (lead.Name) subParts.push(SldEscape(lead.Name));
        if (lead.CorpEmail) subParts.push(SldEscape(lead.CorpEmail));
        if (lead.CountryName) subParts.push(SldEscape(lead.CountryName));
        var subHtml = subParts.join(" &middot; ");
        if (lead.Status) subHtml += " <span class='sld-pill sld-pill-gray'><span class='sld-pill-dot'></span>" + SldEscape(lead.Status) + "</span>";
        if (lead.LeadStatus) subHtml += " <span class='sld-pill sld-pill-blue'><span class='sld-pill-dot'></span>" + SldEscape(lead.LeadStatus) + "</span>";
        if (lead.LeadType) subHtml += " <span class='sld-pill sld-pill-purple'>" + SldEscape(lead.LeadType) + "</span>";
        $("#SldSubLine").html(subHtml);

        // Amount is always the mandatory USD figure now (Currency can be
        // INR for the secondary AmountINR amount, which isn't shown here) -
        // display always reads as USD, regardless of the stored Currency.
        $("#SldValue").html(SldFormatMoney(lead.Amount, "USD"));
        $("#SldExpectedClose").html(SldFormatDate(lead.ExpectedCloseDate));
        $("#SldSource").html(SldValueOrDash(lead.Source));
        $("#SldOwner").html(SldValueOrDash(lead.CreatedBy));

        $("#SldSumStage").html(lead.Status ? "<span class='sld-pill sld-pill-gray'><span class='sld-pill-dot'></span>" + SldEscape(lead.Status) + "</span>" : "&mdash;");
        $("#SldSumScore").html(lead.LeadStatus ? "<span class='sld-pill sld-pill-blue'><span class='sld-pill-dot'></span>" + SldEscape(lead.LeadStatus) + "</span>" : "&mdash;");
        $("#SldSumType").html(SldValueOrDash(lead.LeadType));
        $("#SldSumSource").html(SldValueOrDash(lead.Source));
        $("#SldSumInterested").html(SldValueOrDash(lead.Message));
        $("#SldSumValue").html(SldFormatMoney(lead.Amount, "USD"));
        $("#SldSumClose").html(SldFormatDate(lead.ExpectedCloseDate));
        $("#SldSumFollowup").html(SldFormatDate(lead.SetFollowUp, true));

        $("#SldCoCompany").html(SldValueOrDash(lead.CompanyName));
        $("#SldCoContact").html(SldValueOrDash(lead.Name));
        $("#SldCoEmail").html(SldValueOrDash(lead.CorpEmail));
        var phone = [lead.ContactCountryCode, lead.ContactNumber].filter(function (v) { return !!v; }).join(" ");
        $("#SldCoPhone").html(SldValueOrDash(phone));
        $("#SldCoCountry").html(SldValueOrDash(lead.CountryName));

        SldRenderOrderTab(lead);
        SldUpdateActionButtons(lead);
    }

    // "Order & handover" tab - reuses the same lead object RenderLeadDetail
    // already has (New-stage from SA_MaskEmail, Open-stage from
    // SA_MaskEmail_Open via the existing source-aware GetLeadDetail), so no
    // separate fetch is needed here.
    function SldRenderOrderTab(lead) {
        $("#SldOrderProducts").html(SldValueOrDash(lead.Message));
        $("#SldOrderAmount").html(SldFormatMoney(lead.Amount, "USD"));
        $("#SldOrderCurrency").html("USD");
        $("#SldOrderPaymentTerms").html(lead.PaymentTerms ? SldEscape(lead.PaymentTerms) : "To be set on win (PO Net 30/60 or advance)");

        var isNewStage = SldSource === "New";
        var isWon = (lead.Status || "").toLowerCase() === "won";
        $("#SldClosingNotWon").toggle(!isWon);
        $("#SldClosingWon").toggle(isWon);

        // Mark won (Order tab) only makes sense once the lead's actually
        // been Opened - disabled (not hidden, so "Win this deal to begin
        // closing" above it still reads correctly) on a still-New lead.
        $("#SldOrderMarkWonBtn").prop("disabled", isNewStage).css({
            opacity: isNewStage ? .5 : 1,
            cursor: isNewStage ? "not-allowed" : "pointer"
        });

        // Create proforma invoice only makes sense once the deal is Won.
        $("#SldProformaBtn").prop("disabled", !isWon).css({
            opacity: isWon ? 1 : .5,
            cursor: isWon ? "pointer" : "not-allowed"
        });
    }

    function SldGoToProformaInvoice() {
        // Button-level disable can be bypassed via dev tools - re-check here
        // so the underlying action still can't run before the deal is Won.
        var isWon = SldCurrentLead && (SldCurrentLead.Status || "").toLowerCase() === "won";
        if (!isWon) {
            if (window.swal) swal("Not available yet", "Win this deal first before creating a proforma invoice.", "error");
            return;
        }
        window.location.href = "@Url.Action("ChemAnalystProformaInvoiceList", "Invoice")";
    }

    // "+ Add subscription" - only meaningful once the deal is Won. Hands off
    // to the same CreateSubscription convert flow the SalesIndex "New
    // subscription" drawer uses (leadId prefill + salesFlow=1).
    function SldGoToAddSubscription() {
        var isWon = SldCurrentLead && (SldCurrentLead.Status || "").toLowerCase() === "won";
        if (!isWon) {
            if (window.swal) swal("Not available yet", "Win this deal first before creating a subscription.", "error");
            return;
        }
        window.location.href = "@Url.Action("CreateSubscription", "SalesManagement")" + "?leadId=" + encodeURIComponent(SldLeadId) + "&salesFlow=1";
    }

    // New-stage (SA_MaskEmail) leads get Open/Lost/Junk; Open/Contacted-stage
    // (SA_MaskEmail_Open) leads get Mark won/Lost. Whichever set doesn't
    // apply is hidden outright, and once a lead has reached a terminal
    // status (Won/Lost/Junk) its own action buttons disable - there's
    // nothing left to do with a decided lead from this page.
    function SldDisableBtn($btn, label) {
        $btn.prop("disabled", true).css({ opacity: .5, cursor: "not-allowed" });
        if (label) $btn.text(label);
    }

    function SldUpdateActionButtons(lead) {
        var status = (lead.Status || "").toLowerCase();
        var isNewStage = SldSource === "New";

        // "Open" aur "Junk" dono New-stage lead pe dikhte hain; Lost tab tak
        // hidden jab tak lead actually Open na ho.
        $("#SldOpenBtn").toggle(isNewStage);
        $("#SldJunkBtn").toggle(isNewStage);
        $("#SldLostNewBtn").hide();
        // Log follow-up / Schedule demo only make sense once the lead has
        // actually been Opened (SA_MaskEmail_Open) - hidden on a still-New
        // lead, same as Mark won/Lost.
        $("#SldMarkWonBtn, #SldMarkLostBtn, #SldLogFollowupBtn, #SldScheduleDemoBtn").toggle(!isNewStage);

        // "+ Add contact" (Contacts tab) - only once the lead has actually
        // been Opened; hidden on a still-New lead.
        $("#SldAddContactBtn").toggle(!isNewStage);

        // "+ Add subscription" - only once the deal is Won; converts this
        // won lead into a subscription (same as the SalesIndex drawer).
        $("#SldAddSubscriptionBtn").toggle(status === "won");


        // Inline "Edit" on the Lead summary / Company cards - only for an
        // Open/Contacted lead (not New, not Won). Any in-progress edit closes on render.
        SldCancelEdit();
        $("#SldSumEditBtn, #SldCoEditBtn").toggle(!isNewStage && status !== "won");

        // Log follow-up button on the Activity & follow-ups tab - hidden
        // until the lead has actually been Opened (same as "+ Add contact"),
        // instead of just being shown greyed-out.
        $("#SldActivityLogFollowupBtn").toggle(!isNewStage);

        if (isNewStage) {
            if (status === "lost" || status === "junk" || status === "open") {
                SldDisableBtn($("#SldOpenBtn"), status === "open" ? "\ud83d\udcc1 Open" : "Open");
                SldDisableBtn($("#SldLostNewBtn"), status === "lost" ? "\u2717 Lost" : "Lost");
                SldDisableBtn($("#SldJunkBtn"), status === "junk" ? "\ud83d\uddd1 Junk" : "Junk");
            }
        } else {
            // Advance payment isn't treated as fully closed the moment
            // "Mark won" is clicked - the money's only an advance, so both
            // buttons stay live in case the deal still falls through or
            // needs re-confirming. Purchase Order wins disable immediately
            // like before.
            var wonViaAdvance = status === "won" && lead.PaymentOption === "AdvancePayment";

            if (status === "won" && !wonViaAdvance) {
                SldDisableBtn($("#SldMarkWonBtn"), "\u2713 Won");
                SldDisableBtn($("#SldMarkLostBtn"));
            } else if (status === "lost") {
                SldDisableBtn($("#SldMarkWonBtn"));
                SldDisableBtn($("#SldMarkLostBtn"), "\u2717 Lost");
            }

            // Once the lead is Won, there's nothing left to log/schedule
            // from here - disable Log follow-up / Schedule demo outright
            // (both header buttons and the Activity tab's own Log
            // follow-up button).
            if (status === "won") {
                SldDisableBtn($("#SldLogFollowupBtn"));
                SldDisableBtn($("#SldScheduleDemoBtn"));
                SldDisableBtn($("#SldActivityLogFollowupBtn"));
            }
        }
    }

    // New-stage "Open" - reuses LeadManagementSubscription's existing,
    // already-tested ChangestatusofLead endpoint (not mine to touch) rather
    // than a new proc: it already does exactly what's needed here - flips
    // SA_MaskEmail.Status to Open AND inserts the lead's row into
    // SA_MaskEmail_Open. A reload is enough afterward: the page is still on
    // source=New, and usp_SalesNew_GetLeadDetailNew will now read the
    // updated Status straight off SA_MaskEmail.
    function SldMarkLeadOpen() {
        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/ChangestatusofLead",
            data: { LeadId: SldLeadId },
            success: function (response) {
                if (response == "Success") {
                    swal({
                        title: "Thank you!", text: "Opened Successfully.", type: "success"
                    }).then(function () {
                        // Once opened the lead moves from New to the Open
                        // column, so send the user back to the pipeline
                        // rather than reloading the now-stale source=New URL.
                        window.location.href = "@Url.Action("Pipeline", "SalesNew")";
                    });
                } else if (window.swal) {
                    swal("Couldn't open", "Please try again.", "error");
                }
            },
            failure: function (response) {
                console.log(response);
            },
            error: function (response) {
                console.log(response);
            }
        });
    }

    // New-stage "Lost"/"Junk" - plain confirm, no extra data captured
    // (matches the current app: only Open-stage Lost needs a reason).
    function SldMarkLeadNewStatus(status) {
        function doUpdate() {
            $.ajax({
                type: "POST",
                url: "/SalesNew/MarkLeadNewStatus",
                data: { id: SldLeadId, status: status }
            }).done(function (response) {
                if (response && response.Success) {
                    LoadLeadDetail();
                } else if (window.swal) {
                    swal("Couldn't update", (response && response.Message) || "Please try again.", "error");
                }
            }).fail(function () {
                if (window.swal) swal("Couldn't update", "Please try again.", "error");
            });
        }

        if (window.swal) {
            swal({
                title: "Mark this lead as " + status + "?",
                icon: "warning",
                buttons: true
            }).then(function (confirmed) {
                if (confirmed) doUpdate();
            });
        } else {
            doUpdate();
        }
    }

    // ---------- Mark lost (Open-stage) modal ----------
    function SldPickLostReason(text) {
        $("#SldLostReasonText").val(text);
    }

    function SldOpenLostModal() {
        $("#SldLostReasonText").val("");
        var heading = (SldCurrentLead && (SldCurrentLead.CompanyName || SldCurrentLead.Name)) || "Lead";
        $("#SldLostModalAvatar").text(SldInitial(heading));
        $("#SldLostModalSubtitle").text(heading);
        $("#SldLostModalBackdrop").addClass("sld-modal-open");
    }

    function SldCloseLostModal() {
        $("#SldLostModalBackdrop").removeClass("sld-modal-open");
    }

    function SldSaveLostModal() {
        var reason = $.trim($("#SldLostReasonText").val());
        if (!reason) {
            if (window.swal) swal("Warning", "Please enter a reason for the loss.", "error");
            return;
        }
        // Persisting the reason itself is pending confirmation of a
        // LostReason-style column on SA_MaskEmail_Open - for now this just
        // flips the status, same as MarkLeadWon does for Won.
        $.ajax({
            type: "POST",
            url: "/SalesNew/MarkLeadLost",
            data: { id: SldLeadId, reason: reason }
        }).done(function (response) {
            if (response && response.Success) {
                SldCloseLostModal();
                LoadLeadDetail();
            } else if (window.swal) {
                swal("Couldn't update", (response && response.Message) || "Please try again.", "error");
            }
        }).fail(function () {
            if (window.swal) swal("Couldn't update", "Please try again.", "error");
        });
    }

    function LoadLeadDetail() {
        $.ajax({
            type: "GET",
            url: "/SalesNew/GetLeadDetail",
            data: { id: SldLeadId, source: SldSource },
            dataType: "json"
        }).done(function (response) {
            var lead = response && response.DataItem;
            if (!lead) {
                $("#SldLoading").text("Lead not found.");
                return;
            }
            RenderLeadDetail(lead);
        }).fail(function () {
            $("#SldLoading").text("Couldn't load this lead - please refresh.");
        });
    }

    $(document).ready(function () {
        if (SldLeadId > 0) {
            LoadLeadDetail();
        } else {
            $("#SldLoading").text("No lead specified.");
        }
    });
</script>
