<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.13/css/intlTelInput.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.13/js/intlTelInput.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/2.1.0/sweetalert.min.js"></script>

<script>
    var SldLeadId = @leadId;
    var SldSource = "@leadSource";
    var SldCurrentLead = null;

    function SldEscape(val) {
        return val ? $("<div>").text(val).html() : "";
    }

    function SldValueOrDash(val) {
        return val ? SldEscape(val) : "&mdash;";
    }

    function SldInitial(name) {
        if (!name) return "?";
        return $.trim(name).charAt(0).toUpperCase();
    }

    function SldFormatMoney(amount, currency) {
        if (!amount) return "&mdash;";
        var symbol = (currency === "EUR") ? "\u20AC" : (currency === "GBP") ? "\u00A3" : (currency === "INR") ? "\u20B9" : "$";
        return symbol + Math.round(amount).toLocaleString("en-IN") + (currency ? " " + SldEscape(currency) : "");
    }

    function SldFormatDate(dotNetDate, showTodayLabel) {
        if (!dotNetDate) return "&mdash;";
        var match = /\/Date\((\d+)\)\//.exec(dotNetDate);
        var d = match ? new Date(parseInt(match[1], 10)) : new Date(dotNetDate);
        if (isNaN(d.getTime())) return "&mdash;";
        if (showTodayLabel) {
            var today = new Date();
            if (d.getFullYear() === today.getFullYear() && d.getMonth() === today.getMonth() && d.getDate() === today.getDate()) {
                return "Today";
            }
        }
        var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        return d.getDate() + " " + months[d.getMonth()] + " " + d.getFullYear();
    }

    function SldToDateInputValue(dotNetDate) {
        if (!dotNetDate) return "";
        var match = /\/Date\((\d+)\)\//.exec(dotNetDate);
        var d = match ? new Date(parseInt(match[1], 10)) : new Date(dotNetDate);
        if (isNaN(d.getTime())) return "";
        var mm = ("0" + (d.getMonth() + 1)).slice(-2);
        var dd = ("0" + d.getDate()).slice(-2);
        return d.getFullYear() + "-" + mm + "-" + dd;
    }

    function SldSwitchTab(tab) {
        $(".sld-tab").removeClass("sld-tab-active");
        $(".sld-tab[data-tab='" + tab + "']").addClass("sld-tab-active");
        $(".sld-tab-content").removeClass("sld-tab-content-active");
        $("#SldTab" + tab.charAt(0).toUpperCase() + tab.slice(1)).addClass("sld-tab-content-active");
        if (tab === "activity") {
            SldLoadActivity();
        } else if (tab === "emails") {
            SldLoadEmailDropdown();
        } else if (tab === "contacts") {
            SldLoadContacts();
        } else if (tab === "contract") {
            SldLoadContract();
        }
    }

    // Contract tab - shows the saved contract-sign dates (SA_ContractSign).
    function SldLoadContract() {
        $("#SldContractBody").html('<div class="sld-empty-tab" style="padding:20px 0;">Loading&hellip;</div>');
        $.ajax({
            type: "GET",
            url: "/SalesNew/GetContractSignByLead",
            data: { id: SldLeadId },
            dataType: "json"
        }).done(function (resp) {
            var rows = (resp && resp.DataList) || [];
            if (!rows.length) {
                $("#SldContractBody").html('<div class="sld-empty-tab" style="padding:20px 0;">No contract sign saved yet.</div>');
                return;
            }
            var html = "";
            for (var i = 0; i < rows.length; i++) {
                var c = rows[i];
                html += '<div class="sld-panel-row"><span class="sld-panel-label">Contract sign start date</span><span class="sld-panel-value">' + SldValueOrDash(c.StartDate) + '</span></div>';
                html += '<div class="sld-panel-row"><span class="sld-panel-label">Contract sign end date</span><span class="sld-panel-value">' + SldValueOrDash(c.EndDate) + '</span></div>';
