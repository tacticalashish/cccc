@{
    ViewBag.Title = "Lead detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int leadId = ViewBag.LeadID != null ? (int)ViewBag.LeadID : 0;
    string leadSource = ViewBag.Source != null ? ViewBag.Source.ToString() : "Open";
}
<style>
    .sld-wrap {
        background: #f4f5f7;
        padding: 18px 28px 40px;
    }

    .sld-crumb {
        font-size: 13px;
        color: #7c828a;
        margin-bottom: 14px;
    }

        .sld-crumb a {
            color: #7c828a;
            text-decoration: none;
        }

        .sld-crumb span {
            color: #22262b;
            font-weight: 600;
        }

    .sld-back {
        display: inline-block;
        font-size: 13px;
        color: #33383f;
        text-decoration: none;
        margin-bottom: 14px;
    }

        .sld-back:hover {
            text-decoration: underline;
        }

    .sld-card {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 1px 4px rgba(20, 20, 30, .06);
        padding: 18px 20px;
        margin-bottom: 16px;
    }

    .sld-header-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 14px;
    }

    .sld-header-left {
        display: flex;
        align-items: flex-start;
    }

    .sld-avatar {
        width: 44px;
        height: 44px;
        border-radius: 8px;
        background: #1f5a37;
        color: #fff;
        font-size: 16px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 14px;
        flex-shrink: 0;
    }

    .sld-company-name {
        font-size: 18px;
        font-weight: 700;
        color: #22262b;
        margin-bottom: 4px;
    }

    .sld-sub-line {
        font-size: 12px;
        color: #7c828a;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
    }

    .sld-pill {
        display: inline-flex;
        align-items: center;
        font-size: 11px;
        font-weight: 600;
        border-radius: 20px;
        padding: 2px 9px;
        white-space: nowrap;
    }

    .sld-pill-gray { background: #f0f1f3; color: #6b7078; }
    .sld-pill-blue { background: #eef2fb; color: #3f5fa8; }
    .sld-pill-purple { background: #f1eefb; color: #6c47c9; text-transform: uppercase; letter-spacing: .03em; font-size: 10px; }

    .sld-pill-dot {
        display: inline-block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        margin-right: 5px;
        background: currentColor;
        opacity: .7;
    }

    .sld-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .sld-btn {
        border: 1px solid #d7dade;
        background: #fff;
        color: #33383f;
        border-radius: 6px;
        padding: 8px 14px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
    }

        .sld-btn:hover {
            background: #f7f8f9;
        }

    .sld-btn-primary {
        background: #e07b1f;
        border-color: #e07b1f;
        color: #fff;
    }

        .sld-btn-primary:hover {
            background: #c96c16;
        }

    .sld-btn-danger {
        background: #fff;
        border-color: #e2453c;
        color: #e2453c;
    }

        .sld-btn-danger:hover {
            background: #fdecec;
        }

    .sld-btn-success {
        background: #1f5a37;
        border-color: #1f5a37;
        color: #fff;
    }

        .sld-btn-success:hover {
            background: #17452a;
        }

    .sld-info-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0;
        margin-top: 16px;
        border: 1px solid #eceef0;
        border-radius: 8px;
        overflow: hidden;
    }

    @@media (max-width: 900px) {
        .sld-info-row {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .sld-info-cell {
        padding: 12px 16px;
        border-right: 1px solid #eceef0;
    }

        .sld-info-cell:last-child {
            border-right: none;
        }

    .sld-info-label {
        font-size: 10px;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: #a4aab3;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .sld-info-value {
        font-size: 14px;
        font-weight: 700;
        color: #22262b;
    }

    .sld-tabs {
        display: flex;
        gap: 22px;
        border-bottom: 1px solid #e2e4e8;
        margin-bottom: 16px;
    }

    .sld-tab {
        padding: 10px 2px;
        font-size: 13px;
        font-weight: 600;
        color: #7c828a;
        cursor: pointer;
        border-bottom: 2px solid transparent;
    }

        .sld-tab.sld-tab-active {
            color: #22262b;
            border-bottom-color: #1f5a37;
        }

    .sld-banner {
        background: #fdf1e0;
        border: 1px solid #f3ddb0;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 12px;
        color: #7a5a1e;
        margin-bottom: 16px;
    }

        .sld-banner b {
            color: #5c4416;
        }

    .sld-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    @@media (max-width: 900px) {
        .sld-two-col {
            grid-template-columns: 1fr;
        }
    }

    .sld-panel-title {
        font-size: 14px;
        font-weight: 700;
        color: #22262b;
        margin-bottom: 4px;
    }

    .sld-panel-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 4px;
        border-bottom: 1px solid #f2f3f5;
        font-size: 13px;
    }

        .sld-panel-row:last-child {
            border-bottom: none;
        }

    .sld-panel-label {
        color: #7c828a;
    }

    .sld-panel-value {
        color: #22262b;
        font-weight: 600;
        text-align: right;
    }

    /* inline edit for Lead summary / Company cards */
    .sld-panel-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 4px;
    }

    .sld-edit-input {
        display: none;
        width: 58%;
        border: 1px solid #d7dade;
        border-radius: 6px;
        padding: 5px 8px;
        font-size: 13px;
        color: #33383f;
        text-align: left;
    }

    .sld-card.sld-editing .sld-panel-value { display: none; }
    .sld-card.sld-editing .sld-edit-input { display: inline-block; }

    .sld-tab-content {
        display: none;
    }

        .sld-tab-content.sld-tab-content-active {
            display: block;
        }

    .sld-empty-tab {
        text-align: center;
        padding: 50px 0;
        color: #a4aab3;
        font-size: 13px;
    }

    .sld-order-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    @@media (max-width: 900px) {
        .sld-order-grid {
            grid-template-columns: 1fr;
        }
    }

    .sld-order-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #f0f1f3;
        font-size: 13px;
    }

    .sld-order-label {
        color: #7c828a;
    }

    .sld-order-value {
        color: #22262b;
        font-weight: 600;
    }

    .sld-loading {
        text-align: center;
        padding: 40px 0;
        color: #a4aab3;
        font-size: 13px;
    }

    .sld-activity-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
    }

    .sld-activity-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 12px 0;
        border-bottom: 1px solid #f2f3f5;
    }

        .sld-activity-row:last-child {
            border-bottom: none;
        }

    .sld-activity-icon {
        width: 26px;
        height: 26px;
        border-radius: 6px;
        background: #f0f1f3;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        margin-right: 12px;
        flex-shrink: 0;
    }

    .sld-activity-title {
        font-size: 13px;
        font-weight: 700;
        color: #22262b;
    }

    .sld-activity-sub {
        font-size: 12px;
        color: #7c828a;
        margin-top: 2px;
    }

    .sld-activity-date {
        font-size: 12px;
        color: #a4aab3;
        white-space: nowrap;
        margin-left: 10px;
    }

    .sld-pager {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        margin-top: 10px;
        padding-top: 10px;
        border-top: 1px solid #f2f3f5;
    }

    .sld-pg-btn {
        border: 1px solid #e2e4e8;
        background: #fff;
        color: #33383f;
        border-radius: 5px;
        min-width: 24px;
        height: 24px;
        padding: 0 6px;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
    }

        .sld-pg-btn:hover:not(:disabled) {
            background: #f7f8f9;
        }

        .sld-pg-btn:disabled {
            opacity: .4;
            cursor: not-allowed;
        }

        .sld-pg-btn.sld-pg-active {
            background: #1f5a37;
            border-color: #1f5a37;
            color: #fff;
        }

    .sld-pg-dots {
        font-size: 11px;
        color: #a4aab3;
        padding: 0 2px;
    }

    .sld-email-toolbar {
        display: flex;
        gap: 8px;
        margin-bottom: 14px;
    }

    .sld-email-row {
        border-radius: 8px;
        padding: 14px 16px;
        margin-bottom: 12px;
        border: 1px solid #eceef0;
    }

    .sld-email-row-sent {
        background: #f4f8f5;
    }

    .sld-email-row-received {
        background: #f7f8fa;
    }

    .sld-email-badge {
        display: inline-block;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .03em;
        text-transform: uppercase;
        padding: 2px 8px;
        border-radius: 20px;
        margin-bottom: 8px;
    }

    .sld-email-badge-sent {
        background: #eaf7ee;
        color: #2c8a4b;
    }

    .sld-email-badge-received {
        background: #eef2fb;
        color: #3f5fa8;
    }

    .sld-email-field {
        font-size: 12px;
        margin-bottom: 4px;
        color: #33383f;
    }

        .sld-email-field b {
            color: #7c828a;
            font-weight: 600;
            margin-right: 4px;
        }

    table.sld-table {
        width: 100%;
        border-collapse: collapse;
        border: none;
    }

        table.sld-table thead th {
            text-align: left;
            font-size: 10px;
            letter-spacing: .04em;
            text-transform: uppercase;
            color: #a4aab3;
            font-weight: 600;
            padding: 8px 10px;
            border: none;
            border-bottom: 1px solid #edeef1;
            white-space: nowrap;
        }

        table.sld-table tbody td {
            padding: 10px 10px;
            font-size: 13px;
            color: #33383f;
            border: none;
            border-bottom: 1px solid #f2f3f5;
            vertical-align: middle;
        }

        table.sld-table tbody tr:last-child td {
            border-bottom: none;
        }

    .iti {
        width: 100%;
        display: block;
    }

    .iti__country-list {
        color: #22262b;
        max-height: 200px;
        z-index: 400;
    }

    .sld-email-body-frame {
        display: block;
        width: 100%;
        height: 220px;
        border: none;
        border-top: 1px solid #f0f1f3;
        margin-top: 6px;
        background: #fff;
    }

    .sld-modal-backdrop {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(20, 20, 30, .35);
        z-index: 300;
        justify-content: flex-end;
    }

        .sld-modal-backdrop.sld-modal-open {
            display: flex;
        }

    .sld-modal {
        background: #fff;
        width: 380px;
        max-width: 92vw;
        height: 100%;
        box-shadow: -4px 0 20px rgba(20, 20, 30, .15);
        display: flex;
        flex-direction: column;
    }

    .sld-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 16px 18px;
        border-bottom: 1px solid #f0f1f3;
    }

    .sld-modal-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .sld-modal-title {
        font-size: 14px;
        font-weight: 700;
        color: #22262b;
    }

    .sld-modal-subtitle {
        font-size: 12px;
        color: #a4aab3;
    }

    .sld-info-banner {
        border-radius: 8px;
        padding: 12px 14px;
        font-size: 12.5px;
        line-height: 1.5;
    }

    .sld-info-banner-green {
        background: #eaf7ee;
        color: #1e7b3a;
    }

    .sld-info-banner-orange {
        background: #fdf3e3;
        color: #8a5a10;
    }

    .sld-modal-close {
        cursor: pointer;
        color: #a4aab3;
        font-size: 20px;
        line-height: 1;
    }

    .sld-modal-body {
        padding: 16px 18px;
        flex: 1;
        overflow-y: auto;
    }

    .sld-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 14px 18px;
        border-top: 1px solid #f0f1f3;
    }

    .sld-field-label {
        font-size: 12px;
        font-weight: 600;
        color: #33383f;
        margin: 14px 0 6px;
    }

        .sld-field-label:first-child {
            margin-top: 0;
        }

    .sld-type-toggle {
        display: flex;
        border: 1px solid #d7dade;
        border-radius: 6px;
        overflow: hidden;
    }

    .sld-type-btn {
        flex: 1;
        border: none;
        background: #fff;
        padding: 8px 6px;
        font-size: 12px;
        font-weight: 600;
        color: #6b7078;
        cursor: pointer;
        border-right: 1px solid #d7dade;
    }

        .sld-type-btn:last-child {
            border-right: none;
        }

        .sld-type-btn.sld-type-btn-active {
            background: #f0f1f3;
            color: #22262b;
        }

    .sld-textarea, .sld-select, .sld-date-input {
        width: 100%;
        box-sizing: border-box;
        border: 1px solid #d7dade;
        border-radius: 6px;
        padding: 8px 10px;
        font-size: 12px;
        color: #33383f;
    }

    .sld-textarea {
        resize: vertical;
        min-height: 60px;
        font-family: inherit;
    }

    .sld-checkbox-row {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: #33383f;
        margin-top: 14px;
        cursor: pointer;
    }
</style>

<div class="sld-wrap">
    <div class="sld-crumb">
        <a href="@Url.Action("Pipeline", "SalesNew")">Pipeline</a> / <span id="SldCrumbName">&hellip;</span>
    </div>
    <a class="sld-back" href="@Url.Action("Pipeline", "SalesNew")">&larr; Back to pipeline</a>

    <div id="SldLoading" class="sld-loading">Loading lead...</div>

    <div id="SldContent" style="display:none;">
        <div class="sld-card">
            <div class="sld-header-row">
                <div class="sld-header-left">
                    <div class="sld-avatar" id="SldAvatar">?</div>
                    <div>
                        <div class="sld-company-name" id="SldCompanyName">&mdash;</div>
                        <div class="sld-sub-line" id="SldSubLine"></div>
                    </div>
                </div>
                <div class="sld-actions">
                    <!-- New-stage (SA_MaskEmail, not yet promoted) actions -->
                    <button type="button" class="sld-btn sld-btn-primary" id="SldOpenBtn" onclick="SldMarkLeadOpen()">&#128193; Open</button>
                    <button type="button" class="sld-btn sld-btn-danger" id="SldLostNewBtn" onclick="SldMarkLeadNewStatus('Lost')">&#10007; Lost</button>
                    <button type="button" class="sld-btn" id="SldJunkBtn" onclick="SldMarkLeadNewStatus('Junk')">&#128465; Junk</button>
                    <!-- Open/Contacted-stage (SA_MaskEmail_Open) actions -->
                    <button type="button" class="sld-btn sld-btn-primary" id="SldMarkWonBtn" onclick="SldOpenWonModal()">&#10003; Mark won</button>
                    <button type="button" class="sld-btn sld-btn-danger" id="SldMarkLostBtn" onclick="SldOpenLostModal()">&#10007; Lost</button>
                    <button type="button" class="sld-btn" id="SldLogFollowupBtn" onclick="SldOpenFollowupModal()">&#9998; Log follow-up</button>
                    <button type="button" class="sld-btn" id="SldScheduleDemoBtn" onclick="SldOpenDemoModal()">&#128197; Schedule demo</button>
                    <!-- Shown only once the deal is Won - converts this won lead
                         into a subscription, same as the SalesIndex "New
                         subscription" drawer's Convert action. -->
                    <button type="button" class="sld-btn sld-btn-primary" id="SldAddSubscriptionBtn" onclick="SldGoToAddSubscription()">&#43; Add subscription</button>
                </div>
            </div>

            <div class="sld-info-row">
                <div class="sld-info-cell">
                    <div class="sld-info-label">Value</div>
                    <div class="sld-info-value" id="SldValue">&mdash;</div>
                </div>
                <div class="sld-info-cell">
                    <div class="sld-info-label">Expected close</div>
                    <div class="sld-info-value" id="SldExpectedClose">&mdash;</div>
                </div>
                <div class="sld-info-cell">
                    <div class="sld-info-label">Source</div>
                    <div class="sld-info-value" id="SldSource">&mdash;</div>
                </div>
                <div class="sld-info-cell">
                    <div class="sld-info-label">Owner</div>
                    <div class="sld-info-value" id="SldOwner">&mdash;</div>
                </div>
            </div>
        </div>

        <div class="sld-tabs">
            <div class="sld-tab sld-tab-active" data-tab="overview" onclick="SldSwitchTab('overview')">Overview</div>
            <div class="sld-tab" data-tab="activity" onclick="SldSwitchTab('activity')">Activity &amp; follow-ups</div>
            <div class="sld-tab" data-tab="emails" onclick="SldSwitchTab('emails')">Emails</div>
            <div class="sld-tab" data-tab="contacts" onclick="SldSwitchTab('contacts')">Contacts</div>
            <div class="sld-tab" data-tab="order" onclick="SldSwitchTab('order')">Order &amp; handover</div>
            <div class="sld-tab" data-tab="contract" onclick="SldSwitchTab('contract')">Contract</div>
        </div>

        <div class="sld-tab-content sld-tab-content-active" id="SldTabOverview">
            <div class="sld-banner">
                <b>&#128161;</b> This one record replaces the Update-lead, Full-details and Email-history pages. Everything for working this lead &mdash; details, activity, the email thread, contacts and the quote &mdash; lives in these tabs.
            </div>

            <div class="sld-two-col">
                <div class="sld-card" id="SldSummaryCard">
                    <div class="sld-panel-head">
                        <div class="sld-panel-title" style="margin:0;">Lead summary</div>
                        <div>
                            <button type="button" class="sld-btn" id="SldSumEditBtn" style="display:none; padding:3px 10px; font-size:12px;" onclick="SldStartSummaryEdit()">&#9998; Edit</button>
                            <button type="button" class="sld-btn" id="SldSumCancelBtn" style="display:none; padding:3px 10px; font-size:12px;" onclick="SldCancelEdit()">Cancel</button>
                            <button type="button" class="sld-btn sld-btn-primary" id="SldSumSaveBtn" style="display:none; padding:3px 10px; font-size:12px;" onclick="SldSaveLeadEdit()">Save</button>
                        </div>
                    </div>
                    <div class="sld-panel-row"><span class="sld-panel-label">Stage</span><span class="sld-panel-value" id="SldSumStage">&mdash;</span></div>
                    <div class="sld-panel-row"><span class="sld-panel-label">Lead score</span><span class="sld-panel-value" id="SldSumScore">&mdash;</span></div>
                    <div class="sld-panel-row">
                        <span class="sld-panel-label">Type</span>
                        <span class="sld-panel-value" id="SldSumType">&mdash;</span>
                        <select class="sld-edit-input" id="SldEditLeadType"><option value="">&mdash;</option><option value="Inbound">Inbound</option><option value="Outbound">Outbound</option></select>
                    </div>
                    <div class="sld-panel-row">
                        <span class="sld-panel-label">Source</span>
                        <span class="sld-panel-value" id="SldSumSource">&mdash;</span>
                        <input type="text" class="sld-edit-input" id="SldEditSource" placeholder="Source" />
                    </div>
                    <div class="sld-panel-row">
                        <span class="sld-panel-label">Interested in</span>
                        <span class="sld-panel-value" id="SldSumInterested">&mdash;</span>
                        <input type="text" class="sld-edit-input" id="SldEditInterested" placeholder="Interested in" />
                    </div>
                    <div class="sld-panel-row">
                        <span class="sld-panel-label">Value</span>
                        <span class="sld-panel-value" id="SldSumValue">&mdash;</span>
                        <input type="number" class="sld-edit-input" id="SldEditAmount" placeholder="Amount (USD)" min="0" step="0.01" />
                    </div>
                    <div class="sld-panel-row">
                        <span class="sld-panel-label">Expected close</span>
                        <span class="sld-panel-value" id="SldSumClose">&mdash;</span>
                        <input type="date" class="sld-edit-input" id="SldEditClose" />
                    </div>
                    <div class="sld-panel-row">
                        <span class="sld-panel-label">Next follow-up</span>
                        <span class="sld-panel-value" id="SldSumFollowup">&mdash;</span>
                    </div>
                </div>

                <div class="sld-card" id="SldCompanyCard">
                    <div class="sld-panel-head">
