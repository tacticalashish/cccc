    function SldRenderEmailRows(list) {
        if (!list || !list.length) {
            $("#SldEmailList").html("<div class='sld-empty-tab'>No emails found.</div>");
            return;
        }
        var html = "";
        var bodies = [];
        for (var i = 0; i < list.length; i++) {
            var item = list[i];
            var isReceived = !item.SentDate;
            bodies.push(item.Body || "");
            html += "<div class='sld-email-row " + (isReceived ? "sld-email-row-received" : "sld-email-row-sent") + "'>";
            html += isReceived
                ? "<span class='sld-email-badge sld-email-badge-received'>Received mail</span>"
                : "<span class='sld-email-badge sld-email-badge-sent'>Sent mail</span>";
            html += "<div class='sld-email-field'><b>Sender:</b>" + SldValueOrDash(item.Sender) + "</div>";
            html += "<div class='sld-email-field'><b>Subject:</b>" + SldValueOrDash(item.Subject) + "</div>";
            html += "<div class='sld-email-field'><b>Recipient:</b>" + SldValueOrDash(item.Recipient) + "</div>";
            if (item.CC_EMAil) html += "<div class='sld-email-field'><b>CC:</b>" + SldEscape(item.CC_EMAil) + "</div>";
            if (item.BCC_EMail) html += "<div class='sld-email-field'><b>BCC:</b>" + SldEscape(item.BCC_EMail) + "</div>";
            if (item.DateReceived) html += "<div class='sld-email-field'><b>Received date:</b>" + SldEscape(item.DateReceived) + "</div>";
            if (item.SentDate) html += "<div class='sld-email-field'><b>Send date:</b>" + SldEscape(item.SentDate) + "</div>";
            html += "<iframe class='sld-email-body-frame' id='SldEmailFrame_" + i + "' sandbox=''></iframe>";
            if (item.attachmentFilePaths) {
                var files = item.attachmentFilePaths.split(",");
                var attHtml = "";
                for (var f = 0; f < files.length; f++) {
                    var fp = $.trim(files[f]);
                    var fileName = fp.split("\\").pop().split("/").pop();
                    var url = "/OutLookChatHistory/DownloadFile?filePath=E:\\EmailAttachments&fileName=" + encodeURIComponent(fileName);
                    attHtml += "<a href='" + url + "' target='_blank' style='display:block;'>" + SldEscape(fileName) + "</a>";
                }
                html += "<div class='sld-email-field'><b>Attachments:</b></div>" + attHtml;
            }
            html += "</div>";
        }
        $("#SldEmailList").html(html);

        // Render each body as actual HTML, sandboxed in its own iframe so
        // Outlook's inline <style>/MSO markup can't leak into this page --
        // set via the srcdoc property (not a string attribute) so nothing
        // needs manual escaping.
        for (var b = 0; b < bodies.length; b++) {
            var frame = document.getElementById("SldEmailFrame_" + b);
            if (frame) frame.srcdoc = bodies[b];
        }
    }

