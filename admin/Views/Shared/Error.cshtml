
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <title>Error</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.0/css/bootstrap.min.css">
    <style>
        .error-template {
            padding: 40px 15px;
            text-align: center;
        }

        .error-actions {
            margin-top: 15px;
            margin-bottom: 15px;
        }

            .error-actions .btn {
                margin-right: 10px;
            }
    </style>
</head>

<body>
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="error-template">
                    <h1>
                        Oops!
                    </h1>
                    <h2>
                        Something went wrong
                    </h2>
                    <div class="error-details">
                        Sorry, an error has occurred while processing your request. Please go back and try again.
                    </div>
                    @if (ViewData["DebugException"] != null)
                    {
                        <div id="DebugExceptionBlock" style="text-align:left; max-width:900px; margin:20px auto; background:#f8f8f8; border:1px solid #ddd; padding:15px; font-family:consolas,monospace; font-size:12px; white-space:pre-wrap; word-break:break-word;">
                            @ViewData["DebugException"].ToString()
                        </div>
                    }
                    <div class="error-actions">
                        <a href="/Admin/ShowUserList" class="btn btn-primary btn-lg">
                            <span class="glyphicon glyphicon-home"></span>
                            Take Me Home
                        </a><a href="/Admin/ShowUserList" class="btn btn-default btn-lg">
                            <span class="glyphicon glyphicon-envelope"></span> Contact Support
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

</html>
