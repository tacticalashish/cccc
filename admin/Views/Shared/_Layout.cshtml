        function BindTicketBellNotification() {


            $.ajax({
                type: "POST",
                url: "/ticket/TicketNotificationBell",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: true,
                success: function (response) {

                    var count = 0;
                    $(response).each(function (index, value) {
                        count = 1 + count;
                    });
                    $('#spnNotificationBell').text(count);

                },
                failure: function (response) {
                    console.log(response)
                },
                error: function (response) {
                    console.log(response)
                }
            });
        }

        function UpdateTicketBellNotification() {


            $.ajax({
                type: "POST",
                url: "/ticket/UpdateTicketNotificationBell",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                success: function (response) {
                    if (response == 's') {
                        window.location.href = "/ticket/list";
                    }
                    else {
                        console.log(response);
                    }
                },
                failure: function (response) {
                    console.log(response)
                },
                error: function (response) {
                    console.log(response)
                }
            });
        }


        function GetAIGenratedAICount() {

            var URL = "/AdminCommentaryPricing/GetAIGenratedAICount";
            $.ajax({
                url: URL,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                success: function (json) {
                    var tbodyHTMLs = '';
                    if (json && json.length > 0) {
                        $(json).each(function (idx, elm) {

                            if (elm.count != null || elm.count != "") {
                                $("#AICoutdata").html(elm.ID)
                                $("#AIdata").show();
                                tbodyHTMLs += "<tr>"
                                tbodyHTMLs += "<td>" + elm.ProductName + "</td>";
                                tbodyHTMLs += "<td>" + elm.Country + "</td>";
                                var formattedDate = ($.formattedDate(new Date(parseInt(elm.CreatedTime.substr(6)))));
                                tbodyHTMLs += "<td>" + formattedDate + "</td>";
                                tbodyHTMLs += "<td>  </td>";
                                tbodyHTMLs += "</tr>"

                            } else {
                                $("#AIdata").hide();
                            }

                        });
                        $('#aitable').html(tbodyHTMLs);
                    } else {
                        $("#AIdata").hide();

                    }
                }
            });
        }


        function GetGroundTruthCount() {

            var URL = "/ExternalAPI/GetGroundTruthCount";
            $.ajax({
                url: URL,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                success: function (json) {
                    var tbodyHTML = '';
                    if (json && json.length > 0) {
                        $(json).each(function (idx, elm) {
                            debugger;
                            if (elm.count != null || elm.count != "") {
                                $("#GroundtruthdCoutdata").html(elm.Count)
                                $("#Groundtruth").show();
                                tbodyHTML += "<tr>"
                                tbodyHTML += "<td>" + elm.ProductName + "</td>";
                                tbodyHTML += "<td>" + elm.CountryName + "</td>";
                                tbodyHTML += "</tr>"
                            } else {
                                $("#Groundtruth").hide();
                            }

                        });
                        $('#groundtable').html(tbodyHTML);
                    } else {
                        $("#Groundtruth").hide();

                    }
                }
            });
        }



        //Note: Loading modal pop up
        function Loading(status) {
            if (status) {
                $('#loading').modal('show');
            }
            else {
                $('#loading').modal('hide');
            }
        }


        function GetAssociateTotalRating(value, Type2) {

            var URL = "/PricingRating/GetPricingLatestTotalRating?Type=" + value + "";
            URL += '&Type2=' + Type2;
            $.ajax({
                url: URL,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                success: function (json) {

                    if (json && json.length > 0) {
                        $(json).each(function (idx, elm) {
                            if (elm.TotalRating != null || elm.TotalRating != "") {
                                $("#LatestRating").html(elm.TotalRating)
                                $("#RatingMonth").html(elm.Month)
                                $("#RatingYear").html(elm.Year)
                                $("#latrating").show();

                            } else {
                                $("#latrating").hide();
                            }

                        });
                    } else {
                        $("#latrating").hide();

                    }
                }
            });
        }
        $.formattedDate = function (dateToFormat) {
            var dateObject = new Date(dateToFormat);
            var day = dateObject.getDate();
            var month = dateObject.getMonth() + 1;
            var year = dateObject.getFullYear();
            day = day < 10 ? "0" + day : day;
            month = month < 10 ? "0" + month : month;
            var formattedDate = day + "/" + month + "/" + year;
            return formattedDate;
        };


    </script>
