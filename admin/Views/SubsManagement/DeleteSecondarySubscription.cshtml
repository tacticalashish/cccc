@{
    ViewBag.Title = "DeleteSecondarySubscription";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-select@1.13.14/dist/css/bootstrap-select.min.css">
<script src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.13.14/dist/js/bootstrap-select.min.js"></script>

<script>

    $(document).ready(function () {
        GetCustomerPrimaryEmail();
    });

    function GetCustomerPrimaryEmail()
    {
        $.ajax({
            type: "GET",          
            url: "/SubsManagement/GetCustomerPrimaryEmail",
                async: false,
                success: function (json) {
                    debugger;
                    var data = json;
                    if (data != null) {
                        $(data).each(function (idx, elm) {
                            $("#CustomerPrimaryEmail").append($("<option></option>").val(elm.CompanyPrimaryId).html(elm.Email));
                            $("#Secondarylist").hide();
                            $("#status").hide();
                        });
                    }
                }
        });
    }

    function Submit()
    {
        debugger
        var ID = $("#CustomerPrimaryEmail").val();
        var Email = $("#CustomerPrimaryEmail option:selected").text();
        if ((ID != '') || (ID != null) || (ID != undefined))
        {
            $.ajax({
                type: "GET",
                url: "/SubsManagement/GetCompanySecondaryEmail",
                data: { CompanyPrimaryId: ID},
                async: false,
                success: function (json) {
                    debugger;
                    var data = json;
                    var tbodyHTML = '';
                    if (data.length != 0) {
                        $(data).each(function (idx, elm) {
                            tbodyHTML += "<tr>";
                            tbodyHTML += "<td>" + elm.Email + "</td>";                          
                            tbodyHTML += "</tr>";
                        });                  
                    }
                    else {
                        tbodyHTML = "<tr><td class='text-center' colspan='20'><span>No records found..!!</span> </td></tr>";
                    }
                    $("#Secondarylist").show();
                    $('.Secondarylisttbodydata').html(tbodyHTML);
                    $("#status").hide();
                }
            });
        }
        else {
            tbodyHTML = "<tr><td class='text-center' colspan='20'><span>No records found..!!</span> </td></tr>";
            $("#Secondarylist").show();
            $('.Secondarylisttbodydata').html(tbodyHTML);
        }
    }

    function DeleteCompanySecondaryEmail() {
        debugger;
        var ID = $("#CustomerPrimaryEmail").val();
        $.ajax({
            type: "GET",
            url: "/SubsManagement/DeleteCompanySecondaryEmail",
            data: { CompanyPrimaryId: ID },
            async: false,
            success: function (json) {
                debugger;
                var innerHTML = '';
                var data = json;
                if (data.length != 0) {
                    $(data).each(function (idx, elm) {
                        innerHTML += '<h3> ' + elm.ValidationMessage+' Row Effected </h3>' ;
                    });
                }
                $('.modal').hide();
                $('#Rownumber').html(innerHTML);
                $("#Secondarylist").hide();
                $("#status").show();

            }
        });
    }

    function status()
    {
        $("#status").hide();
    }
</script>
<style>
    .modal {       
        position: absolute;
        float: left;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
    }
</style>
<div class="col-md-12 text-center" style="padding:10px">
    <h3 style="color:#fff;">Delete Customer Subscription</h3>
    <hr />
</div>
<div class="col-md-12">
    <p id="status" style="display:none;color:yellowgreen"> Secondary Customer Subscription Deleted</p>
</div>
<div class="col-md-4 col-lg-4 padding-0">
    <select id="CustomerPrimaryEmail" class="selectpicker form-control" data-live-search="true" onchange="status()" required>
        <option value="">Select PrimaryEmail *</option>
    </select>
    <input id="btnSubmit" name="btnSubmit" type="button" style="background-color:#7db11a;color:#fff;width:100%!important;margin-top:10px" class="btn  " value="Submit" onclick="Submit()">
</div>

<div class="col-md-6 col-lg-6">
   <div class="panel panel-success"  id="Secondarylist"  style="display:none">
       <div class="panel-heading text-center">SECONDARY EMAIL</div>
       <div class="panel-body" style="height: 400px; overflow-y: scroll;overflow-x: hidden;">
           <table class="table table-bordered table-hover">
               <tbody class="Secondarylisttbodydata" id="tbodydata"></tbody>
           </table>
       </div>

       <div class="panel-footer text-right">
           <button class="btn btn-md btn-danger" type="button" data-toggle="modal" data-target="#exampleModal">Delete All List</button>
       </div>

   </div>
 </div>

@*---------------------Popup box--------------------*@

    <div class="modal fade" id="exampleModal" tabindex="+1" role="dialog" aria-labelledby="exampleModalLabel">
        <div class="modal-dialog modal-dialog-centered modal-dialog-sm" role="document">
            <div class="modal-content bg-success">
                <div class="modal-body text-center">
                   <h3 style="margin:20px 0px">Are you sure want to Detele It?</h3>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-success" data-dismiss="modal">No</button>
                    <button type="button" class="btn btn-danger" onclick="DeleteCompanySecondaryEmail()" data-dismiss="modal" data-toggle="modal" data-target="#secondbox">Yes Delete It</button>
                </div>
              
            </div>
        </div>
    </div>

    <div class="modal fade" id="secondbox" tabindex="+1" role="dialog" aria-labelledby="exampleModalLabel">
        <div class="modal-dialog modal-dialog-centered modal-dialog-sm" role="document">
            <div class="modal-content bg-success">
                <div class="modal-body text-center">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h3 id="Rownumber" style="margin:20px 0px"></h3>
                </div>
            </div>
        </div>
    </div>

<script type="text/javascript" src="//code.jquery.com/jquery-1.11.3.min.js"></script>

