<!-- Correct table2excel library (GitHub version) -->
<script src="https://unpkg.com/table2excel@1.1.1/dist/table2excel.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.13.14/js/bootstrap-select.min.js"></script>
<script>
    var Search = "";
    var type = "";


    document.getElementById('searchInput').addEventListener('keyup', function () {
        var input = this.value.toLowerCase();
        var rows = document.querySelectorAll('#subsdata tbody tr');

        rows.forEach(function (row) {
            var text = row.textContent.toLowerCase();
            row.style.display = text.includes(input) ? '' : 'none';
        });
    });

    document.getElementById('download').addEventListener('click', function () {
        // Get table
        
        var table = document.getElementById('subsdata');

        // Convert table to worksheet
        var wb = XLSX.utils.table_to_book(table, { sheet: "Sheet1" });

        // Export to Excel file
        XLSX.writeFile(wb, 'MyTable.xlsx');
    });
    $(document).ready(function () {
        $("#Company").removeClass('btn-secondary').addClass('btn-primary');
     //   GetClintEmail();
        GetCompany();
    });
    $('#Customer').on('click', function () {
        $('#Company').removeClass('btn-primary').addClass('btn-secondary');
        $(this).removeClass('btn-secondary').addClass('btn-primary');
        GetClintEmail();
    });
    $('#Company').on('click', function () {
        $("#Customer").removeClass('btn-primary').addClass('btn-secondary');
        GetCompany();
        $(this).removeClass('btn-secondary').addClass('btn-primary');
    });

    function GetCompany() {
        type = "Company";
        $.ajax({
            type: "POST",
            url: "/LeadManagementSubscription/GetClintCompany",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            success: function (data) {

                var innerHTML = "";
                innerHTML += "<option  value = ''>" + "Select Company" + "</option>";
                $(data.DataList).each(function (index, value) {
                    if (value.CompanyName != null || value.CompanyName != "" || value.CompanyName != undefined) {
                        innerHTML += "<option value = '" + value.CompanyId + "'> " + value.CompanyName + "</option>"
                    }
                });
              
          
                $('#ClientPrimaryEmail').html(innerHTML);
                $('#ClientPrimaryEmail').selectpicker('refresh');
            },
            failure: function (response) {
                console.log(response)
            },
            error: function (response) {
                console.log(response)
            }
        });
    }

    function GetClintEmail() {
        type = "Client";
        var ClintEmailinnerHTML = "";
        var PrimaryClintEmailinnerHTML = "";
        var ClintName = "";
        ClintName += "<option value=''>" + "Select Client Name" + "</option>";
        PrimaryClintEmailinnerHTML += "<option value=''>" + "Select Primary Client Email" + "</option>";
        $.ajax({
            type: "POST",
            url: "/SubsManagement/GetClintEmail",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            success: function (data) {
                
                $(data.DataList).each(function (index, value) {
                    
                    ClintEmailinnerHTML += "<option value = '" + value.UserId + "'> " + value.CorpEmail + "</option>"
                    PrimaryClintEmailinnerHTML += "<option value = '" + value.UserId + "'> " + value.CorpEmail + "</option>"
                    ClintName += "<option value = '" + value.Name + "'> " + value.Name + "</option>"
                });
               
                $('#ClientPrimaryEmail').html(PrimaryClintEmailinnerHTML);
                $('#ClientPrimaryEmail').selectpicker('refresh');
            },
            failure: function (response) {
                console.log(response)
            },
            error: function (response) {
                console.log(response)
            }
        });
    }

    $("#btnSubmit").click(function (e) {
        
        e.preventDefault(); 
        GetLeadOnSearchFilter();

    });



    function GetLeadOnSearchFilter() {
        
        var pageNumber = $('#PageNumber').val();
        var UserId = $("#ClientPrimaryEmail").val();
        var URL = "/SubsManagement/GellAllClintAllSubsciption?searchKeyword='" + Search + "'";
        URL += '&PageNumber=' + pageNumber;
        URL += '&UserId=' + UserId;
        URL += '&Type=' + type;
        $.ajax({
            url: URL,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,  // <-- Remove 'false', let it be async
            beforeSend: function () {
                $("#loader").show();
            },
            success: function (json) {
                var tbodyHTML = '';
                if (json != null) {
                    $(json.DateList).each(function (idx, elm) {

                        tbodyHTML += "<tr>";
                        tbodyHTML += "<td>" + elm.CorpEmail + "</td>";
                        tbodyHTML += "<td>" + elm.UserName + "</td>";
                        tbodyHTML += "<td>" + elm.CompanyName + "</td>";
                        tbodyHTML += "<td>" + elm.PrimarySecondary + "</td>";
                        tbodyHTML += "<td>" + elm.AccountStatus + "</td>";
                        tbodyHTML += "<td>" + elm.FromDate + "</td>";
                        tbodyHTML += "<td>" + elm.ToDate + "</td>";
                        tbodyHTML += "<td>" + elm.ModuleName + "</td>";
                        tbodyHTML += "<td>" + elm.ProductName + "</td>";
                        tbodyHTML += "<td>" + elm.CountryRegion + "</td>";
                        tbodyHTML += "<td>" + elm.ClintType + "</td>";
                        tbodyHTML += "<td>" + elm.ApiAccess + "</td>";
                        tbodyHTML += "</tr>"
                    });

                   // $('#divPagging').html(GetPaginationHTML(json));
                   // $('#pageSize').val(json.PageSize);

                }
                else {
                    tbodyHTML = "<tr><td class='text-center' colspan='20'><span>No records found..!!</span> </td></tr>";
                }
                $("#loader").hide();
                $('.tbodydata').html(tbodyHTML);
            },
            complete: function () {
                $("#loader").hide();
            }
        });
    }



    function GetPaginationHTML(json) {

        var pagingInnerHTML = "<span class='pull-left' style='color:#fff'>(Showing " + json.ShowingFrom + " to " + json.ShowingTo + " of " + json.RecordsCount + " records)</span>";
        var getPaginationButton = GetPagination(json.ActivePage, json.PagerSize, json.NumberOfPages, "");
        pagingInnerHTML += getPaginationButton;

        return pagingInnerHTML;
    }
    function PaggingButton(elm) {

        var pageNumber = elm.attr('url');

        $('#PageNumber').val(pageNumber);

        GetLeadOnSearchFilter();

    }
    function GetPagination(activePage, pagerSize, numberOfPages, URL) {

        var innerHTML = '';
        var startLi = pagerSize / pagerSize;
        var endLi = pagerSize;
        var multiplier = activePage / pagerSize;
        var modulo = activePage % pagerSize;
        var virtualLi = pagerSize - pagerSize;
        var previous = activePage / pagerSize * pagerSize - pagerSize + 1;
        var next = activePage / pagerSize * pagerSize + pagerSize + 1;

        if (modulo == 0) {
            next = next - pagerSize;
            previous = previous - pagerSize;
        }

        if (activePage > pagerSize) {
            for (var i = 1; i <= multiplier; i++) {
                virtualLi += pagerSize;
            }

            if (modulo > 0) {
                startLi = virtualLi + 1;
            }
            else {
                startLi = virtualLi - pagerSize + 1;
            }
            endLi = startLi + pagerSize - 1;
        }

        innerHTML = "<ul class='pagination pagination-sm no-margin pull-right'>";
        if (activePage > 1 && activePage < pagerSize + 1) {
            innerHTML += "<li class='paginate_button previous disabled' style='display:none;'>";
            innerHTML += "<a href='javascript:void(0);"

            innerHTML += "'><i class='fa fa-fw fa-arrow-left'></i></a>";
            innerHTML += "</li>";

            if (activePage == 1) {
                innerHTML += "<li class='paginate_button previous disabled'>";
                innerHTML += "<a href='javascript:void(0);";
                innerHTML += "'>&laquo;</a>";
                innerHTML += "</li>";
            }
            else {
                innerHTML += "<li class='paginate_button previous'>";
                innerHTML += "<a href='javascript:void(0);'  url='";
                //innerHTML += URL + "&id=" + (activePage - 1);
                innerHTML += URL + (activePage - 1);
                innerHTML += "' onclick='PaggingButton($(this));'>&laquo;</a>";
                innerHTML += "</li>";
            }
        }
        else if (activePage == 1) {
            innerHTML += "<li class='paginate_button previous disabled' disabled style='display:none;'>";
            innerHTML += "<a href='javascript:void(0);";
            innerHTML += "'><i class='fa fa-fw fa-arrow-left'></i></a>";
            innerHTML += "</li>";
            innerHTML += "<li class='paginate_button previous disabled'>";
            innerHTML += "<a href='javascript:void(0);";
            innerHTML += "'>&laquo;</a>";
            innerHTML += "</li>";
        }
        else {
            innerHTML += "<li class='paginate_button previous'>";
            innerHTML += "<a href='javascript:void(0);'  url='";
            //innerHTML += URL + "&id=" + (previous);
            innerHTML += URL + (previous);
            innerHTML += "' onclick='PaggingButton($(this));'><i class='fa fa-fw fa-arrow-left'></i></a>";
            innerHTML += "</li>";
            innerHTML += "<li class='paginate_button previous'>";
            innerHTML += "<a href='javascript:void(0);'  url='";
            //innerHTML += URL + "&id=" + (activePage - 1);
            innerHTML += URL + (activePage - 1);
            innerHTML += "' onclick='PaggingButton($(this));'>&laquo;</a>";
            innerHTML += "</li>";
        }


        for (var i = startLi; i <= endLi && i <= numberOfPages; i++) {
            if (i == activePage) {
                innerHTML += "<li>";
                innerHTML += "<a style='background-color:gainsboro;' href='javascript:void(0);";
            }
            else {
                innerHTML += "<li class='paginate_button'>";
                innerHTML += "<a onclick='PaggingButton($(this));' href='javascript:void(0);'  url='";
                //innerHTML += URL + "&id=" + i;
                innerHTML += URL + i;
            }

            innerHTML += "' >";
            innerHTML += i;
            innerHTML += "</a>";
            innerHTML += "</li>";
        }

        if (activePage + pagerSize > numberOfPages) {
            if (activePage == numberOfPages) {
                innerHTML += "<li class='paginate_button next disabled'>";
                innerHTML += "<a href='javascript:void(0);";
                innerHTML += "'>&raquo;</a>";
                innerHTML += "</li>";
            }
            else {
                innerHTML += "<li class='paginate_button next'>";
                innerHTML += "<a href='javascript:void(0);'  url='";
                //innerHTML += URL + "&id=" + (activePage + 1);
                innerHTML += URL + (activePage + 1);

                innerHTML += "' onclick='PaggingButton($(this));'>&raquo;</a>";
                innerHTML += "</li>";
            }

            innerHTML += "<li class='paginate_button next disabled' style='display:none;'>";
            innerHTML += "<a href='javascript:void(0);";
            innerHTML += "'><i class='fa fa-fw fa-arrow-right'></i></a>";
            innerHTML += "</li>";
        }
        else if (activePage == numberOfPages) {
            innerHTML += "<li class='paginate_button next disabled'>";
            innerHTML += "<a href='javascript:void(0);";
            innerHTML += "'>&raquo;</a>";
            innerHTML += "</li>";
            innerHTML += "<li class='paginate_button next disabled'> style='display:none;'";
            innerHTML += "<a href='javascript:void(0);";
            innerHTML += "'><i class='fa fa-fw fa-arrow-right'></i></a>";
            innerHTML += "</li>";
        }
        else {
            innerHTML += "<li class='paginate_button next'>";
            innerHTML += "<a href='javascript:void(0);'  url='";
            //innerHTML += URL + "&id=" + (activePage + 1);
            innerHTML += URL + (activePage + 1);

            innerHTML += "' onclick='PaggingButton($(this));'>&raquo;</a>";
            innerHTML += "</li>";

            innerHTML += "<li class='paginate_button next'>";
            innerHTML += "<a href='javascript:void(0);'  url='";
            //innerHTML += URL + "&id=" + (next);
            innerHTML += URL + (next);

            innerHTML += "' onclick='PaggingButton($(this));'><i class='fa fa-fw fa-arrow-right'></i></a>";
            innerHTML += "</li>";
        }
        innerHTML += "</ul>";

        return innerHTML;
    }

</script> 


