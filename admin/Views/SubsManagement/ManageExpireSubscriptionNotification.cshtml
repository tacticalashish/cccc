    <script type="text/javascript">
        $.formattedDate = function (dateToFormat) {
            var dateObject = new Date(dateToFormat);
            var day = dateObject.getDate();
            var month = dateObject.getMonth() + 1;
            var year = dateObject.getFullYear(); 
            var hours = dateObject.getHours();
            var minutes = dateObject.getMinutes();
            var seconds = dateObject.getSeconds();


            day = day < 10 ? "0" + day : day;
            month = month < 10 ? "0" + month : month;
            hours = hours < 10 ? "0" + hours : hours;
            minutes = minutes < 10 ? "0" + minutes : minutes;
            seconds = seconds < 10 ? "0" + seconds : seconds;

            var formattedDate = day + "/" + month + "/" + year + " " + hours + ":" + minutes + ":" + seconds;
            return formattedDate;
        };

        $(document).ready(function () {
        
            GetClintEmail();
        });

        function GetsearchValues() {
            Search = $('#search').val();
            $('#search').html(GetPaginationHTML(Search));
            GetSubscriptionBasedOnSearchFilter();
        }

        function GetSubscriptionBasedOnSearchFilter() {
          
            var TotalCount = 0;
            var pageNumber = $('#PageNumber').val();
            var Search = $('#search').val();
            var UserId = $('#ClientPrimaryEmail').val();

            var URL = "/SubsManagement/GetListForExpireSubscriptionNotification?searchKeyword='" + Search + "'";
            URL += '&PageNumber=' + pageNumber ;
            URL += '&UserId=' + UserId;
            $.ajax({
                url: URL,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                success: function (json) {

                    var tbodyHTML = '';
                    if (json != null) {
                        $(json.DateList).each(function (idx, elm) { 
                            var date = elm.CreatedDate
                            var CreatedDate = ($.formattedDate(new Date(parseInt(date.substr(6)))));

                            var formattedDateFrom = null;
                            var DateFrom = elm.DateFrom;
                            formattedDateFrom = ($.formattedDate(new Date(parseInt(DateFrom.substr(6)))));

                            var formattedDateTo = null;
                            var DateTo = elm.DateTo;
                            formattedDateTo = ($.formattedDate(new Date(parseInt(DateTo.substr(6)))));

                            tbodyHTML += "<tr>";
                            tbodyHTML += "<td hidden>" + elm.Id + "</td>";
                            tbodyHTML += "<td>" + elm.Name + "</td>";
                            tbodyHTML += "<td>" + elm.Phone + "</td>";
                            tbodyHTML += "<td>" + elm.CorpEmail + "</td>";
                            tbodyHTML += "<td>" + elm.Status + "</td>";
                            tbodyHTML += "<td>" + CreatedDate + "</td>";
                            tbodyHTML += "<td>" + formattedDateFrom + "</td>";
                            tbodyHTML += "<td>" + formattedDateTo + "</td>";
                          
                            if (elm.ExpiryNotification=="1")
                            {
                                tbodyHTML += "<td style='text-align:left'>" + "<input type='checkbox' id='Chkbox"+elm.Id+"'  onclick=UpdatecheckStatus('" + elm.Id + "') checked>" + "</td>"
                                //tbodyHTML += "<td style='text-align:left'>" + "<a class='label label- info' href='../SubsManagement/UpdateNotifystatus?SubsId=" + elm.Id + "&Status=" +chkboxval+"'> <input type='checkbox' id='Chkbox' name='Chkbox' checked></a>" + "</td>"
                            }
                            else {
                               // tbodyHTML += "<td style='text-align:left'>" + "<a class='label label- info' href='../SubsManagement/UpdateNotifystatus?SubsId=" + elm.Id + "&Status=" +chkboxval+"'> <input type='checkbox' id='Chkbox' name='Chkbox'></a>" + "</td>"
                                tbodyHTML += "<td style='text-align:left'>" + "<input type='checkbox' id='Chkbox"+elm.Id+"'  onchange=UpdatecheckStatus('" + elm.Id + "')>" + "</td>"
                            }
                          
                            tbodyHTML += "</tr>"
                        });

                        $('#divPagging').html(GetPaginationHTML(json));
                        $('#pageSize').val(json.PageSize);

                    }
                    else {
                        tbodyHTML = "<tr><td class='text-center' colspan='20'><span>No records found..!!</span> </td></tr>";
                    }


                    $('.tbodydata').html(tbodyHTML);

                    $('#DeSelectAll').show();
                    $('#Rownumber').val('');
                   
                }
            });
        }

        function UpdatecheckStatus(Id)
        {
            
            var chkboxval = '';
            var chkid = "#Chkbox" + Id;
            
            if ($(chkid).is(":checked")) {
                chkboxval = '1';
            }
            else {
                chkboxval = '0';
            }
         
            $.ajax({
                type: "POST",
                url: "/SubsManagement/UpdateNotifystatus",
                data: { SubsId: Id, Status: chkboxval },
                success: function (response) {
                   
                },
                failure: function (response) {
                    console.log(response)

                },
                error: function (response) {
                    console.log(response)
                }
            });
        }



        function GetPaginationHTML(json) {

            var pagingInnerHTML = "<span class='pull-left' style='color:#fff'>(Showing " + json.ShowingFrom + " to " + json.ShowingTo + " of " + json.RecordsCount + " records)</span>";
            var getPaginationButton = GetPagination(json.ActivePage, json.PagerSize, json.NumberOfPages, "");
            pagingInnerHTML += getPaginationButton;

            return pagingInnerHTML;
        }
        function PaggingButton(elm) {

            var pageNumber = elm.attr('url');

            $('#PageNumber').val(pageNumber);

            GetSubscriptionBasedOnSearchFilter();

        }
        function GetPagination(activePage, pagerSize, numberOfPages, URL) {

            var innerHTML = '';
            var startLi = pagerSize / pagerSize;
            var endLi = pagerSize;
            var multiplier = activePage / pagerSize;
            var modulo = activePage % pagerSize;
            var virtualLi = pagerSize - pagerSize;
            var previous = activePage / pagerSize * pagerSize - pagerSize + 1;
            var next = activePage / pagerSize * pagerSize + pagerSize + 1;

            if (modulo == 0) {
                next = next - pagerSize;
                previous = previous - pagerSize;
            }

            if (activePage > pagerSize) {
                for (var i = 1; i <= multiplier; i++) {
                    virtualLi += pagerSize;
                }

                if (modulo > 0) {
                    startLi = virtualLi + 1;
                }
                else {
                    startLi = virtualLi - pagerSize + 1;
                }
                endLi = startLi + pagerSize - 1;
            }

            innerHTML = "<ul class='pagination pagination-sm no-margin pull-right'>";
            if (activePage > 1 && activePage < pagerSize + 1) {
                innerHTML += "<li class='paginate_button previous disabled' style='display:none;'>";
                innerHTML += "<a href='javascript:void(0);"

                innerHTML += "'><i class='fa fa-fw fa-arrow-left'></i></a>";
                innerHTML += "</li>";

                if (activePage == 1) {
                    innerHTML += "<li class='paginate_button previous disabled'>";
                    innerHTML += "<a href='javascript:void(0);";
                    innerHTML += "'>&laquo;</a>";
                    innerHTML += "</li>";
                }
                else {
                    innerHTML += "<li class='paginate_button previous'>";
                    innerHTML += "<a href='javascript:void(0);'  url='";
                    //innerHTML += URL + "&id=" + (activePage - 1);
                    innerHTML += URL + (activePage - 1);
                    innerHTML += "' onclick='PaggingButton($(this));'>&laquo;</a>";
                    innerHTML += "</li>";
                }
            }
            else if (activePage == 1) {
                innerHTML += "<li class='paginate_button previous disabled' disabled style='display:none;'>";
                innerHTML += "<a href='javascript:void(0);";
                innerHTML += "'><i class='fa fa-fw fa-arrow-left'></i></a>";
                innerHTML += "</li>";
                innerHTML += "<li class='paginate_button previous disabled'>";
                innerHTML += "<a href='javascript:void(0);";
                innerHTML += "'>&laquo;</a>";
                innerHTML += "</li>";
            }
            else {
                innerHTML += "<li class='paginate_button previous'>";
                innerHTML += "<a href='javascript:void(0);'  url='";
                //innerHTML += URL + "&id=" + (previous);
                innerHTML += URL + (previous);
                innerHTML += "' onclick='PaggingButton($(this));'><i class='fa fa-fw fa-arrow-left'></i></a>";
                innerHTML += "</li>";
                innerHTML += "<li class='paginate_button previous'>";
                innerHTML += "<a href='javascript:void(0);'  url='";
                //innerHTML += URL + "&id=" + (activePage - 1);
                innerHTML += URL + (activePage - 1);
                innerHTML += "' onclick='PaggingButton($(this));'>&laquo;</a>";
                innerHTML += "</li>";
            }


            for (var i = startLi; i <= endLi && i <= numberOfPages; i++) {
                if (i == activePage) {
                    innerHTML += "<li>";
                    innerHTML += "<a style='background-color:gainsboro;' href='javascript:void(0);";
                }
                else {
                    innerHTML += "<li class='paginate_button'>";
                    innerHTML += "<a onclick='PaggingButton($(this));' href='javascript:void(0);'  url='";
                    //innerHTML += URL + "&id=" + i;
                    innerHTML += URL + i;
                }

                innerHTML += "' >";
                innerHTML += i;
                innerHTML += "</a>";
                innerHTML += "</li>";
            }

            if (activePage + pagerSize > numberOfPages) {
                if (activePage == numberOfPages) {
                    innerHTML += "<li class='paginate_button next disabled'>";
                    innerHTML += "<a href='javascript:void(0);";
                    innerHTML += "'>&raquo;</a>";
                    innerHTML += "</li>";
                }
                else {
                    innerHTML += "<li class='paginate_button next'>";
                    innerHTML += "<a href='javascript:void(0);'  url='";
                    //innerHTML += URL + "&id=" + (activePage + 1);
                    innerHTML += URL + (activePage + 1);

                    innerHTML += "' onclick='PaggingButton($(this));'>&raquo;</a>";
                    innerHTML += "</li>";
                }

                innerHTML += "<li class='paginate_button next disabled' style='display:none;'>";
                innerHTML += "<a href='javascript:void(0);";
                innerHTML += "'><i class='fa fa-fw fa-arrow-right'></i></a>";
                innerHTML += "</li>";
            }
            else if (activePage == numberOfPages) {
                innerHTML += "<li class='paginate_button next disabled'>";
                innerHTML += "<a href='javascript:void(0);";
                innerHTML += "'>&raquo;</a>";
                innerHTML += "</li>";
                innerHTML += "<li class='paginate_button next disabled'> style='display:none;'";
                innerHTML += "<a href='javascript:void(0);";
                innerHTML += "'><i class='fa fa-fw fa-arrow-right'></i></a>";
                innerHTML += "</li>";
            }
            else {
                innerHTML += "<li class='paginate_button next'>";
                innerHTML += "<a href='javascript:void(0);'  url='";
                //innerHTML += URL + "&id=" + (activePage + 1);
                innerHTML += URL + (activePage + 1);

                innerHTML += "' onclick='PaggingButton($(this));'>&raquo;</a>";
                innerHTML += "</li>";

                innerHTML += "<li class='paginate_button next'>";
                innerHTML += "<a href='javascript:void(0);'  url='";
                //innerHTML += URL + "&id=" + (next);
                innerHTML += URL + (next);

                innerHTML += "' onclick='PaggingButton($(this));'><i class='fa fa-fw fa-arrow-right'></i></a>";
                innerHTML += "</li>";
            }
            innerHTML += "</ul>";

            return innerHTML;
        }
        
        function GetClintEmail() {

            var ClintEmailinnerHTML = "";

         ClintEmailinnerHTML += "<option value=''>" + "Select Client Email" + "</option>";
            $.ajax({
                type: "POST",
                url: "/SubsManagement/GetAllClintEmail",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                success: function (json) {
                    
                    $(json.DataList).each(function (index, value) {
                        ClintEmailinnerHTML += "<option value = '" + value.UserId + "'> " + value.CorpEmail + "</option>" 
                    });
                    $('#ClientPrimaryEmail').html(ClintEmailinnerHTML);
                },
                failure: function (response) {
                    console.log(response)
                },
                error: function (response) {
                    console.log(response)
                }
            });
        }


        function Reset() {
            $('#PageNumber').val('1');
        }


        function DeSelectAllCheck() {

            var UserId = $('#ClientPrimaryEmail').val();

            $.ajax({
                type: "POST",
                url: "/SubsManagement/DeSelectAllCheck",
                data: { UserId: UserId },
                success: function (json) {

                    var innerHTML = '';
                    var data = json;
                    if (data.length != 0) {
                        $(data).each(function (idx, elm) {
                            innerHTML += '<h3> ' + elm.ValidationMessage + ' Row Effected </h3>';
                        });
                    }

                    $('.modal').hide();
                    $('#Rownumber').html(innerHTML);
                    GetSubscriptionBasedOnSearchFilter();

                },
                failure: function (response) {
                    console.log(response)

                },
                error: function (response) {
                    console.log(response)
                }

            });

        }


 </script>

