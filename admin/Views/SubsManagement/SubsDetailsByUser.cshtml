    function GetModuleSearchFilter() {
        
        var ModuleID = $("#ModuleIDs").val();
        $.ajax({
            url: "/SubsManagement/GetCustomerbyModule",
            data: { ModuleId: ModuleID},
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,  // <-- Remove 'false', let it be async
            beforeSend: function () {
                $("#loader").show();
