                }
                else {
                    tbodyHTML = "<tr><td class='text-center' colspan='20'><span>No records found..!!</span> </td></tr>";
                }
                $('.Modulebodydata').html(tbodyHTML);
            },
            complete: function () {
                $("#loader").hide();
            }
        });
    } 

    function GetCustomerPrimary() {
        
        $.ajax({
            url: "/SubsManagement/GetCustomerPrimary",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,  // <-- Remove 'false', let it be async
            beforeSend: function () {
                $("#loader").show();
            },
            success: function (json) {
                var tbodyHTML = '';
                if (json != null) {
                    $(json.DataList).each(function (idx, elm) {
                        tbodyHTML += "<tr>";
                        tbodyHTML += "<td>" + elm.CompanyName + "</td>";
                        tbodyHTML += "<td>" + elm.UserName + "</td>";
                        tbodyHTML += "<td>" + elm.CorpEmail + "</td>";
                        tbodyHTML += "<td>" + elm.PrimarySecondary + "</td>";
                        tbodyHTML += "<td>" + elm.ClientStatus + "</td>";
                        tbodyHTML += "<td>" + elm.ToDate + "</td>";
                        
                        tbodyHTML += "</tr>"
                    });

                }
                else {
                    tbodyHTML = "<tr><td class='text-center' colspan='20'><span>No records found..!!</span> </td></tr>";
                }
                $('.PrimarySecondaybodydata').html(tbodyHTML);
            },
            complete: function () {
                $("#loader").hide();
            }
        });
    } 

    
</script>