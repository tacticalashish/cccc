<script>

    $(document).ready(function () {

         GetClintEmail();

    });

    $("#Product").click(function () {
        $("#loader").show();
        $("#Apitable, #ModuleList ,#PrimarySecondaytable, #Moduletable").hide();
        $("#ProductList, #producttable").show();
        GetProduct();
        GetProductSearchFilter();
        $("#loader").hide();
    });
    $("#ChekApiClint").click(function (e) {
        
        e.preventDefault();
        $("#Apitable").show();
        $("#ProductList, #producttable ,#ModuleList ,#PrimarySecondaytable").hide();
        GetApiSearchFilter();
        
    });
    $("#Module").click(function () {
        
        $("#ModuleList ,#Moduletable").show();
        $("#ProductList, #producttable ,#Apitable, #PrimarySecondaytable").hide();
        GetModuleSearchFilter();
    });
    $("#btnSubmitProduct").click(function (e) {
        $("#ProductsearchInput").val('');
        e.preventDefault();  // prevent form submit if any
        $("#ProductList").show();
        GetProductSearchFilter();
    });
    $("#ModuleSubmit").click(function (e) {
        
        e.preventDefault(); 
        $("#ProductList, #producttable ,#Apitable ,#PrimarySecondaytable").hide();
        $("#Moduletable").show();
        GetModuleSearchFilter();
       
    });
    $("#PrimarySeconday").click(function (e) {
        
        e.preventDefault(); 
        $("#ProductList, #producttable ,#Apitable, #Moduletable").hide();
        $("#PrimarySecondaytable").show();
        GetCustomerPrimary();
        
    });


    //-------------------search code start-----------------------------------------------------------------
    document.getElementById('ProductsearchInput').addEventListener('keyup', function () {
        var input = this.value.toLowerCase();
        var rows = document.querySelectorAll('#Productdata tbody tr');

        rows.forEach(function (row) {
            var text = row.textContent.toLowerCase();
            row.style.display = text.includes(input) ? '' : 'none';
        });
    });
    document.getElementById('ApisearchInput').addEventListener('keyup', function () {
        
        var input = this.value.toLowerCase();
        var rows = document.querySelectorAll('#Apidata tbody tr');

        rows.forEach(function (row) {
            var text = row.textContent.toLowerCase();
            row.style.display = text.includes(input) ? '' : 'none';
        });
    });
    document.getElementById('PrimarySecondaysearchInput').addEventListener('keyup', function () {
        
        var input = this.value.toLowerCase();
        var rows = document.querySelectorAll('#PrimarySecondaydata tbody tr');

        rows.forEach(function (row) {
            var text = row.textContent.toLowerCase();
            row.style.display = text.includes(input) ? '' : 'none';
        });
    });
    document.getElementById('ModulesearchInput').addEventListener('keyup', function () {
        
        var input = this.value.toLowerCase();
        var rows = document.querySelectorAll('#Moduledata tbody tr');

        rows.forEach(function (row) {
            var text = row.textContent.toLowerCase();
            row.style.display = text.includes(input) ? '' : 'none';
