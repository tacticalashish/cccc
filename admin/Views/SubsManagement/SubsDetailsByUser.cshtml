     //-------------------search code end-----------------------------------------------------------------



    document.getElementById('Productdatadownload').addEventListener('click', function () {
        // Get table
        
        var table = document.getElementById('Productdata');

        // Convert table to worksheet
        var wb = XLSX.utils.table_to_book(table, { sheet: "Sheet1" });

        // Export to Excel file
        XLSX.writeFile(wb, 'Productdata.xlsx');
    });
    document.getElementById('Apidatadownload').addEventListener('click', function () {
