        // Export to Excel file
        XLSX.writeFile(wb, 'PrimarySecondaydata.xlsx');
    }); 


    function GetClintEmail() {
        type = "Client";
        var ClintEmailinnerHTML = "";
        var PrimaryClintEmailinnerHTML = "";
        var ClintName = "";
        ClintName += "<option value=''>" + "Select Client Name" + "</option>";
        PrimaryClintEmailinnerHTML += "<option value=''>" + "Select Primary Client Email" + "</option>";
        $.ajax({
            type: "POST",
            url: "/SubsManagement/GetClintEmail",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            success: function (data) {
                
                $(data.DataList).each(function (index, value) {
                    
                    ClintEmailinnerHTML += "<option value = '" + value.UserId + "'> " + value.CorpEmail + "</option>"
                    PrimaryClintEmailinnerHTML += "<option value = '" + value.UserId + "'> " + value.CorpEmail + "</option>"
                    ClintName += "<option value = '" + value.Name + "'> " + value.Name + "</option>"
                });

                $('#ClientPrimaryEmail').html(PrimaryClintEmailinnerHTML);
                $('#ClientPrimaryEmail').selectpicker('refresh');
            },
            failure: function (response) {
                console.log(response)
            },
            error: function (response) {
                console.log(response)
            }
        });
    }

    function GetProduct() {
        
        type = "Company";
        $.ajax({
            type: "POST",
            url: "/SubsManagement/GetProduct",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            success: function (data) {
                
                var innerHTML = "";
                innerHTML += "<option  value = ''>" + "Select Product" + "</option>";
                $(data.DataList).each(function (index, value) {
                    if (value.ProductName != null || value.ProductName != "" || value.ProductName != undefined) {
                        innerHTML += "<option value = '" + value.ProductId + "'> " + value.ProductName + "</option>"
                    }
                });


                $('#ProductIDs').html(innerHTML);
                $('#ProductIDs').selectpicker('refresh');
            },
            failure: function (response) {
                console.log(response)
            },
            error: function (response) {
                console.log(response)
            }
        });
    }

    function GetProductSearchFilter() {
        var pageNumber = $('#PageNumber').val();
        var Product = $("#ProductIDs").val();
        $.ajax({
            url: "/SubsManagement/GetCustomerByProduct",
            data: { Productid: Product },
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,  // <-- Remove 'false', let it be async
            beforeSend: function () {
                $("#loader").show();
            },
            success: function (json) {
                var tbodyHTML = '';
                if (json != null) {
                    $(json.DataList).each(function (idx, elm) {
                        tbodyHTML += "<tr>";
                        tbodyHTML += "<td>" + elm.CorpEmail + "</td>";
                        tbodyHTML += "<td>" + elm.CompanyName + "</td>";
                        tbodyHTML += "<td>" + elm.ModuleName + "</td>";
                        tbodyHTML += "</tr>";
                    });
                } else {
                    tbodyHTML = "<tr><td class='text-center' colspan='20'><span>No records found..!!</span> </td></tr>";
                }
                $('.Producttbodydata').html(tbodyHTML);
            },
            complete: function () {
                $("#loader").hide();
            }
        });
    }


    function GetApiSearchFilter() {
        
        $.ajax({
            url: "/SubsManagement/GetCustomerISApiAccess",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,  // <-- Remove 'false', let it be async
            beforeSend: function () {
                $("#loader").show();
            },
            success: function (json) {
                var tbodyHTML = '';
