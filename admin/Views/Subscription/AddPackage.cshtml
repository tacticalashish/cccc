                //    if (!ProductId) {
                //        ProductId = productList[i];
                //    }
                //    else {
                //        ProductId = ProductId + ',' + productList[i];
                //    }
                //}

                var MenuId = "";
                for (var i = 0; i < moduleList.length; i++) {
                    if (!MenuId) {
                        MenuId = moduleList[i];
                    }
                    else {
                        MenuId = MenuId + ',' + moduleList[i];
                    }
                }

                var subs = {};
                var subsType = $('#ddlSubscriptionType').val();
                subs.SubscriptionType = $("input:radio[name = subscription_type]:checked").val();
                subs.FromDate = $("#FromDatepicker").val();
                subs.ToDate = $("#ToDatepicker").val();
                subs.Description = $("#description").val();
                //subs.ProductId = ProductId;
                subs.LeadId = $("#Leadid").val();
                subs.MenuId = MenuId;

                subs.RegionsID = GetCheckedBox('checkboxesregion');
                subs.CountriesID = GetCheckedBox('checkboxesCountry');
                subs.ProductId = GetCheckedBox('checkboxes');
                subs.ChemicalPricingRange = GetRangeCheckbox('divChemicalPricingRange');
                subs.MarketAnalysisRange = GetRangeCheckbox('divMarketAnalysisRange');

                if (!subs.SubscriptionType) {
                    //alert("Please Select Subscription Type");
                    swal("Warning", "Please Select Subscription Type", "error");
                    return false;
                }

                if (!subs.FromDate) {
                    //alert("Please Enter From Date");
                    swal("Warning", "Please Enter From Date", "error");
                    return false;
                }

                if (!subs.ToDate) {
                    //alert("Please Enter From ToDate");
                    swal("Warning", "Please Enter To Date", "error");
                    return false;
                }

                if (!subs.MenuId) {
                    //alert("Please Select Module");
                    swal("Warning", "Please Select Module", "error");
                    return false;
                }

                if (subsType == 'region' && !subs.RegionsID) {
                    //alert("Please Select Product");
                    swal("Warning", "Please Select Region", "error");
                    return false;
                }

                if (subsType == 'country' && !subs.CountriesID) {
                    //alert("Please Select Product");
                    swal("Warning", "Please Select Country", "error");
                    return false;
                }

                if (!subs.ProductId) {
                    //alert("Please Select Product");
                    swal("Warning", "Please Select Product", "error");
                    return false;
                }


               

               $("#loaderCustom").show();

               $.ajax({
                    type: "POST",
                    url: '@Url.Action("SaveSalesPackageSubscriptionAsync")',
                    data:  subs,
                   success: function (data) {

                       $("#loaderCustom").hide();
                        if (data && data.result) {
                            //setTimeout(function () {
                            swal("Thank you!", "Subscription Created Sucessfully.", "success");
                            //alert(data.result);
                            window.location.href = "../../SubsManagement/ShowSubscriptionListForSales";
                            $("#FromDatepicker").val('');
                            $("#ToDatepicker").val('');
                            $("#description").val('');
                            productList = [];
                            moduleList = [];
                            $('input[name="module"]').each(function () {
                                this.checked = false;
                            });
                            $('input[name="productList"]').each(function () {
                                this.checked = false;
                            });
                                document.getElementById("checkboxes").style.display = "none";
                            //}, 2000);
                        }
                        else {
                            //alert("Error while inserting data");
                            swal("Warning", "Error while inserting data :)", "error");
                        }
                    },
                    error: function () {
                        //alert("Error while inserting data");
                        swal("Warning", "Error while inserting data :)", "error");
                    }
                });
            return false;
        });
    });

